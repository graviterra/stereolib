@[simp] theorem imageArtifactsChunk4_length : imageArtifactsChunk4.length = 50 := by rfl

def imageArtifactPathsChunk4 : List String :=
  imageArtifactsChunk4.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk4_isChain :
    imageArtifactPathsChunk4.IsChain (· < ·) := by decide

theorem imageArtifactsChunk4_transcribedCount :
    (imageArtifactsChunk4.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk4_transcribedTemplatesWellFormed :
    (imageArtifactsChunk4.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk4_genericAndErratumTranscribed :
    (imageArtifactsChunk4.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk4_kindCounts :
    (imageArtifactsChunk4.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk4.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk4.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk4.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk4_chemicalPartitionCounts :
    (imageArtifactsChunk4.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk4.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk4_graphAuditMaturityCounts :
    (imageArtifactsChunk4.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk4.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk4.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

