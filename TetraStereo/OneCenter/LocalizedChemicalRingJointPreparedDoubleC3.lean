import TetraStereo.OneCenter.LocalizedChemicalRingJointPreparedRootSuccess
import TetraStereo.OneCenter.LocalizedChemicalRingDoubleC3Domain
import TetraStereo.KernelOnly

set_option autoImplicit false

/-! Nonvacuity of the general root success theorem: the actual 25-atom double-C3 cyclic
fixture, with detected centers 0, 3 and 14 and spatially calibrated opposite branches.
Its auxiliary labels and root comparisons are generated by the repaired evaluator. No
whole-state computation or desired output is supplied. The concrete letter and lowercase
case are not inferred here merely from the independently proved physical pair count. -/
namespace TetraStereo.OneCenter.LocalizedChemicalRingJointPreparedDoubleC3

open LocalizedChemicalRingDoubleC3Input LocalizedChemicalRingDoubleC3Domain
open LocalizedChemicalRingJointMarkerOperations (jointOperations)
open LocalizedChemicalRingPreparedContextRecursion (preparedAssignCenter?)
open LocalizedChemicalRingPhysicalSense (inputGeometry)

theorem root_success : ∃ label,
    preparedAssignCenter? mol (jointOperations input mol) (inputGeometry input) 0 = some label :=
  LocalizedChemicalRingJointPreparedRootSuccess.assignCenter_success input mol
    (structure_agreement true) admissible supported single_bonded ⟨0, constant_charge⟩
    cfg calibrated detectedRoot proper_distinct

end TetraStereo.OneCenter.LocalizedChemicalRingJointPreparedDoubleC3

assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingJointPreparedDoubleC3.root_success
