/-! ## Rule-1a projection vocabulary -/

/-- Project one raw Rule-1a entry to the localized sparse vocabulary. -/
def rule1aEntryProjection (entry : RawMolecule.CanonicalAtomicEntry) :
    OfficialSparseEntry ℕ :=
  (entry.1, entry.2.numerator)

/-- Project one raw Rule-1a layer. -/
def rule1aLayerProjection (layer : List RawMolecule.CanonicalAtomicEntry) :
    List (OfficialSparseEntry ℕ) :=
  layer.map rule1aEntryProjection

/-- The accepted plain projection is the layerwise projection. -/
theorem plainRule1aProjection_eq_map
    (layers : List (List RawMolecule.CanonicalAtomicEntry)) :
    plainRule1aProjection layers = layers.map rule1aLayerProjection :=
  rfl

/-- Layerwise projection commutes with append. -/
theorem plainRule1aProjection_append
    (left right : List (List RawMolecule.CanonicalAtomicEntry)) :
    plainRule1aProjection (left ++ right) =
      plainRule1aProjection left ++ plainRule1aProjection right := by
  simp [plainRule1aProjection]

/-- Projection commutes with the sibling-slot prefix. -/
theorem rule1aLayerProjection_prefix (slot : ℕ)
    (layer : List RawMolecule.CanonicalAtomicEntry) :
    rule1aLayerProjection (RawMolecule.prefixCanonicalAtomicLayer slot layer) =
      OfficialRuleMajorKey.prefixLayer slot (rule1aLayerProjection layer) := by
  simp [rule1aLayerProjection, RawMolecule.prefixCanonicalAtomicLayer,
    OfficialRuleMajorKey.prefixLayer, rule1aEntryProjection, List.map_map]

/-- Mapping a `getD`-selected layer. -/
theorem map_getD_layer {α β : Type*} (f : α → β)
    (layers : List (List α)) (depth : ℕ) :
    (layers.getD depth []).map f =
      (layers.map (List.map f)).getD depth [] := by
  induction layers generalizing depth with
  | nil => rfl
  | cons layer layers ih =>
      cases depth with
      | zero => rfl
      | succ depth => simpa using ih depth

/-- Projection commutes with the layer-indexed `getD`. -/
theorem rule1aLayerProjection_getD
    (layers : List (List RawMolecule.CanonicalAtomicEntry)) (depth : ℕ) :
    rule1aLayerProjection (layers.getD depth []) =
      (layers.map rule1aLayerProjection).getD depth [] :=
  map_getD_layer rule1aEntryProjection layers depth

/-- A corresponding child key has equal projected Rule-1a columns. -/
theorem rule1aProjection_eq_of_corresponds {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : ConstitutionalKeyCorresponds raw loc) :
    raw.rule1a.map rule1aLayerProjection = loc.rule1a := by
  simpa [plainRule1aProjection_eq_map] using h.rule1a

/-! ## Generic list lemmas -/

/-- Two `Forall₂`-related lists have equal emptiness. -/
theorem isEmpty_eq_of_forall₂ {α β : Type*} {R : α → β → Prop}
    {xs : List α} {ys : List β} (h : List.Forall₂ R xs ys) :
    xs.isEmpty = ys.isEmpty := by
  rw [Bool.eq_iff_iff, List.isEmpty_iff_length_eq_zero, List.isEmpty_iff_length_eq_zero,
    h.length_eq]

/-- Permutation preserves emptiness. -/
theorem isEmpty_eq_of_perm {α : Type*} {left right : List α} (h : left.Perm right) :
    left.isEmpty = right.isEmpty := by
  rw [Bool.eq_iff_iff, List.isEmpty_iff_length_eq_zero, List.isEmpty_iff_length_eq_zero,
    h.length_eq]

/-- `zipIdx` transports pointwise along a `Forall₂`. -/
theorem forall₂_zipIdx {α β : Type*} {R : α → β → Prop}
    {xs : List α} {ys : List β} (h : List.Forall₂ R xs ys) :
    ∀ start : ℕ,
      List.Forall₂ (fun a b => R a.1 b.1 ∧ a.2 = b.2)
        (xs.zipIdx start) (ys.zipIdx start) := by
  induction h with
  | nil => intro start; simp
  | cons hhead htail ih =>
      intro start
      simp [List.zipIdx_cons, hhead, ih (start + 1)]

/-- `flatMap` equality from pointwise equality on a `Forall₂`-aligned list. -/
theorem flatMap_eq_of_forall₂ {α β γ : Type*} {R : α → β → Prop}
    {xs : List α} {ys : List β} (h : List.Forall₂ R xs ys)
    (f : α → List γ) (g : β → List γ)
    (hf : ∀ a b, R a b → f a = g b) :
    xs.flatMap f = ys.flatMap g := by
  induction h with
  | nil => rfl
  | cons hhead htail ih =>
      simp [List.flatMap_cons, hf _ _ hhead, ih]

/-- An entry of the layer selected by `getD` is an entry of the flattened layer list. -/
theorem mem_flatten_getD {α : Type*} {layers : List (List α)} {depth : ℕ} {e : α}
    (h : e ∈ layers.getD depth []) : e ∈ layers.flatten := by
  rw [List.getD_eq_getElem?_getD] at h
  cases hlayer : layers[depth]? with
  | none => simp [hlayer] at h
  | some layer =>
      exact List.mem_flatten.mpr ⟨layer, List.mem_of_getElem? hlayer, by simpa [hlayer] using h⟩

/-- An equality of projected lists is a pointwise `Forall₂`. -/
theorem forall₂_of_map_eq_map {α β γ : Type*} {f : α → γ} {g : β → γ} :
    ∀ {left : List α} {right : List β},
      left.map f = right.map g → List.Forall₂ (fun a b => f a = g b) left right := by
  intro left
  induction left with
  | nil =>
      intro right equal
      cases right with
      | nil => exact List.Forall₂.nil
      | cons _ _ => simp at equal
  | cons head tail ih =>
      intro right equal
      cases right with
      | nil => simp at equal
      | cons other rest =>
          simp only [List.map_cons, List.cons.injEq] at equal
          exact List.Forall₂.cons equal.1 (ih equal.2)

/-- `all` with a Boolean predicate is invariant under permutation. -/
theorem all_eq_of_perm {α : Type*} (p : α → Bool) :
    ∀ {left right : List α}, left.Perm right → left.all p = right.all p := by
  intro left right h
  induction h with
  | nil => rfl
  | cons x _ ih => simp [List.all_cons, ih]
  | swap x y rest => simp [List.all_cons, Bool.and_left_comm]
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- `all` respects a pointwise `Forall₂`. -/
theorem all_eq_of_forall₂ {α β : Type*} {R : α → β → Prop}
    {xs : List α} {ys : List β} (h : List.Forall₂ R xs ys)
    (f : α → Bool) (g : β → Bool) (hfg : ∀ a b, R a b → f a = g b) :
    xs.all f = ys.all g := by
  induction h with
  | nil => rfl
  | cons hhead htail ih =>
      simp [List.all_cons, hfg _ _ hhead, ih]

/-- `mapM'` transports a successful computation across a permutation, up to `List.Perm`. -/
theorem mapM'_perm_of_perm {α β : Type*} (f : α → Option β) :
    ∀ {source target : List α}, source.Perm target →
      ∀ {result : List β}, source.mapM' f = some result →
        ∃ other, target.mapM' f = some other ∧ result.Perm other := by
  intro source target h
  induction h with
  | nil =>
      intro result computed
      rw [List.mapM'_nil] at computed
      simp only [Option.pure_def, Option.some.injEq] at computed
      cases computed
      exact ⟨[], rfl, List.Perm.nil⟩
  | cons x _ ih =>
      rename_i tailSource tailTarget hperm
      intro result computed
      rw [List.mapM'_cons] at computed
      change (f x).bind
        (fun head => (tailSource.mapM' f).bind (fun tail => some (head :: tail))) =
          some result at computed
      rw [Option.bind_eq_some_iff] at computed
      obtain ⟨head, hhead, tailBuild⟩ := computed
      rw [Option.bind_eq_some_iff] at tailBuild
      obtain ⟨tail, htail, hsum⟩ := tailBuild
      rw [Option.some.injEq] at hsum
      cases hsum
      obtain ⟨otherTail, hotherTail, hpermTail⟩ := ih htail
      refine ⟨head :: otherTail, ?_, List.Perm.cons head hpermTail⟩
      rw [List.mapM'_cons]
      simp [hhead, hotherTail]
  | swap x y rest =>
      intro result computed
      rw [List.mapM'_cons] at computed
      change (f y).bind
        (fun headY => ((x :: rest).mapM' f).bind
          (fun tail => some (headY :: tail))) = some result at computed
      rw [Option.bind_eq_some_iff] at computed
      obtain ⟨headY, hy, restBuild⟩ := computed
      rw [Option.bind_eq_some_iff] at restBuild
      obtain ⟨middle, hmiddle, hsum⟩ := restBuild
      rw [Option.some.injEq] at hsum
      cases hsum
      rw [List.mapM'_cons] at hmiddle
      change (f x).bind
        (fun headX => (rest.mapM' f).bind (fun tail => some (headX :: tail))) =
          some middle at hmiddle
      rw [Option.bind_eq_some_iff] at hmiddle
      obtain ⟨headX, hx, tailBuild⟩ := hmiddle
      rw [Option.bind_eq_some_iff] at tailBuild
      obtain ⟨tail, htail, hsum⟩ := tailBuild
      rw [Option.some.injEq] at hsum
      cases hsum
      refine ⟨headX :: headY :: tail, ?_, List.Perm.swap headX headY tail⟩
      rw [List.mapM'_cons, List.mapM'_cons]
      simp [hx, hy, htail]
  | trans _ _ ih1 ih2 =>
      intro result computed
      obtain ⟨middle, hmiddle, hpermMiddle⟩ := ih1 computed
      obtain ⟨other, hother, hpermOther⟩ := ih2 hmiddle
      exact ⟨other, hother, hpermMiddle.trans hpermOther⟩

/-- `mapM` transports a successful computation across a permutation, up to `List.Perm`. -/
theorem mapM_perm_of_perm {α β : Type*} (f : α → Option β)
    {source target : List α} (h : source.Perm target)
    {result : List β} (computed : source.mapM f = some result) :
    ∃ other, target.mapM f = some other ∧ result.Perm other := by
  have hcomputed : source.mapM' f = some result := by
    rwa [List.mapM'_eq_mapM]
  obtain ⟨other, hother, hperm⟩ := mapM'_perm_of_perm f h hcomputed
  refine ⟨other, ?_, hperm⟩
  rw [← List.mapM'_eq_mapM]
  exact hother

/-! ## Rule-1a domain and root-key columns -/

/-- The plain-label domain of the constructed bridge, stated for the reachable node set. -/
def ActualRule1aPlainDomain (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) : Prop :=
  mol.canonicalRule1aLabel? node =
    some { numerator := mol.atomZAt node.atom, denominator := 1 }

/-- Raw `atomZAt` reads the same parsed-atom atomic number as the raw parser-index lookup. -/
theorem atomZAt_eq_get (mol : RawMolecule) (idx : ℕ) (h : idx < mol.atomCount) :
    mol.atomZAt idx =
      (mol.atoms.get ⟨idx, by simpa [RawMolecule.atomCount] using h⟩).element.atomicNumber := by
  unfold RawMolecule.atomZAt RawMolecule.atomAt?
  rw [listGet?_eq_some_get mol.atoms ⟨idx, by simpa [RawMolecule.atomCount] using h⟩]

/-- Case analysis on provenance correspondence, exposed as an ordinary disjunction. -/
theorem nodeProvenance_cases (provenanceO : OfficialCIPNodeProvenance)
    (provenanceC : RawMolecule.CanonicalNodeProvenance)
    (h : NodeProvenanceCorresponds provenanceO provenanceC) :
    (provenanceO = OfficialCIPNodeProvenance.realAtom ∧
      provenanceC = RawMolecule.CanonicalNodeProvenance.realAtom) ∨
    (∃ distance, provenanceO = OfficialCIPNodeProvenance.multipleBondDuplicate distance ∧
      provenanceC = RawMolecule.CanonicalNodeProvenance.multipleBondDuplicate distance) ∨
    (∃ distance, provenanceO = OfficialCIPNodeProvenance.ringDuplicate distance ∧
      provenanceC = RawMolecule.CanonicalNodeProvenance.ringDuplicate distance) := by
  cases h with
  | realAtom => exact Or.inl ⟨rfl, rfl⟩
  | multipleBondDuplicate distance => exact Or.inr (Or.inl ⟨distance, rfl, rfl⟩)
  | ringDuplicate distance => exact Or.inr (Or.inr ⟨distance, rfl, rfl⟩)

/-- The first component of the localized node label is the raw atomic number at the node atom. -/
theorem officialNodeAtomLabel_first_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    {node : RawMolecule.CanonicalBranchNode}
    {onode : OfficialCIPNode input.Atom}
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    (atomBound : node.atom < mol.atomCount) :
    (ofLex (input.moleculeGraph.officialNodeAtomLabel onode)).1 = mol.atomZAt node.atom := by
  obtain ⟨atom, hcurrent⟩ := hcorr.exists_current
  have hval : atom.val = node.atom := by
    have h := hcorr.current
    rw [hcurrent] at h
    simpa using h
  let rawIndex : Fin mol.atomCount := ⟨node.atom, atomBound⟩
  have hloc : localizedIndexOf mol input agreement rawIndex = atom := by
    apply Fin.ext
    simp [rawIndex, localizedIndexOf, hval]
  have hz := (intakeAtomDataCorresponds mol input agreement rawIndex).1
  rw [hloc] at hz
  simp only [MoleculeGraph.officialNodeAtomLabel, hcurrent]
  split <;>
    simp [MoleculeGraph.rawCIPAtomLabel, ofLex_toLex, hz, rawIndex,
      atomZAt_eq_get mol node.atom atomBound]

/-- The second component of the localized node label is the raw Rule-2 mass for real atoms and
zero for duplicate provenance. -/
theorem officialNodeAtomLabel_second_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    {node : RawMolecule.CanonicalBranchNode}
    {onode : OfficialCIPNode input.Atom}
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    (atomBound : node.atom < mol.atomCount) :
    (ofLex (input.moleculeGraph.officialNodeAtomLabel onode)).2 =
      (match node.provenance with
       | RawMolecule.CanonicalNodeProvenance.realAtom => mol.atomMassAt node.atom
       | _ => 0) := by
  obtain ⟨atom, hcurrent⟩ := hcorr.exists_current
  have hval : atom.val = node.atom := by
    have h := hcorr.current
    rw [hcurrent] at h
    simpa using h
  let rawIndex : Fin mol.atomCount := ⟨node.atom, atomBound⟩
  have hloc : localizedIndexOf mol input agreement rawIndex = atom := by
    apply Fin.ext
    simp [rawIndex, localizedIndexOf, hval]
  have hm := (intakeAtomDataCorresponds mol input agreement rawIndex).2
  rw [hloc] at hm
  have hmAt : mol.atomMassAt node.atom = input.moleculeGraph.atomMass atom := hm.symm
  have hcases := nodeProvenance_cases onode.provenance node.provenance hcorr.provenance
  rcases hcases with hreal | hrest
  · obtain ⟨hpo, hpc⟩ := hreal
    simp only [MoleculeGraph.officialNodeAtomLabel, hcurrent, hpo, hpc]
    simp [MoleculeGraph.rawCIPAtomLabel, ofLex_toLex, hmAt]
  · rcases hrest with hduplicate | hring
    · obtain ⟨distance, hpo, hpc⟩ := hduplicate
      simp only [MoleculeGraph.officialNodeAtomLabel, hcurrent, hpo, hpc]
      simp [ofLex_toLex]
    · obtain ⟨distance, hpo, hpc⟩ := hring
      simp only [MoleculeGraph.officialNodeAtomLabel, hcurrent, hpo, hpc]
      simp [ofLex_toLex]

/-- Columns-level constitutional correspondence (the observable content without the completeness
flag). -/
structure ActualKeyColumnsCorrespond {V : Type*}
    (raw : RawMolecule.CanonicalBranchKey) (loc : OfficialRuleMajorKey V) : Prop where
  plain : ∀ e, e ∈ raw.rule1a.flatten → e.2.denominator = 1
  rule1a : plainRule1aProjection raw.rule1a = loc.rule1a
  rule1b : raw.rule1b = loc.rule1b
  rule2 : raw.rule2 = loc.rule2

/-- Add a proved completeness equality. -/
theorem ActualKeyColumnsCorrespond.toCorresponds {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : ActualKeyColumnsCorrespond raw loc) (hcomplete : raw.complete = loc.complete) :
    ConstitutionalKeyCorresponds raw loc :=
  ⟨h.plain, h.rule1a, h.rule1b, h.rule2, hcomplete⟩

/-- Column correspondence for the two actually constructed root keys, at arbitrary completeness
flags. -/
theorem canonicalRootKey_columns
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    {node : RawMolecule.CanonicalBranchNode}
    {onode : OfficialCIPNode input.Atom}
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    (atomBound : node.atom < mol.atomCount)
    (domain : ActualRule1aPlainDomain mol node)
    (rawComplete locComplete : Bool) :
    ActualKeyColumnsCorrespond
      (mol.canonicalRootKey node rawComplete)
      (input.moleculeGraph.officialRuleMajorRootKey onode locComplete) := by
  have hdomain : mol.canonicalRule1aLabel? node =
      some { numerator := mol.atomZAt node.atom, denominator := 1 } := domain
  have hlabel : mol.canonicalRule1aLabel node =
      { numerator := mol.atomZAt node.atom, denominator := 1 } := by
    simp only [RawMolecule.canonicalRule1aLabel, hdomain, Option.getD_some]
  have hz := officialNodeAtomLabel_first_eq mol input agreement hcorr atomBound
  have hm := officialNodeAtomLabel_second_eq mol input agreement hcorr atomBound
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro e he
    have he' : e = ([], mol.canonicalRule1aLabel node) := by
      simpa [RawMolecule.canonicalRootKey] using he
    rw [he', hlabel]
  · simp [RawMolecule.canonicalRootKey, MoleculeGraph.officialRuleMajorRootKey,
      plainRule1aProjection, hlabel, hz]
  · simp [RawMolecule.canonicalRootKey, MoleculeGraph.officialRuleMajorRootKey,
      RawMolecule.CanonicalBranchNode.rule1bCode, rule1bRootDistance_eq hcorr]
  · simpa [RawMolecule.canonicalRootKey, MoleculeGraph.officialRuleMajorRootKey] using hm.symm

/-- The root key is plain on the plain-label domain. -/
theorem canonicalRootKey_plain (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) (complete : Bool)
    (domain : ActualRule1aPlainDomain mol node) :
    ∀ e, e ∈ (mol.canonicalRootKey node complete).rule1a.flatten →
      e.2.denominator = 1 := by
  intro e he
  have hdomain : mol.canonicalRule1aLabel? node =
      some { numerator := mol.atomZAt node.atom, denominator := 1 } := domain
  have hlabel : mol.canonicalRule1aLabel node =
      { numerator := mol.atomZAt node.atom, denominator := 1 } := by
    simp only [RawMolecule.canonicalRule1aLabel, hdomain, Option.getD_some]
  have he' : e = ([], mol.canonicalRule1aLabel node) := by
    simpa [RawMolecule.canonicalRootKey] using he
  rw [he']
  simp [hlabel]

/-! ## Observable correspondence of keys -/

/-- The visible constitutional content of a raw key, read through the localized sparse vocabulary. -/
def rawConstitutionalObservable (key : RawMolecule.CanonicalBranchKey) :
    CertifiedLocalizedCIPInput.LocalizedConstitutionalObservable :=
  ⟨plainRule1aProjection key.rule1a, key.rule1b, key.rule2⟩

/-- Columnwise observable correspondence between a raw key and a localized key. -/
structure KeyObservableCorresponds {V : Type*}
    (raw : RawMolecule.CanonicalBranchKey) (loc : OfficialRuleMajorKey V) : Prop where
  rule1a : plainRule1aProjection raw.rule1a = loc.rule1a
  rule1b : raw.rule1b = loc.rule1b
  rule2 : raw.rule2 = loc.rule2

/-- Observable correspondence is exactly equality of the two observable records. -/
theorem keyObservableCorresponds_iff {V : Type*}
    (raw : RawMolecule.CanonicalBranchKey) (loc : OfficialRuleMajorKey V) :
    KeyObservableCorresponds raw loc ↔
      rawConstitutionalObservable raw = constitutionalObservable loc := by
  constructor
  · rintro ⟨rule1a, rule1b, rule2⟩
    simp [rawConstitutionalObservable, constitutionalObservable, rule1a, rule1b, rule2]
  · intro equal
    exact ⟨congrArg CertifiedLocalizedCIPInput.LocalizedConstitutionalObservable.rule1a equal,
      congrArg CertifiedLocalizedCIPInput.LocalizedConstitutionalObservable.rule1b equal,
      congrArg CertifiedLocalizedCIPInput.LocalizedConstitutionalObservable.rule2 equal⟩

/-- Full correspondence forgets to observable correspondence. -/
theorem constitutionalKeyCorresponds_toObservable {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : ConstitutionalKeyCorresponds raw loc) : KeyObservableCorresponds raw loc :=
  ⟨h.rule1a, h.rule1b, h.rule2⟩

/-- Column correspondence forgets to observable correspondence. -/
theorem columnsCorrespond_toObservable {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : ActualKeyColumnsCorrespond raw loc) : KeyObservableCorresponds raw loc :=
  ⟨h.rule1a, h.rule1b, h.rule2⟩

/-- Corresponding keys have equal observable records. -/
theorem rawConstitutionalObservable_eq_of_corresponds {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : ConstitutionalKeyCorresponds raw loc) :
    rawConstitutionalObservable raw = constitutionalObservable loc :=
  keyObservableCorresponds_iff raw loc |>.mp (constitutionalKeyCorresponds_toObservable h)

/-- Pointwise observable equality of two key lists. -/
theorem map_rawConstitutionalObservable_eq_of_forall₂ {V : Type*}
    {rawKeys : List RawMolecule.CanonicalBranchKey}
    {locKeys : List (OfficialRuleMajorKey V)}
    (h : List.Forall₂ KeyObservableCorresponds rawKeys locKeys) :
    rawKeys.map rawConstitutionalObservable = locKeys.map constitutionalObservable := by
  induction h with
  | nil => rfl
  | cons hhead htail ih =>
      simp only [List.map_cons]
      rw [keyObservableCorresponds_iff _ _ |>.mp hhead, ih]

/-! ## Merge and assembly transport -/

/-- Plainness of the merged child layers follows from plainness of each child key. -/
theorem mergeCanonicalAtomicChildren_plain_of_forall
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenPlain : ∀ child, child ∈ childrenRaw →
      ∀ e, e ∈ child.rule1a.flatten → e.2.denominator = 1) :
    ∀ e, e ∈ (RawMolecule.mergeCanonicalAtomicChildren childrenRaw).flatten →
      e.2.denominator = 1 := by
  intro e he
  rw [RawMolecule.mergeCanonicalAtomicChildren, List.mem_flatten] at he
  rcases he with ⟨layer, hlayer, helayer⟩
  rw [List.mem_map] at hlayer
  rcases hlayer with ⟨depth, _hdepth, rfl⟩
  rw [List.mem_flatMap] at helayer
  rcases helayer with ⟨child, hchild, hechild⟩
  have hkeyMem : child.1 ∈ childrenRaw :=
    List.mem_of_getElem? (List.mem_zipIdx_iff_getElem?.mp hchild)
  rw [RawMolecule.prefixCanonicalAtomicLayer, List.mem_map] at hechild
  rcases hechild with ⟨original, horiginal, heq⟩
  have horiginalFlat : original ∈ child.1.rule1a.flatten :=
    mem_flatten_getD horiginal
  rw [← heq]
  exact childrenPlain child.1 hkeyMem original horiginalFlat

/-- Plainness of a list of corresponding keys. -/
theorem plain_of_forall₂_corresponds {V : Type*}
    {rawKeys : List RawMolecule.CanonicalBranchKey}
    {locKeys : List (OfficialRuleMajorKey V)}
    (h : List.Forall₂ ConstitutionalKeyCorresponds rawKeys locKeys) :
    ∀ child, child ∈ rawKeys →
      ∀ e, e ∈ child.rule1a.flatten → e.2.denominator = 1 := by
  induction h with
  | nil => intro child hmem; simp at hmem
  | cons hhead htail ih =>
      intro child hmem e he
      rcases List.mem_cons.mp hmem with same | hmem
      · subst same
        exact hhead.plain e he
      · exact ih child hmem e he

/-- The maximum layer-count fold is invariant under observably corresponding child lists. -/
theorem foldl_max_eq_of_observable {V α β : Type*}
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenLoc : List (OfficialRuleMajorKey V))
    (layersRaw : RawMolecule.CanonicalBranchKey → List (List α))
    (layersLoc : OfficialRuleMajorKey V → List (List (OfficialSparseEntry β)))
    (hcorr : List.Forall₂ KeyObservableCorresponds childrenRaw childrenLoc)
    (hlayers : ∀ raw loc, KeyObservableCorresponds raw loc →
      (layersRaw raw).length = (layersLoc loc).length) :
    ∀ initial : ℕ,
      childrenRaw.foldl (fun acc child => max acc (layersRaw child).length) initial =
        childrenLoc.foldl (fun acc child => max acc (layersLoc child).length) initial := by
  induction hcorr with
  | nil => intro initial; rfl
  | cons hhead htail ih =>
      intro initial
      simp only [List.foldl_cons]
      rw [hlayers _ _ hhead]
      exact ih _

/-- Child-layer counts agree for observably corresponding child lists. -/
theorem childLayerCount_eq_of_observable {V α β : Type*}
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenLoc : List (OfficialRuleMajorKey V))
    (layersRaw : RawMolecule.CanonicalBranchKey → List (List α))
    (layersLoc : OfficialRuleMajorKey V → List (List (OfficialSparseEntry β)))
    (hcorr : List.Forall₂ KeyObservableCorresponds childrenRaw childrenLoc)
    (hlayers : ∀ raw loc, KeyObservableCorresponds raw loc →
      (layersRaw raw).length = (layersLoc loc).length) :
    RawMolecule.canonicalChildLayerCount childrenRaw layersRaw =
      OfficialRuleMajorKey.childLayerCount childrenLoc layersLoc :=
  foldl_max_eq_of_observable childrenRaw childrenLoc layersRaw layersLoc hcorr hlayers 0

/-- The layer selected at a fixed depth projects equally for observably corresponding keys. -/
theorem rule1aLayerProjection_getD_eq_of_observable {V : Type*}
    {raw : RawMolecule.CanonicalBranchKey} {loc : OfficialRuleMajorKey V}
    (h : KeyObservableCorresponds raw loc) (depth : ℕ) :
    rule1aLayerProjection (raw.rule1a.getD depth []) = loc.rule1a.getD depth [] := by
  rw [rule1aLayerProjection_getD, ← plainRule1aProjection_eq_map, h.rule1a]

/-- Projecting the merged raw Rule-1a layers gives the localized merge. -/
theorem plainRule1aProjection_mergeCanonicalAtomicChildren_of_observable {V : Type*}
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenLoc : List (OfficialRuleMajorKey V))
    (hcorr : List.Forall₂ KeyObservableCorresponds childrenRaw childrenLoc) :
    plainRule1aProjection (RawMolecule.mergeCanonicalAtomicChildren childrenRaw) =
      OfficialRuleMajorKey.mergeChildren childrenLoc OfficialRuleMajorKey.rule1a := by
  have hcount := childLayerCount_eq_of_observable childrenRaw childrenLoc
    (fun child => child.rule1a) OfficialRuleMajorKey.rule1a hcorr
    (fun raw loc h => by
      have hlen := congrArg List.length h.rule1a
      simpa [plainRule1aProjection_eq_map] using hlen)
  simp only [RawMolecule.mergeCanonicalAtomicChildren, OfficialRuleMajorKey.mergeChildren]
  rw [hcount]
  rw [plainRule1aProjection_eq_map, List.map_map]
  apply List.map_congr_left
  intro depth _
  dsimp only [Function.comp_apply, rule1aLayerProjection]
  rw [List.map_flatMap]
  apply flatMap_eq_of_forall₂ (forall₂_zipIdx hcorr 0)
  rintro ⟨rawKey, slot⟩ ⟨locKey, slot'⟩ ⟨hkey, hslot⟩
  have hslotEq : slot = slot' := hslot
  subst slot'
  dsimp only at hkey ⊢
  change rule1aLayerProjection
      (prefixCanonicalAtomicLayer slot (rawKey.rule1a.getD depth [])) =
    OfficialRuleMajorKey.prefixLayer slot (locKey.rule1a.getD depth [])
  rw [rule1aLayerProjection_prefix]
  rw [rule1aLayerProjection_getD_eq_of_observable hkey depth]

/-- Merging observably corresponding natural-number columns gives equal columns. -/
theorem mergeCanonicalNatChildren_eq_of_observable {V : Type*}
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenLoc : List (OfficialRuleMajorKey V))
    (layersRaw : RawMolecule.CanonicalBranchKey → List (List RawMolecule.CanonicalNatEntry))
    (layersLoc : OfficialRuleMajorKey V → List (List RawMolecule.CanonicalNatEntry))
    (hcorr : List.Forall₂ KeyObservableCorresponds childrenRaw childrenLoc)
    (hlayers : ∀ raw loc, KeyObservableCorresponds raw loc → layersRaw raw = layersLoc loc) :
    RawMolecule.mergeCanonicalNatChildren layersRaw childrenRaw =
      OfficialRuleMajorKey.mergeChildren childrenLoc layersLoc := by
  have hcount := childLayerCount_eq_of_observable childrenRaw childrenLoc
    layersRaw layersLoc hcorr
    (fun raw loc h => congrArg List.length (hlayers raw loc h))
  simp only [RawMolecule.mergeCanonicalNatChildren, OfficialRuleMajorKey.mergeChildren]
  rw [hcount]
  apply List.map_congr_left
  intro depth _
  apply flatMap_eq_of_forall₂ (forall₂_zipIdx hcorr 0)
  rintro ⟨rawKey, slot⟩ ⟨locKey, slot'⟩ ⟨hkey, hslot⟩
  have hslotEq : slot = slot' := hslot
  subst slot'
  dsimp only at hkey ⊢
  rw [hlayers rawKey locKey hkey]
  rfl

/-- Column correspondence is preserved by the assembled constructor at the observable level. -/
theorem assemble_columns_of_observable {V : Type*}
    (rootRaw : RawMolecule.CanonicalBranchKey) (rootLoc : OfficialRuleMajorKey V)
    (childrenRaw : List RawMolecule.CanonicalBranchKey)
    (childrenLoc : List (OfficialRuleMajorKey V))
    (rootPlain : ∀ e, e ∈ rootRaw.rule1a.flatten → e.2.denominator = 1)
    (rootObs : KeyObservableCorresponds rootRaw rootLoc)
    (childrenObs : List.Forall₂ KeyObservableCorresponds childrenRaw childrenLoc)
    (childrenPlain : ∀ child, child ∈ childrenRaw →
      ∀ e, e ∈ child.rule1a.flatten → e.2.denominator = 1) :
    ActualKeyColumnsCorrespond
      (RawMolecule.assembleCanonicalBranchKey rootRaw childrenRaw)
      (OfficialRuleMajorKey.assemble rootLoc childrenLoc) := by
  refine ⟨?plain, ?rule1a, ?rule1b, ?rule2⟩
  · intro e he
    have he' : e ∈ (rootRaw.rule1a ++
        RawMolecule.mergeCanonicalAtomicChildren childrenRaw).flatten := by
      simpa [RawMolecule.assembleCanonicalBranchKey] using he
    rw [List.flatten_append, List.mem_append] at he'
    rcases he' with he' | he'
    · exact rootPlain e he'
    · exact mergeCanonicalAtomicChildren_plain_of_forall childrenRaw childrenPlain e he'
  · simp only [RawMolecule.assembleCanonicalBranchKey, OfficialRuleMajorKey.assemble]
    rw [plainRule1aProjection_append, rootObs.rule1a,
      plainRule1aProjection_mergeCanonicalAtomicChildren_of_observable childrenRaw childrenLoc
        childrenObs]
  · simp only [RawMolecule.assembleCanonicalBranchKey, OfficialRuleMajorKey.assemble]
    rw [rootObs.rule1b,
      mergeCanonicalNatChildren_eq_of_observable childrenRaw childrenLoc
        (fun child => child.rule1b) OfficialRuleMajorKey.rule1b childrenObs
        (fun raw loc h => h.rule1b)]
  · simp only [RawMolecule.assembleCanonicalBranchKey, OfficialRuleMajorKey.assemble]
    rw [rootObs.rule2,
      mergeCanonicalNatChildren_eq_of_observable childrenRaw childrenLoc
        (fun child => child.rule2) OfficialRuleMajorKey.rule2 childrenObs
        (fun raw loc h => h.rule2)]

/-! ## Comparator and sort transport -/

/-- With the stated correspondence, the safe raw comparator computes exactly the safe localized
comparator. -/
theorem compareCanonicalBranchKeys?_eq_of_corresponds {V : Type*}
    (leftKey rightKey : RawMolecule.CanonicalBranchKey)
    (leftLoc rightLoc : OfficialRuleMajorKey V)
    (leftCorr : ConstitutionalKeyCorresponds leftKey leftLoc)
    (rightCorr : ConstitutionalKeyCorresponds rightKey rightLoc) :
    RawMolecule.compareCanonicalBranchKeys? leftKey rightKey =
      OfficialRuleMajorKey.compare? leftLoc rightLoc := by
  unfold RawMolecule.compareCanonicalBranchKeys? OfficialRuleMajorKey.compare?
  rw [compareSparseCanonicalLayers_rule1a_eq_of_plain leftKey.rule1a rightKey.rule1a
      leftCorr.plain rightCorr.plain,
    leftCorr.rule1a, rightCorr.rule1a, leftCorr.complete, rightCorr.complete]
  by_cases hcomplete : (leftLoc.complete && rightLoc.complete) = true
  · simp only [hcomplete, if_true]
    rw [compareCanonicalBranchKeys_eq_officialRuleMajorKey_compare leftKey rightKey
      leftLoc rightLoc leftCorr rightCorr]
    cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftLoc.rule1a rightLoc.rule1a <;> rfl
  · cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftLoc.rule1a rightLoc.rule1a with
    | lt => rfl
    | gt => rfl
    | eq => simp [hcomplete]

/-- Insertion preserves the pointwise correspondence and produces a corresponding result. -/
theorem insertCanonicalKey?_corresponds {V : Type*}
    (key : RawMolecule.CanonicalBranchKey) (locKey : OfficialRuleMajorKey V)
    (keyCorr : ConstitutionalKeyCorresponds key locKey) :
    ∀ (keys : List RawMolecule.CanonicalBranchKey) (locKeys : List (OfficialRuleMajorKey V)),
      List.Forall₂ ConstitutionalKeyCorresponds keys locKeys → ∀ result,
      RawMolecule.insertCanonicalKey? key keys = some result →
      ∃ locResult, OfficialRuleMajorKey.insert? locKey locKeys = some locResult ∧
        List.Forall₂ ConstitutionalKeyCorresponds result locResult := by
  intro keys
  induction keys with
  | nil =>
      intro locKeys hcorr result hresult
      rw [List.forall₂_nil_left_iff] at hcorr
      subst locKeys
      simp [RawMolecule.insertCanonicalKey?] at hresult
      subst result
      exact ⟨[locKey], by simp [OfficialRuleMajorKey.insert?],
        List.Forall₂.cons keyCorr List.Forall₂.nil⟩
  | cons head tail ih =>
      intro locKeys hcorr result hresult
      rcases List.forall₂_cons_left_iff.mp hcorr with
        ⟨locHead, locTail, hhead, htail, rfl⟩
      have hcmp := compareCanonicalBranchKeys?_eq_of_corresponds key head locKey locHead
        keyCorr hhead
      cases hdecision : RawMolecule.compareCanonicalBranchKeys? key head with
      | none =>
          simp [RawMolecule.insertCanonicalKey?, hdecision] at hresult
      | some decision =>
          cases decision with
          | gt =>
              have hlocDecision : OfficialRuleMajorKey.compare? locKey locHead = some Ordering.gt := by
                rw [← hcmp]
                exact hdecision
              simp only [RawMolecule.insertCanonicalKey?, hdecision] at hresult
              rw [Option.some.injEq] at hresult
              subst result
              exact ⟨locKey :: locHead :: locTail, by
                simp [OfficialRuleMajorKey.insert?, hlocDecision],
                List.Forall₂.cons keyCorr (List.Forall₂.cons hhead htail)⟩
          | eq =>
              have hlocDecision : OfficialRuleMajorKey.compare? locKey locHead = some Ordering.eq := by
                rw [← hcmp]
                exact hdecision
              simp only [RawMolecule.insertCanonicalKey?, hdecision] at hresult
              rw [Option.some.injEq] at hresult
              subst result
              exact ⟨locKey :: locHead :: locTail, by
                simp [OfficialRuleMajorKey.insert?, hlocDecision],
                List.Forall₂.cons keyCorr (List.Forall₂.cons hhead htail)⟩
          | lt =>
              have hlocDecision : OfficialRuleMajorKey.compare? locKey locHead = some Ordering.lt := by
                rw [← hcmp]
                exact hdecision
              simp only [RawMolecule.insertCanonicalKey?, hdecision] at hresult
              rw [Option.map_eq_some_iff] at hresult
              rcases hresult with ⟨inserted, hinserted, hresultEq⟩
              subst result
              obtain ⟨locInserted, hlocInserted, hinsertedCorr⟩ :=
                ih locTail htail inserted hinserted
              refine ⟨locHead :: locInserted, ?_,
                List.Forall₂.cons hhead hinsertedCorr⟩
              simp [OfficialRuleMajorKey.insert?, hlocDecision, hlocInserted]

/-- Sort preserves the pointwise correspondence and produces a corresponding result. -/
theorem sortCanonicalKeys?_corresponds {V : Type*}
    (keys : List RawMolecule.CanonicalBranchKey)
    (locKeys : List (OfficialRuleMajorKey V))
    (keysCorr : List.Forall₂ ConstitutionalKeyCorresponds keys locKeys) :
    ∀ result, RawMolecule.sortCanonicalKeys? keys = some result →
      ∃ locResult, OfficialRuleMajorKey.sort? locKeys = some locResult ∧
        List.Forall₂ ConstitutionalKeyCorresponds result locResult := by
  induction keys generalizing locKeys with
  | nil =>
      intro result hresult
      rw [List.forall₂_nil_left_iff] at keysCorr
      subst locKeys
      simp [RawMolecule.sortCanonicalKeys?] at hresult
      subst result
      exact ⟨[], by simp [OfficialRuleMajorKey.sort?], List.Forall₂.nil⟩
  | cons head tail ih =>
      intro result hresult
      rcases List.forall₂_cons_left_iff.mp keysCorr with
        ⟨locHead, locTail, hhead, htail, rfl⟩
      simp only [RawMolecule.sortCanonicalKeys?] at hresult
      change Option.bind (RawMolecule.sortCanonicalKeys? tail)
        (fun sorted => RawMolecule.insertCanonicalKey? head sorted) = some result at hresult
      rw [Option.bind_eq_some_iff] at hresult
      rcases hresult with ⟨sortedTail, hsortTail, hinsert⟩
      obtain ⟨locSortedTail, hlocSortTail, htailCorr⟩ := ih locTail htail sortedTail hsortTail
      obtain ⟨locResult, hlocInsert, hresultCorr⟩ :=
        insertCanonicalKey?_corresponds head locHead hhead
          sortedTail locSortedTail htailCorr result hinsert
      refine ⟨locResult, ?_, hresultCorr⟩
      simp only [OfficialRuleMajorKey.sort?]
      change Option.bind (OfficialRuleMajorKey.sort? locTail)
        (fun sorted => OfficialRuleMajorKey.insert? locHead sorted) = some locResult
      rw [hlocSortTail]
      simpa using hlocInsert

/-- The all-complete flags of corresponding child lists agree. -/
theorem all_complete_eq_of_forall₂ {V : Type*}
    {childrenRaw : List RawMolecule.CanonicalBranchKey}
    {childrenLoc : List (OfficialRuleMajorKey V)}
    (h : List.Forall₂ ConstitutionalKeyCorresponds childrenRaw childrenLoc) :
    childrenRaw.all (fun child => child.complete) =
      childrenLoc.all (fun child => child.complete) := by
  induction h with
  | nil => rfl
  | cons hhead htail ih =>
      simp [List.all_cons, hhead.complete, ih]

/-! ## Sort success is independent of the enumeration order

`OfficialRuleMajorKey.sort?` refuses exactly when a Rule-1a tie involves an incomplete key.  That
condition is a property of the child multiset, so a successful sort of one child enumeration
implies a successful sort of any permutation of it.  This is the transport that lets the actual
executable child order be used on the localized side without assuming enumeration alignment. -/

/-- Rule-1a tie of two localized keys. -/
def Rule1aTie {V : Type*} (left right : OfficialRuleMajorKey V) : Prop :=
  OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
    left.rule1a right.rule1a = Ordering.eq

/-- The addressed Rule-1a layer comparator is oriented and transitive. -/
theorem compareSparseLayers_compareNat_transCmp :
    Std.TransCmp
      (OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat) := by
  letI : Std.TransCmp OfficialRuleMajorKey.compareNat := by
    unfold OfficialRuleMajorKey.compareNat
    infer_instance
  unfold OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareSparseLayer
    OfficialRuleMajorKey.compareSparseEntry
  infer_instance

theorem rule1aTie_symm {V : Type*} {left right : OfficialRuleMajorKey V}
    (h : Rule1aTie left right) : Rule1aTie right left := by
  letI := compareSparseLayers_compareNat_transCmp
  exact Std.OrientedCmp.eq_symm h

theorem rule1aTie_trans {V : Type*} {first second third : OfficialRuleMajorKey V}
    (h₁ : Rule1aTie first second) (h₂ : Rule1aTie second third) :
    Rule1aTie first third := by
  letI := compareSparseLayers_compareNat_transCmp
  exact Std.TransCmp.eq_trans h₁ h₂

/-- A non-tied Rule-1a outcome contradicts a Rule-1a tie. -/
theorem false_of_rule1aTie_of_ne {V : Type*} {left right : OfficialRuleMajorKey V}
    {outcome : Ordering} (houtcome : outcome ≠ Ordering.eq)
    (hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a = outcome)
    (htie : Rule1aTie left right) : False := by
  have heq : outcome = Ordering.eq := by
    rw [← hcmp]
    exact htie
  exact houtcome heq

/-- The safe comparison refuses exactly on a Rule-1a tie with an incomplete key. -/
theorem compare?_eq_none_iff {V : Type*} (left right : OfficialRuleMajorKey V) :
    OfficialRuleMajorKey.compare? left right = none ↔
      Rule1aTie left right ∧
        ¬(left.complete = true ∧ right.complete = true) := by
  cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a with
  | lt =>
      have hvalue : OfficialRuleMajorKey.compare? left right = some Ordering.lt := by
        unfold OfficialRuleMajorKey.compare?
        rw [hcmp]
      rw [hvalue]
      constructor
      · intro h
        exact absurd h (Option.some_ne_none _)
      · rintro ⟨htie, _⟩
        exact False.elim
          (false_of_rule1aTie_of_ne (outcome := Ordering.lt) (by decide) hcmp htie)
  | gt =>
      have hvalue : OfficialRuleMajorKey.compare? left right = some Ordering.gt := by
        unfold OfficialRuleMajorKey.compare?
        rw [hcmp]
      rw [hvalue]
      constructor
      · intro h
        exact absurd h (Option.some_ne_none _)
      · rintro ⟨htie, _⟩
        exact False.elim
          (false_of_rule1aTie_of_ne (outcome := Ordering.gt) (by decide) hcmp htie)
  | eq =>
      have hvalue : OfficialRuleMajorKey.compare? left right =
          (if left.complete && right.complete then
            some (OfficialRuleMajorKey.compare left right) else none) := by
        unfold OfficialRuleMajorKey.compare?
        rw [hcmp]
      rw [hvalue]
      by_cases hc : (left.complete && right.complete) = true
      · rw [if_pos hc]
        constructor
        · intro h
          exact absurd h (Option.some_ne_none _)
        · rintro ⟨_, hbad⟩
          exact absurd (Bool.and_eq_true_iff.mp hc) hbad
      · rw [if_neg hc]
        constructor
        · intro _
          exact ⟨hcmp, fun hand => hc (Bool.and_eq_true_iff.mpr hand)⟩
        · intro _
          rfl

/-- A successful comparison at `Ordering.eq` exposes the tie and both completeness flags. -/
theorem compare?_eq_some_eq_data {V : Type*} {left right : OfficialRuleMajorKey V}
    (h : OfficialRuleMajorKey.compare? left right = some Ordering.eq) :
    Rule1aTie left right ∧ left.complete = true ∧ right.complete = true := by
  revert h
  unfold OfficialRuleMajorKey.compare?
  cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a with
  | lt =>
      intro h
      simp at h
  | gt =>
      intro h
      simp at h
  | eq =>
      intro h
      by_cases hc : (left.complete && right.complete) = true
      · exact ⟨hcmp, Bool.and_eq_true_iff.mp hc⟩
      · rw [if_neg hc] at h
        simp at h

/-- A successful comparison at `Ordering.gt` either decides on Rule 1a or is a complete tie. -/
theorem compare?_eq_some_gt_data {V : Type*} {left right : OfficialRuleMajorKey V}
    (h : OfficialRuleMajorKey.compare? left right = some Ordering.gt) :
    OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        left.rule1a right.rule1a = Ordering.gt ∨
      (Rule1aTie left right ∧ left.complete = true ∧ right.complete = true) := by
  revert h
  unfold OfficialRuleMajorKey.compare?
  cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a with
  | lt =>
      intro h
      simp at h
  | gt =>
      intro _
      exact Or.inl rfl
  | eq =>
      intro h
      by_cases hc : (left.complete && right.complete) = true
      · exact Or.inr ⟨hcmp, Bool.and_eq_true_iff.mp hc⟩
      · rw [if_neg hc] at h
        simp at h

/-- A successful comparison at `Ordering.lt` either decides on Rule 1a or is a complete tie. -/
theorem compare?_eq_some_lt_data {V : Type*} {left right : OfficialRuleMajorKey V}
    (h : OfficialRuleMajorKey.compare? left right = some Ordering.lt) :
    OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        left.rule1a right.rule1a = Ordering.lt ∨
      (Rule1aTie left right ∧ left.complete = true ∧ right.complete = true) := by
  revert h
  unfold OfficialRuleMajorKey.compare?
  cases hcmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a with
  | lt =>
      intro _
      exact Or.inl rfl
  | gt =>
      intro h
      simp at h
  | eq =>
      intro h
      by_cases hc : (left.complete && right.complete) = true
      · exact Or.inr ⟨hcmp, Bool.and_eq_true_iff.mp hc⟩
      · rw [if_neg hc] at h
        simp at h

/-- A full-key comparison that is not `lt` is not `lt` on the Rule-1a projection either. -/
theorem rule1a_not_lt_of_compare_ne_lt {V : Type*} {left right : OfficialRuleMajorKey V}
    (h : OfficialRuleMajorKey.compare left right ≠ Ordering.lt) :
    OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
      left.rule1a right.rule1a ≠ Ordering.lt := by
  intro hlt
  apply h
  unfold OfficialRuleMajorKey.compare
  simp only [compareLex, Ordering.byKey]
  rw [hlt]
  rfl

/-- No two distinct occurrences among these keys share a Rule-1a class unless both are complete. -/
def NoRefusingPair {V : Type*} : List (OfficialRuleMajorKey V) → Prop
  | [] => True
  | key :: rest =>
      NoRefusingPair rest ∧
        ∀ other ∈ rest, Rule1aTie key other →
          key.complete = true ∧ other.complete = true

theorem noRefusingPair_cons {V : Type*} (key : OfficialRuleMajorKey V)
    (rest : List (OfficialRuleMajorKey V)) :
    NoRefusingPair (key :: rest) ↔
      NoRefusingPair rest ∧
        ∀ other ∈ rest, Rule1aTie key other →
          key.complete = true ∧ other.complete = true :=
  Iff.rfl

/-- The pair-safe condition depends only on the multiset of keys. -/
theorem noRefusingPair_of_perm {V : Type*}
    {left right : List (OfficialRuleMajorKey V)} (permutation : left.Perm right) :
    NoRefusingPair left → NoRefusingPair right := by
  induction permutation with
  | nil =>
      intro noBad
      exact noBad
  | cons head step ih =>
      intro noBad
      obtain ⟨noBadTail, noBadHead⟩ := noBad
      refine ⟨ih noBadTail, ?_⟩
      intro other hother htie
      exact noBadHead other (step.mem_iff.mpr hother) htie
  | swap first second rest =>
      intro noBad
      obtain ⟨noBadTail, noBadSecond⟩ := noBad
      obtain ⟨noBadRest, noBadFirst⟩ := noBadTail
      refine ⟨⟨noBadRest, ?_⟩, ?_⟩
      · intro other hother htie
        exact noBadSecond other (List.mem_cons_of_mem first hother) htie
      · intro other hother htie
        rcases List.mem_cons.mp hother with rfl | hother
        · have hboth := noBadSecond first List.mem_cons_self (rule1aTie_symm htie)
          exact ⟨hboth.2, hboth.1⟩
        · exact noBadFirst other hother htie
  | trans step₁ step₂ ih₁ ih₂ =>
      intro noBad
      exact ih₂ (ih₁ noBad)

/-- A refusing insertion exposes the two tied occurrences responsible. -/
theorem insert?_eq_none_witness {V : Type*} (key : OfficialRuleMajorKey V) :
    ∀ keys : List (OfficialRuleMajorKey V),
      OfficialRuleMajorKey.insert? key keys = none →
      ∃ other ∈ keys, Rule1aTie key other ∧
        ¬(key.complete = true ∧ other.complete = true) := by
  intro keys
  induction keys with
  | nil =>
      intro h
      simp [OfficialRuleMajorKey.insert?, Option.some_ne_none] at h
  | cons head tail ih =>
      intro h
      unfold OfficialRuleMajorKey.insert? at h
      cases cmp : OfficialRuleMajorKey.compare? key head with
      | none =>
          exact ⟨head, List.mem_cons_self, (compare?_eq_none_iff key head).mp cmp⟩
      | some decision =>
          cases decision with
          | gt => simp [cmp, Option.some_ne_none] at h
          | eq => simp [cmp, Option.some_ne_none] at h
          | lt =>
              simp only [cmp, Option.map_eq_none_iff] at h
              obtain ⟨other, hother, hwitness⟩ := ih h
              exact ⟨other, List.mem_cons_of_mem head hother, hwitness⟩

/-- On a descending key list with no refusing pair, a tied incompatible element forces the
insertion to refuse when it reaches the first element of the tie class. -/
theorem insert?_eq_none_of_witness {V : Type*} (key : OfficialRuleMajorKey V) :
    ∀ keys : List (OfficialRuleMajorKey V),
      OfficialRuleMajorKey.Descending keys → NoRefusingPair keys →
      (∃ other ∈ keys, Rule1aTie key other ∧
        ¬(key.complete = true ∧ other.complete = true)) →
      OfficialRuleMajorKey.insert? key keys = none := by
  intro keys
  induction keys with
  | nil =>
      intro _ _ witness
      obtain ⟨_, hmem, _⟩ := witness
      simp at hmem
  | cons head tail ih =>
      intro descending noBad witness
      obtain ⟨headOverTail, tailDescending⟩ := List.pairwise_cons.mp descending
      obtain ⟨noBadTail, noBadHead⟩ := noBad
      by_cases hheadTie : Rule1aTie key head
      · have hcmpNone : OfficialRuleMajorKey.compare? key head = none := by
          rw [compare?_eq_none_iff]
          refine ⟨hheadTie, ?_⟩
          rintro ⟨hkeyComplete, hheadComplete⟩
          obtain ⟨other, hother, htie, hbad⟩ := witness
          rcases List.mem_cons.mp hother with rfl | htail
          · exact hbad ⟨hkeyComplete, hheadComplete⟩
          · have hheadOther : Rule1aTie head other :=
              rule1aTie_trans (rule1aTie_symm hheadTie) htie
            exact hbad ⟨hkeyComplete, (noBadHead other htail hheadOther).2⟩
        simp only [OfficialRuleMajorKey.insert?, hcmpNone]
      · cases cmp : OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
            key.rule1a head.rule1a with
        | eq => exact absurd cmp hheadTie
        | lt =>
            have hcmpLt : OfficialRuleMajorKey.compare? key head = some Ordering.lt := by
              unfold OfficialRuleMajorKey.compare?
              rw [cmp]
            obtain ⟨other, hother, htie, hbad⟩ := witness
            rcases List.mem_cons.mp hother with rfl | htail
            · exact absurd htie hheadTie
            · have htailNone : OfficialRuleMajorKey.insert? key tail = none :=
                ih tailDescending noBadTail ⟨other, htail, htie, hbad⟩
              simpa only [OfficialRuleMajorKey.insert?, hcmpLt,
                Option.map_eq_none_iff] using htailNone
        | gt =>
            obtain ⟨other, hother, htie, hbad⟩ := witness
            rcases List.mem_cons.mp hother with rfl | htail
            · exact absurd htie hheadTie
            · letI := compareSparseLayers_compareNat_transCmp
              have hheadGe :
                  OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
                    head.rule1a other.rule1a ≠ Ordering.lt :=
                rule1a_not_lt_of_compare_ne_lt (headOverTail other htail)
              have hkeyGt :
                  OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
                    key.rule1a other.rule1a = Ordering.gt :=
                Std.TransCmp.gt_of_gt_of_isGE cmp
                  (Ordering.ne_lt_iff_isGE.mp hheadGe)
              exact False.elim
                (false_of_rule1aTie_of_ne (outcome := Ordering.gt) (by decide) hkeyGt htie)

/-- A successful insertion into a descending, pair-safe list again has no refusing pair. -/
theorem insert?_result_noRefusingPair {V : Type*} (key : OfficialRuleMajorKey V) :
    ∀ keys result : List (OfficialRuleMajorKey V),
      OfficialRuleMajorKey.Descending keys → NoRefusingPair keys →
      OfficialRuleMajorKey.insert? key keys = some result →
      NoRefusingPair result := by
  intro keys
  induction keys with
  | nil =>
      intro result _ _ computed
      have hresult : [key] = result := by
        simpa [OfficialRuleMajorKey.insert?] using computed
      subst result
      refine ⟨trivial, ?_⟩
      intro other hother
      simp at hother
  | cons head tail ih =>
      intro result descending noBad computed
      obtain ⟨headOverTail, tailDescending⟩ := List.pairwise_cons.mp descending
      obtain ⟨noBadTail, noBadHead⟩ := noBad
      unfold OfficialRuleMajorKey.insert? at computed
      cases cmp : OfficialRuleMajorKey.compare? key head with
      | none =>
          simp [cmp] at computed
      | some decision =>
          cases decision with
          | gt =>
              simp [cmp] at computed
              subst result
              rw [noRefusingPair_cons]
              refine ⟨⟨noBadTail, noBadHead⟩, ?_⟩
              intro other hother htie
              rcases List.mem_cons.mp hother with rfl | htail
              · rcases compare?_eq_some_gt_data cmp with
                  hdirect | ⟨_, hkeyC, hheadC⟩
                · exact False.elim
                    (false_of_rule1aTie_of_ne (outcome := Ordering.gt) (by decide) hdirect
                      htie)
                · exact ⟨hkeyC, hheadC⟩
              · letI := compareSparseLayers_compareNat_transCmp
                rcases compare?_eq_some_gt_data cmp with
                  hdirect | ⟨hkeyHeadTie, hkeyC, _⟩
                · have hheadGe :
                      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
                        head.rule1a other.rule1a ≠ Ordering.lt :=
                    rule1a_not_lt_of_compare_ne_lt (headOverTail other htail)
                  have hkeyGt :
                      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
                        key.rule1a other.rule1a = Ordering.gt :=
                    Std.TransCmp.gt_of_gt_of_isGE hdirect
                      (Ordering.ne_lt_iff_isGE.mp hheadGe)
                  exact False.elim
                    (false_of_rule1aTie_of_ne (outcome := Ordering.gt) (by decide) hkeyGt
                      htie)
                · have hheadOther : Rule1aTie head other :=
                    rule1aTie_trans (rule1aTie_symm hkeyHeadTie) htie
                  exact ⟨hkeyC, (noBadHead other htail hheadOther).2⟩
          | eq =>
              simp [cmp] at computed
              subst result
              rw [noRefusingPair_cons]
              refine ⟨⟨noBadTail, noBadHead⟩, ?_⟩
              intro other hother htie
              have data := compare?_eq_some_eq_data cmp
              rcases List.mem_cons.mp hother with rfl | htail
              · exact ⟨data.2.1, data.2.2⟩
              · have hheadOther : Rule1aTie head other :=
                  rule1aTie_trans (rule1aTie_symm data.1) htie
                exact ⟨data.2.1, (noBadHead other htail hheadOther).2⟩
          | lt =>
              simp only [cmp, Option.map_eq_some_iff] at computed
              obtain ⟨inserted, hinserted, rfl⟩ := computed
              have insertedNoBad :=
                ih inserted tailDescending noBadTail hinserted
              rw [noRefusingPair_cons]
              refine ⟨insertedNoBad, ?_⟩
              intro other hother htie
              have hotherSource : other ∈ key :: tail :=
                (OfficialRuleMajorKey.insert?_perm key tail inserted hinserted).mem_iff.mp hother
              rcases List.mem_cons.mp hotherSource with rfl | htail
              · rcases compare?_eq_some_lt_data cmp with
                  hdirect | ⟨_, hkeyC, hheadC⟩
                · exact False.elim
                    (false_of_rule1aTie_of_ne (outcome := Ordering.lt) (by decide) hdirect
                      (rule1aTie_symm htie))
                · exact ⟨hheadC, hkeyC⟩
              · exact noBadHead other htail htie

/-- A successful sort has no refusing pair in its result. -/
theorem sort?_result_noRefusingPair {V : Type*} :
    ∀ (keys result : List (OfficialRuleMajorKey V)),
      OfficialRuleMajorKey.sort? keys = some result → NoRefusingPair result := by
  intro keys
  induction keys with
  | nil =>
      intro result computed
      have hresult : [] = result := by
        simpa [OfficialRuleMajorKey.sort?] using computed
      subst result
      exact trivial
  | cons key tail ih =>
      intro result computed
      unfold OfficialRuleMajorKey.sort? at computed
      cases sortedComputed : OfficialRuleMajorKey.sort? tail with
      | none => simp [sortedComputed] at computed
      | some sorted =>
          have inserted : OfficialRuleMajorKey.insert? key sorted = some result := by
            simpa [sortedComputed] using computed
          exact insert?_result_noRefusingPair key sorted result
            (OfficialRuleMajorKey.sort?_descending tail sorted sortedComputed)
            (ih sorted sortedComputed) inserted

/-- A successful sort has no refusing pair in its input. -/
theorem sort?_input_noRefusingPair {V : Type*} :
    ∀ (keys result : List (OfficialRuleMajorKey V)),
      OfficialRuleMajorKey.sort? keys = some result → NoRefusingPair keys := by
  intro keys result computed
  exact noRefusingPair_of_perm
    (OfficialRuleMajorKey.sort?_perm keys result computed)
    (sort?_result_noRefusingPair keys result computed)

/-- A pair-safe key list always sorts successfully. -/
theorem sort?_isSome_of_noRefusingPair {V : Type*} :
    ∀ keys : List (OfficialRuleMajorKey V),
      NoRefusingPair keys → (OfficialRuleMajorKey.sort? keys).isSome = true := by
  intro keys
  induction keys with
  | nil => intro _; rfl
  | cons key tail ih =>
      intro noBad
      obtain ⟨noBadTail, noBadHead⟩ := noBad
      obtain ⟨sorted, hsort⟩ := Option.isSome_iff_exists.mp (ih noBadTail)
      have hinsertSome : (OfficialRuleMajorKey.insert? key sorted).isSome = true := by
        by_contra hnot
        have hnone : OfficialRuleMajorKey.insert? key sorted = none := by
          cases hinsert : OfficialRuleMajorKey.insert? key sorted with
          | none => rfl
          | some value =>
              rw [hinsert] at hnot
              exact absurd rfl hnot
        obtain ⟨other, hother, htie, hbad⟩ := insert?_eq_none_witness key sorted hnone
        have hmem : other ∈ tail :=
          (OfficialRuleMajorKey.sort?_perm tail sorted hsort).mem_iff.mp hother
        exact hbad (noBadHead other hmem htie)
      obtain ⟨inserted, hinserted⟩ := Option.isSome_iff_exists.mp hinsertSome
      have hsortAll : OfficialRuleMajorKey.sort? (key :: tail) = some inserted := by
        unfold OfficialRuleMajorKey.sort?
        simpa [hsort] using hinserted
      rw [hsortAll]
      rfl

/-- Successful sorting is invariant under permutation of the child enumeration. -/
theorem sort?_isSome_of_perm {V : Type*} {left right : List (OfficialRuleMajorKey V)}
    (permutation : left.Perm right)
    (computed : (OfficialRuleMajorKey.sort? left).isSome = true) :
    (OfficialRuleMajorKey.sort? right).isSome = true := by
  obtain ⟨result, hresult⟩ := Option.isSome_iff_exists.mp computed
  exact sort?_isSome_of_noRefusingPair right
    (noRefusingPair_of_perm permutation (sort?_input_noRefusingPair left result hresult))

/-- A successful sort of one enumeration yields some sorted permutation of any other. -/
theorem exists_sort?_of_perm {V : Type*} {left right : List (OfficialRuleMajorKey V)}
    (permutation : left.Perm right)
    (computed : (OfficialRuleMajorKey.sort? left).isSome = true) :
    ∃ result, OfficialRuleMajorKey.sort? right = some result :=
  Option.isSome_iff_exists.mp (sort?_isSome_of_perm permutation computed)

/-! ## Terminal agreement with the actual executable enumeration -/

/-- The raw terminal flag is exactly the emptiness of the actual executable official child
enumeration under the accepted child correspondence. -/
theorem canonicalTerminal_eq_executableChildren_isEmpty
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    {node : RawMolecule.CanonicalBranchNode} {onode : OfficialCIPNode input.Atom}
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    {aligned : List RawMolecule.CanonicalBranchNode}
    (haligned : List.Forall₂ (NodeCorresponds (fun atom : input.Atom => atom.val))
      (input.executableOfficialCIPChildren onode) aligned)
    (hperm : List.Perm aligned (mol.canonicalChildren node)) :
    mol.canonicalTerminal node = (input.executableOfficialCIPChildren onode).isEmpty := by
  have hforced := node_forcedLeaf_eq hcorr
  have hemptyTransport :
      (input.executableOfficialCIPChildren onode).isEmpty =
        (mol.canonicalChildren node).isEmpty := by
    rw [isEmpty_eq_of_forall₂ haligned, isEmpty_eq_of_perm hperm]
  by_cases hleaf : node.forcedLeaf = true
  · have hduplicate : onode.isDuplicateLeaf = true := by
      rw [← hforced]
      exact hleaf
    rw [RawMolecule.canonicalTerminal, hleaf, Bool.true_or]
    rw [CertifiedLocalizedCIPInput.executableOfficialCIPChildren, if_pos hduplicate]
    rfl
  · have hleafFalse : node.forcedLeaf = false := Bool.eq_false_of_not_eq_true hleaf
    rw [RawMolecule.canonicalTerminal, hleafFalse, Bool.false_or]
    exact hemptyTransport.symm

/-! ## Budget transport of the executable child recursion

The raw compiler threads the exact remaining-node budget through the child list.  Moving a compiled
child list from the actual canonical child order to the aligned child order (or back) therefore
requires two structural facts about that threading, neither of which inspects molecular data:

* upward monotonicity: a successful child list stays successful, with the same keys, whenever more
  remaining budget is available;
* adequacy: a successful key stays successful, unchanged, at every budget at least its own
  `nodeCount`.

These are properties of the executable constructor alone.  They are proved here once and then used
to transport child builds across the `List.Perm` supplied by the accepted child endpoint, without
assuming any enumeration alignment. -/

/-- One-step equation of the executable child recursion at a nonempty child list.  Stating it as a
rewrite rule keeps the residual recursive call on `rest` opaque, so the induction hypothesis for
`rest` remains applicable. -/
theorem buildCanonicalChildKeys_cons_eq
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (remaining : ℕ) (child : RawMolecule.CanonicalBranchNode)
    (rest : List RawMolecule.CanonicalBranchNode) :
    RawMolecule.buildCanonicalChildKeys buildChild remaining (child :: rest) =
      (do
        let key ← buildChild remaining child
        if remaining < key.nodeCount then none
        else
          let keys ← RawMolecule.buildCanonicalChildKeys buildChild
            (remaining - key.nodeCount) rest
          some (key :: keys)) := rfl

/-- Destruct a successful nonempty child-list build into its head key and residual build. -/
theorem buildCanonicalChildKeys_cons_data
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (remaining : ℕ) (child : RawMolecule.CanonicalBranchNode)
    (rest : List RawMolecule.CanonicalBranchNode)
    (keys : List RawMolecule.CanonicalBranchKey)
    (computed : RawMolecule.buildCanonicalChildKeys buildChild remaining (child :: rest) =
      some keys) :
    ∃ key tail, buildChild remaining child = some key ∧ key.nodeCount ≤ remaining ∧
      RawMolecule.buildCanonicalChildKeys buildChild (remaining - key.nodeCount) rest =
        some tail ∧
      keys = key :: tail := by
  rw [buildCanonicalChildKeys_cons_eq] at computed
  cases hchild : buildChild remaining child with
  | none => simp [hchild] at computed
  | some key =>
      by_cases hbudget : remaining < key.nodeCount
      · simp [hchild, hbudget] at computed
      · cases htail : RawMolecule.buildCanonicalChildKeys buildChild
            (remaining - key.nodeCount) rest with
        | none => simp [hchild, hbudget, htail] at computed
        | some tail =>
            simp [hchild, hbudget, htail] at computed
            have hkeys : keys = key :: tail := by simpa using computed.symm
            exact ⟨key, tail, rfl, Nat.le_of_not_lt hbudget, htail, hkeys⟩

/-- The keys produced from a child list fit in the remaining budget. -/
theorem buildCanonicalChildKeys_budget
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey) :
    ∀ (nodes : List RawMolecule.CanonicalBranchNode) (remaining : ℕ)
        (keys : List RawMolecule.CanonicalBranchKey),
      RawMolecule.buildCanonicalChildKeys buildChild remaining nodes = some keys →
      (keys.map fun key => key.nodeCount).sum ≤ remaining := by
  intro nodes
  induction nodes with
  | nil =>
      intro remaining keys computed
      simp only [RawMolecule.buildCanonicalChildKeys, Option.some.injEq] at computed
      subst keys
      simp
  | cons child rest ih =>
      intro remaining keys computed
      obtain ⟨key, tail, _hkey, hle, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining child rest keys computed
      have hrec := ih (remaining - key.nodeCount) tail htail
      simp only [List.map_cons, List.sum_cons]
      omega

/-- A successful child-list build is preserved when the remaining budget grows. -/
theorem buildCanonicalChildKeys_mono
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (hmono : ∀ remaining node key, buildChild remaining node = some key →
      ∀ remaining', remaining ≤ remaining' → buildChild remaining' node = some key) :
    ∀ (nodes : List RawMolecule.CanonicalBranchNode) (remaining remaining' : ℕ)
        (keys : List RawMolecule.CanonicalBranchKey),
      remaining ≤ remaining' →
      RawMolecule.buildCanonicalChildKeys buildChild remaining nodes = some keys →
      RawMolecule.buildCanonicalChildKeys buildChild remaining' nodes = some keys := by
  intro nodes
  induction nodes with
  | nil =>
      intro remaining remaining' keys _hle computed
      simpa [RawMolecule.buildCanonicalChildKeys] using computed
  | cons child rest ih =>
      intro remaining remaining' keys hle computed
      obtain ⟨key, tail, hkey, hbudget, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining child rest keys computed
      have hkey' : buildChild remaining' child = some key :=
        hmono remaining child key hkey remaining' hle
      have hbudget' : ¬ remaining' < key.nodeCount := by omega
      have htail' : RawMolecule.buildCanonicalChildKeys buildChild
          (remaining' - key.nodeCount) rest = some tail :=
        ih (remaining - key.nodeCount) (remaining' - key.nodeCount) tail (by omega) htail
      rw [buildCanonicalChildKeys_cons_eq]
      simp [hkey', hbudget', htail']

/-- A successful child-list build is preserved, with the same keys, at every budget at least the
sum of the produced `nodeCount`s. -/
theorem buildCanonicalChildKeys_adequate
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (hadequate : ∀ remaining node key, buildChild remaining node = some key →
      ∀ remaining', key.nodeCount ≤ remaining' → buildChild remaining' node = some key) :
    ∀ (nodes : List RawMolecule.CanonicalBranchNode) (remaining : ℕ)
        (keys : List RawMolecule.CanonicalBranchKey),
      RawMolecule.buildCanonicalChildKeys buildChild remaining nodes = some keys →
      ∀ remaining', (keys.map fun key => key.nodeCount).sum ≤ remaining' →
        RawMolecule.buildCanonicalChildKeys buildChild remaining' nodes = some keys := by
  intro nodes
  induction nodes with
  | nil =>
      intro remaining keys computed remaining' _hfit
      simpa [RawMolecule.buildCanonicalChildKeys] using computed
  | cons child rest ih =>
      intro remaining keys computed remaining' hfit
      obtain ⟨key, tail, hkey, _hbudget, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining child rest keys computed
      simp only [List.map_cons, List.sum_cons] at hfit
      have hkey' : buildChild remaining' child = some key :=
        hadequate remaining child key hkey remaining' (by omega)
      have hbudget' : ¬ remaining' < key.nodeCount := by omega
      have htail' : RawMolecule.buildCanonicalChildKeys buildChild
          (remaining' - key.nodeCount) rest = some tail :=
        ih (remaining - key.nodeCount) tail htail (remaining' - key.nodeCount) (by omega)
      rw [buildCanonicalChildKeys_cons_eq]
      simp [hkey', hbudget', htail']

/-- The node count of a successful key does not depend on the budget it is compiled with: any two
successful compilations of the same node and fuel produce the same key. -/
theorem buildCanonicalChildKeys_key_eq
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (hkeyEq : ∀ remaining node key, buildChild remaining node = some key →
      ∀ remaining' key', buildChild remaining' node = some key' → key' = key) :
    ∀ (nodes : List RawMolecule.CanonicalBranchNode) (remaining : ℕ)
        (keys : List RawMolecule.CanonicalBranchKey),
      RawMolecule.buildCanonicalChildKeys buildChild remaining nodes = some keys →
      ∀ (remaining' : ℕ) (keys' : List RawMolecule.CanonicalBranchKey),
        RawMolecule.buildCanonicalChildKeys buildChild remaining' nodes = some keys' →
        keys' = keys := by
  intro nodes
  induction nodes with
  | nil =>
      intro remaining keys computed remaining' keys' computed'
      simp only [RawMolecule.buildCanonicalChildKeys, Option.some.injEq] at computed computed'
      subst keys
      exact computed'.symm
  | cons child rest ih =>
      intro remaining keys computed remaining' keys' computed'
      obtain ⟨key, tail, hkey, _hbudget, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining child rest keys computed
      obtain ⟨key', tail', hkey', _hbudget', htail', rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining' child rest keys' computed'
      have hkeyEq' : key' = key := hkeyEq remaining child key hkey remaining' key' hkey'
      rw [hkeyEq'] at htail'
      have htailEq := ih (remaining - key.nodeCount) tail htail
        (remaining' - key.nodeCount) tail' htail'
      rw [hkeyEq', htailEq]

/-! ### Budget monotonicity of the node compiler -/

/-- One-step equation of the executable branch compiler at zero fuel. -/
theorem buildCanonicalBranchKey_zero_eq (mol : RawMolecule) (cap : ℕ)
    (node : RawMolecule.CanonicalBranchNode) :
    mol.buildCanonicalBranchKey cap 0 node =
      (do
        let _ ← mol.canonicalRule1aLabel? node
        some (mol.canonicalRootKey node (mol.canonicalTerminal node))) := rfl

/-- One-step equation of the executable branch compiler at positive fuel.  The child builder is
kept as the literal recursive closure, so rewriting with this equation never unfolds the closure
itself. -/
theorem buildCanonicalBranchKey_succ_eq (mol : RawMolecule) (cap fuel : ℕ)
    (node : RawMolecule.CanonicalBranchNode) :
    mol.buildCanonicalBranchKey cap (fuel + 1) node =
      (match mol.canonicalRule1aLabel? node with
        | none => none
        | some _ =>
            if mol.canonicalTerminal node then
              some (mol.canonicalRootKey node true)
            else
              (do
                let children := mol.canonicalChildren node
                if 3 < children.length then none
                else
                  let childKeys ← RawMolecule.buildCanonicalChildKeys
                    (fun remaining child =>
                      mol.buildCanonicalBranchKey remaining fuel child)
                    (cap - 1) children
                  let sorted ← RawMolecule.sortCanonicalKeys? childKeys
                  let root := mol.canonicalRootKey node
                    (sorted.all fun child => child.complete)
                  let key := RawMolecule.assembleCanonicalBranchKey root sorted
                  if cap < key.nodeCount then none else some key)) := rfl

/-- The same positive-fuel equation with the child and sort steps written as explicit
`Option.bind`s.  This is the form used when destructing a successful compilation: it exposes the
two bind nodes to `Option.bind_eq_some_iff` without any reduction of `do` notation. -/
theorem buildCanonicalBranchKey_succ_bind_eq (mol : RawMolecule) (cap fuel : ℕ)
    (node : RawMolecule.CanonicalBranchNode) :
    mol.buildCanonicalBranchKey cap (fuel + 1) node =
      (match mol.canonicalRule1aLabel? node with
        | none => none
        | some _ =>
            if mol.canonicalTerminal node then
              some (mol.canonicalRootKey node true)
            else
              if 3 < (mol.canonicalChildren node).length then none
              else
                Option.bind
                  (RawMolecule.buildCanonicalChildKeys
                    (fun remaining child =>
                      mol.buildCanonicalBranchKey remaining fuel child)
                    (cap - 1) (mol.canonicalChildren node))
                  (fun childKeys =>
                    Option.bind (RawMolecule.sortCanonicalKeys? childKeys)
                      (fun sorted =>
                        let root := mol.canonicalRootKey node
                          (sorted.all fun child => child.complete)
                        let key := RawMolecule.assembleCanonicalBranchKey root sorted
                        if cap < key.nodeCount then none else some key))) := rfl

/-- Upward monotonicity in the budget for the executable branch compiler. -/
theorem buildCanonicalBranchKey_mono (mol : RawMolecule) :
    ∀ (fuel : ℕ) (node : RawMolecule.CanonicalBranchNode) (cap : ℕ)
        (key : RawMolecule.CanonicalBranchKey),
      mol.buildCanonicalBranchKey cap fuel node = some key →
      ∀ cap', cap ≤ cap' → mol.buildCanonicalBranchKey cap' fuel node = some key := by
  intro fuel
  induction fuel with
  | zero =>
      intro node cap key computed cap' _hcap
      simp only [RawMolecule.buildCanonicalBranchKey] at computed ⊢
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label => simpa [hlabel] using computed
  | succ fuel ih =>
      intro node cap key computed cap' hcap
      rw [buildCanonicalBranchKey_succ_bind_eq] at computed
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed
          by_cases hterminal : mol.canonicalTerminal node = true
          · rw [hterminal] at computed
            rw [if_pos rfl] at computed
            have hkey : key = mol.canonicalRootKey node true :=
              (Option.some_inj.mp computed).symm
            rw [buildCanonicalBranchKey_succ_bind_eq]
            rw [hlabel]
            rw [hterminal]
            rw [if_pos rfl]
            rw [hkey]
          · have hterminalFalse : mol.canonicalTerminal node = false :=
              Bool.eq_false_of_not_eq_true hterminal
            rw [hterminalFalse] at computed
            rw [if_neg (by decide : ¬ (false = true))] at computed
            by_cases hwidth : 3 < (mol.canonicalChildren node).length
            · rw [if_pos hwidth] at computed
              simp at computed
            · rw [if_neg hwidth] at computed
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨childKeys, hchildKeys, computed⟩
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨sorted, hsorted, computed⟩
              dsimp only at computed
              by_cases hbudget : cap <
                  (RawMolecule.assembleCanonicalBranchKey
                    (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                    sorted).nodeCount
              · simp [hbudget] at computed
              · simp only [hbudget, if_false, Option.some.injEq] at computed
                have hchildKeys' : RawMolecule.buildCanonicalChildKeys
                    (fun remaining child => mol.buildCanonicalBranchKey remaining fuel child)
                    (cap' - 1) (mol.canonicalChildren node) = some childKeys :=
                  buildCanonicalChildKeys_mono _
                    (fun remaining child childKey hk remaining' hle =>
                      ih child remaining childKey hk remaining' hle)
                    (mol.canonicalChildren node) (cap - 1) (cap' - 1) childKeys
                    (by omega) hchildKeys
                have hbudget' : ¬ cap' <
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                      sorted).nodeCount := by omega
                rw [← computed, buildCanonicalBranchKey_succ_bind_eq]
                rw [hlabel]
                rw [hterminalFalse]
                rw [if_neg (by decide : ¬ (false = true))]
                rw [if_neg hwidth]
                rw [hchildKeys']
                rw [Option.bind_some]
                rw [hsorted]
                rw [Option.bind_some]
                simp [hbudget']

/-- The executable branch compiler's key does not depend on the budget it is compiled with. -/
theorem buildCanonicalBranchKey_cap_eq (mol : RawMolecule) :
    ∀ (fuel : ℕ) (node : RawMolecule.CanonicalBranchNode) (cap : ℕ)
        (key : RawMolecule.CanonicalBranchKey),
      mol.buildCanonicalBranchKey cap fuel node = some key →
      ∀ (cap' : ℕ) (key' : RawMolecule.CanonicalBranchKey),
        mol.buildCanonicalBranchKey cap' fuel node = some key' → key' = key := by
  intro fuel
  induction fuel with
  | zero =>
      intro node cap key computed cap' key' computed'
      rw [buildCanonicalBranchKey_zero_eq] at computed computed'
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed computed'
          have hkey : key = mol.canonicalRootKey node (mol.canonicalTerminal node) :=
            (Option.some_inj.mp computed).symm
          have hkey' : key' = mol.canonicalRootKey node (mol.canonicalTerminal node) :=
            (Option.some_inj.mp computed').symm
          exact hkey'.trans hkey.symm
  | succ fuel ih =>
      intro node cap key computed cap' key' computed'
      rw [buildCanonicalBranchKey_succ_bind_eq] at computed computed'
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed computed'
          by_cases hterminal : mol.canonicalTerminal node = true
          · rw [hterminal] at computed computed'
            rw [if_pos rfl] at computed computed'
            have hkey : key = mol.canonicalRootKey node true :=
              (Option.some_inj.mp computed).symm
            have hkey' : key' = mol.canonicalRootKey node true :=
              (Option.some_inj.mp computed').symm
            exact hkey'.trans hkey.symm
          · have hterminalFalse : mol.canonicalTerminal node = false :=
              Bool.eq_false_of_not_eq_true hterminal
            rw [hterminalFalse] at computed computed'
            rw [if_neg (by decide : ¬ (false = true))] at computed computed'
            by_cases hwidth : 3 < (mol.canonicalChildren node).length
            · rw [if_pos hwidth] at computed
              simp at computed
            · rw [if_neg hwidth] at computed computed'
              rw [Option.bind_eq_some_iff] at computed computed'
              rcases computed with ⟨childKeys, hchildKeys, computed⟩
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨sorted, hsorted, computed⟩
              rcases computed' with ⟨childKeys', hchildKeys', computed'⟩
              rw [Option.bind_eq_some_iff] at computed'
              rcases computed' with ⟨sorted', hsorted', computed'⟩
              dsimp only at computed computed'
              by_cases hbudget : cap <
                  (RawMolecule.assembleCanonicalBranchKey
                    (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                    sorted).nodeCount
              · simp [hbudget] at computed
              · simp only [hbudget, if_false, Option.some.injEq] at computed
                by_cases hbudget' : cap' <
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node (sorted'.all fun child => child.complete))
                      sorted').nodeCount
                · simp [hbudget'] at computed'
                · simp only [hbudget', if_false, Option.some.injEq] at computed'
                  have hchildEq : childKeys' = childKeys :=
                    buildCanonicalChildKeys_key_eq _
                      (fun remaining child childKey hk remaining' childKey' hk' =>
                        ih child remaining childKey hk remaining' childKey' hk')
                      (mol.canonicalChildren node) (cap - 1) childKeys hchildKeys
                      (cap' - 1) childKeys' hchildKeys'
                  rw [hchildEq] at hsorted'
                  have hsortedEq : sorted' = sorted := by
                    rw [hsorted] at hsorted'
                    exact (Option.some_inj.mp hsorted').symm
                  rw [hsortedEq] at computed'
                  exact computed'.symm.trans computed

/-! ### The assembled node count -/

/-- Adding a mapped value along a list is the shifted sum of the mapped list. -/
theorem foldl_add_map_eq_sum {α : Type*} (l : List α) (value : α → ℕ) (start : ℕ) :
    l.foldl (fun total entry => total + value entry) start = start + (l.map value).sum := by
  induction l generalizing start with
  | nil => simp
  | cons head tail ih =>
      simp only [List.foldl_cons, List.map_cons, List.sum_cons]
      rw [ih]
      omega

/-- The node count is the sum of the Rule-1a layer lengths. -/
theorem nodeCount_eq_sum (key : RawMolecule.CanonicalBranchKey) :
    key.nodeCount = ((key.rule1a).map fun layer => layer.length).sum := by
  unfold RawMolecule.CanonicalBranchKey.nodeCount
  rw [foldl_add_map_eq_sum]
  simp

/-- Pointwise addition distributes over a list sum. -/
theorem sum_map_add_nat {α : Type*} (l : List α) (left right : α → ℕ) :
    (l.map fun entry => left entry + right entry).sum =
      (l.map left).sum + (l.map right).sum := by
  induction l with
  | nil => rfl
  | cons head tail ih =>
      simp only [List.map_cons, List.sum_cons]
      rw [ih]
      omega

/-- Interchange of the two finite sums over a pair of lists. -/
theorem sum_comm_nat {α β : Type*} (left : List α) (right : List β)
    (value : α → β → ℕ) :
    (left.map fun a => (right.map fun b => value a b).sum).sum =
      (right.map fun b => (left.map fun a => value a b).sum).sum := by
  induction left with
  | nil => simp
  | cons head tail ih =>
      simp only [List.map_cons, List.sum_cons]
      rw [ih, ← sum_map_add_nat right (fun b => value head b)
        (fun b => (tail.map fun a => value a b).sum)]

/-- The sum of a mapped `zipIdx` list ignores the index. -/
theorem sum_map_zipIdx_fst {α : Type*} (value : α → ℕ) :
    ∀ (l : List α) (start : ℕ),
      ((l.zipIdx start).map fun entry => value entry.1).sum = (l.map value).sum := by
  intro l
  induction l with
  | nil => intro start; rfl
  | cons head tail ih =>
      intro start
      simp only [List.zipIdx_cons, List.map_cons, List.sum_cons]
      rw [ih]

/-- Each child's Rule-1a layer count is bounded by the merged layer count. -/
theorem foldl_max_ge_init (l : List ℕ) (init : ℕ) : init ≤ l.foldl max init := by
  induction l generalizing init with
  | nil => exact Nat.le_refl init
  | cons head tail ih =>
      simp only [List.foldl_cons]
      exact Nat.le_trans (Nat.le_max_left init head) (ih (max init head))

/-- A member of a natural-number list is at most its maximum fold. -/
theorem le_foldl_max_of_mem : ∀ (l : List ℕ) (init value : ℕ),
    value ∈ l → value ≤ l.foldl max init := by
  intro l
  induction l with
  | nil =>
      intro init value hmem
      simp at hmem
  | cons head tail ih =>
      intro init value hmem
      simp only [List.foldl_cons]
      rcases List.mem_cons.mp hmem with same | hmem
      · rw [same]
        exact Nat.le_trans (Nat.le_max_right init head)
          (foldl_max_ge_init tail (max init head))
      · exact ih (max init head) value hmem

/-- The merged child-layer count dominates every child's Rule-1a layer count. -/
theorem layerLength_le_childLayerCount
    (children : List RawMolecule.CanonicalBranchKey)
    (child : RawMolecule.CanonicalBranchKey) (hmem : child ∈ children) :
    (child.rule1a).length ≤
      RawMolecule.canonicalChildLayerCount children (fun entry => entry.rule1a) := by
  unfold RawMolecule.canonicalChildLayerCount
  rw [← List.foldl_map]
  exact le_foldl_max_of_mem
    (children.map fun entry => (entry.rule1a).length) 0 ((child.rule1a).length)
    (List.mem_map_of_mem hmem)

/-- At a layer count at least every child's depth count, summing the padded layer lengths of a
child recovers its node count. -/
theorem sum_range_getD_length {α : Type*} (layers : List (List α)) (count : ℕ)
    (bounds : layers.length ≤ count) :
    ((List.range count).map fun depth => (layers.getD depth []).length).sum =
      (layers.map fun layer => layer.length).sum := by
  induction layers generalizing count with
  | nil => simp
  | cons head tail ih =>
      cases count with
      | zero => simp at bounds
      | succ count' =>
          rw [List.range_succ_eq_map]
          simp only [List.map_cons, List.sum_cons, List.getD_cons_zero, List.map_map,
            Function.comp_def, List.getD_cons_succ]
          rw [ih count' (by simpa using bounds)]

/-- The merged Rule-1a layers contain exactly the total node counts of the child keys. -/
theorem merge_layers_nodeCount (children : List RawMolecule.CanonicalBranchKey)
    (count : ℕ)
    (bounds : ∀ child ∈ children, (child.rule1a).length ≤ count) :
    ((List.range count).map fun depth =>
        children.zipIdx.flatMap fun child =>
          RawMolecule.prefixCanonicalAtomicLayer child.2
            (child.1.rule1a.getD depth [])).foldl
        (fun total layer => total + layer.length) 0 =
      (children.map fun key => key.nodeCount).sum := by
  rw [List.foldl_map, foldl_add_map_eq_sum]
  simp only [Nat.zero_add]
  simp only [List.length_flatMap, RawMolecule.prefixCanonicalAtomicLayer, List.length_map]
  trans ((List.range count).map fun depth =>
      (children.map fun child => (child.rule1a.getD depth []).length).sum).sum
  · congr 1
    apply List.map_congr_left
    intro depth _hdepth
    simpa using sum_map_zipIdx_fst
      (fun child => (child.rule1a.getD depth []).length) children 0
  · trans (children.map fun child =>
        ((List.range count).map fun depth => (child.rule1a.getD depth []).length).sum).sum
    · exact sum_comm_nat (List.range count) children
        (fun depth child => (child.rule1a.getD depth []).length)
    · congr 1
      apply List.map_congr_left
      intro child hchild
      rw [sum_range_getD_length child.rule1a count (bounds child hchild), nodeCount_eq_sum]

/-- The merged Rule-1a layers contain exactly the total node counts of the child keys. -/
theorem mergeCanonicalAtomicChildren_nodeCount
    (children : List RawMolecule.CanonicalBranchKey) :
    (RawMolecule.mergeCanonicalAtomicChildren children).foldl
        (fun total layer => total + layer.length) 0 =
      (children.map fun key => key.nodeCount).sum := by
  unfold RawMolecule.mergeCanonicalAtomicChildren
  exact merge_layers_nodeCount children
    (RawMolecule.canonicalChildLayerCount children (fun entry => entry.rule1a))
    (fun child hchild => layerLength_le_childLayerCount children child hchild)

/-- The assembled key's node count is the root node plus all child node counts. -/
theorem assembleCanonicalBranchKey_nodeCount (root : RawMolecule.CanonicalBranchKey)
    (sorted : List RawMolecule.CanonicalBranchKey) :
    (RawMolecule.assembleCanonicalBranchKey root sorted).nodeCount =
      root.nodeCount + (sorted.map fun key => key.nodeCount).sum := by
  rw [nodeCount_eq_sum]
  change ((root.rule1a ++ RawMolecule.mergeCanonicalAtomicChildren sorted).map
      fun layer => layer.length).sum =
    root.nodeCount + (sorted.map fun key => key.nodeCount).sum
  rw [List.map_append, List.sum_append, nodeCount_eq_sum root]
  have hmerge : ((RawMolecule.mergeCanonicalAtomicChildren sorted).map
      fun layer => layer.length).sum = (sorted.map fun key => key.nodeCount).sum := by
    have hfold := foldl_add_map_eq_sum
      (RawMolecule.mergeCanonicalAtomicChildren sorted) (fun layer => layer.length) 0
    simp only [Nat.zero_add] at hfold
    rw [← hfold]
    exact mergeCanonicalAtomicChildren_nodeCount sorted
  rw [hmerge]

/-- The root key has exactly one node. -/
theorem canonicalRootKey_nodeCount (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) (complete : Bool) :
    (mol.canonicalRootKey node complete).nodeCount = 1 := by
  rw [nodeCount_eq_sum]
  simp [RawMolecule.canonicalRootKey]

/-- Node counts are invariant under permutation of a key list. -/
theorem sum_nodeCount_eq_of_perm {left right : List RawMolecule.CanonicalBranchKey}
    (permutation : left.Perm right) :
    (left.map fun key => key.nodeCount).sum =
      (right.map fun key => key.nodeCount).sum := by
  induction permutation with
  | nil => rfl
  | cons head step ih =>
      simp only [List.map_cons, List.sum_cons]
      rw [ih]
  | swap first second rest =>
      simp only [List.map_cons, List.sum_cons]
      omega
  | trans step₁ step₂ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Adequacy: once a key compiles successfully at any budget, it compiles unchanged at every budget
at least its own `nodeCount`. -/
theorem buildCanonicalBranchKey_adequate (mol : RawMolecule) :
    ∀ (fuel : ℕ) (node : RawMolecule.CanonicalBranchNode) (cap : ℕ)
        (key : RawMolecule.CanonicalBranchKey),
      mol.buildCanonicalBranchKey cap fuel node = some key →
      ∀ cap', key.nodeCount ≤ cap' → mol.buildCanonicalBranchKey cap' fuel node = some key := by
  intro fuel
  induction fuel with
  | zero =>
      intro node cap key computed cap' _hfit
      simp only [RawMolecule.buildCanonicalBranchKey] at computed ⊢
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label => simpa [hlabel] using computed
  | succ fuel ih =>
      intro node cap key computed cap' hfit
      rw [buildCanonicalBranchKey_succ_bind_eq] at computed
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed
          by_cases hterminal : mol.canonicalTerminal node = true
          · rw [hterminal] at computed
            rw [if_pos rfl] at computed
            have hkey : key = mol.canonicalRootKey node true :=
              (Option.some_inj.mp computed).symm
            rw [buildCanonicalBranchKey_succ_bind_eq]
            rw [hlabel]
            rw [hterminal]
            rw [if_pos rfl]
            rw [hkey]
          · have hterminalFalse : mol.canonicalTerminal node = false :=
              Bool.eq_false_of_not_eq_true hterminal
            rw [hterminalFalse] at computed
            rw [if_neg (by decide : ¬ (false = true))] at computed
            by_cases hwidth : 3 < (mol.canonicalChildren node).length
            · rw [if_pos hwidth] at computed
              simp at computed
            · rw [if_neg hwidth] at computed
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨childKeys, hchildKeys, computed⟩
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨sorted, hsorted, computed⟩
              dsimp only at computed
              by_cases hbudget : cap <
                  (RawMolecule.assembleCanonicalBranchKey
                    (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                    sorted).nodeCount
              · simp [hbudget] at computed
              · simp only [hbudget, if_false, Option.some.injEq] at computed
                have hfit' : (RawMolecule.assembleCanonicalBranchKey
                    (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                    sorted).nodeCount ≤ cap' := by
                  rw [computed]
                  exact hfit
                have hformula := assembleCanonicalBranchKey_nodeCount
                  (mol.canonicalRootKey node (sorted.all fun child => child.complete)) sorted
                have hrootCount : (mol.canonicalRootKey node
                    (sorted.all fun child => child.complete)).nodeCount = 1 :=
                  canonicalRootKey_nodeCount mol node _
                have hsumSorted : (sorted.map fun child => child.nodeCount).sum ≤ cap' - 1 := by
                  omega
                have hsumChildKeys :
                    (childKeys.map fun child => child.nodeCount).sum ≤ cap' - 1 := by
                  rw [← sum_nodeCount_eq_of_perm
                    (sortCanonicalKeys?_perm childKeys sorted hsorted)]
                  exact hsumSorted
                have hchildKeys' : RawMolecule.buildCanonicalChildKeys
                    (fun remaining child => mol.buildCanonicalBranchKey remaining fuel child)
                    (cap' - 1) (mol.canonicalChildren node) = some childKeys :=
                  buildCanonicalChildKeys_adequate _
                    (fun remaining child childKey hk remaining' hfit'' =>
                      ih child remaining childKey hk remaining' hfit'')
                    (mol.canonicalChildren node) (cap - 1) childKeys hchildKeys
                    (cap' - 1) hsumChildKeys
                have hbudget' : ¬ cap' <
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                      sorted).nodeCount := by omega
                rw [← computed, buildCanonicalBranchKey_succ_bind_eq]
                rw [hlabel]
                rw [hterminalFalse]
                rw [if_neg (by decide : ¬ (false = true))]
                rw [if_neg hwidth]
                rw [hchildKeys']
                rw [Option.bind_some]
                rw [hsorted]
                rw [Option.bind_some]
                simp [hbudget']

/-! ## Aligning the actual executable child enumeration

The accepted endpoint gives `Forall₂` between the executable official children and a canonical list
that `Perm`-permutes `mol.canonicalChildren node`.  The raw compiler, however, threads its budget
through the canonical order.  The lemmas in this section perform the two independent transports
needed to compare the two actual constructions:

* the budget-threaded raw child recursion is moved across the canonical permutation; and
* the raw child keys are aligned positionally with the official keys built from the actual
  executable child nodes.

No synthetic enumeration is introduced: the localized side is always the actual
`input.executableOfficialCIPChildren`. -/

/-- Membership in a `zip` of two `Forall₂`-related lists inherits the relation. -/
theorem forall₂_zip_mem {α β : Type*} {R : α → β → Prop} :
    ∀ {xs : List α} {ys : List β}, List.Forall₂ R xs ys →
      ∀ p ∈ xs.zip ys, R p.1 p.2 := by
  intro xs ys h
  induction h with
  | nil =>
      intro p hp
      simp at hp
  | cons hhead htail ih =>
      intro p hp
      simp only [List.zip_cons_cons, List.mem_cons] at hp
      rcases hp with rfl | hp
      · exact hhead
      · exact ih p hp

/-- Rebuild a pointwise relation from its `zip` form. -/
theorem forall₂_of_zip_mem {α β : Type*} {R : α → β → Prop} :
    ∀ (xs : List α) (ys : List β), (∀ p ∈ xs.zip ys, R p.1 p.2) →
      xs.length = ys.length → List.Forall₂ R xs ys := by
  intro xs
  induction xs with
  | nil =>
      intro ys _ hlen
      cases ys with
      | nil => exact List.Forall₂.nil
      | cons _ _ => simp at hlen
  | cons x xs ih =>
      intro ys hmem hlen
      cases ys with
      | nil => simp at hlen
      | cons y ys =>
          refine List.Forall₂.cons (hmem (x, y) (by simp)) (ih ys ?_ ?_)
          · intro p hp
            exact hmem p (by simp [hp])
          · simpa using hlen

/-- A list of pairs, each satisfying a relation on `(snd, fst)`, gives a pointwise relation
between its two projections. -/
theorem forall₂_map_snd_map_fst {α β : Type*} {P : α → β → Prop} :
    ∀ (pairs : List (β × α)), (∀ p ∈ pairs, P p.2 p.1) →
      List.Forall₂ P (pairs.map Prod.snd) (pairs.map Prod.fst) := by
  intro pairs
  induction pairs with
  | nil => intro _; exact List.Forall₂.nil
  | cons p ps ih =>
      intro hall
      exact List.Forall₂.cons (hall p (by simp))
        (ih (fun q hq => hall q (by simp [hq])))

/-- Reorder a list of pairs so that its second projection is a prescribed permutation of the
original second projection.  This is the elementary permutation-lifting step used to pass from
the executable order to the canonical order without identifying the two enumerations. -/
theorem exists_perm_map_snd_eq {α β : Type*} :
    ∀ {source target : List β}, source.Perm target →
      ∀ (pairs : List (α × β)), pairs.map Prod.snd = source →
        ∃ pairs' : List (α × β), pairs'.Perm pairs ∧ pairs'.map Prod.snd = target := by
  intro source target permutation
  induction permutation with
  | nil =>
      intro pairs hsource
      cases pairs with
      | nil => exact ⟨[], List.Perm.nil, rfl⟩
      | cons _ _ => simp at hsource
  | cons b tailPerm ih =>
      rename_i tailSource tailTarget
      intro pairs hsource
      cases pairs with
      | nil => simp at hsource
      | cons p ps =>
          simp only [List.map_cons, List.cons.injEq] at hsource
          obtain ⟨hp, hps⟩ := hsource
          subst b
          obtain ⟨ps', hpsPerm, hpsMap⟩ := ih ps hps
          exact ⟨p :: ps', List.Perm.cons p hpsPerm, by simp [hpsMap]⟩
  | swap b c rest =>
      intro pairs hsource
      cases pairs with
      | nil => simp at hsource
      | cons p ps =>
          cases ps with
          | nil => simp at hsource
          | cons q qs =>
              simp only [List.map_cons, List.cons.injEq] at hsource
              obtain ⟨hp, hq, hqs⟩ := hsource
              subst b
              subst c
              exact ⟨q :: p :: qs, List.Perm.swap p q qs, by simp [hqs]⟩
  | trans first second ihFirst ihSecond =>
      intro pairs hsource
      obtain ⟨middle, hmiddlePerm, hmiddleMap⟩ := ihFirst pairs hsource
      obtain ⟨result, hresultPerm, hresultMap⟩ := ihSecond middle hmiddleMap
      exact ⟨result, hresultPerm.trans hmiddlePerm, hresultMap⟩

/-- Swapping two adjacent raw children preserves success of the budget-threaded child build,
up to a permutation of the produced key list.  The two child keys are compiled at the budgets
required by the swapped order; adequacy moves each compilation to its new budget. -/
theorem buildCanonicalChildKeys_swap
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (hadequate : ∀ remaining node key, buildChild remaining node = some key →
      ∀ remaining', key.nodeCount ≤ remaining' → buildChild remaining' node = some key)
    (first second : RawMolecule.CanonicalBranchNode)
    (rest : List RawMolecule.CanonicalBranchNode)
    (remaining : ℕ) (keys : List RawMolecule.CanonicalBranchKey)
    (computed : RawMolecule.buildCanonicalChildKeys buildChild remaining
      (first :: second :: rest) = some keys) :
    ∃ other, RawMolecule.buildCanonicalChildKeys buildChild remaining
        (second :: first :: rest) = some other ∧ other.Perm keys := by
  obtain ⟨firstKey, middle, hfirstKey, _hfirstBudget, hmiddle, rfl⟩ :=
    buildCanonicalChildKeys_cons_data buildChild remaining first (second :: rest) keys computed
  obtain ⟨secondKey, tail, hsecondKey, hsecondBudget, htail, rfl⟩ :=
    buildCanonicalChildKeys_cons_data buildChild (remaining - firstKey.nodeCount)
      second rest middle hmiddle
  have hsecondLe : secondKey.nodeCount ≤ remaining := by omega
  have hfirstLe : firstKey.nodeCount ≤ remaining - secondKey.nodeCount := by omega
  have hsecondBudgetNot : ¬ remaining < secondKey.nodeCount := by omega
  have hfirstBudgetNot : ¬ (remaining - secondKey.nodeCount) < firstKey.nodeCount := by omega
  have hsecondKey' : buildChild remaining second = some secondKey :=
    hadequate (remaining - firstKey.nodeCount) second secondKey hsecondKey remaining hsecondLe
  have hfirstKey' : buildChild (remaining - secondKey.nodeCount) first = some firstKey :=
    hadequate remaining first firstKey hfirstKey (remaining - secondKey.nodeCount) hfirstLe
  have hsub : (remaining - secondKey.nodeCount) - firstKey.nodeCount =
      remaining - firstKey.nodeCount - secondKey.nodeCount := by omega
  have htail' : RawMolecule.buildCanonicalChildKeys buildChild
      ((remaining - secondKey.nodeCount) - firstKey.nodeCount) rest = some tail := by
    rw [hsub]
    exact htail
  refine ⟨secondKey :: firstKey :: tail, ?_, List.Perm.swap firstKey secondKey tail⟩
  rw [buildCanonicalChildKeys_cons_eq]
  simp [hsecondKey', hsecondBudgetNot]
  rw [buildCanonicalChildKeys_cons_eq]
  simp [hfirstKey', hfirstBudgetNot, htail']

/-- The budget-threaded child build can be moved across any permutation of its input list. -/
theorem buildCanonicalChildKeys_perm
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (hadequate : ∀ remaining node key, buildChild remaining node = some key →
      ∀ remaining', key.nodeCount ≤ remaining' → buildChild remaining' node = some key) :
    ∀ {source target : List RawMolecule.CanonicalBranchNode}, source.Perm target →
      ∀ (remaining : ℕ) (keys : List RawMolecule.CanonicalBranchKey),
        RawMolecule.buildCanonicalChildKeys buildChild remaining source = some keys →
        ∃ other, RawMolecule.buildCanonicalChildKeys buildChild remaining target = some other ∧
          other.Perm keys := by
  intro source target permutation
  induction permutation with
  | nil =>
      intro remaining keys computed
      rw [RawMolecule.buildCanonicalChildKeys] at computed
      simp only [Option.some.injEq] at computed
      subst keys
      exact ⟨[], rfl, List.Perm.nil⟩
  | cons head _tailPerm ih =>
      rename_i tailSource tailTarget
      intro remaining keys computed
      obtain ⟨key, tail, hkey, hbudget, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining head tailSource keys computed
      have hbudgetNot : ¬ remaining < key.nodeCount := by omega
      obtain ⟨otherTail, hotherTail, hpermTail⟩ :=
        ih (remaining - key.nodeCount) tail htail
      refine ⟨key :: otherTail, ?_, List.Perm.cons key hpermTail⟩
      rw [buildCanonicalChildKeys_cons_eq]
      simp [hkey, hbudgetNot, hotherTail]
  | swap first second rest =>
      intro remaining keys computed
      exact buildCanonicalChildKeys_swap buildChild hadequate second first rest
        remaining keys computed
  | trans _firstPerm _secondPerm ihFirst ihSecond =>
      intro remaining keys computed
      obtain ⟨middle, hmiddle, hpermMiddle⟩ := ihFirst remaining keys computed
      obtain ⟨other, hother, hpermOther⟩ := ihSecond remaining middle hmiddle
      exact ⟨other, hother, hpermOther.trans hpermMiddle⟩

/-- Positional transport of a successful budget-threaded raw child build against official child
keys compiled from the corresponding official nodes.  The soundness premise is the recursive
transport theorem applied at the smaller fuel bound. -/
theorem buildCanonicalChildKeys_forall₂_corresponds {V : Type*}
    (buildChild : ℕ → RawMolecule.CanonicalBranchNode →
      Option RawMolecule.CanonicalBranchKey)
    (buildLoc : OfficialCIPNode V → Option (OfficialRuleMajorKey V))
    (P : RawMolecule.CanonicalBranchNode → OfficialCIPNode V → Prop)
    (sound : ∀ remaining node onode rawKey, P node onode →
      buildChild remaining node = some rawKey →
      ∃ locKey, buildLoc onode = some locKey ∧
        ConstitutionalKeyCorresponds rawKey locKey) :
    ∀ (nodes : List RawMolecule.CanonicalBranchNode) (remaining : ℕ)
      (keys : List RawMolecule.CanonicalBranchKey)
      (locNodes : List (OfficialCIPNode V)),
      RawMolecule.buildCanonicalChildKeys buildChild remaining nodes = some keys →
      List.Forall₂ P nodes locNodes →
      ∃ locKeys : List (OfficialRuleMajorKey V),
        locNodes.mapM buildLoc = some locKeys ∧
        List.Forall₂ ConstitutionalKeyCorresponds keys locKeys := by
  intro nodes
  induction nodes with
  | nil =>
      intro remaining keys locNodes computed hrel
      simp only [RawMolecule.buildCanonicalChildKeys, Option.some.injEq] at computed
      subst keys
      rw [List.forall₂_nil_left_iff] at hrel
      subst locNodes
      exact ⟨[], rfl, List.Forall₂.nil⟩
  | cons node rest ih =>
      intro remaining keys locNodes computed hrel
      obtain ⟨key, tail, hkey, hbudget, htail, rfl⟩ :=
        buildCanonicalChildKeys_cons_data buildChild remaining node rest keys computed
      rcases List.forall₂_cons_left_iff.mp hrel with
        ⟨locHead, locTail, hhead, htailRel, rfl⟩
      obtain ⟨locHeadKey, hlocHead, hheadCorr⟩ := sound remaining node locHead key hhead hkey
      obtain ⟨locTailKeys, hlocTail, htailCorr⟩ :=
        ih (remaining - key.nodeCount) tail locTail htail htailRel
      refine ⟨locHeadKey :: locTailKeys, ?_,
        List.Forall₂.cons hheadCorr htailCorr⟩
      rw [List.mapM_cons]
      simp [hlocHead, hlocTail]

/-- Full correspondence forgets to observable correspondence, pointwise. -/
theorem forall₂_toObservable {V : Type*}
    {raws : List RawMolecule.CanonicalBranchKey}
    {locs : List (OfficialRuleMajorKey V)}
    (h : List.Forall₂ ConstitutionalKeyCorresponds raws locs) :
    List.Forall₂ KeyObservableCorresponds raws locs := by
  induction h with
  | nil => exact List.Forall₂.nil
  | cons hhead htail ih =>
      exact List.Forall₂.cons (constitutionalKeyCorresponds_toObservable hhead) ih

/-! ## Actual constructed transport -/

/-- **Actual constructed raw/localized transport.**  If the production raw compiler
`mol.buildCanonicalBranchKey cap fuel node` succeeds at any node reachable from the center root,
then the actual official compiler
`input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren fuel onode`
succeeds on the corresponding official node, and the two keys carry the same three constitutional
columns and the same completeness flag.

The executable child order is used on the official side throughout; no replacement enumeration is
introduced.  The conclusion is the strongest available under the permutation obstruction: full
`ConstitutionalKeyCorresponds`, hence equality of the constitutional observable, but not equality
of provenance/source records.  Raw compiler success is assumed only as the hypothesis `computed`;
localized success is *derived*. -/
theorem buildCanonicalBranchKey_actualTransport
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (root : RawMolecule.CanonicalBranchNode)
    (rootHist : root.history = [root.atom])
    (rootBound : root.atom < mol.atomCount)
    (gate : NoOxidoRootEdgeAtRootCopies mol root)
    (rootSelf : root = RawLocalizedChildNodeTransport.canonicalSelfParentRoot root.atom)
    (nonMancude : NonMancudeGeneratedDuplicates mol root.atom) :
    ∀ (fuel : ℕ) (node : RawMolecule.CanonicalBranchNode)
        (onode : OfficialCIPNode input.Atom),
      ReachableCanonical mol root node →
      NodeCorresponds (fun atom : input.Atom => atom.val) onode node →
      ∀ (cap : ℕ) (rawKey : RawMolecule.CanonicalBranchKey),
        mol.buildCanonicalBranchKey cap fuel node = some rawKey →
        ∃ locKey,
          input.moleculeGraph.buildOfficialRuleMajorKey
            input.executableOfficialCIPChildren fuel onode = some locKey ∧
          ConstitutionalKeyCorresponds rawKey locKey := by
  have domainOf : ∀ {node : RawMolecule.CanonicalBranchNode},
      ReachableCanonical mol root node → ActualRule1aPlainDomain mol node := by
    intro node reach
    have reach' : ReachableCanonical mol
        (RawLocalizedChildNodeTransport.canonicalSelfParentRoot root.atom) node := by
      rw [← rootSelf]
      exact reach
    exact (TetraStereo.OneCenter.GeneratedExactPlainAtomicLabels.reachable_exact_plain_atomic_labels_selfParentRoot
      mol root.atom nonMancude reach').1
  intro fuel
  induction fuel with
  | zero =>
      intro node onode reach hcorr cap rawKey computed
      have atomBound : node.atom < mol.atomCount :=
        reachable_atom_lt mol root rootHist rootBound wellFormed node reach
      have domain : ActualRule1aPlainDomain mol node := domainOf reach
      obtain ⟨aligned, haligned, hperm⟩ :=
        reachableCIPChildren_forall₂_canonicalChildren mol input agreement wellFormed
          unique supported root rootHist rootBound gate node onode reach hcorr
      have hterm := canonicalTerminal_eq_executableChildren_isEmpty
        mol input hcorr haligned hperm
      rw [buildCanonicalBranchKey_zero_eq] at computed
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed
          change some (mol.canonicalRootKey node (mol.canonicalTerminal node)) =
            some rawKey at computed
          have hraw : rawKey = mol.canonicalRootKey node (mol.canonicalTerminal node) :=
            (Option.some_inj.mp computed).symm
          refine ⟨input.moleculeGraph.officialRuleMajorRootKey onode
            (input.executableOfficialCIPChildren onode).isEmpty, rfl, ?_⟩
          rw [hraw]
          have hcols := canonicalRootKey_columns mol input agreement hcorr atomBound domain
            (mol.canonicalTerminal node) (input.executableOfficialCIPChildren onode).isEmpty
          have hcomplete :
              (mol.canonicalRootKey node (mol.canonicalTerminal node)).complete =
              (input.moleculeGraph.officialRuleMajorRootKey onode
                (input.executableOfficialCIPChildren onode).isEmpty).complete := by
            simpa [RawMolecule.canonicalRootKey, MoleculeGraph.officialRuleMajorRootKey]
              using hterm
          exact hcols.toCorresponds hcomplete
  | succ fuel ih =>
      intro node onode reach hcorr cap rawKey computed
      have atomBound : node.atom < mol.atomCount :=
        reachable_atom_lt mol root rootHist rootBound wellFormed node reach
      have domain : ActualRule1aPlainDomain mol node := domainOf reach
      obtain ⟨aligned, haligned, hperm⟩ :=
        reachableCIPChildren_forall₂_canonicalChildren mol input agreement wellFormed
          unique supported root rootHist rootBound gate node onode reach hcorr
      have hterm := canonicalTerminal_eq_executableChildren_isEmpty
        mol input hcorr haligned hperm
      rw [buildCanonicalBranchKey_succ_bind_eq] at computed
      cases hlabel : mol.canonicalRule1aLabel? node with
      | none => simp [hlabel] at computed
      | some label =>
          rw [hlabel] at computed
          by_cases hterminal : mol.canonicalTerminal node = true
          · rw [hterminal] at computed
            rw [if_pos rfl] at computed
            simp only [Option.some.injEq] at computed
            have hraw : rawKey = mol.canonicalRootKey node true := computed.symm
            have hempty : (input.executableOfficialCIPChildren onode).isEmpty = true := by
              rw [← hterm]
              exact hterminal
            refine ⟨input.moleculeGraph.officialRuleMajorRootKey onode true, ?_, ?_⟩
            · unfold MoleculeGraph.buildOfficialRuleMajorKey
              dsimp only
              simp only [hempty, if_true]
            · rw [hraw]
              exact (canonicalRootKey_columns mol input agreement hcorr atomBound domain
                true true).toCorresponds rfl
          · have hterminalFalse : mol.canonicalTerminal node = false :=
              Bool.eq_false_of_not_eq_true hterminal
            rw [hterminalFalse] at computed
            rw [if_neg (by decide : ¬ (false = true))] at computed
            by_cases hwidth : 3 < (mol.canonicalChildren node).length
            · rw [if_pos hwidth] at computed
              simp at computed
            · rw [if_neg hwidth] at computed
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨childKeys, hchildKeys, computed⟩
              rw [Option.bind_eq_some_iff] at computed
              rcases computed with ⟨sorted, hsorted, computed⟩
              dsimp only at computed
              by_cases hbudget : cap <
                  (RawMolecule.assembleCanonicalBranchKey
                    (mol.canonicalRootKey node (sorted.all fun child => child.complete))
                    sorted).nodeCount
              · simp [hbudget] at computed
              · simp only [hbudget, if_false, Option.some.injEq] at computed
                have hrawEq : rawKey =
                    RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node
                        (sorted.all fun child => child.complete)) sorted := computed.symm
                -- The aligned pairs between the actual executable children and the aligned
                -- canonical list.
                obtain ⟨pairs, hpairsPerm, hpairsSnd⟩ :=
                  exists_perm_map_snd_eq hperm
                    ((input.executableOfficialCIPChildren onode).zip aligned)
                    (List.map_snd_zip (l₁ := input.executableOfficialCIPChildren onode)
                      (l₂ := aligned) (Nat.le_of_eq haligned.length_eq.symm))
                have hpairCorr : ∀ p ∈
                    (input.executableOfficialCIPChildren onode).zip aligned,
                    NodeCorresponds (fun atom : input.Atom => atom.val) p.1 p.2 :=
                  forall₂_zip_mem haligned
                have hpairsCorr : ∀ p ∈ pairs,
                    NodeCorresponds (fun atom : input.Atom => atom.val) p.1 p.2 := by
                  intro p hp
                  exact hpairCorr p ((hpairsPerm.mem_iff).mp hp)
                have hpairsFst : (pairs.map Prod.fst).Perm
                    (input.executableOfficialCIPChildren onode) := by
                  have h := hpairsPerm.map Prod.fst
                  have hfst : ((input.executableOfficialCIPChildren onode).zip aligned).map
                      Prod.fst = input.executableOfficialCIPChildren onode :=
                    List.map_fst_zip (l₁ := input.executableOfficialCIPChildren onode)
                      (l₂ := aligned) (Nat.le_of_eq haligned.length_eq)
                  simpa [hfst] using h
                have hnodesCorr : List.Forall₂
                    (fun child : RawMolecule.CanonicalBranchNode =>
                      fun ochild : OfficialCIPNode input.Atom =>
                        NodeCorresponds (fun atom : input.Atom => atom.val) ochild child ∧
                          child ∈ mol.canonicalChildren node)
                    (mol.canonicalChildren node) (pairs.map Prod.fst) := by
                  have hcore : List.Forall₂
                      (fun child : RawMolecule.CanonicalBranchNode =>
                        fun ochild : OfficialCIPNode input.Atom =>
                          NodeCorresponds (fun atom : input.Atom => atom.val) ochild child)
                      (pairs.map Prod.snd) (pairs.map Prod.fst) :=
                    forall₂_map_snd_map_fst pairs hpairsCorr
                  have hcore' : List.Forall₂
                      (fun child : RawMolecule.CanonicalBranchNode =>
                        fun ochild : OfficialCIPNode input.Atom =>
                          NodeCorresponds (fun atom : input.Atom => atom.val) ochild child)
                      (mol.canonicalChildren node) (pairs.map Prod.fst) := by
                    simpa [hpairsSnd] using hcore
                  exact forall₂_of_zip_mem (mol.canonicalChildren node)
                    (pairs.map Prod.fst)
                    (fun p hp =>
                      ⟨forall₂_zip_mem hcore' p hp, (List.of_mem_zip hp).1⟩)
                    hcore'.length_eq
                have hsound : ∀ (remaining : ℕ) (child : RawMolecule.CanonicalBranchNode)
                    (ochild : OfficialCIPNode input.Atom)
                    (rawChild : RawMolecule.CanonicalBranchKey),
                    (NodeCorresponds (fun atom : input.Atom => atom.val) ochild child ∧
                      child ∈ mol.canonicalChildren node) →
                    mol.buildCanonicalBranchKey remaining fuel child = some rawChild →
                    ∃ locChild,
                      input.moleculeGraph.buildOfficialRuleMajorKey
                        input.executableOfficialCIPChildren fuel ochild = some locChild ∧
                      ConstitutionalKeyCorresponds rawChild locChild := by
                  intro remaining child ochild rawChild hpair hrawChild
                  exact ih child ochild
                    (ReachableCanonical.child node child reach hpair.2) hpair.1
                    remaining rawChild hrawChild
                obtain ⟨locChildKeys, hlocMap, hchildCorr⟩ :=
                  buildCanonicalChildKeys_forall₂_corresponds
                    (fun remaining child =>
                      mol.buildCanonicalBranchKey remaining fuel child)
                    (fun ochild =>
                      input.moleculeGraph.buildOfficialRuleMajorKey
                        input.executableOfficialCIPChildren fuel ochild)
                    (fun child ochild =>
                      NodeCorresponds (fun atom : input.Atom => atom.val) ochild child ∧
                        child ∈ mol.canonicalChildren node)
                    hsound (mol.canonicalChildren node) (cap - 1) childKeys
                    (pairs.map Prod.fst) hchildKeys hnodesCorr
                obtain ⟨locChildKeysExec, hlocMapExec, hlocPerm⟩ :=
                  mapM_perm_of_perm
                    (fun ochild =>
                      input.moleculeGraph.buildOfficialRuleMajorKey
                        input.executableOfficialCIPChildren fuel ochild)
                    hpairsFst hlocMap
                obtain ⟨sortedLocCanonical, hlocSortCanonical, hsortedCorr⟩ :=
                  sortCanonicalKeys?_corresponds childKeys locChildKeys hchildCorr
                    sorted hsorted
                have hlocSortSome :
                    (OfficialRuleMajorKey.sort? locChildKeys).isSome = true := by
                  rw [hlocSortCanonical]
                  rfl
                obtain ⟨sortedLocExec, hlocSortExec⟩ :=
                  exists_sort?_of_perm hlocPerm hlocSortSome
                have hpermSorted : sortedLocCanonical.Perm sortedLocExec :=
                  (OfficialRuleMajorKey.sort?_perm locChildKeys sortedLocCanonical
                    hlocSortCanonical).trans
                    (hlocPerm.trans
                      (OfficialRuleMajorKey.sort?_perm locChildKeysExec sortedLocExec
                        hlocSortExec).symm)
                have hobsPerm :
                    (sortedLocCanonical.map constitutionalObservable).Perm
                      (sortedLocExec.map constitutionalObservable) :=
                  hpermSorted.map constitutionalObservable
                have hdescCanonical :=
                  OfficialRuleMajorKey.sort?_descending locChildKeys sortedLocCanonical
                    hlocSortCanonical
                have hdescExec :=
                  OfficialRuleMajorKey.sort?_descending locChildKeysExec sortedLocExec
                    hlocSortExec
                have hobsEq : sortedLocCanonical.map constitutionalObservable =
                    sortedLocExec.map constitutionalObservable :=
                  constitutional_observables_eq_of_perm sortedLocCanonical sortedLocExec
                    hobsPerm hdescCanonical hdescExec
                -- Root and child columns.
                have hrootPlain : ∀ e,
                    e ∈ (mol.canonicalRootKey node
                      (sorted.all fun child => child.complete)).rule1a.flatten →
                      e.2.denominator = 1 :=
                  canonicalRootKey_plain mol node
                    (sorted.all fun child => child.complete) domain
                have hrootColumns := canonicalRootKey_columns mol input agreement hcorr
                  atomBound domain (sorted.all fun child => child.complete) false
                have hchildrenObs :
                    List.Forall₂ KeyObservableCorresponds sorted sortedLocCanonical :=
                  forall₂_toObservable hsortedCorr
                have hchildrenPlain : ∀ child ∈ sorted,
                    ∀ e, e ∈ child.rule1a.flatten → e.2.denominator = 1 := by
                  intro child hchild e he
                  obtain ⟨locChild, _hlocMem, hcorrChild⟩ :=
                    exists_mem_of_forall₂_left hsortedCorr hchild
                  exact hcorrChild.plain e he
                have hcols : ActualKeyColumnsCorrespond
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node
                        (sorted.all fun child => child.complete)) sorted)
                    (OfficialRuleMajorKey.assemble
                      (input.moleculeGraph.officialRuleMajorRootKey onode false)
                      sortedLocCanonical) :=
                  assemble_columns_of_observable
                    (mol.canonicalRootKey node
                      (sorted.all fun child => child.complete))
                    (input.moleculeGraph.officialRuleMajorRootKey onode false)
                    sorted sortedLocCanonical hrootPlain
                    (columnsCorrespond_toObservable hrootColumns)
                    hchildrenObs hchildrenPlain
                have hcompleteSorted :
                    (sorted.all fun child => child.complete) =
                      (sortedLocCanonical.all fun child => child.complete) :=
                  all_complete_eq_of_forall₂ hsortedCorr
                have hcompleteCanonical :
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node
                        (sorted.all fun child => child.complete)) sorted).complete =
                    (OfficialRuleMajorKey.assemble
                      (input.moleculeGraph.officialRuleMajorRootKey onode false)
                      sortedLocCanonical).complete := by
                  simpa only [RawMolecule.assembleCanonicalBranchKey,
                    OfficialRuleMajorKey.assemble] using hcompleteSorted
                have hcorrCanonical : ConstitutionalKeyCorresponds
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node
                        (sorted.all fun child => child.complete)) sorted)
                    (OfficialRuleMajorKey.assemble
                      (input.moleculeGraph.officialRuleMajorRootKey onode false)
                      sortedLocCanonical) :=
                  hcols.toCorresponds hcompleteCanonical
                have hobsAssembly :
                    constitutionalObservable
                      (OfficialRuleMajorKey.assemble
                        (input.moleculeGraph.officialRuleMajorRootKey onode false)
                        sortedLocCanonical) =
                    constitutionalObservable
                      (OfficialRuleMajorKey.assemble
                        (input.moleculeGraph.officialRuleMajorRootKey onode false)
                        sortedLocExec) :=
                  assembled_constitutional_observable_eq
                    (input.moleculeGraph.officialRuleMajorRootKey onode false)
                    sortedLocCanonical sortedLocExec hobsEq
                have hcompleteFinal :
                    (RawMolecule.assembleCanonicalBranchKey
                      (mol.canonicalRootKey node
                        (sorted.all fun child => child.complete)) sorted).complete =
                    (OfficialRuleMajorKey.assemble
                      (input.moleculeGraph.officialRuleMajorRootKey onode false)
                      sortedLocExec).complete := by
                  simp only [RawMolecule.assembleCanonicalBranchKey,
                    OfficialRuleMajorKey.assemble]
                  exact hcompleteSorted.trans
                    (all_eq_of_perm (fun key => key.complete) hpermSorted)
                -- The official compiler result on the actual executable enumeration.
                refine ⟨OfficialRuleMajorKey.assemble
                  (input.moleculeGraph.officialRuleMajorRootKey onode false)
                  sortedLocExec, ?_, ?_⟩
                · unfold MoleculeGraph.buildOfficialRuleMajorKey
                  dsimp only
                  have hemptyFalse :
                      (input.executableOfficialCIPChildren onode).isEmpty = false := by
                    rw [← hterm]
                    exact hterminalFalse
                  simp only [hemptyFalse, Bool.false_eq_true, if_false]
                  change Option.bind
                    ((input.executableOfficialCIPChildren onode).mapM
                      (input.moleculeGraph.buildOfficialRuleMajorKey
                        input.executableOfficialCIPChildren fuel))
                    (fun childKeys =>
