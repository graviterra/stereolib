import TetraStereo.OneCenter.IR9TransBicappedOctahedron8SpatialPerception

set_option autoImplicit false

namespace TetraStereo.OneCenter.RedBookIR9.TransBicappedOctahedron8ExecutableSpatialPerception

namespace Semantic

abbrev Frame := TransBicappedOctahedron8SpatialPerception.Frame
abbrev Position := TransBicappedOctahedron8SpatialPerception.Position
abbrev Placement := TransBicappedOctahedron8SpatialPerception.Placement
abbrev CentralOpposite := TransBicappedOctahedron8SpatialPerception.CentralOpposite
abbrev CapOnPositiveFaceCentroidRay :=
  TransBicappedOctahedron8SpatialPerception.CapOnPositiveFaceCentroidRay
abbrev IsExactPlacement := TransBicappedOctahedron8SpatialPerception.IsExactPlacement
abbrev Refused := TransBicappedOctahedron8SpatialPerception.Refused
noncomputable abbrev recognize? := TransBicappedOctahedron8SpatialPerception.recognize?

end Semantic

abbrev Frame := Semantic.Frame
abbrev Position := Semantic.Position

/-!
# Executable exact coordinate perception for OCT-8

The semantic OCT-8 recognizer quantifies over the finite type of eight-role bijections, whose list
ordering is classical.  Here a production placement is instead an explicit permutation of
`List.finRange 8`.  All `8!` lists are generated by `List.permutations`, and geometry is evaluated
by direct list indexing.  A proof-only equivalence connects each list placement to the independent
semantic role bijection and establishes exact success and refusal conformance.
-/

/-! ## Explicit role/index equivalence -/

def positionIndex : Position → Fin 8
  | .cap 0 => 0
  | .cap 1 => 1
  | .baseVertex 0 0 => 2
  | .baseVertex 1 0 => 3
  | .baseVertex 0 1 => 4
  | .baseVertex 1 1 => 5
  | .baseVertex 0 2 => 6
  | .baseVertex 1 2 => 7

def positionOfIndex : Fin 8 → Position
  | 0 => .cap 0
  | 1 => .cap 1
  | 2 => .baseVertex 0 0
  | 3 => .baseVertex 1 0
  | 4 => .baseVertex 0 1
  | 5 => .baseVertex 1 1
  | 6 => .baseVertex 0 2
  | 7 => .baseVertex 1 2

def positionIndexEquiv : Position ≃ Fin 8 where
  toFun := positionIndex
  invFun := positionOfIndex
  left_inv := by
    intro position
    cases position with
    | cap side => fin_cases side <;> rfl
    | baseVertex side pair => fin_cases side <;> fin_cases pair <;> rfl
  right_inv := by
    intro index
    fin_cases index <;> rfl

theorem positionIndexEquiv_bijective : Function.Bijective positionIndexEquiv :=
  positionIndexEquiv.bijective

/-! ## Computable `8!` placement enumeration -/

/-- A production placement is a concrete list containing every donor index exactly once. -/
structure ExecutablePlacement where
  values : List (Fin 8)
  permutation : values.Perm (List.finRange 8)

@[ext] theorem ExecutablePlacement.ext
    {left right : ExecutablePlacement} (same : left.values = right.values) : left = right := by
  cases left
  cases right
  cases same
  rfl

instance : DecidableEq ExecutablePlacement := fun left right =>
  if same : left.values = right.values then
    isTrue (ExecutablePlacement.ext same)
  else
    isFalse (fun equal => same (congrArg ExecutablePlacement.values equal))

/-- Every explicit permutation, with its membership proof attached and erased by code generation. -/
def allExecutablePlacements : List ExecutablePlacement :=
  (List.finRange 8).permutations.attach.map fun entry =>
    { values := entry.1
      permutation := List.mem_permutations.mp entry.2 }

theorem allExecutablePlacements_nodup : allExecutablePlacements.Nodup := by
  unfold allExecutablePlacements
  apply List.Nodup.map
  · intro left right same
    apply Subtype.ext
    exact congrArg ExecutablePlacement.values same
  · exact (List.nodup_permutations _ (List.nodup_finRange 8)).attach

@[simp] theorem mem_allExecutablePlacements (placement : ExecutablePlacement) :
    placement ∈ allExecutablePlacements := by
  unfold allExecutablePlacements
  rw [List.mem_map]
  let entry : { values // values ∈ (List.finRange 8).permutations } :=
    ⟨placement.values, List.mem_permutations.mpr placement.permutation⟩
  refine ⟨entry, by simp [entry], ?_⟩
  apply ExecutablePlacement.ext
  rfl

namespace ExecutablePlacement

theorem length_eq (placement : ExecutablePlacement) : placement.values.length = 8 := by
  simpa using placement.permutation.length_eq

theorem values_nodup (placement : ExecutablePlacement) : placement.values.Nodup :=
  placement.permutation.nodup_iff.mpr (List.nodup_finRange 8)

/-- Value occupying one fixed role-index slot. -/
def valueAt (placement : ExecutablePlacement) (index : Fin 8) : Fin 8 := by
  exact placement.values[index.val]'(by simp [placement.length_eq, index.isLt])

/-- Donor index occupying one independent structural role. -/
def donorIndexAt (placement : ExecutablePlacement) (position : Position) : Fin 8 :=
  placement.valueAt (positionIndexEquiv position)

/-- Exact coordinate occupying one structural role. -/
def pointAt (placement : ExecutablePlacement) (frame : Frame)
    (position : Position) : CartesianPoint3 :=
  frame.donorAt (placement.donorIndexAt position)

/-- The directly indexed OC-6 base frame. -/
def baseOctahedron (placement : ExecutablePlacement) (frame : Frame) :
    OctahedronSpatialPerception.Frame :=
  { center := frame.center
    donor0 := placement.pointAt frame (.baseVertex 0 0)
    donor1 := placement.pointAt frame (.baseVertex 1 0)
    donor2 := placement.pointAt frame (.baseVertex 0 1)
    donor3 := placement.pointAt frame (.baseVertex 1 1)
    donor4 := placement.pointAt frame (.baseVertex 0 2)
    donor5 := placement.pointAt frame (.baseVertex 1 2) }

/-- The list permutation as a proof-only group permutation. -/
noncomputable def indexPermutation (placement : ExecutablePlacement) : Equiv.Perm (Fin 8) :=
  Equiv.ofBijective placement.valueAt
    ((Fintype.bijective_iff_injective_and_card placement.valueAt).mpr ⟨by
      intro left right same
      apply Fin.ext
      apply placement.values_nodup.getElem_inj_iff.mp
      exact same
    , rfl⟩)

@[simp] theorem indexPermutation_apply
    (placement : ExecutablePlacement) (index : Fin 8) :
    placement.indexPermutation index = placement.valueAt index := rfl

/-- Corresponding independent semantic role bijection. -/
noncomputable def semanticPlacement (placement : ExecutablePlacement) : Semantic.Placement :=
  positionIndexEquiv.trans placement.indexPermutation

@[simp] theorem semanticPlacement_apply
    (placement : ExecutablePlacement) (position : Position) :
    placement.semanticPlacement position = placement.donorIndexAt position := rfl

@[simp] theorem semantic_pointAt_eq
    (placement : ExecutablePlacement) (frame : Frame) (position : Position) :
    frame.pointAt placement.semanticPlacement position = placement.pointAt frame position := rfl

@[simp] theorem semantic_baseOctahedron_eq
    (placement : ExecutablePlacement) (frame : Frame) :
    frame.baseOctahedron placement.semanticPlacement = placement.baseOctahedron frame := rfl

end ExecutablePlacement

/-! ## Direct executable geometry judgment -/

/-- The eight unordered input points are pairwise distinct. -/
def DonorPointsDistinct (frame : Frame) : Prop :=
  ((List.finRange 8).map frame.donorAt).Nodup

instance donorPointsDistinctDecidable (frame : Frame) :
    Decidable (DonorPointsDistinct frame) := by
  unfold DonorPointsDistinct
  infer_instance

def donorPointsDistinct? (frame : Frame) : Bool :=
  decide (DonorPointsDistinct frame)

@[simp] theorem donorPointsDistinct?_eq_true_iff (frame : Frame) :
    donorPointsDistinct? frame = true ↔ DonorPointsDistinct frame := by
  simp [donorPointsDistinct?]

theorem donorPointsDistinct_iff_donorAt_injective (frame : Frame) :
    DonorPointsDistinct frame ↔ Function.Injective frame.donorAt := by
  rw [DonorPointsDistinct,
    List.nodup_map_iff_inj_on (List.nodup_finRange 8)]
  constructor
  · intro injectiveOn left right same
    exact injectiveOn left (by simp) right (by simp) same
  · intro injective _left _leftPresent _right _rightPresent same
    exact injective same

def centralOpposite?
    (center left right : CartesianPoint3) : Bool :=
  decide (Semantic.CentralOpposite center left right)

@[simp] theorem centralOpposite?_eq_true_iff
    (center left right : CartesianPoint3) :
    centralOpposite? center left right = true ↔
      Semantic.CentralOpposite center left right := by
  simp [centralOpposite?]

def capOnPositiveFaceCentroidRay?
    (center cap first second third : CartesianPoint3) : Bool :=
  decide (Semantic.CapOnPositiveFaceCentroidRay center cap first second third)

@[simp] theorem capOnPositiveFaceCentroidRay?_eq_true_iff
    (center cap first second third : CartesianPoint3) :
    capOnPositiveFaceCentroidRay? center cap first second third = true ↔
      Semantic.CapOnPositiveFaceCentroidRay center cap first second third := by
  simp [capOnPositiveFaceCentroidRay?]

def pairPositions : List (Fin 3) := [0, 1, 2]

@[simp] theorem mem_pairPositions (pair : Fin 3) : pair ∈ pairPositions := by
  fin_cases pair <;> simp [pairPositions]

/-- Independent direct-list form of the exact OCT-8 placement judgment. -/
def IsExactExecutablePlacement
    (frame : Frame) (placement : ExecutablePlacement) : Prop :=
  DonorPointsDistinct frame ∧
    OctahedronSpatialPerception.IsExactOctahedron (placement.baseOctahedron frame) ∧
    Semantic.CentralOpposite frame.center
      (placement.pointAt frame (.cap 0))
      (placement.pointAt frame (.cap 1)) ∧
    (∀ pair : Fin 3,
      Semantic.CentralOpposite frame.center
        (placement.pointAt frame (.baseVertex 0 pair))
        (placement.pointAt frame (.baseVertex 1 pair))) ∧
    Semantic.CapOnPositiveFaceCentroidRay frame.center
      (placement.pointAt frame (.cap 0))
      (placement.pointAt frame (.baseVertex 0 0))
      (placement.pointAt frame (.baseVertex 0 1))
      (placement.pointAt frame (.baseVertex 0 2)) ∧
    Semantic.CapOnPositiveFaceCentroidRay frame.center
      (placement.pointAt frame (.cap 1))
      (placement.pointAt frame (.baseVertex 1 0))
      (placement.pointAt frame (.baseVertex 1 1))
      (placement.pointAt frame (.baseVertex 1 2))

/-- Fully executable direct-list placement check. -/
def placementJudgment? (frame : Frame) (placement : ExecutablePlacement) : Bool :=
  donorPointsDistinct? frame &&
    OctahedronSpatialPerception.recognize? (placement.baseOctahedron frame) &&
    centralOpposite? frame.center
      (placement.pointAt frame (.cap 0))
      (placement.pointAt frame (.cap 1)) &&
    (pairPositions.all fun pair =>
      centralOpposite? frame.center
        (placement.pointAt frame (.baseVertex 0 pair))
        (placement.pointAt frame (.baseVertex 1 pair))) &&
    capOnPositiveFaceCentroidRay? frame.center
      (placement.pointAt frame (.cap 0))
      (placement.pointAt frame (.baseVertex 0 0))
      (placement.pointAt frame (.baseVertex 0 1))
      (placement.pointAt frame (.baseVertex 0 2)) &&
    capOnPositiveFaceCentroidRay? frame.center
      (placement.pointAt frame (.cap 1))
      (placement.pointAt frame (.baseVertex 1 0))
      (placement.pointAt frame (.baseVertex 1 1))
      (placement.pointAt frame (.baseVertex 1 2))

@[simp] theorem placementJudgment?_eq_true_iff
    (frame : Frame) (placement : ExecutablePlacement) :
    placementJudgment? frame placement = true ↔
      IsExactExecutablePlacement frame placement := by
  simp only [placementJudgment?, Bool.and_eq_true,
    donorPointsDistinct?_eq_true_iff,
    centralOpposite?_eq_true_iff,
    capOnPositiveFaceCentroidRay?_eq_true_iff,
    OctahedronSpatialPerception.recognize?_eq_true_iff,
    List.all_eq_true, IsExactExecutablePlacement]
  constructor <;> aesop

/-! ## Exact executable/semantic conformance -/

theorem exactExecutablePlacement_iff_semantic
    (frame : Frame) (placement : ExecutablePlacement) :
    IsExactExecutablePlacement frame placement ↔
      Semantic.IsExactPlacement frame placement.semanticPlacement := by
  rw [IsExactExecutablePlacement, Semantic.IsExactPlacement]
  constructor
  · rintro ⟨pointsDistinct, base, caps, pairs, cap0, cap1⟩
    have donorInjective :=
      (donorPointsDistinct_iff_donorAt_injective frame).mp pointsDistinct
    refine ⟨donorInjective.comp placement.semanticPlacement.injective,
      by simpa using base, by simpa using caps, ?_, by simpa using cap0,
      by simpa using cap1⟩
    intro pair
    simpa using pairs pair
  · rintro ⟨pointInjective, base, caps, pairs, cap0, cap1⟩
    have donorInjective : Function.Injective frame.donorAt := by
      intro left right same
      have positionSame : placement.semanticPlacement.symm left =
          placement.semanticPlacement.symm right :=
        pointInjective (by
          simp [TransBicappedOctahedron8SpatialPerception.Frame.pointAt, same])
      have indexSame := congrArg placement.semanticPlacement positionSame
      simpa using indexSame
    refine ⟨(donorPointsDistinct_iff_donorAt_injective frame).mpr donorInjective,
      by simpa using base, by simpa using caps, ?_, by simpa using cap0,
      by simpa using cap1⟩
    intro pair
    simpa using pairs pair

/-- Executable placements accepted by the direct Boolean. -/
def recognizedExecutablePlacements (frame : Frame) : List ExecutablePlacement :=
  allExecutablePlacements.filter (placementJudgment? frame)

@[simp] theorem mem_recognizedExecutablePlacements_iff
    (frame : Frame) (placement : ExecutablePlacement) :
    placement ∈ recognizedExecutablePlacements frame ↔
      IsExactExecutablePlacement frame placement := by
  simp [recognizedExecutablePlacements]

theorem recognizedExecutablePlacements_nodup (frame : Frame) :
    (recognizedExecutablePlacements frame).Nodup :=
  allExecutablePlacements_nodup.filter _

/-- Executable whole-frame OCT-8 recognition. -/
def recognize? (frame : Frame) : Bool :=
  allExecutablePlacements.any (placementJudgment? frame)

theorem recognize?_eq_true_iff_executable (frame : Frame) :
    recognize? frame = true ↔
      ∃ placement, IsExactExecutablePlacement frame placement := by
  simp [recognize?, List.any_eq_true]

/-! ## Surjectivity back to every semantic role bijection -/

def semanticIndexPermutation (placement : Semantic.Placement) : Equiv.Perm (Fin 8) :=
  positionIndexEquiv.symm.trans placement

def executableOfSemantic (placement : Semantic.Placement) : ExecutablePlacement :=
  { values := List.ofFn (semanticIndexPermutation placement)
    permutation := by
      simpa [List.ofFn_eq_map, Function.comp_def] using
        (semanticIndexPermutation placement).ofFn_comp_perm
          (f := fun index : Fin 8 => index) }

@[simp] theorem executableOfSemantic_values
    (placement : Semantic.Placement) :
    (executableOfSemantic placement).values =
      List.ofFn (semanticIndexPermutation placement) := rfl

theorem semanticPlacement_executableOfSemantic
    (placement : Semantic.Placement) :
    (executableOfSemantic placement).semanticPlacement = placement := by
  apply Equiv.ext
  intro position
  cases position with
  | cap side =>
      fin_cases side <;>
        simp [ExecutablePlacement.semanticPlacement,
          ExecutablePlacement.indexPermutation, ExecutablePlacement.valueAt,
          executableOfSemantic, semanticIndexPermutation, positionIndexEquiv,
          positionIndex, positionOfIndex]
  | baseVertex side pair =>
      fin_cases side <;> fin_cases pair <;>
        simp [ExecutablePlacement.semanticPlacement,
          ExecutablePlacement.indexPermutation, ExecutablePlacement.valueAt,
          executableOfSemantic, semanticIndexPermutation, positionIndexEquiv,
          positionIndex, positionOfIndex]

theorem recognize?_eq_true_iff_semantic (frame : Frame) :
    recognize? frame = true ↔
      ∃ placement : Semantic.Placement, Semantic.IsExactPlacement frame placement := by
  rw [recognize?_eq_true_iff_executable]
  constructor
  · rintro ⟨placement, exact⟩
    exact ⟨placement.semanticPlacement,
      (exactExecutablePlacement_iff_semantic frame placement).mp exact⟩
  · rintro ⟨placement, exact⟩
    let executable := executableOfSemantic placement
    refine ⟨executable,
      (exactExecutablePlacement_iff_semantic frame executable).mpr ?_⟩
    simpa [executable, semanticPlacement_executableOfSemantic] using exact

theorem recognize?_eq_false_iff_semanticRefusal (frame : Frame) :
    recognize? frame = false ↔ Semantic.Refused frame := by
  constructor
  · intro rejected placement exact
    have accepted := (recognize?_eq_true_iff_semantic frame).mpr ⟨placement, exact⟩
    simp [rejected] at accepted
  · intro refusal
    apply Bool.eq_false_iff.mpr
    intro accepted
    rcases (recognize?_eq_true_iff_semantic frame).mp accepted with
      ⟨placement, exact⟩
    exact refusal placement exact

/-- The production Boolean and independent semantic Boolean accept exactly the same frames. -/
theorem executable_recognizer_conforms_semantic (frame : Frame) :
    recognize? frame = true ↔ Semantic.recognize? frame = true :=
  (recognize?_eq_true_iff_semantic frame).trans
    (TransBicappedOctahedron8SpatialPerception.recognize?_eq_true_iff_exists_placement
      frame).symm

end TetraStereo.OneCenter.RedBookIR9.TransBicappedOctahedron8ExecutableSpatialPerception
