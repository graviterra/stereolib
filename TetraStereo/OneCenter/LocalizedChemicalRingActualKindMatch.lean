import TetraStereo.OneCenter.LocalizedChemicalRingPromotedKindReadback
import TetraStereo.KernelOnly

set_option autoImplicit false
set_option maxHeartbeats 2000000

/-!
# Actual key ties derive matching node kinds

An actual refined-key tie constructs a common pair of promoted addressings preserving the
constitutional observations, reference marker, occupied positions, and stereogenic kind jointly.
No kind correspondence or canonicality is assumed. The auxiliary state is arbitrary, so this
also applies when it is the state actually generated by the evaluator.

The result distinguishes absence, uppercase, and lowercase labels. Equality of their absolute
senses and a compatible molecular automorphism remain separate obligations.
-/

namespace TetraStereo.OneCenter.LocalizedChemicalRingActualKindMatch

open CertifiedLocalizedCIPInput DeclarativeCIP RootedDigraph Rule4aTableBridge
open LocalizedCumulativeDecoratedTree LocalizedMarkedRetainedCanonicalFrame
open LocalizedMarkedRetainedCanonicalMarker LocalizedMarkedRetainedMolecularSelection
open LocalizedMarkedRetainedOrdinaryRanking LocalizedMarkedRetainedPromotedRanking
open LocalizedMarkedRetainedStateReader LocalizedChemicalRingPromotedColorReadback
open LocalizedChemicalRingPromotedConstitutionReadback LocalizedChemicalRingPromotedStereoReadback
open LocalizedChemicalRingPromotedKindReadback RetainedContextStereoReadback

noncomputable section
open scoped Classical

variable (input : CertifiedLocalizedCIPInput) (single : input.moleculeGraph.SimpleBonded)
  (state : OccurrenceAuxState) (target : input.LocalizedCIPOccurrence (retainedCarrierFuel input))
  (real : target.1.node.provenance = OfficialCIPNodeProvenance.realAtom)
  (unit : DetectedOccurrence input.moleculeGraph) (targetUnit : input.molecularFrameUnit target.1 = unit.1)
  (reference : input.Atom) (W D : Nat) (fallback : CompleteLigandRule5Key)

theorem actual_tie_joint_kind_readback (left right : Fin 4)
    (widthL : ∀ node, ((ruleMajorTreeGraph (slotTree input single state target real unit targetUnit left)).childList node).length ≤ W)
    (heightL : (ruleMajorTreeGraph (slotTree input single state target real unit targetUnit left)).height ≤ D)
    (widthR : ∀ node, ((ruleMajorTreeGraph (slotTree input single state target real unit targetUnit right)).childList node).length ≤ W)
    (heightR : (ruleMajorTreeGraph (slotTree input single state target real unit targetUnit right)).height ≤ D)
    (tie : refinedKey input single state target real unit targetUnit reference W D left =
      refinedKey input single state target real unit targetUnit reference W D right) :
    let treeL := slotTree input single state target real unit targetUnit left
    let treeR := slotTree input single state target real unit targetUnit right
    ∃ matched : MatchedMarkerAddressings (ruleMajorTreeGraph treeL) (ruleMajorTreeGraph treeR)
        (deepPrior (rawStateDescriptorMap input state) target fallback treeL)
        (deepPrior (rawStateDescriptorMap input state) target fallback treeR)
        (referenceMark input reference treeL) (referenceMark input reference treeR) W D,
      (∀ rule position, observationAt (ruleMajorTreeGraph treeL) (observe treeL)
          matched.leftAddressing rule position =
        observationAt (ruleMajorTreeGraph treeR) (observe treeR) matched.rightAddressing rule position) ∧
      (∀ position, (∃ node, matched.leftAddressing.address node = position) ↔
        (∃ node, matched.rightAddressing.address node = position)) ∧
      (∀ position, stereoAt (ruleMajorTreeGraph treeL)
          (retainedRankEvidence input.moleculeGraph (rawStateDescriptorMap input state) unit.1
            (ruleMajorTreeGraph treeL)) matched.leftAddressing .rule4aStereogenicUnitKind position =
        stereoAt (ruleMajorTreeGraph treeR)
          (retainedRankEvidence input.moleculeGraph (rawStateDescriptorMap input state) unit.1
            (ruleMajorTreeGraph treeR)) matched.rightAddressing .rule4aStereogenicUnitKind position) := by
  dsimp only
  obtain ⟨matched, constitution, occupied⟩ := actual_tie_joint_readback input single state target real
    unit targetUnit reference W D fallback left right widthL heightL widthR heightR tie
  refine ⟨matched, constitution, occupied, ?_⟩
  let frame := frames input single state target real unit targetUnit
  have rootChild (slot : Fin 4) : (frame.stages slot).a.tree.source ∈
      input.executableLocalizedRerootChildren ⟨target, none⟩ := by
    rw [(frame.stages slot).a.sourceEq]
    exact frame.childAt slot
  let cW := max (ruleMajorTreeGraph (frame.stages left).a.tree).width
    (ruleMajorTreeGraph (frame.stages right).a.tree).width
  let cD := max (ruleMajorTreeGraph (frame.stages left).a.tree).height
    (ruleMajorTreeGraph (frame.stages right).a.tree).height
  have wL : (ruleMajorTreeGraph (frame.stages left).a.tree).width ≤ cW := le_max_left _ _
  have wR : (ruleMajorTreeGraph (frame.stages right).a.tree).width ≤ cW := le_max_right _ _
  have dL : (ruleMajorTreeGraph (frame.stages left).a.tree).height ≤ cD := le_max_left _ _
  have dR : (ruleMajorTreeGraph (frame.stages right).a.tree).height ≤ cD := le_max_right _ _
  have sortedL := promoted_rule4a_sorted (rawStateDescriptorMap input state) target unit.1 targetUnit
    fallback (frame.stages left).a.trace (rawStateDescriptorMap_tetrahedral input state) single
    (rootChild left) cW cD wL dL reference W D matched.leftCanonical
  have sortedR := promoted_rule4a_sorted (rawStateDescriptorMap input state) target unit.1 targetUnit
    fallback (frame.stages right).a.trace (rawStateDescriptorMap_tetrahedral input state) single
    (rootChild right) cW cD wR dR reference W D matched.rightCanonical
  have ordinary : frame.retainedKeys unit left = frame.retainedKeys unit right :=
    congrArg (fun value : RefinedKey => (ofLex value).1) tie
  have keys := frame_rule4a_component_eq (rawStateDescriptorMap input state) target frame
    (rawStateDescriptorMap_tetrahedral input state) single unit targetUnit left right cW cD wL dL wR dR ordinary
  exact stereoAt_eq_of_component_eq (ruleMajorTreeGraph (frame.stages left).a.tree)
    (observe (frame.stages left).a.tree) _ (ruleMajorTreeGraph (frame.stages right).a.tree)
    (observe (frame.stages right).a.tree) _ cW cD wL dL wR dR matched.leftAddressing
    matched.rightAddressing matched.leftCanonical.1 matched.rightCanonical.1 sortedL sortedR
    .rule4aStereogenicUnitKind keys

section Decode

variable {input}

theorem kind_evidence_eq_actual {carrierFuel : Nat}
    (tree : LocalizedCumulativeDecoratedTree input carrierFuel)
    (descriptorMap : DescriptorMap (DetectedOccurrence input.moleculeGraph))
    (unit : OccurrenceUnit input.Atom) (hyp : RetainedContextTreeRankReadback tree descriptorMap unit)
    (node : (ruleMajorTreeGraph tree).Node)
    (actual : LocalizedCumulativeDecoratedTree input carrierFuel)
    (lookup : subtreeAt? tree node.1 = some actual) :
    stereoLabel (ruleMajorTreeGraph tree)
        (retainedRankEvidence input.moleculeGraph descriptorMap unit (ruleMajorTreeGraph tree))
        .rule4aStereogenicUnitKind node =
      ((code (localizedRule4aPriority actual.label) : StereoCode) : StereoLabel) := by
  cases hyp.nodeStatus node with
  | realAvailable real available =>
      rw [stereoLabel_retainedRankEvidence_rule4a_real_available descriptorMap unit _ node real available,
        ← kindPriority_eq_runtime _ (hyp.tetrahedral node), ← hyp.label node actual lookup]
  | ringDuplicate distance duplicate unavailable noneLabel =>
      rw [stereoLabel_retainedRankEvidence_rule4a_ringDuplicate_eq_code descriptorMap unit _ node distance duplicate,
        hyp.label node actual lookup, noneLabel]
      rfl

/-- At occupied corresponding nodes the equal key observations are the actual label kinds. -/
theorem same_kind_of_same_address {carrierFuel : Nat}
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (descriptorMap : DescriptorMap (DetectedOccurrence input.moleculeGraph))
    (unit : OccurrenceUnit input.Atom)
    (hypL : RetainedContextTreeRankReadback left descriptorMap unit)
    (hypR : RetainedContextTreeRankReadback right descriptorMap unit)
    (addrL : (ruleMajorTreeGraph left).Addressing) (addrR : (ruleMajorTreeGraph right).Addressing)
    (same : ∀ position, stereoAt (ruleMajorTreeGraph left)
        (retainedRankEvidence input.moleculeGraph descriptorMap unit (ruleMajorTreeGraph left))
        addrL .rule4aStereogenicUnitKind position =
      stereoAt (ruleMajorTreeGraph right)
        (retainedRankEvidence input.moleculeGraph descriptorMap unit (ruleMajorTreeGraph right))
        addrR .rule4aStereogenicUnitKind position)
    (l : (ruleMajorTreeGraph left).Node) (r : (ruleMajorTreeGraph right).Node)
    (address : addrL.address l = addrR.address r)
    (subL subR : LocalizedCumulativeDecoratedTree input carrierFuel)
    (lookupL : subtreeAt? left l.1 = some subL) (lookupR : subtreeAt? right r.1 = some subR) :
    localizedRule4aPriority subL.label = localizedRule4aPriority subR.label := by
  have h := same (addrL.address l)
  rw [stereoAt_of_address, address, stereoAt_of_address] at h
  have inner := WithBot.coe_injective h
  rw [kind_evidence_eq_actual left descriptorMap unit hypL l subL lookupL,
    kind_evidence_eq_actual right descriptorMap unit hypR r subR lookupR] at inner
  exact code_injective (WithBot.coe_injective inner)

end Decode
end
end TetraStereo.OneCenter.LocalizedChemicalRingActualKindMatch

assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingActualKindMatch.actual_tie_joint_kind_readback
assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingActualKindMatch.kind_evidence_eq_actual
assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingActualKindMatch.same_kind_of_same_address
