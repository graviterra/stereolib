@[simp] theorem imageArtifactsChunk6_length : imageArtifactsChunk6.length = 50 := by rfl

def imageArtifactPathsChunk6 : List String :=
  imageArtifactsChunk6.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk6_isChain :
    imageArtifactPathsChunk6.IsChain (· < ·) := by decide

theorem imageArtifactsChunk6_transcribedCount :
    (imageArtifactsChunk6.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk6_transcribedTemplatesWellFormed :
    (imageArtifactsChunk6.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk6_genericAndErratumTranscribed :
    (imageArtifactsChunk6.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk6_kindCounts :
    (imageArtifactsChunk6.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk6.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk6.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk6.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk6_chemicalPartitionCounts :
    (imageArtifactsChunk6.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk6.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk6_graphAuditMaturityCounts :
    (imageArtifactsChunk6.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk6.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk6.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

