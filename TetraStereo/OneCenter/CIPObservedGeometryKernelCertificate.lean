import TetraStereo.OneCenter.CIPObservedGeometryAssignmentConformance
import TetraStereo.KernelOnly

set_option autoImplicit false

/-!
# Kernel-only certificate for observed-geometry descriptor ingress

This certificate covers every assignment emitted by the certified graph-plus-observed-geometry
entry point.  It proves the conversion from supplied orientation/recognition evidence to public
descriptors; it does not assert that an external coordinate or drawing importer observed the
physical geometry correctly.
-/

assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.atomFin?_isSome_iff
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.atomFin?_eq_some_bound
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.atomFinList?_eq_some_all_in_range

assert_kernel_only TetraStereo.OneCenter.IndexedPlanarGeometryObservation.assignmentOfSense_positive_ne_negative
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.planarGeometryObservationAssignment?_withSense_isSome
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.planarGeometryObservationAssignment?_opposite_raw_senses

assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.axialGeometryObservationAssignment?_sound_P92
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.planarGeometryObservationAssignment?_sound_P92
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.helicalGeometryObservationAssignment?_sound_P92
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.polyhedralGeometryObservationAssignment?_sound_judgment

assert_kernel_only TetraStereo.OneCenter.conflictFreeGeometryAssignments_member_source
assert_kernel_only TetraStereo.OneCenter.mem_eraseDups_iff_mem_lawful
assert_kernel_only TetraStereo.OneCenter.eraseDups_nodup_lawful
assert_kernel_only TetraStereo.OneCenter.mem_conflictFreeGeometryAssignments_iff
assert_kernel_only TetraStereo.OneCenter.conflictFreeGeometryAssignments_nodup
assert_kernel_only TetraStereo.OneCenter.observedGeometryAssignments_member_judged
assert_kernel_only TetraStereo.OneCenter.analyzeCertifiedNormalizedWithObservedGeometry_member_judged
