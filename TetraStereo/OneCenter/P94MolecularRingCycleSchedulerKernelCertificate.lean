import TetraStereo.OneCenter.P94MolecularRingCycleScheduler
import TetraStereo.KernelOnly

set_option autoImplicit false

/-!
# Kernel-only certificate: automatic molecular P-94 ring-carrier scheduling

This certificate fixes the proof boundary that replaces caller-supplied ordered ring traversals.
The scheduler exhausts every bounded finite traversal, accepts exactly independently specified
chordless molecular cycles of a P-94-supported size, and retains a unique representative of each
rotation/reversal class.  Its scope is deliberately basis-neutral: in fused or bridged systems it
schedules every chordless induced cycle and does not claim that such cycles constitute an IUPAC
smallest-ring basis.
-/

assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.mem_boundedNodupTraversals_iff
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.independentP94RingTraversals_dihedrallyRelated
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.exists_canonicalP94RingTraversal_dihedrallyRelated
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.existsUnique_canonicalP94RingTraversal_dihedralClass
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.mem_p94MolecularRingCycleScheduler_iff
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.p94MolecularRingCycleScheduler_toList_nodup
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_member_cycleCarrier
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_member_validFor
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_member_supported_length
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_same_carrier_unique
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_rotation_reversal_unique
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.existsUnique_scheduler_unit_dihedralClass
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduler_complete_iff_declarativeCarrier
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.mem_scheduledAutomaticCoordinateRingInputs_iff
assert_kernel_only TetraStereo.OneCenter.P94MolecularRingCycleScheduler.scheduledAutomaticCoordinateRingInputs_toList_nodup
