import TetraStereo.OneCenter.P93MolecularFullereneAddendEvidence
import TetraStereo.OneCenter.P93MolecularFullereneDerivativeAssembler
import TetraStereo.OneCenter.P93MolecularFullereneRelationalSymmetry

set_option autoImplicit false

/-!
# Local-template compiler for fullerene derivative addends

Concrete derivative rows should not hand-number every external atom.  This module gives each
addend a local graph (`0 .. atomCount - 1`) and Fin-indexed attachment ports, then compiles a list
of placed templates by prefix sums.  Cage atom indices remain fixed and every external interval is
generated by the compiler.
-/

namespace TetraStereo.OneCenter
namespace BlueBookP93.Cyclic

noncomputable section

/-- One attachment port of a local addend graph.  The endpoint is bounded by construction. -/
structure MolecularFullereneLocalAddendPort (externalAtomCount : Nat) where
  externalAtom : Fin externalAtomCount
  bondKind : ParsedBondKind
  deriving DecidableEq

/-- A reusable constitutional addend graph.  `internalBonds` use local external-atom indices. -/
structure MolecularFullereneLocalAddendTemplate where
  externalAtoms : List AtomSpec
  internalBonds : List RawBond
  portCount : Nat
  port : Fin portCount → MolecularFullereneLocalAddendPort externalAtoms.length
  identityClass : Nat
  intrinsicallyChiral : Bool

namespace MolecularFullereneLocalAddendTemplate

/-- The raw local graph used by the connectedness judgment. -/
def localMolecule (template : MolecularFullereneLocalAddendTemplate) : RawMolecule where
  atoms := template.externalAtoms
  bonds := template.internalBonds
  neighborOrder := []

/-- Exact source-side obligations for one reusable template.  Endpoint bounds for ports are in
their `Fin` type; internal endpoint bounds and connectedness are proved once per template. -/
def Valid (template : MolecularFullereneLocalAddendTemplate) : Prop :=
  0 < template.identityClass ∧
    0 < template.portCount ∧
    (template.internalBonds.Pairwise fun first second => first.edgeKey ≠ second.edgeKey) ∧
    (∀ bond ∈ template.internalBonds,
      bond.source < template.externalAtoms.length ∧
        bond.target < template.externalAtoms.length ∧ bond.source ≠ bond.target) ∧
    (∀ first : Fin template.externalAtoms.length,
      ∀ second : Fin template.externalAtoms.length,
        ∃ path, MolecularFullereneCagePath template.localMolecule
          (Finset.range template.externalAtoms.length) first second path)

theorem valid_externalAtoms_nonempty {template : MolecularFullereneLocalAddendTemplate}
    (valid : template.Valid) : template.externalAtoms ≠ [] := by
  intro empty
  have port := template.port ⟨0, valid.2.1⟩
  have := port.externalAtom.isLt
  simp [empty] at this

end MolecularFullereneLocalAddendTemplate

/-- A template placed on distinct sites of one numbered cage.  Port sites are Fin-indexed, so a
two-port cyclopropa addend retains its pairing instead of degenerating to two unary colors. -/
structure MolecularFullerenePlacedAddendTemplate (carrier : Finset Nat) where
  template : MolecularFullereneLocalAddendTemplate
  attachmentSite : Fin template.portCount → Nat
  attachmentSite_mem : ∀ port, attachmentSite port ∈ carrier
  attachmentSite_injective : Function.Injective attachmentSite

namespace MolecularFullerenePlacedAddendTemplate

def attachmentSites {carrier : Finset Nat}
    (placed : MolecularFullerenePlacedAddendTemplate carrier) : Finset Nat :=
  Finset.univ.image placed.attachmentSite

theorem attachmentSite_mem_attachmentSites {carrier : Finset Nat}
    (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (port : Fin placed.template.portCount) :
    placed.attachmentSite port ∈ placed.attachmentSites := by
  simp [attachmentSites]

theorem attachmentSites_subset {carrier : Finset Nat}
    (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    placed.attachmentSites ⊆ carrier := by
  intro site sitePresent
  simp only [attachmentSites, Finset.mem_image, Finset.mem_univ, true_and] at sitePresent
  obtain ⟨port, rfl⟩ := sitePresent
  exact placed.attachmentSite_mem port

end MolecularFullerenePlacedAddendTemplate

/-- Number of external atoms preceding list position `index`. -/
def molecularFullereneAddendPrefixAtomCount {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (index : Nat) : Nat :=
  ((placements.take index).map fun placed => placed.template.externalAtoms.length).sum

/-- First global atom index of the addend at list position `index`. -/
def molecularFullereneAddendExternalOffset {carrier : Finset Nat}
    (coreAtomCount : Nat)
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (index : Nat) : Nat :=
  coreAtomCount + molecularFullereneAddendPrefixAtomCount placements index

/-- Remap one local external-atom index into its generated global interval. -/
def molecularFullereneRemapLocalAtom (offset localAtom : Nat) : Nat :=
  offset + localAtom

private def molecularFullereneRemapLocalBond (offset : Nat) (bond : RawBond) : RawBond where
  source := molecularFullereneRemapLocalAtom offset bond.source
  target := molecularFullereneRemapLocalAtom offset bond.target
  kind := bond.kind

private def molecularFullereneCompilePortBond {carrier : Finset Nat}
    (offset : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (port : Fin placed.template.portCount) : RawBond where
  source := placed.attachmentSite port
  target := molecularFullereneRemapLocalAtom offset
    (placed.template.port port).externalAtom
  kind := (placed.template.port port).bondKind

private def molecularFullereneCompilePlacedBonds {carrier : Finset Nat}
    (offset : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) : List RawBond :=
  placed.template.internalBonds.map (molecularFullereneRemapLocalBond offset) ++
    List.ofFn (molecularFullereneCompilePortBond offset placed)

private def molecularFullereneCompileExtraBondsFrom {carrier : Finset Nat} :
    Nat → List (MolecularFullerenePlacedAddendTemplate carrier) → List RawBond
  | _offset, [] => []
  | offset, placed :: rest =>
      molecularFullereneCompilePlacedBonds offset placed ++
        molecularFullereneCompileExtraBondsFrom
          (offset + placed.template.externalAtoms.length) rest

private def molecularFullereneCompiledAddendAt {carrier : Finset Nat}
    (offset : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    MolecularFullereneAddend where
  externalAtoms := Finset.Ico offset (offset + placed.template.externalAtoms.length)
  attachmentPorts := Finset.univ.image fun port : Fin placed.template.portCount =>
    (placed.attachmentSite port,
      molecularFullereneRemapLocalAtom offset (placed.template.port port).externalAtom)
  identityClass := placed.template.identityClass

private def molecularFullereneCompiledAddendsFrom {carrier : Finset Nat} :
    Nat → List (MolecularFullerenePlacedAddendTemplate carrier) →
      List MolecularFullereneAddend
  | _offset, [] => []
  | offset, placed :: rest =>
      molecularFullereneCompiledAddendAt offset placed ::
        molecularFullereneCompiledAddendsFrom
          (offset + placed.template.externalAtoms.length) rest

private def molecularFullereneCompiledChiralAddendsFrom {carrier : Finset Nat} :
    Nat → List (MolecularFullerenePlacedAddendTemplate carrier) →
      List MolecularFullereneAddend
  | _offset, [] => []
  | offset, placed :: rest =>
      let tail := molecularFullereneCompiledChiralAddendsFrom
        (offset + placed.template.externalAtoms.length) rest
      if placed.template.intrinsicallyChiral then
        molecularFullereneCompiledAddendAt offset placed :: tail
      else
        tail

/-- Complete finite input for compiling all addends of one derivative.  Requiring the certified
core carrier to be exactly its atom range is appropriate for the source-only C60/C70/C76 cage
cores and makes the core/external partition a theorem of interval arithmetic. -/
structure MolecularFullereneAddendTemplateAssembly
    (core : RawMolecule) (carrier : Finset Nat) where
  placements : List (MolecularFullerenePlacedAddendTemplate carrier)
  carrier_eq_range : carrier = Finset.range core.atomCount
  templatesValid : ∀ placed ∈ placements, placed.template.Valid
  attachmentSitesPairwiseDisjoint :
    placements.Pairwise fun first second =>
      Disjoint first.attachmentSites second.attachmentSites

namespace MolecularFullereneAddendTemplateAssembly

def compiledExternalAtoms {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) : List AtomSpec :=
  assembly.placements.flatMap fun placed => placed.template.externalAtoms

def compiledExtraBonds {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) : List RawBond :=
  molecularFullereneCompileExtraBondsFrom core.atomCount assembly.placements

def compiledAddends {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    List MolecularFullereneAddend :=
  molecularFullereneCompiledAddendsFrom core.atomCount assembly.placements

/-- The intrinsically chiral addends are derived from the audited template flags; callers cannot
silently reclassify a compiled template at the relational-evidence boundary. -/
def compiledChiralAddends {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    Finset MolecularFullereneAddend :=
  (molecularFullereneCompiledChiralAddendsFrom core.atomCount assembly.placements).toFinset

/-- The compiled addend at a source list index, with its prefix-derived offset exposed. -/
def compiledAddend {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) : Option MolecularFullereneAddend :=
  match assembly.placements[index]? with
  | none => none
  | some placed => some (molecularFullereneCompiledAddendAt
      (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index) placed)

private theorem compiledAddendsFrom_getElem?_eq
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset index : Nat) :
    (molecularFullereneCompiledAddendsFrom offset placements)[index]? =
      match placements[index]? with
      | none => none
      | some placed => some (molecularFullereneCompiledAddendAt
          (offset + molecularFullereneAddendPrefixAtomCount placements index) placed) := by
  induction placements generalizing offset index with
  | nil => simp [molecularFullereneCompiledAddendsFrom]
  | cons placed rest inductionHypothesis =>
      cases index with
      | zero =>
          simp [molecularFullereneCompiledAddendsFrom,
            molecularFullereneAddendPrefixAtomCount]
      | succ index =>
          simp only [molecularFullereneCompiledAddendsFrom, List.getElem?_cons_succ]
          rw [inductionHypothesis]
          simp [molecularFullereneAddendPrefixAtomCount, Nat.add_assoc]

/-- The public prefix-indexed view is definitionally aligned with the recursively compiled list
used by the partition and evidence theorems. -/
theorem compiledAddend_eq_compiledAddends_getElem?
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) :
    assembly.compiledAddend index = assembly.compiledAddends[index]? := by
  change assembly.compiledAddend index =
    (molecularFullereneCompiledAddendsFrom core.atomCount assembly.placements)[index]?
  rw [compiledAddendsFrom_getElem?_eq]
  simp [compiledAddend, molecularFullereneAddendExternalOffset]

private theorem compiledChiralAddendsFrom_subset
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) :
    ∀ addend ∈ molecularFullereneCompiledChiralAddendsFrom offset placements,
      addend ∈ molecularFullereneCompiledAddendsFrom offset placements := by
  induction placements generalizing offset with
  | nil => simp [molecularFullereneCompiledChiralAddendsFrom]
  | cons placed rest inductionHypothesis =>
      intro addend addendPresent
      by_cases chiral : placed.template.intrinsicallyChiral
      · simp only [molecularFullereneCompiledChiralAddendsFrom, chiral, ↓reduceIte,
          List.mem_cons] at addendPresent
        simp only [molecularFullereneCompiledAddendsFrom, List.mem_cons]
        rcases addendPresent with rfl | tailPresent
        · exact Or.inl rfl
        · exact Or.inr (inductionHypothesis
            (offset + placed.template.externalAtoms.length) addend tailPresent)
      · simp only [molecularFullereneCompiledChiralAddendsFrom, chiral]
          at addendPresent
        exact List.mem_cons_of_mem _ (inductionHypothesis
          (offset + placed.template.externalAtoms.length) addend addendPresent)

theorem compiledChiralAddends_owned
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    ∀ addend ∈ assembly.compiledChiralAddends,
      addend ∈ assembly.compiledAddends := by
  intro addend addendChiral
  exact compiledChiralAddendsFrom_subset assembly.placements core.atomCount addend
    (by simpa [compiledChiralAddends] using addendChiral)

@[simp] theorem compiledAddend_externalAtoms {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : assembly.placements[index]? = some placed) :
    assembly.compiledAddend index = some
      { externalAtoms := Finset.Ico
          (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index)
          (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index +
            placed.template.externalAtoms.length)
        attachmentPorts := Finset.univ.image fun port : Fin placed.template.portCount =>
          (placed.attachmentSite port,
            molecularFullereneRemapLocalAtom
              (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index)
              (placed.template.port port).externalAtom)
        identityClass := placed.template.identityClass } := by
  simp [compiledAddend, atIndex, molecularFullereneCompiledAddendAt]

private theorem compileExtraBondsFrom_endpoints
    {core : RawMolecule} {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (carrierExact : carrier = Finset.range core.atomCount)
    (templatesValid : ∀ placed ∈ placements, placed.template.Valid)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (bond : RawBond)
    (bondPresent : bond ∈ molecularFullereneCompileExtraBondsFrom offset placements) :
    bond.source < offset + (placements.flatMap fun placed => placed.template.externalAtoms).length ∧
      bond.target < offset +
          (placements.flatMap fun placed => placed.template.externalAtoms).length ∧
        bond.source ≠ bond.target := by
  induction placements generalizing offset bond with
  | nil => simp [molecularFullereneCompileExtraBondsFrom] at bondPresent
  | cons placed rest inductionHypothesis =>
      have placedValid : placed.template.Valid :=
        templatesValid placed (by simp)
      have restValid : ∀ next ∈ rest, next.template.Valid := by
        intro next nextPresent
        exact templatesValid next (by simp [nextPresent])
      simp only [molecularFullereneCompileExtraBondsFrom, List.mem_append] at bondPresent
      rcases bondPresent with headBond | tailBond
      · simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at headBond
        rcases headBond with internalBond | portBond
        · obtain ⟨localBond, localPresent, rfl⟩ := List.mem_map.mp internalBond
          obtain ⟨sourceBound, targetBound, distinct⟩ :=
            placedValid.2.2.2.1 localBond localPresent
          have sourceLocal :
              offset + localBond.source < offset + placed.template.externalAtoms.length :=
            Nat.add_lt_add_left sourceBound offset
          have targetLocal :
              offset + localBond.target < offset + placed.template.externalAtoms.length :=
            Nat.add_lt_add_left targetBound offset
          have intervalLe :
              offset + placed.template.externalAtoms.length ≤
                offset + (placed.template.externalAtoms ++
                  (rest.flatMap fun next => next.template.externalAtoms)).length := by
            simp
          refine ⟨Nat.lt_of_lt_of_le sourceLocal intervalLe,
            Nat.lt_of_lt_of_le targetLocal intervalLe, ?_⟩
          simp [molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom, distinct]
        · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp portBond
          have siteBound : placed.attachmentSite port < core.atomCount := by
            rw [← Finset.mem_range]
            rw [← carrierExact]
            exact placed.attachmentSite_mem port
          have externalBound :
              offset + (placed.template.port port).externalAtom <
                offset + placed.template.externalAtoms.length :=
            Nat.add_lt_add_left (placed.template.port port).externalAtom.isLt offset
          have intervalLe :
              offset + placed.template.externalAtoms.length ≤
                offset + (placed.template.externalAtoms ++
                  (rest.flatMap fun next => next.template.externalAtoms)).length := by
            simp
          refine ⟨Nat.lt_of_lt_of_le siteBound ?_,
            Nat.lt_of_lt_of_le externalBound intervalLe, ?_⟩
          · exact Nat.le_trans coreLeOffset (Nat.le_add_right offset _)
          · exact Nat.ne_of_lt (Nat.lt_of_lt_of_le siteBound
              (Nat.le_trans coreLeOffset (Nat.le_add_right offset _)))
      · have tailResult := inductionHypothesis restValid
          (offset + placed.template.externalAtoms.length)
          (Nat.le_trans coreLeOffset (Nat.le_add_right offset _)) bond tailBond
        simpa [List.flatMap, Nat.add_assoc] using tailResult

private theorem compileExtraBondsFrom_target_ge
    {core : RawMolecule} {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (bond : RawBond)
    (bondPresent : bond ∈ molecularFullereneCompileExtraBondsFrom offset placements) :
    core.atomCount ≤ bond.target := by
  induction placements generalizing offset bond with
  | nil => simp [molecularFullereneCompileExtraBondsFrom] at bondPresent
  | cons placed rest inductionHypothesis =>
      simp only [molecularFullereneCompileExtraBondsFrom, List.mem_append] at bondPresent
      rcases bondPresent with headBond | tailBond
      · simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at headBond
        rcases headBond with internalBond | portBond
        · obtain ⟨localBond, _localPresent, rfl⟩ := List.mem_map.mp internalBond
          exact Nat.le_trans coreLeOffset (Nat.le_add_right offset _)
        · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp portBond
          exact Nat.le_trans coreLeOffset (Nat.le_add_right offset _)
      · exact inductionHypothesis
          (offset + placed.template.externalAtoms.length)
          (Nat.le_trans coreLeOffset (Nat.le_add_right offset _)) bond tailBond

private theorem remapLocalBond_edgeKey
    (offset : Nat) (bond : RawBond) :
    (molecularFullereneRemapLocalBond offset bond).edgeKey =
      (offset + bond.edgeKey.1, offset + bond.edgeKey.2) := by
  rcases Nat.le_total bond.source bond.target with sourceLeTarget | targetLeSource
  · simp [molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom,
      RawBond.edgeKey, Nat.min_eq_left sourceLeTarget, Nat.max_eq_right sourceLeTarget,
      Nat.min_eq_left (Nat.add_le_add_left sourceLeTarget offset),
      Nat.max_eq_right (Nat.add_le_add_left sourceLeTarget offset)]
  · simp [molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom,
      RawBond.edgeKey, Nat.min_eq_right targetLeSource, Nat.max_eq_left targetLeSource,
      Nat.min_eq_right (Nat.add_le_add_left targetLeSource offset),
      Nat.max_eq_left (Nat.add_le_add_left targetLeSource offset)]

private theorem compilePortBond_edgeKey
    {core : RawMolecule} {carrier : Finset Nat}
    (carrierExact : carrier = Finset.range core.atomCount)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (port : Fin placed.template.portCount) :
    (molecularFullereneCompilePortBond offset placed port).edgeKey =
      (placed.attachmentSite port,
        offset + (placed.template.port port).externalAtom) := by
  have siteLtCore : placed.attachmentSite port < core.atomCount := by
    rw [← Finset.mem_range, ← carrierExact]
    exact placed.attachmentSite_mem port
  have siteLeTarget : placed.attachmentSite port ≤
      offset + (placed.template.port port).externalAtom := by
    omega
  simp [molecularFullereneCompilePortBond, molecularFullereneRemapLocalAtom,
    RawBond.edgeKey, Nat.min_eq_left siteLeTarget, Nat.max_eq_right siteLeTarget]

private theorem compilePlacedBonds_edgeKeys_nodup
    {core : RawMolecule} {carrier : Finset Nat}
    (carrierExact : carrier = Finset.range core.atomCount)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (placedValid : placed.template.Valid) :
    ((molecularFullereneCompilePlacedBonds offset placed).map RawBond.edgeKey).Nodup := by
  rw [molecularFullereneCompilePlacedBonds, List.map_append]
  rw [List.nodup_append]
  refine ⟨?_, ?_, ?_⟩
  · rw [List.map_map, List.nodup_iff_pairwise_ne, List.pairwise_map]
    exact placedValid.2.2.1.imp (by
      intro first second keyNe remappedEq
      apply keyNe
      apply Prod.ext
      · have firstEq := congrArg Prod.fst remappedEq
        simp only [Function.comp_apply, remapLocalBond_edgeKey] at firstEq
        exact Nat.add_left_cancel firstEq
      · have secondEq := congrArg Prod.snd remappedEq
        simp only [Function.comp_apply, remapLocalBond_edgeKey] at secondEq
        exact Nat.add_left_cancel secondEq)
  · rw [List.map_ofFn, List.nodup_ofFn]
    intro first second keysEqual
    apply placed.attachmentSite_injective
    have firstCoordinates := congrArg Prod.fst keysEqual
    simpa [Function.comp_def,
      compilePortBond_edgeKey carrierExact offset coreLeOffset] using firstCoordinates
  · intro internalKey internalPresent portKey portPresent keysEqual
    obtain ⟨internalBond, internalBondPresent, internalKeyEq⟩ :=
      List.mem_map.mp internalPresent
    obtain ⟨localBond, localPresent, localBondEq⟩ :=
      List.mem_map.mp internalBondPresent
    obtain ⟨portBond, portBondPresent, portKeyEq⟩ := List.mem_map.mp portPresent
    obtain ⟨port, portBondEq⟩ := List.mem_ofFn.mp portBondPresent
    have siteLtCore : placed.attachmentSite port < core.atomCount := by
      rw [← Finset.mem_range, ← carrierExact]
      exact placed.attachmentSite_mem port
    have edgeKeysEqual :
        (molecularFullereneRemapLocalBond offset localBond).edgeKey =
          (molecularFullereneCompilePortBond offset placed port).edgeKey := by
      rw [localBondEq, internalKeyEq, keysEqual, ← portKeyEq, portBondEq]
    have firstCoordinates := congrArg Prod.fst edgeKeysEqual
    rw [remapLocalBond_edgeKey,
      compilePortBond_edgeKey carrierExact offset coreLeOffset] at firstCoordinates
    have localMinNonnegative : 0 ≤ localBond.edgeKey.1 := Nat.zero_le _
    omega

private theorem compilePlacedBonds_edgeKey_snd_lt
    {core : RawMolecule} {carrier : Finset Nat}
    (carrierExact : carrier = Finset.range core.atomCount)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (placedValid : placed.template.Valid)
    (bond : RawBond) (bondPresent : bond ∈ molecularFullereneCompilePlacedBonds offset placed) :
    bond.edgeKey.2 < offset + placed.template.externalAtoms.length := by
  simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at bondPresent
  rcases bondPresent with internalBond | portBond
  · obtain ⟨localBond, localPresent, rfl⟩ := List.mem_map.mp internalBond
    obtain ⟨sourceBound, targetBound, _distinct⟩ :=
      placedValid.2.2.2.1 localBond localPresent
    rw [remapLocalBond_edgeKey]
    have localMaxBound : localBond.edgeKey.2 < placed.template.externalAtoms.length := by
      simp only [RawBond.edgeKey]
      exact max_lt sourceBound targetBound
    omega
  · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp portBond
    rw [compilePortBond_edgeKey carrierExact offset coreLeOffset]
    exact Nat.add_lt_add_left (placed.template.port port).externalAtom.isLt offset

private theorem compileExtraBondsFrom_target_ge_ownOffset
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) (bond : RawBond)
    (bondPresent : bond ∈ molecularFullereneCompileExtraBondsFrom offset placements) :
    offset ≤ bond.target := by
  induction placements generalizing offset bond with
  | nil => simp [molecularFullereneCompileExtraBondsFrom] at bondPresent
  | cons placed rest inductionHypothesis =>
      simp only [molecularFullereneCompileExtraBondsFrom, List.mem_append] at bondPresent
      rcases bondPresent with headBond | tailBond
      · simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at headBond
        rcases headBond with internalBond | portBond
        · obtain ⟨localBond, _localPresent, rfl⟩ := List.mem_map.mp internalBond
          simp [molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom]
        · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp portBond
          simp [molecularFullereneCompilePortBond, molecularFullereneRemapLocalAtom]
      · have tailTarget := inductionHypothesis
          (offset + placed.template.externalAtoms.length) bond tailBond
        omega

private theorem compileExtraBondsFrom_edgeKeys_nodup
    {core : RawMolecule} {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (carrierExact : carrier = Finset.range core.atomCount)
    (templatesValid : ∀ placed ∈ placements, placed.template.Valid)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset) :
    ((molecularFullereneCompileExtraBondsFrom offset placements).map
      RawBond.edgeKey).Nodup := by
  induction placements generalizing offset with
  | nil => simp [molecularFullereneCompileExtraBondsFrom]
  | cons placed rest inductionHypothesis =>
      have placedValid : placed.template.Valid := templatesValid placed (by simp)
      have restValid : ∀ next ∈ rest, next.template.Valid := by
        intro next nextPresent
        exact templatesValid next (by simp [nextPresent])
      rw [molecularFullereneCompileExtraBondsFrom, List.map_append]
      rw [List.nodup_append]
      refine ⟨?_, ?_, ?_⟩
      · exact compilePlacedBonds_edgeKeys_nodup carrierExact offset coreLeOffset
          placed placedValid
      · exact inductionHypothesis restValid
          (offset + placed.template.externalAtoms.length)
          (Nat.le_trans coreLeOffset (Nat.le_add_right offset _))
      · intro headKey headPresent tailKey tailPresent keysEqual
        obtain ⟨headBond, headBondPresent, headKeyEq⟩ := List.mem_map.mp headPresent
        obtain ⟨tailBond, tailBondPresent, tailKeyEq⟩ := List.mem_map.mp tailPresent
        have headMaxLt := compilePlacedBonds_edgeKey_snd_lt carrierExact offset
          coreLeOffset placed placedValid headBond headBondPresent
        have tailTargetGe := compileExtraBondsFrom_target_ge_ownOffset rest
          (offset + placed.template.externalAtoms.length) tailBond tailBondPresent
        have equalMax := congrArg Prod.snd
          (headKeyEq.trans (keysEqual.trans tailKeyEq.symm))
        simp only [RawBond.edgeKey] at headMaxLt equalMax
        have tailMaxGe : offset + placed.template.externalAtoms.length ≤
            max tailBond.source tailBond.target :=
          Nat.le_trans tailTargetGe (Nat.le_max_right _ _)
        omega

/-- Every compiler-generated edge has one constitutional owner: it is either internal to that
owner's generated external interval or is exactly one of that owner's oriented cage ports.  This
is the central incidence fact used below; boundary exactness and external closure do not inspect
the recursive compiler independently. -/
private theorem compileExtraBondsFrom_provenance
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (templatesValid : ∀ placed ∈ placements, placed.template.Valid)
    (offset : Nat) (bond : RawBond)
    (bondPresent : bond ∈ molecularFullereneCompileExtraBondsFrom offset placements) :
    (∃ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
      bond.source ∈ addend.externalAtoms ∧ bond.target ∈ addend.externalAtoms) ∨
    (∃ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
      (bond.source, bond.target) ∈ addend.attachmentPorts) := by
  induction placements generalizing offset bond with
  | nil => simp [molecularFullereneCompileExtraBondsFrom] at bondPresent
  | cons placed rest inductionHypothesis =>
      have placedValid : placed.template.Valid := templatesValid placed (by simp)
      have restValid : ∀ next ∈ rest, next.template.Valid := by
        intro next nextPresent
        exact templatesValid next (by simp [nextPresent])
      simp only [molecularFullereneCompileExtraBondsFrom, List.mem_append] at bondPresent
      rcases bondPresent with headBond | tailBond
      · simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at headBond
        rcases headBond with internalBond | portBond
        · obtain ⟨localBond, localPresent, rfl⟩ := List.mem_map.mp internalBond
          obtain ⟨sourceBound, targetBound, _distinct⟩ :=
            placedValid.2.2.2.1 localBond localPresent
          left
          refine ⟨molecularFullereneCompiledAddendAt offset placed,
            List.mem_cons_self, ?_, ?_⟩
          · simpa [molecularFullereneCompiledAddendAt,
              molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom] using
              sourceBound
          · simpa [molecularFullereneCompiledAddendAt,
              molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom] using
              targetBound
        · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp portBond
          right
          refine ⟨molecularFullereneCompiledAddendAt offset placed,
            List.mem_cons_self, ?_⟩
          simp only [molecularFullereneCompiledAddendAt,
            molecularFullereneCompilePortBond, molecularFullereneRemapLocalAtom,
            Finset.mem_image, Finset.mem_univ, true_and]
          exact ⟨port, rfl⟩
      · rcases inductionHypothesis restValid
          (offset + placed.template.externalAtoms.length) bond tailBond with
          internal | port
        · left
          rcases internal with ⟨addend, addendPresent, sourcePresent, targetPresent⟩
          exact ⟨addend, by simp [molecularFullereneCompiledAddendsFrom, addendPresent],
            sourcePresent, targetPresent⟩
        · right
          rcases port with ⟨addend, addendPresent, portPresent⟩
          exact ⟨addend, by simp [molecularFullereneCompiledAddendsFrom, addendPresent],
            portPresent⟩

/-- Compile local graphs and ports into the append-only derivative extension. -/
def compileExtension {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    MolecularFullereneDerivativeExtension core carrier := by
  refine
    { externalAtoms := assembly.compiledExternalAtoms
      extraBonds := assembly.compiledExtraBonds
      extraBondEndpoints := ?_
      noExtraCageInternalBond := ?_ }
  · intro bond bondPresent
    exact compileExtraBondsFrom_endpoints assembly.placements assembly.carrier_eq_range
      assembly.templatesValid core.atomCount (Nat.le_refl _) bond bondPresent
  · intro bond bondPresent bothCage
    have targetGe : core.atomCount ≤ bond.target :=
      compileExtraBondsFrom_target_ge assembly.placements core.atomCount
        (Nat.le_refl _) bond bondPresent
    have targetLt : bond.target < core.atomCount := by
      rw [← Finset.mem_range, ← assembly.carrier_eq_range]
      exact bothCage.2
    exact (Nat.not_lt_of_ge targetGe) targetLt

/-- The complete certified cage transports through template compilation in one step. -/
def transportCertificate
    {core : RawMolecule} {package : MolecularFullereneNumberedCagePackage}
    (assembly : MolecularFullereneAddendTemplateAssembly core package.carrier)
    (certificate : package.Certificate core) :
    package.Certificate assembly.compileExtension.assemble :=
  assembly.compileExtension.transportCertificate certificate

/-- Generated external intervals for distinct placements are pairwise disjoint. -/
theorem compiledAddends_externalAtoms_pairwiseDisjoint
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    assembly.compiledAddends.Pairwise fun first second =>
      Disjoint first.externalAtoms second.externalAtoms := by
  let compiledFrom :
      Nat → List (MolecularFullerenePlacedAddendTemplate carrier) →
        List MolecularFullereneAddend :=
    molecularFullereneCompiledAddendsFrom
  have lowerBound : ∀ (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
      (offset : Nat) (addend : MolecularFullereneAddend),
      addend ∈ compiledFrom offset placements →
        ∀ atom ∈ addend.externalAtoms, offset ≤ atom := by
    intro placements
    induction placements with
    | nil =>
        intro offset addend addendPresent
        simp [compiledFrom, molecularFullereneCompiledAddendsFrom] at addendPresent
    | cons placed rest inductionHypothesis =>
        intro offset addend addendPresent atom atomPresent
        simp only [compiledFrom, molecularFullereneCompiledAddendsFrom,
          List.mem_cons] at addendPresent
        rcases addendPresent with rfl | tailPresent
        · exact (Finset.mem_Ico.mp atomPresent).1
        · exact Nat.le_trans (Nat.le_add_right offset _)
            (inductionHypothesis (offset + placed.template.externalAtoms.length)
              addend tailPresent atom atomPresent)
  have pairwiseFrom : ∀ (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
      (offset : Nat),
      (compiledFrom offset placements).Pairwise fun first second =>
        Disjoint first.externalAtoms second.externalAtoms := by
    intro placements
    induction placements with
    | nil => intro offset; simp [compiledFrom, molecularFullereneCompiledAddendsFrom]
    | cons placed rest inductionHypothesis =>
        intro offset
        simp only [compiledFrom, molecularFullereneCompiledAddendsFrom, List.pairwise_cons]
        constructor
        · intro addend addendPresent
          rw [Finset.disjoint_left]
          intro atom headPresent tailPresent
          have headLt := (Finset.mem_Ico.mp headPresent).2
          have tailGe := lowerBound rest
            (offset + placed.template.externalAtoms.length) addend addendPresent atom tailPresent
          exact (Nat.not_lt_of_ge tailGe) headLt
        · exact inductionHypothesis (offset + placed.template.externalAtoms.length)
  exact pairwiseFrom assembly.placements core.atomCount

private theorem exists_mem_compiledAddendsFrom_externalAtoms_iff
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset atom : Nat) :
    (∃ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
        atom ∈ addend.externalAtoms) ↔
      offset ≤ atom ∧
        atom < offset +
          (placements.flatMap fun placed => placed.template.externalAtoms).length := by
  induction placements generalizing offset with
  | nil => simp [molecularFullereneCompiledAddendsFrom]
  | cons placed rest inductionHypothesis =>
      rw [show molecularFullereneCompiledAddendsFrom offset (placed :: rest) =
        molecularFullereneCompiledAddendAt offset placed ::
          molecularFullereneCompiledAddendsFrom
            (offset + placed.template.externalAtoms.length) rest by rfl]
      simp only [List.mem_cons, exists_eq_or_imp, molecularFullereneCompiledAddendAt,
        Finset.mem_Ico]
      rw [inductionHypothesis]
      simp only [List.flatMap_cons, List.length_append, Nat.add_assoc]
      omega

/-- The generated addend intervals are an exact partition of every appended atom. -/
theorem compiledAddends_externalAtomsPartition
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    MolecularFullereneAddendExternalAtomsPartition
      assembly.compileExtension.assemble carrier assembly.compiledAddends := by
  intro atom atomBound
  rw [MolecularFullereneDerivativeExtension.assemble_atomCount] at atomBound
  have generated := exists_mem_compiledAddendsFrom_externalAtoms_iff
    assembly.placements core.atomCount atom
  change atom ∉ carrier ↔ ∃ addend ∈ assembly.compiledAddends,
    atom ∈ addend.externalAtoms
  have carrierMem : atom ∈ carrier ↔ atom < core.atomCount := by
    rw [assembly.carrier_eq_range, Finset.mem_range]
  rw [carrierMem, not_lt]
  change core.atomCount ≤ atom ↔
    ∃ addend ∈ molecularFullereneCompiledAddendsFrom core.atomCount assembly.placements,
      atom ∈ addend.externalAtoms
  rw [generated]
  have atomUpper : atom < core.atomCount +
      (assembly.placements.flatMap fun placed => placed.template.externalAtoms).length := by
    simpa [compileExtension, compiledExternalAtoms] using atomBound
  constructor
  · exact fun lower => ⟨lower, atomUpper⟩
  · exact fun bounded => bounded.1

private theorem compiledAddendsFrom_external_bounds
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) (addend : MolecularFullereneAddend)
    (addendPresent : addend ∈ molecularFullereneCompiledAddendsFrom offset placements)
    (atom : Nat) (atomPresent : atom ∈ addend.externalAtoms) :
    offset ≤ atom ∧
      atom < offset +
        (placements.flatMap fun placed => placed.template.externalAtoms).length := by
  induction placements generalizing offset addend atom with
  | nil => simp [molecularFullereneCompiledAddendsFrom] at addendPresent
  | cons placed rest inductionHypothesis =>
      simp only [molecularFullereneCompiledAddendsFrom, List.mem_cons] at addendPresent
      rcases addendPresent with rfl | tailPresent
      · have interval := Finset.mem_Ico.mp atomPresent
        refine ⟨interval.1, Nat.lt_of_lt_of_le interval.2 ?_⟩
        simp
      · have tailBounds := inductionHypothesis
          (offset + placed.template.externalAtoms.length) addend tailPresent atom atomPresent
        constructor
        · exact Nat.le_trans (Nat.le_add_right offset _) tailBounds.1
        · simpa only [List.flatMap_cons, List.length_append, Nat.add_assoc] using
            tailBounds.2

private theorem compiledAddendsFrom_port_shape
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) (addend : MolecularFullereneAddend)
    (addendPresent : addend ∈ molecularFullereneCompiledAddendsFrom offset placements)
    (site externalAtom : Nat)
    (portPresent : (site, externalAtom) ∈ addend.attachmentPorts) :
    site ∈ carrier ∧ externalAtom ∈ addend.externalAtoms := by
  induction placements generalizing offset addend site externalAtom with
  | nil => simp [molecularFullereneCompiledAddendsFrom] at addendPresent
  | cons placed rest inductionHypothesis =>
      simp only [molecularFullereneCompiledAddendsFrom, List.mem_cons] at addendPresent
      rcases addendPresent with rfl | tailPresent
      · simp only [molecularFullereneCompiledAddendAt, Finset.mem_image,
          Finset.mem_univ, true_and] at portPresent
        obtain ⟨port, portEq⟩ := portPresent
        have siteEq : placed.attachmentSite port = site := congrArg Prod.fst portEq
        have externalEq :
            molecularFullereneRemapLocalAtom offset
                (placed.template.port port).externalAtom = externalAtom :=
          congrArg Prod.snd portEq
        rw [← siteEq, ← externalEq]
        refine ⟨placed.attachmentSite_mem port, ?_⟩
        change offset + (placed.template.port port).externalAtom ∈
          Finset.Ico offset (offset + placed.template.externalAtoms.length)
        simp [(placed.template.port port).externalAtom.isLt]
      · exact inductionHypothesis
          (offset + placed.template.externalAtoms.length) addend tailPresent
          site externalAtom portPresent

private theorem eq_of_compiledAddends_external_overlap
    (addends : List MolecularFullereneAddend)
    (pairwise : addends.Pairwise fun first second =>
      Disjoint first.externalAtoms second.externalAtoms)
    {first second : MolecularFullereneAddend}
    (firstPresent : first ∈ addends) (secondPresent : second ∈ addends)
    {atom : Nat} (firstAtom : atom ∈ first.externalAtoms)
    (secondAtom : atom ∈ second.externalAtoms) :
    first = second := by
  by_contra different
  have disjoint := pairwise.forall
    (fun _ _ relation => relation.symm) firstPresent secondPresent different
  exact (Finset.disjoint_left.mp disjoint) firstAtom secondAtom

private theorem compiledAddendAt_validFor_ambient
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed)
    (offset : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (placedValid : placed.template.Valid)
    (coreLeOffset : core.atomCount ≤ offset)
    (intervalUpper : offset + placed.template.externalAtoms.length ≤
      core.atomCount + assembly.compiledExternalAtoms.length)
    (addendPresent : molecularFullereneCompiledAddendAt offset placed ∈
      assembly.compiledAddends)
    (placedBondsPresent : ∀ bond ∈ molecularFullereneCompilePlacedBonds offset placed,
      bond ∈ assembly.compiledExtraBonds) :
    (molecularFullereneCompiledAddendAt offset placed).ValidFor
      assembly.compileExtension.assemble carrier := by
  let addend := molecularFullereneCompiledAddendAt offset placed
  let molecule := assembly.compileExtension.assemble
  have pairwise := assembly.compiledAddends_externalAtoms_pairwiseDisjoint
  have externalInterval : ∀ atom, atom ∈ addend.externalAtoms →
      offset ≤ atom ∧ atom < offset + placed.template.externalAtoms.length := by
    intro atom atomPresent
    exact Finset.mem_Ico.mp atomPresent
  have externalOutside : ∀ atom, atom ∈ addend.externalAtoms → atom ∉ carrier := by
    intro atom atomPresent atomCarrier
    have atomLtCore : atom < core.atomCount := by
      rw [← Finset.mem_range, ← assembly.carrier_eq_range]
      exact atomCarrier
    exact (Nat.not_lt_of_ge (Nat.le_trans coreLeOffset
      (externalInterval atom atomPresent).1)) atomLtCore
  have ambientExternalOutside : ∀ owner ∈ assembly.compiledAddends,
      ∀ atom ∈ owner.externalAtoms, atom ∉ carrier := by
    intro owner ownerPresent atom atomPresent atomCarrier
    have bounds := compiledAddendsFrom_external_bounds assembly.placements core.atomCount
      owner ownerPresent atom atomPresent
    have atomLtCore : atom < core.atomCount := by
      rw [← Finset.mem_range, ← assembly.carrier_eq_range]
      exact atomCarrier
    exact (Nat.not_lt_of_ge bounds.1) atomLtCore
  have coreBondNotIncident : ∀ bond ∈ core.bonds,
      ∀ atom ∈ addend.externalAtoms, ∀ neighbor,
        bond.connects atom neighbor ≠ true := by
    intro bond bondPresent atom atomPresent neighbor connected
    obtain ⟨sourceBound, targetBound, _distinct⟩ := coreWellFormed bond bondPresent
    have atomGe : core.atomCount ≤ atom :=
      Nat.le_trans coreLeOffset (externalInterval atom atomPresent).1
    simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
      at connected
    rcases connected with ⟨sourceEq, _targetEq⟩ | ⟨_sourceEq, targetEq⟩
    · exact (Nat.not_lt_of_ge atomGe) (sourceEq ▸ sourceBound)
    · exact (Nat.not_lt_of_ge atomGe) (targetEq ▸ targetBound)
  have assembledBondPresent : ∀ bond ∈ assembly.compiledExtraBonds,
      bond ∈ molecule.bonds := by
    intro bond bondPresent
    exact List.mem_append_right core.bonds bondPresent
  have generatedProvenance : ∀ bond ∈ assembly.compiledExtraBonds,
      (∃ owner ∈ assembly.compiledAddends,
        bond.source ∈ owner.externalAtoms ∧ bond.target ∈ owner.externalAtoms) ∨
      (∃ owner ∈ assembly.compiledAddends,
        (bond.source, bond.target) ∈ owner.attachmentPorts) := by
    intro bond bondPresent
    exact compileExtraBondsFrom_provenance assembly.placements assembly.templatesValid
      core.atomCount bond bondPresent
  have portShape : ∀ owner ∈ assembly.compiledAddends,
      ∀ site externalAtom, (site, externalAtom) ∈ owner.attachmentPorts →
        site ∈ carrier ∧ externalAtom ∈ owner.externalAtoms := by
    intro owner ownerPresent site externalAtom portPresent
    exact compiledAddendsFrom_port_shape assembly.placements core.atomCount owner ownerPresent
      site externalAtom portPresent
  refine ⟨placedValid.1, ?_, ?_, ?_⟩
  · have portCountPositive := placedValid.2.1
    let port : Fin placed.template.portCount := ⟨0, portCountPositive⟩
    refine ⟨(placed.attachmentSite port,
      molecularFullereneRemapLocalAtom offset
        (placed.template.port port).externalAtom), ?_⟩
    change _ ∈ Finset.univ.image fun candidate : Fin placed.template.portCount =>
      (placed.attachmentSite candidate,
        molecularFullereneRemapLocalAtom offset
          (placed.template.port candidate).externalAtom)
    exact Finset.mem_image.mpr ⟨port, Finset.mem_univ _, rfl⟩
  · constructor
    · intro site externalAtom
      constructor
      · intro declared
        have shape := portShape addend addendPresent site externalAtom declared
        refine ⟨shape.1, shape.2, ?_⟩
        have distinct : site ≠ externalAtom := by
          intro equal
          exact externalOutside externalAtom shape.2 (equal ▸ shape.1)
        apply (molecule.bondOrder_pos_iff_exists_bond distinct).2
        simp only [molecularFullereneCompiledAddendAt, Finset.mem_image,
          Finset.mem_univ, true_and] at declared
        obtain ⟨port, portEq⟩ := declared
        let bond := molecularFullereneCompilePortBond offset placed port
        refine ⟨bond, assembledBondPresent bond (placedBondsPresent bond ?_), ?_⟩
        · simp [bond, molecularFullereneCompilePlacedBonds]
        · have sourceEq : bond.source = site := congrArg Prod.fst portEq
          have targetEq : bond.target = externalAtom := congrArg Prod.snd portEq
          simp [RawBond.connects, sourceEq, targetEq]
      · rintro ⟨siteCarrier, externalPresent, positive⟩
        have distinct : site ≠ externalAtom := by
          intro equal
          exact externalOutside externalAtom externalPresent (equal ▸ siteCarrier)
        obtain ⟨bond, bondPresent, connected⟩ :=
          (molecule.bondOrder_pos_iff_exists_bond distinct).1 positive
        rcases List.mem_append.mp bondPresent with coreBond | extraBond
        · exact False.elim (coreBondNotIncident bond coreBond externalAtom
            externalPresent site (by
              simpa [RawBond.connects, Bool.or_comm] using connected))
        · rcases generatedProvenance bond extraBond with internal | port
          · rcases internal with
              ⟨owner, ownerPresent, sourceExternal, targetExternal⟩
            simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
              at connected
            rcases connected with ⟨sourceEq, _targetEq⟩ | ⟨_sourceEq, targetEq⟩
            · exact False.elim (ambientExternalOutside owner ownerPresent bond.source
                sourceExternal (sourceEq ▸ siteCarrier))
            · exact False.elim (ambientExternalOutside owner ownerPresent bond.target
                targetExternal (targetEq ▸ siteCarrier))
          · rcases port with ⟨owner, ownerPresent, portPresent⟩
            have shape := portShape owner ownerPresent bond.source bond.target portPresent
            simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
              at connected
            rcases connected with ⟨sourceEq, targetEq⟩ | ⟨sourceEq, _targetEq⟩
            · have ownerEq : owner = addend :=
                eq_of_compiledAddends_external_overlap assembly.compiledAddends pairwise
                  ownerPresent addendPresent shape.2 (targetEq ▸ externalPresent)
              simpa [← sourceEq, ← targetEq, ownerEq] using portPresent
            · exact False.elim (externalOutside externalAtom externalPresent
                (sourceEq ▸ shape.1))
    · intro site firstEndpoint secondEndpoint firstPort secondPort
      simp only [molecularFullereneCompiledAddendAt, Finset.mem_image,
        Finset.mem_univ, true_and] at firstPort secondPort
      obtain ⟨first, firstEq⟩ := firstPort
      obtain ⟨second, secondEq⟩ := secondPort
      have sitesEqual : placed.attachmentSite first = placed.attachmentSite second := by
        calc
          placed.attachmentSite first = site := congrArg Prod.fst firstEq
          _ = placed.attachmentSite second := (congrArg Prod.fst secondEq).symm
      have portsEqual : first = second := placed.attachmentSite_injective sitesEqual
      subst second
      calc
        firstEndpoint = molecularFullereneRemapLocalAtom offset
            (placed.template.port first).externalAtom := (congrArg Prod.snd firstEq).symm
        _ = secondEndpoint := congrArg Prod.snd secondEq
  · refine ⟨?_, ?_, ?_, ?_⟩
    · have atomsNonempty :=
        MolecularFullereneLocalAddendTemplate.valid_externalAtoms_nonempty placedValid
      exact Finset.nonempty_iff_ne_empty.mpr (by
        intro empty
        change Finset.Ico offset
          (offset + placed.template.externalAtoms.length) = ∅ at empty
        have lengthZero : placed.template.externalAtoms.length = 0 := by
          simpa using congrArg Finset.card empty
        exact atomsNonempty (List.length_eq_zero_iff.mp lengthZero))
    · intro atom atomPresent
      refine ⟨?_, externalOutside atom atomPresent⟩
      rw [MolecularFullereneDerivativeExtension.assemble_atomCount]
      exact Nat.lt_of_lt_of_le (externalInterval atom atomPresent).2 intervalUpper
    · intro first firstPresent second secondPresent
      have firstInterval := externalInterval first firstPresent
      have secondInterval := externalInterval second secondPresent
      let localFirst : Fin placed.template.externalAtoms.length :=
        ⟨first - offset, by omega⟩
      let localSecond : Fin placed.template.externalAtoms.length :=
        ⟨second - offset, by omega⟩
      obtain ⟨path, nodup, within, headEq, lastEq, consecutive⟩ :=
        placedValid.2.2.2.2 localFirst localSecond
      refine ⟨path.map (fun atom => offset + atom), ?_, ?_, ?_, ?_, ?_⟩
      · exact nodup.map (fun _ _ equal => Nat.add_left_cancel equal)
      · intro atom atomPresent
        obtain ⟨localAtom, localPresent, rfl⟩ := List.mem_map.mp atomPresent
        have localRange := within localAtom localPresent
        simp only [Finset.mem_range] at localRange
        exact Finset.mem_Ico.mpr ⟨Nat.le_add_right offset _, Nat.add_lt_add_left localRange offset⟩
      · simpa [localFirst, Nat.add_sub_of_le firstInterval.1] using
          congrArg (Option.map fun atom => offset + atom) headEq
      · simpa [localSecond, Nat.add_sub_of_le secondInterval.1] using
          congrArg (Option.map fun atom => offset + atom) lastEq
      · rw [consecutivelyBonded_iff_isChain] at consecutive ⊢
        apply List.isChain_map_of_isChain (fun atom => offset + atom) _ consecutive
        intro left right bonded
        rcases bonded with ⟨bond, bondPresent, connected⟩
        let remapped := molecularFullereneRemapLocalBond offset bond
        refine ⟨remapped, assembledBondPresent remapped (placedBondsPresent remapped ?_), ?_⟩
        · apply List.mem_append_left
          exact List.mem_map.mpr ⟨bond, bondPresent, rfl⟩
        · simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
            at connected ⊢
          rcases connected with ⟨sourceEq, targetEq⟩ | ⟨sourceEq, targetEq⟩
          · left
            simp [remapped, molecularFullereneRemapLocalBond,
              molecularFullereneRemapLocalAtom, sourceEq, targetEq]
          · right
            simp [remapped, molecularFullereneRemapLocalBond,
              molecularFullereneRemapLocalAtom, sourceEq, targetEq]
    · intro atom atomPresent neighbor positive
      have distinct : atom ≠ neighbor := by
        intro equal
        subst neighbor
        simp [RawMolecule.bondOrder] at positive
      obtain ⟨bond, bondPresent, connected⟩ :=
        (molecule.bondOrder_pos_iff_exists_bond distinct).1 positive
      rcases List.mem_append.mp bondPresent with coreBond | extraBond
      · exact False.elim (coreBondNotIncident bond coreBond atom atomPresent neighbor connected)
      · rcases generatedProvenance bond extraBond with internal | port
        · rcases internal with ⟨owner, ownerPresent, sourceExternal, targetExternal⟩
          simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
            at connected
          rcases connected with ⟨sourceEq, targetEq⟩ | ⟨sourceEq, targetEq⟩
          · have ownerEq : owner = addend :=
              eq_of_compiledAddends_external_overlap assembly.compiledAddends pairwise
                ownerPresent addendPresent sourceExternal (sourceEq ▸ atomPresent)
            exact Or.inl (by simpa [ownerEq, targetEq] using targetExternal)
          · have ownerEq : owner = addend :=
              eq_of_compiledAddends_external_overlap assembly.compiledAddends pairwise
                ownerPresent addendPresent targetExternal (targetEq ▸ atomPresent)
            exact Or.inl (by simpa [ownerEq, sourceEq] using sourceExternal)
        · rcases port with ⟨owner, ownerPresent, portPresent⟩
          have shape := portShape owner ownerPresent bond.source bond.target portPresent
          simp only [RawBond.connects, Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq]
            at connected
          rcases connected with ⟨sourceEq, _targetEq⟩ | ⟨sourceEq, targetEq⟩
          · exact False.elim (externalOutside atom atomPresent (sourceEq ▸ shape.1))
          · have ownerEq : owner = addend :=
              eq_of_compiledAddends_external_overlap assembly.compiledAddends pairwise
                ownerPresent addendPresent shape.2 (targetEq ▸ atomPresent)
            exact Or.inr (by simpa [← sourceEq, ← targetEq, ownerEq] using portPresent)

@[simp] private theorem compiledAddendAt_attachmentSites
    {carrier : Finset Nat} (offset : Nat)
    (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    (molecularFullereneCompiledAddendAt offset placed).attachmentSites =
      placed.attachmentSites := by
  ext site
  simp [molecularFullereneCompiledAddendAt,
    MolecularFullereneAddend.attachmentSites,
    MolecularFullerenePlacedAddendTemplate.attachmentSites]

private theorem compiledAddendsFrom_attachmentSites_forall
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (predicate : Finset Nat → Prop)
    (source : ∀ placed ∈ placements, predicate placed.attachmentSites)
    (offset : Nat) :
    ∀ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
      predicate addend.attachmentSites := by
  induction placements generalizing offset with
  | nil => simp [molecularFullereneCompiledAddendsFrom]
  | cons placed rest inductionHypothesis =>
      intro addend addendPresent
      simp only [molecularFullereneCompiledAddendsFrom, List.mem_cons] at addendPresent
      rcases addendPresent with rfl | tailPresent
      · simpa using source placed (by simp)
      · apply inductionHypothesis
          (fun next nextPresent => source next (by simp [nextPresent]))
          (offset + placed.template.externalAtoms.length) addend tailPresent

private theorem compiledAddendsFrom_attachmentSites_pairwise
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (placedPairwise : placements.Pairwise fun first second =>
      Disjoint first.attachmentSites second.attachmentSites)
    (offset : Nat) :
    (molecularFullereneCompiledAddendsFrom offset placements).Pairwise fun first second =>
      Disjoint first.attachmentSites second.attachmentSites := by
  induction placements generalizing offset with
  | nil => simp [molecularFullereneCompiledAddendsFrom]
  | cons placed rest inductionHypothesis =>
      rw [List.pairwise_cons] at placedPairwise
      rw [show molecularFullereneCompiledAddendsFrom offset (placed :: rest) =
        molecularFullereneCompiledAddendAt offset placed ::
          molecularFullereneCompiledAddendsFrom
            (offset + placed.template.externalAtoms.length) rest by rfl]
      rw [List.pairwise_cons]
      constructor
      · intro addend addendPresent
        simpa using compiledAddendsFrom_attachmentSites_forall rest
          (fun sites => Disjoint placed.attachmentSites sites)
          placedPairwise.1 (offset + placed.template.externalAtoms.length)
          addend addendPresent
      · exact inductionHypothesis placedPairwise.2
          (offset + placed.template.externalAtoms.length)

/-- Distinct templates preserve their exact multiport site grouping and remain site-disjoint. -/
theorem compiledAddends_attachmentSites_pairwiseDisjoint
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier) :
    assembly.compiledAddends.Pairwise fun first second =>
      Disjoint first.attachmentSites second.attachmentSites :=
  compiledAddendsFrom_attachmentSites_pairwise assembly.placements
    assembly.attachmentSitesPairwiseDisjoint core.atomCount

/-- Every compiler-owned constitutional addend satisfies the complete molecule-backed validity
judgment.  The only global premise is well-formedness of the cage core: it prevents a malformed
pre-existing core bond from reaching into the compiler's future external-atom interval. -/
theorem compiledAddends_validFor
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed) :
    ∀ addend ∈ assembly.compiledAddends,
      addend.ValidFor assembly.compileExtension.assemble carrier := by
  have visit : ∀
      (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
      (offset : Nat),
      (∀ placed ∈ placements, placed.template.Valid) →
      core.atomCount ≤ offset →
      offset +
          (placements.flatMap fun placed => placed.template.externalAtoms).length ≤
        core.atomCount + assembly.compiledExternalAtoms.length →
      (∀ bond ∈ molecularFullereneCompileExtraBondsFrom offset placements,
        bond ∈ assembly.compiledExtraBonds) →
      (∀ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
        addend ∈ assembly.compiledAddends) →
      ∀ addend ∈ molecularFullereneCompiledAddendsFrom offset placements,
        addend.ValidFor assembly.compileExtension.assemble carrier := by
    intro placements
    induction placements with
    | nil =>
        intro offset _valid _coreLe _upper _bondsPresent _addendsPresent addend addendPresent
        simp [molecularFullereneCompiledAddendsFrom] at addendPresent
    | cons placed rest inductionHypothesis =>
        intro offset templatesValid coreLeOffset allUpper bondsPresent addendsPresent
          addend addendPresent
        have placedValid : placed.template.Valid := templatesValid placed (by simp)
        have restValid : ∀ next ∈ rest, next.template.Valid := by
          intro next nextPresent
          exact templatesValid next (by simp [nextPresent])
        simp only [molecularFullereneCompiledAddendsFrom, List.mem_cons] at addendPresent
        rcases addendPresent with rfl | tailPresent
        · have headUpper :
              offset + placed.template.externalAtoms.length ≤
                core.atomCount + assembly.compiledExternalAtoms.length := by
            have wholeUpper :
                offset + placed.template.externalAtoms.length +
                    (rest.flatMap fun next => next.template.externalAtoms).length ≤
                  core.atomCount + assembly.compiledExternalAtoms.length := by
              simpa only [List.flatMap_cons, List.length_append, Nat.add_assoc] using allUpper
            exact Nat.le_trans (Nat.le_add_right
              (offset + placed.template.externalAtoms.length) _) wholeUpper
          exact compiledAddendAt_validFor_ambient assembly coreWellFormed offset placed
            placedValid coreLeOffset headUpper
            (addendsPresent _ List.mem_cons_self)
            (fun bond bondPresent => bondsPresent bond
              (List.mem_append_left _ bondPresent))
        · exact inductionHypothesis (offset + placed.template.externalAtoms.length)
            restValid (Nat.le_trans coreLeOffset (Nat.le_add_right offset _))
            (by simpa only [List.flatMap_cons, List.length_append, Nat.add_assoc] using allUpper)
            (fun bond bondPresent => bondsPresent bond
              (List.mem_append_right _ bondPresent))
            (fun tailAddend tailAddendPresent => addendsPresent tailAddend
              (List.mem_cons_of_mem _ tailAddendPresent))
            addend tailPresent
  apply visit assembly.placements core.atomCount assembly.templatesValid (Nat.le_refl _)
  · exact Nat.le_refl _
  · intro bond bondPresent
    exact bondPresent
  · intro addend addendPresent
    exact addendPresent

/-- Exact port partition follows from the compiler's exact atom partition plus local validity of
each compiled component. -/
theorem compiledAddends_attachmentPortsPartition
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed) :
    MolecularFullereneAddendPortsPartition
      assembly.compileExtension.assemble carrier assembly.compiledAddends := by
  have compiledValid := assembly.compiledAddends_validFor coreWellFormed
  intro site externalAtom sitePresent externalBound externalOutside
  constructor
  · intro positive
    obtain ⟨addend, addendPresent, externalPresent⟩ :=
      (assembly.compiledAddends_externalAtomsPartition externalAtom externalBound).1
        externalOutside
    refine ⟨addend, addendPresent, ?_⟩
    exact (MolecularFullereneAddend.validFor_port_exact
      (compiledValid addend addendPresent) site externalAtom).2
        ⟨sitePresent, externalPresent, positive⟩
  · rintro ⟨addend, addendPresent, portPresent⟩
    exact ((MolecularFullereneAddend.validFor_port_exact
      (compiledValid addend addendPresent) site externalAtom).1 portPresent).2.2

private theorem compiledAddends_length
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) :
    (molecularFullereneCompiledAddendsFrom offset placements).length = placements.length := by
  induction placements generalizing offset with
  | nil => rfl
  | cons placed rest inductionHypothesis =>
      simp [molecularFullereneCompiledAddendsFrom, inductionHypothesis]

private theorem nodup_of_pairwise_externalAtoms_disjoint
    (addends : List MolecularFullereneAddend)
    (pairwise : addends.Pairwise fun first second =>
      Disjoint first.externalAtoms second.externalAtoms)
    (nonempty : ∀ addend ∈ addends, addend.externalAtoms.Nonempty) :
    addends.Nodup := by
  induction addends with
  | nil => exact List.nodup_nil
  | cons first rest inductionHypothesis =>
      rw [List.pairwise_cons] at pairwise
      rw [List.nodup_cons]
      constructor
      · intro firstInRest
        have disjoint := pairwise.1 first firstInRest
        obtain ⟨atom, atomPresent⟩ := nonempty first (by simp)
        exact (Finset.disjoint_left.mp disjoint) atomPresent atomPresent
      · apply inductionHypothesis pairwise.2
        intro addend addendPresent
        exact nonempty addend (by simp [addendPresent])

/-- Assemble the graph-level relational evidence once concrete rows discharge only the genuinely
constitutional obligations: core well-formedness, identity-class faithfulness, and the
chiral-addend classification.  Per-addend validity, atom/port partitions, and both disjointness
conditions are compiler theorems, not row-authored ledgers. -/
def toRelationalEvidence
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (placementsNonempty : assembly.placements ≠ [])
    (coreWellFormed : core.WellFormed)
    (originalDerivativeChiral : Bool)
    (identityFaithful : ∀ first ∈ assembly.compiledAddends,
      ∀ second ∈ assembly.compiledAddends,
        first.identityClass = second.identityClass ↔
          first.ConstitutionallyIsomorphic assembly.compileExtension.assemble second)
    (chiralIdentityFaithful : ∀ first ∈ assembly.compiledAddends,
      ∀ second ∈ assembly.compiledAddends,
        first.identityClass = second.identityClass →
          (first ∈ assembly.compiledChiralAddends ↔
            second ∈ assembly.compiledChiralAddends)) :
    MolecularFullereneAddendRelationalEvidence
      assembly.compileExtension.assemble carrier := by
  have compiledValid := assembly.compiledAddends_validFor coreWellFormed
  refine
    { addends := assembly.compiledAddends
      originalDerivativeChiral := originalDerivativeChiral
      chiralAddends := assembly.compiledChiralAddends
      addendsNonempty := ?_
      addendsNodup := ?_
      addendsValid := compiledValid
      externalAtomsPairwiseDisjoint :=
        assembly.compiledAddends_externalAtoms_pairwiseDisjoint
      attachmentSitesPairwiseDisjoint :=
        assembly.compiledAddends_attachmentSites_pairwiseDisjoint
      externalAtomsPartition := assembly.compiledAddends_externalAtomsPartition
      attachmentPortsPartition :=
        assembly.compiledAddends_attachmentPortsPartition coreWellFormed
      identityClassesFaithful := identityFaithful
      chiralAddendsOwned := assembly.compiledChiralAddends_owned
      chiralIdentityFaithful := chiralIdentityFaithful }
  · intro empty
    have lengths := compiledAddends_length assembly.placements core.atomCount
    have compiledLengthZero : assembly.compiledAddends.length = 0 := by rw [empty]; rfl
    have placementsLengthZero : assembly.placements.length = 0 := by
      exact lengths ▸ compiledLengthZero
    exact placementsNonempty (List.length_eq_zero_iff.mp placementsLengthZero)
  · apply nodup_of_pairwise_externalAtoms_disjoint assembly.compiledAddends
      assembly.compiledAddends_externalAtoms_pairwiseDisjoint
    intro addend addendPresent
    exact (compiledValid addend addendPresent).2.2.2.1

/-- Compiler-produced extensions preserve raw graph well-formedness. -/
theorem assembleWellFormed
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed) :
    assembly.compileExtension.assemble.WellFormed :=
  assembly.compileExtension.assemble_wellFormed coreWellFormed







theorem assembleBondRecordsUnique
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed)
    (coreBondRecordsUnique : core.BondRecordsUnique) :
    assembly.compileExtension.assemble.BondRecordsUnique := by
  rw [RawMolecule.BondRecordsUnique,
    MolecularFullereneDerivativeExtension.assemble_bonds, List.map_append,
    List.nodup_append]
  refine ⟨coreBondRecordsUnique, ?_, ?_⟩
  · exact compileExtraBondsFrom_edgeKeys_nodup assembly.placements
      assembly.carrier_eq_range assembly.templatesValid core.atomCount (Nat.le_refl _)
  · intro coreKey coreKeyPresent extraKey extraKeyPresent keysEqual
    obtain ⟨coreBond, coreBondPresent, coreKeyEq⟩ := List.mem_map.mp coreKeyPresent
    obtain ⟨extraBond, extraBondPresent, extraKeyEq⟩ := List.mem_map.mp extraKeyPresent
    obtain ⟨coreSourceBound, coreTargetBound, _coreDistinct⟩ :=
      coreWellFormed coreBond coreBondPresent
    have coreMaxLt : max coreBond.source coreBond.target < core.atomCount :=
      max_lt coreSourceBound coreTargetBound
    have extraTargetGe : core.atomCount ≤ extraBond.target :=
      compileExtraBondsFrom_target_ge assembly.placements core.atomCount
        (Nat.le_refl _) extraBond extraBondPresent
    have extraMaxGe : core.atomCount ≤ max extraBond.source extraBond.target :=
      Nat.le_trans extraTargetGe (Nat.le_max_right _ _)
    have maxEqual := congrArg Prod.snd
      (coreKeyEq.trans (keysEqual.trans extraKeyEq.symm))
    simp only [RawBond.edgeKey] at maxEqual
    omega

/-! ## Exact translation of repeated templates -/

private theorem listGet?_append_right {α : Type*} (left right : List α) (index : Nat)
    (bound : left.length ≤ index) :
    listGet? (left ++ right) index = listGet? right (index - left.length) := by
  induction left generalizing index with
  | nil => simp
  | cons head tail inductionHypothesis =>
      cases index with
      | zero => simp at bound
      | succ index =>
          simp only [List.length_cons, Nat.succ_le_succ_iff] at bound
          simpa [listGet?, Nat.succ_sub_succ_eq_sub] using
            inductionHypothesis index bound

private theorem listGet?_append_left {α : Type*} (left right : List α) (index : Nat)
    (bound : index < left.length) :
    listGet? (left ++ right) index = listGet? left index := by
  induction left generalizing index with
  | nil => simp at bound
  | cons head tail inductionHypothesis =>
      cases index with
      | zero => rfl
      | succ index =>
          simp only [List.length_cons, Nat.succ_lt_succ_iff] at bound
          simpa [listGet?] using inductionHypothesis index bound

private theorem compiledExternalAtoms_lookup
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : placements[index]? = some placed)
    (localAtom : Fin placed.template.externalAtoms.length) :
    listGet? (placements.flatMap fun next => next.template.externalAtoms)
        (molecularFullereneAddendPrefixAtomCount placements index + localAtom) =
      some (placed.template.externalAtoms.get localAtom) := by
  induction placements generalizing index with
  | nil => simp at atIndex
  | cons head rest inductionHypothesis =>
      cases index with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at atIndex
          subst head
          rw [show molecularFullereneAddendPrefixAtomCount (placed :: rest) 0 = 0 by
            simp [molecularFullereneAddendPrefixAtomCount]]
          simp only [List.flatMap_cons]
          rw [Nat.zero_add, listGet?_append_left]
          · exact listGet?_eq_some_get _ localAtom
          · exact localAtom.isLt
      | succ index =>
          simp only [List.getElem?_cons_succ] at atIndex
          have bound : head.template.externalAtoms.length ≤
              molecularFullereneAddendPrefixAtomCount (head :: rest) (index + 1) + localAtom := by
            simp [molecularFullereneAddendPrefixAtomCount]
            omega
          simp only [List.flatMap_cons]
          rw [listGet?_append_right _ _ _ bound]
          have prefixEq :
              molecularFullereneAddendPrefixAtomCount (head :: rest) (index + 1) + localAtom -
                  head.template.externalAtoms.length =
                molecularFullereneAddendPrefixAtomCount rest index + localAtom := by
            simp [molecularFullereneAddendPrefixAtomCount, Nat.add_assoc]
          rw [prefixEq]
          exact inductionHypothesis index atIndex

/-- Every local atom of a compiled placement has exactly the source template's `AtomSpec`. -/
theorem compiledAddend_atomSpecAt
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : assembly.placements[index]? = some placed)
    (localAtom : Fin placed.template.externalAtoms.length) :
    assembly.compileExtension.assemble.atomAt?
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + localAtom) =
      some (placed.template.externalAtoms.get localAtom) := by
  unfold RawMolecule.atomAt?
  rw [MolecularFullereneDerivativeExtension.assemble_atoms]
  have bound : core.atoms.length ≤
      molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + localAtom := by
    simp [molecularFullereneAddendExternalOffset, RawMolecule.atomCount]
    omega
  rw [listGet?_append_right _ _ _ bound]
  have reduce :
      molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + localAtom -
          core.atoms.length =
        molecularFullereneAddendPrefixAtomCount assembly.placements index + localAtom := by
    simp [molecularFullereneAddendExternalOffset, RawMolecule.atomCount, Nat.add_assoc]
  rw [reduce]
  exact compiledExternalAtoms_lookup assembly.placements index placed atIndex localAtom

private theorem foldl_directed_eq_of_false (bonds : List RawBond) (left right : Nat)
    (never : ∀ bond ∈ bonds, bond.directedConnects left right = false)
    (initial : BondOrder) :
    bonds.foldl (fun order bond =>
      if bond.directedConnects left right then max order bond.kind.order else order) initial =
      initial := by
  induction bonds generalizing initial with
  | nil => rfl
  | cons bond rest inductionHypothesis =>
      have head := never bond (by simp)
      simp only [List.foldl_cons, head, Bool.false_eq_true, ↓reduceIte]
      exact inductionHypothesis (fun next nextMem => never next (by simp [nextMem])) initial

private theorem foldl_remapLocalBond (bonds : List RawBond) (offset left right : Nat)
    (initial : BondOrder) :
    (bonds.map (molecularFullereneRemapLocalBond offset)).foldl
        (fun order bond => if bond.directedConnects (offset + left) (offset + right)
          then max order bond.kind.order else order) initial =
      bonds.foldl (fun order bond => if bond.directedConnects left right
          then max order bond.kind.order else order) initial := by
  induction bonds generalizing initial with
  | nil => rfl
  | cons bond rest inductionHypothesis =>
      simp only [List.map_cons, List.foldl_cons]
      have connects :
          (molecularFullereneRemapLocalBond offset bond).directedConnects
              (offset + left) (offset + right) = bond.directedConnects left right := by
        simp only [molecularFullereneRemapLocalBond, molecularFullereneRemapLocalAtom,
          RawBond.directedConnects]
        apply congrArg₂ Bool.and
        · apply Bool.eq_iff_iff.mpr
          simp
        · apply Bool.eq_iff_iff.mpr
          simp
      rw [connects]
      exact inductionHypothesis _

private theorem compileExtraBondsFrom_target_ge_offset
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (offset : Nat) (bond : RawBond)
    (present : bond ∈ molecularFullereneCompileExtraBondsFrom offset placements) :
    offset ≤ bond.target := by
  induction placements generalizing offset bond with
  | nil => simp [molecularFullereneCompileExtraBondsFrom] at present
  | cons placed rest inductionHypothesis =>
      simp only [molecularFullereneCompileExtraBondsFrom, List.mem_append] at present
      rcases present with head | tail
      · simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at head
        rcases head with internal | port
        · obtain ⟨localBond, _mem, rfl⟩ := List.mem_map.mp internal
          exact Nat.le_add_right offset _
        · obtain ⟨port, rfl⟩ := List.mem_ofFn.mp port
          exact Nat.le_add_right offset _
      · exact Nat.le_trans (Nat.le_add_right offset _)
          (inductionHypothesis (offset + placed.template.externalAtoms.length) bond tail)

private theorem compileExtraBondsFrom_directed_at_index
    {core : RawMolecule} {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (carrierExact : carrier = Finset.range core.atomCount)
    (templatesValid : ∀ next ∈ placements, next.template.Valid)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : placements[index]? = some placed)
    (offset : Nat) (coreLeOffset : core.atomCount ≤ offset)
    (left right : Nat) (rightBound : right < placed.template.externalAtoms.length) :
    (molecularFullereneCompileExtraBondsFrom offset placements).foldl
        (fun order bond => if bond.directedConnects
          (offset + molecularFullereneAddendPrefixAtomCount placements index + left)
          (offset + molecularFullereneAddendPrefixAtomCount placements index + right)
          then max order bond.kind.order else order) 0 =
      placed.template.localMolecule.directedBondOrder left right := by
  induction placements generalizing index offset with
  | nil => simp at atIndex
  | cons head rest inductionHypothesis =>
      cases index with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at atIndex
          subst head
          simp only [molecularFullereneAddendPrefixAtomCount, List.take_zero, List.map_nil,
            List.sum_nil, Nat.add_zero, molecularFullereneCompileExtraBondsFrom,
            molecularFullereneCompilePlacedBonds, List.foldl_append]
          rw [foldl_remapLocalBond]
          have portsFalse : ∀ bond ∈ List.ofFn (molecularFullereneCompilePortBond offset placed),
              bond.directedConnects (offset + left) (offset + right) = false := by
            intro bond present
            obtain ⟨port, rfl⟩ := List.mem_ofFn.mp present
            have siteLt : placed.attachmentSite port < core.atomCount := by
              rw [← Finset.mem_range, ← carrierExact]
              exact placed.attachmentSite_mem port
            have siteNe : placed.attachmentSite port ≠ offset + left :=
              Nat.ne_of_lt (Nat.lt_of_lt_of_le siteLt
                (Nat.le_trans coreLeOffset (Nat.le_add_right offset left)))
            simp [molecularFullereneCompilePortBond, molecularFullereneRemapLocalAtom,
              RawBond.directedConnects, siteNe]
          rw [foldl_directed_eq_of_false _ _ _ portsFalse]
          apply foldl_directed_eq_of_false
          intro bond present
          have targetGe := compileExtraBondsFrom_target_ge_offset rest
            (offset + placed.template.externalAtoms.length) bond present
          have targetNe : bond.target ≠ offset + right :=
            Nat.ne_of_gt (Nat.lt_of_lt_of_le
              (Nat.add_lt_add_left rightBound offset) targetGe)
          simp [RawBond.directedConnects, targetNe]
      | succ index =>
          simp only [List.getElem?_cons_succ] at atIndex
          simp only [molecularFullereneCompileExtraBondsFrom, List.foldl_append]
          have future : offset + head.template.externalAtoms.length ≤
              offset + molecularFullereneAddendPrefixAtomCount (head :: rest) (index + 1) := by
            simp [molecularFullereneAddendPrefixAtomCount]
          have headFalse : ∀ bond ∈ molecularFullereneCompilePlacedBonds offset head,
              bond.directedConnects
                (offset + molecularFullereneAddendPrefixAtomCount (head :: rest) (index + 1) + left)
                (offset + molecularFullereneAddendPrefixAtomCount (head :: rest) (index + 1) + right) = false := by
            intro bond present
            simp only [molecularFullereneCompilePlacedBonds, List.mem_append] at present
            have targetLt : bond.target < offset + head.template.externalAtoms.length := by
              rcases present with internal | port
              · obtain ⟨localBond, localMem, rfl⟩ := List.mem_map.mp internal
                have valid : head.template.Valid := templatesValid head (by simp)
                exact Nat.add_lt_add_left (valid.2.2.2.1 localBond localMem).2.1 offset
              · obtain ⟨portIndex, rfl⟩ := List.mem_ofFn.mp port
                exact Nat.add_lt_add_left (head.template.port portIndex).externalAtom.isLt offset
            have targetNe : bond.target ≠
                offset + molecularFullereneAddendPrefixAtomCount
                    (head :: rest) (index + 1) + right :=
              Nat.ne_of_lt (Nat.lt_of_lt_of_le targetLt
                (Nat.le_trans future (Nat.le_add_right _ right)))
            simp [RawBond.directedConnects, targetNe]
          rw [foldl_directed_eq_of_false _ _ _ headFalse]
          simpa [molecularFullereneAddendPrefixAtomCount, Nat.add_assoc] using
            inductionHypothesis
              (fun next nextMem => templatesValid next (by simp [nextMem]))
              index atIndex
              (offset + head.template.externalAtoms.length)
              (Nat.le_trans coreLeOffset (Nat.le_add_right offset _))

/-- Internal bond orders are invariant under the compiler's prefix-offset translation. -/
theorem compiledAddend_internalBondOrder
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : assembly.placements[index]? = some placed)
    (left right : Fin placed.template.externalAtoms.length) :
    assembly.compileExtension.assemble.bondOrder
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + left)
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + right) =
      placed.template.localMolecule.bondOrder left right := by
  by_cases same : (left : Nat) = right
  · simp [RawMolecule.bondOrder, same]
  have remappedDifferent :
      molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + left ≠
        molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + right := by
    omega
  simp only [RawMolecule.bondOrder, remappedDifferent, same, ↓reduceIte]
  unfold RawMolecule.directedBondOrder
  simp only [MolecularFullereneDerivativeExtension.assemble_bonds, List.foldl_append]
  have coreFalse : ∀ bond ∈ core.bonds,
      bond.directedConnects
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + left)
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + right) = false := by
    intro bond present
    have sourceLt := (coreWellFormed bond present).1
    have sourceNe : bond.source ≠
        molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + left :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le sourceLt (by
        simp [molecularFullereneAddendExternalOffset]
        omega))
    simp [RawBond.directedConnects, sourceNe]
  have coreFalse' : ∀ bond ∈ core.bonds,
      bond.directedConnects
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + right)
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + left) = false := by
    intro bond present
    have sourceLt := (coreWellFormed bond present).1
    have sourceNe : bond.source ≠
        molecularFullereneAddendExternalOffset core.atomCount assembly.placements index + right :=
      Nat.ne_of_lt (Nat.lt_of_lt_of_le sourceLt (by
        simp [molecularFullereneAddendExternalOffset]
        omega))
    simp [RawBond.directedConnects, sourceNe]
  rw [foldl_directed_eq_of_false _ _ _ coreFalse]
  rw [foldl_directed_eq_of_false _ _ _ coreFalse']
  simp only [compileExtension, compiledExtraBonds,
    molecularFullereneAddendExternalOffset]
  rw [compileExtraBondsFrom_directed_at_index assembly.placements assembly.carrier_eq_range
      assembly.templatesValid
      index placed atIndex core.atomCount (Nat.le_refl _) left right right.isLt]
  rw [compileExtraBondsFrom_directed_at_index assembly.placements assembly.carrier_eq_range
      assembly.templatesValid
      index placed atIndex core.atomCount (Nat.le_refl _) right left left.isLt]
  rfl

/-- Public value of the compiler-produced addend at a known placement index. -/
def compiledPlacedAddend
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    MolecularFullereneAddend :=
  molecularFullereneCompiledAddendAt
    (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index) placed

@[simp] theorem compiledAddend_eq_some_compiledPlacedAddend
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : assembly.placements[index]? = some placed) :
    assembly.compiledAddend index = some (assembly.compiledPlacedAddend index placed) := by
  simp [compiledAddend, atIndex, compiledPlacedAddend]

@[simp] theorem compiledPlacedAddend_externalAtoms_card
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    (assembly.compiledPlacedAddend index placed).externalAtoms.card =
      placed.template.externalAtoms.length := by
  simp [compiledPlacedAddend, molecularFullereneCompiledAddendAt]

theorem MolecularFullereneAddend.constitutionallyIsomorphic_externalAtoms_card_eq
    {molecule : RawMolecule} {first second : MolecularFullereneAddend}
    (isomorphic : first.ConstitutionallyIsomorphic molecule second) :
    first.externalAtoms.card = second.externalAtoms.card := by
  rcases isomorphic with ⟨atomEquivalence, _atoms, _bonds, _sites, _ports,
    _siteMap, _endpointMap, _portBonds⟩
  simpa using Fintype.card_congr atomEquivalence

/-- Different local atom counts are a kernel-level obstruction to constitutional isomorphism. -/
theorem compiledAddends_not_constitutionallyIsomorphic_of_atomCount_ne
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (firstIndex secondIndex : Nat)
    (first second : MolecularFullerenePlacedAddendTemplate carrier)
    (different : first.template.externalAtoms.length ≠
      second.template.externalAtoms.length) :
    ¬(assembly.compiledPlacedAddend firstIndex first).ConstitutionallyIsomorphic
      assembly.compileExtension.assemble
      (assembly.compiledPlacedAddend secondIndex second) := by
  intro isomorphic
  apply different
  simpa using MolecularFullereneAddend.constitutionallyIsomorphic_externalAtoms_card_eq
    isomorphic

private def compiledAtomIndexEquiv (offset count : Nat) :
    Fin count ≃ { atom // atom ∈ Finset.Ico offset (offset + count) } where
  toFun atom := ⟨offset + atom, by simp [atom.isLt]⟩
  invFun atom := ⟨atom.1 - offset, by
    have bounds := Finset.mem_Ico.mp atom.2
    omega⟩
  left_inv atom := by apply Fin.ext; simp
  right_inv atom := by
    apply Subtype.ext
    have bounds := Finset.mem_Ico.mp atom.2
    simp
    omega

private noncomputable def placedAttachmentSiteIndexEquiv
    {carrier : Finset Nat} (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    Fin placed.template.portCount ≃ { site // site ∈ placed.attachmentSites } :=
  Equiv.ofBijective
    (fun port => ⟨placed.attachmentSite port,
      placed.attachmentSite_mem_attachmentSites port⟩)
    ⟨by
      intro first second equal
      apply placed.attachmentSite_injective
      exact congrArg Subtype.val equal,
    by
      rintro ⟨site, siteMem⟩
      simp only [MolecularFullerenePlacedAddendTemplate.attachmentSites,
        Finset.mem_image, Finset.mem_univ, true_and] at siteMem
      obtain ⟨port, equality⟩ := siteMem
      refine ⟨port, ?_⟩
      apply Subtype.ext
      exact equality⟩

private noncomputable def compiledAttachmentPortIndexEquiv
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    Fin placed.template.portCount ≃
      { port // port ∈ (assembly.compiledPlacedAddend index placed).attachmentPorts } :=
  Equiv.ofBijective
    (fun port => ⟨(placed.attachmentSite port,
        molecularFullereneAddendExternalOffset core.atomCount assembly.placements index +
          (placed.template.port port).externalAtom), by
      change _ ∈ Finset.univ.image fun candidate : Fin placed.template.portCount =>
        (placed.attachmentSite candidate,
          molecularFullereneAddendExternalOffset core.atomCount assembly.placements index +
            (placed.template.port candidate).externalAtom)
      exact Finset.mem_image.mpr ⟨port, Finset.mem_univ _, rfl⟩⟩)
    ⟨by
      intro first second equal
      apply placed.attachmentSite_injective
      exact congrArg (fun value => value.1.1) equal,
    by
      rintro ⟨port, portMem⟩
      simp only [compiledPlacedAddend, molecularFullereneCompiledAddendAt,
        Finset.mem_image, Finset.mem_univ, true_and] at portMem
      obtain ⟨portIndex, equality⟩ := portMem
      refine ⟨portIndex, ?_⟩
      apply Subtype.ext
      simpa [molecularFullereneRemapLocalAtom] using equality⟩

private def compiledPlacedAttachmentSitesEquiv
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier) :
    { site // site ∈ (assembly.compiledPlacedAddend index placed).attachmentSites } ≃
      { site // site ∈ placed.attachmentSites } :=
  Equiv.setCongr (by
    funext site
    simp [compiledPlacedAddend])

private theorem compileExtraBondsFrom_port_mem
    {carrier : Finset Nat}
    (placements : List (MolecularFullerenePlacedAddendTemplate carrier))
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : placements[index]? = some placed) (offset : Nat)
    (port : Fin placed.template.portCount) :
    molecularFullereneCompilePortBond
        (offset + molecularFullereneAddendPrefixAtomCount placements index) placed port ∈
      molecularFullereneCompileExtraBondsFrom offset placements := by
  induction placements generalizing index offset with
  | nil => simp at atIndex
  | cons head rest inductionHypothesis =>
      cases index with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq] at atIndex
          subst head
          simp [molecularFullereneCompileExtraBondsFrom,
            molecularFullereneCompilePlacedBonds,
            molecularFullereneAddendPrefixAtomCount]
      | succ index =>
          simp only [List.getElem?_cons_succ] at atIndex
          apply List.mem_append_right
          simpa [molecularFullereneAddendPrefixAtomCount, Nat.add_assoc] using
            inductionHypothesis index atIndex
              (offset + head.template.externalAtoms.length)

/-- The compiled attachment edge retains exactly the local port's declared bond order. -/
theorem compiledAddend_attachmentBondOrder
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed)
    (bondRecordsUnique : assembly.compileExtension.assemble.BondRecordsUnique)
    (index : Nat) (placed : MolecularFullerenePlacedAddendTemplate carrier)
    (atIndex : assembly.placements[index]? = some placed)
    (port : Fin placed.template.portCount) :
    assembly.compileExtension.assemble.bondOrder
        (placed.attachmentSite port)
        (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index +
          (placed.template.port port).externalAtom) =
      (placed.template.port port).bondKind.order := by
  let bond := molecularFullereneCompilePortBond
    (molecularFullereneAddendExternalOffset core.atomCount assembly.placements index) placed port
  apply assembly.compileExtension.assemble.bondOrder_eq_kind_of_mem_connects
    (assembly.assembleWellFormed coreWellFormed) bondRecordsUnique (bond := bond)
  · apply List.mem_append_right
    exact compileExtraBondsFrom_port_mem assembly.placements index placed atIndex
      core.atomCount port
  · simp [bond, molecularFullereneCompilePortBond, molecularFullereneRemapLocalAtom,
      molecularFullereneAddendExternalOffset, RawBond.connects]

/-- Two occurrences of one local template are constitutionally identical by the canonical
prefix-offset translation; no external-atom bijection is supplied by the row. -/
structure MolecularFullerenePlacementOf
    (carrier : Finset Nat) (template : MolecularFullereneLocalAddendTemplate) where
  attachmentSite : Fin template.portCount → Nat
  attachmentSite_mem : ∀ port, attachmentSite port ∈ carrier
  attachmentSite_injective : Function.Injective attachmentSite

namespace MolecularFullerenePlacementOf

def toPlaced {carrier : Finset Nat} {template : MolecularFullereneLocalAddendTemplate}
    (placement : MolecularFullerenePlacementOf carrier template) :
    MolecularFullerenePlacedAddendTemplate carrier where
  template := template
  attachmentSite := placement.attachmentSite
  attachmentSite_mem := placement.attachmentSite_mem
  attachmentSite_injective := placement.attachmentSite_injective

end MolecularFullerenePlacementOf

theorem compiledAddends_constitutionallyIsomorphic_of_sameTemplate
    {core : RawMolecule} {carrier : Finset Nat}
    (assembly : MolecularFullereneAddendTemplateAssembly core carrier)
    (coreWellFormed : core.WellFormed)
    (bondRecordsUnique : assembly.compileExtension.assemble.BondRecordsUnique)
    (template : MolecularFullereneLocalAddendTemplate)
    (firstIndex secondIndex : Nat)
    (first second : MolecularFullerenePlacementOf carrier template)
    (firstAt : assembly.placements[firstIndex]? = some first.toPlaced)
    (secondAt : assembly.placements[secondIndex]? = some second.toPlaced) :
    (assembly.compiledPlacedAddend firstIndex first.toPlaced).ConstitutionallyIsomorphic
      assembly.compileExtension.assemble
      (assembly.compiledPlacedAddend secondIndex second.toPlaced) := by
  let firstPlaced := first.toPlaced
  let secondPlaced := second.toPlaced
  let firstOffset := molecularFullereneAddendExternalOffset
    core.atomCount assembly.placements firstIndex
  let secondOffset := molecularFullereneAddendExternalOffset
    core.atomCount assembly.placements secondIndex
  let firstAtoms := compiledAtomIndexEquiv firstOffset template.externalAtoms.length
  let secondAtoms := compiledAtomIndexEquiv secondOffset template.externalAtoms.length
  let atomEquivalence := firstAtoms.symm.trans secondAtoms
  let firstSites := placedAttachmentSiteIndexEquiv firstPlaced
  let secondSites := placedAttachmentSiteIndexEquiv secondPlaced
  let siteEquivalence := firstSites.symm.trans secondSites
  let compiledSiteEquivalence :
      { site // site ∈ (assembly.compiledPlacedAddend firstIndex firstPlaced).attachmentSites } ≃
        { site // site ∈ (assembly.compiledPlacedAddend secondIndex secondPlaced).attachmentSites } := by
    exact (compiledPlacedAttachmentSitesEquiv assembly firstIndex firstPlaced).trans
      (siteEquivalence.trans
        (compiledPlacedAttachmentSitesEquiv assembly secondIndex secondPlaced).symm)
  let firstPorts := compiledAttachmentPortIndexEquiv assembly firstIndex firstPlaced
  let secondPorts := compiledAttachmentPortIndexEquiv assembly secondIndex secondPlaced
  let portEquivalence := firstPorts.symm.trans secondPorts
  change (assembly.compiledPlacedAddend firstIndex firstPlaced).ConstitutionallyIsomorphic
    assembly.compileExtension.assemble
    (assembly.compiledPlacedAddend secondIndex secondPlaced)
  refine ⟨atomEquivalence, ?_, ?_, compiledSiteEquivalence, portEquivalence, ?_, ?_, ?_⟩
  · intro atom
    let localAtom := firstAtoms.symm atom
    have atomEq : firstAtoms localAtom = atom := firstAtoms.apply_symm_apply atom
    rw [← atomEq]
    have firstObserved := assembly.compiledAddend_atomSpecAt firstIndex firstPlaced firstAt localAtom
    have secondObserved := assembly.compiledAddend_atomSpecAt secondIndex secondPlaced secondAt localAtom
    have atomMap : atomEquivalence (firstAtoms localAtom) = secondAtoms localAtom := by
      simp [atomEquivalence]
    have atomMapVal := congrArg Subtype.val atomMap
    calc
      assembly.compileExtension.assemble.atomAt? (firstAtoms localAtom).1 =
          some (template.externalAtoms.get localAtom) := firstObserved
      _ = assembly.compileExtension.assemble.atomAt? (secondAtoms localAtom).1 :=
        secondObserved.symm
      _ = assembly.compileExtension.assemble.atomAt?
          (atomEquivalence (firstAtoms localAtom)).1 :=
        congrArg assembly.compileExtension.assemble.atomAt? atomMapVal.symm
  · intro left right
    let localLeft := firstAtoms.symm left
    let localRight := firstAtoms.symm right
    have leftEq : firstAtoms localLeft = left := firstAtoms.apply_symm_apply left
    have rightEq : firstAtoms localRight = right := firstAtoms.apply_symm_apply right
    rw [← leftEq, ← rightEq]
    have firstOrder := assembly.compiledAddend_internalBondOrder coreWellFormed
      firstIndex firstPlaced firstAt localLeft localRight
    have secondOrder := assembly.compiledAddend_internalBondOrder coreWellFormed
      secondIndex secondPlaced secondAt localLeft localRight
    have leftMap : atomEquivalence (firstAtoms localLeft) = secondAtoms localLeft := by
      simp [atomEquivalence]
    have rightMap : atomEquivalence (firstAtoms localRight) = secondAtoms localRight := by
      simp [atomEquivalence]
    have leftMapVal := congrArg Subtype.val leftMap
    have rightMapVal := congrArg Subtype.val rightMap
    calc
      assembly.compileExtension.assemble.bondOrder (firstAtoms localLeft).1
          (firstAtoms localRight).1 = template.localMolecule.bondOrder localLeft localRight :=
        firstOrder
      _ = assembly.compileExtension.assemble.bondOrder (secondAtoms localLeft).1
          (secondAtoms localRight).1 := secondOrder.symm
      _ = assembly.compileExtension.assemble.bondOrder
          (atomEquivalence (firstAtoms localLeft)).1
          (atomEquivalence (firstAtoms localRight)).1 := by
        rw [leftMapVal, rightMapVal]
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    apply Subtype.ext
    simp only [portEquivalence, Equiv.trans_apply, Equiv.symm_apply_apply,
      firstPorts, secondPorts, compiledAttachmentPortIndexEquiv]
    simp only [compiledSiteEquivalence, Equiv.trans_apply]
    change secondPlaced.attachmentSite
        (firstSites.symm
          ⟨firstPlaced.attachmentSite portIndex,
            firstPlaced.attachmentSite_mem_attachmentSites portIndex⟩) =
      secondPlaced.attachmentSite portIndex
    have indexedSite :
        (⟨firstPlaced.attachmentSite portIndex,
            firstPlaced.attachmentSite_mem_attachmentSites portIndex⟩ :
          { site // site ∈ firstPlaced.attachmentSites }) = firstSites portIndex := rfl
    rw [indexedSite, firstSites.symm_apply_apply]
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    have firstEndpoint : (firstPorts portIndex).1.2 ∈
        (assembly.compiledPlacedAddend firstIndex firstPlaced).externalAtoms := by
      simp [firstPorts, compiledAttachmentPortIndexEquiv,
        compiledPlacedAddend, molecularFullereneCompiledAddendAt]
    have secondEndpoint : (portEquivalence (firstPorts portIndex)).1.2 ∈
        (assembly.compiledPlacedAddend secondIndex secondPlaced).externalAtoms := by
      simp [portEquivalence, firstPorts, secondPorts,
        compiledAttachmentPortIndexEquiv, compiledPlacedAddend,
        molecularFullereneCompiledAddendAt]
    refine ⟨firstEndpoint, secondEndpoint, ?_⟩
    apply Subtype.ext
    simp only [portEquivalence, Equiv.trans_apply, Equiv.symm_apply_apply,
      firstPorts, secondPorts, compiledAttachmentPortIndexEquiv]
    change (atomEquivalence (firstAtoms (template.port portIndex).externalAtom)).1 =
      (secondAtoms (template.port portIndex).externalAtom).1
    rw [Equiv.trans_apply, firstAtoms.symm_apply_apply]
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    have firstOrder := assembly.compiledAddend_attachmentBondOrder coreWellFormed
      bondRecordsUnique firstIndex firstPlaced firstAt portIndex
    have secondOrder := assembly.compiledAddend_attachmentBondOrder coreWellFormed
      bondRecordsUnique secondIndex secondPlaced secondAt portIndex
    simpa [portEquivalence, firstPorts, secondPorts,
      compiledAttachmentPortIndexEquiv] using firstOrder.trans secondOrder.symm

/-- The canonical same-template isomorphism follows a cage symmetry exactly when that symmetry
maps every source attachment site to the target site carrying the same local port index. -/
theorem compiledAddends_constitutionallyIsomorphicAlong_of_sameTemplate
    {core : RawMolecule} {input : MolecularFullereneConfigurationInput}
    (assembly : MolecularFullereneAddendTemplateAssembly core input.carrier)
    (coreWellFormed : core.WellFormed)
    (bondRecordsUnique : assembly.compileExtension.assemble.BondRecordsUnique)
    (symmetry : Equiv.Perm (MolecularFullereneCarrierAtom input))
    (template : MolecularFullereneLocalAddendTemplate)
    (firstIndex secondIndex : Nat)
    (first second : MolecularFullerenePlacementOf input.carrier template)
    (firstAt : assembly.placements[firstIndex]? = some first.toPlaced)
    (secondAt : assembly.placements[secondIndex]? = some second.toPlaced)
    (siteMap : ∀ port : Fin template.portCount,
      mapMolecularFullereneCarrierAtom input symmetry (first.attachmentSite port) =
        second.attachmentSite port) :
    (assembly.compiledPlacedAddend firstIndex first.toPlaced).ConstitutionallyIsomorphicAlong
      assembly.compileExtension.assemble input symmetry
      (assembly.compiledPlacedAddend secondIndex second.toPlaced) := by
  let firstPlaced := first.toPlaced
  let secondPlaced := second.toPlaced
  let firstOffset := molecularFullereneAddendExternalOffset
    core.atomCount assembly.placements firstIndex
  let secondOffset := molecularFullereneAddendExternalOffset
    core.atomCount assembly.placements secondIndex
  let firstAtoms := compiledAtomIndexEquiv firstOffset template.externalAtoms.length
  let secondAtoms := compiledAtomIndexEquiv secondOffset template.externalAtoms.length
  let atomEquivalence := firstAtoms.symm.trans secondAtoms
  let firstSites := placedAttachmentSiteIndexEquiv firstPlaced
  let secondSites := placedAttachmentSiteIndexEquiv secondPlaced
  let firstCompiledSites :
      Fin template.portCount ≃
        { site // site ∈
          (assembly.compiledPlacedAddend firstIndex firstPlaced).attachmentSites } :=
    firstSites.trans
      (compiledPlacedAttachmentSitesEquiv assembly firstIndex firstPlaced).symm
  let secondCompiledSites :
      Fin template.portCount ≃
        { site // site ∈
          (assembly.compiledPlacedAddend secondIndex secondPlaced).attachmentSites } :=
    secondSites.trans
      (compiledPlacedAttachmentSitesEquiv assembly secondIndex secondPlaced).symm
  let compiledSiteEquivalence := firstCompiledSites.symm.trans secondCompiledSites
  let firstPorts := compiledAttachmentPortIndexEquiv assembly firstIndex firstPlaced
  let secondPorts := compiledAttachmentPortIndexEquiv assembly secondIndex secondPlaced
  let portEquivalence := firstPorts.symm.trans secondPorts
  change (assembly.compiledPlacedAddend firstIndex firstPlaced).ConstitutionallyIsomorphicAlong
    assembly.compileExtension.assemble input symmetry
    (assembly.compiledPlacedAddend secondIndex secondPlaced)
  refine ⟨atomEquivalence, ?_, ?_, compiledSiteEquivalence, ?_, portEquivalence, ?_, ?_, ?_⟩
  · intro atom
    let localAtom := firstAtoms.symm atom
    have atomEq : firstAtoms localAtom = atom := firstAtoms.apply_symm_apply atom
    rw [← atomEq]
    have firstObserved := assembly.compiledAddend_atomSpecAt firstIndex firstPlaced firstAt localAtom
    have secondObserved := assembly.compiledAddend_atomSpecAt secondIndex secondPlaced secondAt localAtom
    have atomMap : atomEquivalence (firstAtoms localAtom) = secondAtoms localAtom := by
      simp [atomEquivalence]
    have atomMapVal := congrArg Subtype.val atomMap
    calc
      assembly.compileExtension.assemble.atomAt? (firstAtoms localAtom).1 =
          some (template.externalAtoms.get localAtom) := firstObserved
      _ = assembly.compileExtension.assemble.atomAt? (secondAtoms localAtom).1 :=
        secondObserved.symm
      _ = assembly.compileExtension.assemble.atomAt?
          (atomEquivalence (firstAtoms localAtom)).1 :=
        congrArg assembly.compileExtension.assemble.atomAt? atomMapVal.symm
  · intro left right
    let localLeft := firstAtoms.symm left
    let localRight := firstAtoms.symm right
    have leftEq : firstAtoms localLeft = left := firstAtoms.apply_symm_apply left
    have rightEq : firstAtoms localRight = right := firstAtoms.apply_symm_apply right
    rw [← leftEq, ← rightEq]
    have firstOrder := assembly.compiledAddend_internalBondOrder coreWellFormed
      firstIndex firstPlaced firstAt localLeft localRight
    have secondOrder := assembly.compiledAddend_internalBondOrder coreWellFormed
      secondIndex secondPlaced secondAt localLeft localRight
    have leftMap : atomEquivalence (firstAtoms localLeft) = secondAtoms localLeft := by
      simp [atomEquivalence]
    have rightMap : atomEquivalence (firstAtoms localRight) = secondAtoms localRight := by
      simp [atomEquivalence]
    have leftMapVal := congrArg Subtype.val leftMap
    have rightMapVal := congrArg Subtype.val rightMap
    calc
      assembly.compileExtension.assemble.bondOrder (firstAtoms localLeft).1
          (firstAtoms localRight).1 = template.localMolecule.bondOrder localLeft localRight :=
        firstOrder
      _ = assembly.compileExtension.assemble.bondOrder (secondAtoms localLeft).1
          (secondAtoms localRight).1 := secondOrder.symm
      _ = assembly.compileExtension.assemble.bondOrder
          (atomEquivalence (firstAtoms localLeft)).1
          (atomEquivalence (firstAtoms localRight)).1 := by
        rw [leftMapVal, rightMapVal]
  · intro site
    obtain ⟨portIndex, rfl⟩ := firstCompiledSites.surjective site
    calc
      (compiledSiteEquivalence (firstCompiledSites portIndex)).1 =
          (secondCompiledSites portIndex).1 :=
        congrArg Subtype.val
          (congrArg secondCompiledSites
            (Equiv.symm_apply_apply firstCompiledSites portIndex))
      _ = secondPlaced.attachmentSite portIndex := rfl
      _ = mapMolecularFullereneCarrierAtom input symmetry
          (firstPlaced.attachmentSite portIndex) := (siteMap portIndex).symm
      _ = mapMolecularFullereneCarrierAtom input symmetry
          (firstCompiledSites portIndex).1 := rfl
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    have portMaps : portEquivalence (firstPorts portIndex) = secondPorts portIndex := by
      exact congrArg secondPorts (Equiv.symm_apply_apply firstPorts portIndex)
    have firstSiteAtPort :
        (⟨(firstPorts portIndex).1.1,
          MolecularFullereneAddend.port_site_mem_attachmentSites
            (firstPorts portIndex).2⟩ :
          { site // site ∈
            (assembly.compiledPlacedAddend firstIndex firstPlaced).attachmentSites }) =
          firstCompiledSites portIndex := by
      apply Subtype.ext
      rfl
    have secondSiteAtPort :
        (⟨(secondPorts portIndex).1.1,
          MolecularFullereneAddend.port_site_mem_attachmentSites
            (secondPorts portIndex).2⟩ :
          { site // site ∈
            (assembly.compiledPlacedAddend secondIndex secondPlaced).attachmentSites }) =
          secondCompiledSites portIndex := by
      apply Subtype.ext
      rfl
    have targetSiteAtPort :
        (⟨(portEquivalence (firstPorts portIndex)).1.1,
          MolecularFullereneAddend.port_site_mem_attachmentSites
            (portEquivalence (firstPorts portIndex)).2⟩ :
          { site // site ∈
            (assembly.compiledPlacedAddend secondIndex secondPlaced).attachmentSites }) =
          secondCompiledSites portIndex := by
      apply Subtype.ext
      exact (congrArg (fun value => value.1.1) portMaps).trans
        (congrArg Subtype.val secondSiteAtPort)
    calc
      compiledSiteEquivalence
          ⟨(firstPorts portIndex).1.1,
            MolecularFullereneAddend.port_site_mem_attachmentSites
              (firstPorts portIndex).2⟩ =
          compiledSiteEquivalence (firstCompiledSites portIndex) :=
        congrArg compiledSiteEquivalence firstSiteAtPort
      _ = secondCompiledSites portIndex :=
        congrArg secondCompiledSites
          (Equiv.symm_apply_apply firstCompiledSites portIndex)
      _ = ⟨(portEquivalence (firstPorts portIndex)).1.1,
          MolecularFullereneAddend.port_site_mem_attachmentSites
            (portEquivalence (firstPorts portIndex)).2⟩ := targetSiteAtPort.symm
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    have firstEndpoint : (firstPorts portIndex).1.2 ∈
        (assembly.compiledPlacedAddend firstIndex firstPlaced).externalAtoms := by
      simp [firstPorts, compiledAttachmentPortIndexEquiv,
        compiledPlacedAddend, molecularFullereneCompiledAddendAt]
    have secondEndpoint : (portEquivalence (firstPorts portIndex)).1.2 ∈
        (assembly.compiledPlacedAddend secondIndex secondPlaced).externalAtoms := by
      simp [portEquivalence, firstPorts, secondPorts,
        compiledAttachmentPortIndexEquiv, compiledPlacedAddend,
        molecularFullereneCompiledAddendAt]
    refine ⟨firstEndpoint, secondEndpoint, ?_⟩
    apply Subtype.ext
    simp only [portEquivalence, Equiv.trans_apply, Equiv.symm_apply_apply,
      firstPorts, secondPorts, compiledAttachmentPortIndexEquiv]
    change (atomEquivalence (firstAtoms (template.port portIndex).externalAtom)).1 =
      (secondAtoms (template.port portIndex).externalAtom).1
    rw [Equiv.trans_apply, firstAtoms.symm_apply_apply]
  · intro port
    obtain ⟨portIndex, rfl⟩ := firstPorts.surjective port
    have firstOrder := assembly.compiledAddend_attachmentBondOrder coreWellFormed
      bondRecordsUnique firstIndex firstPlaced firstAt portIndex
    have secondOrder := assembly.compiledAddend_attachmentBondOrder coreWellFormed
      bondRecordsUnique secondIndex secondPlaced secondAt portIndex
    simpa [portEquivalence, firstPorts, secondPorts,
      compiledAttachmentPortIndexEquiv] using firstOrder.trans secondOrder.symm

