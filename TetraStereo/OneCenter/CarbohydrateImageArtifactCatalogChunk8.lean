@[simp] theorem imageArtifactsChunk8_length : imageArtifactsChunk8.length = 30 := by rfl

def imageArtifactPathsChunk8 : List String :=
  imageArtifactsChunk8.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk8_isChain :
    imageArtifactPathsChunk8.IsChain (· < ·) := by decide

theorem imageArtifactsChunk8_transcribedCount :
    (imageArtifactsChunk8.filter ImageArtifactData.symbolicTemplateTranscribed).length = 6 := by
  decide

theorem imageArtifactsChunk8_transcribedTemplatesWellFormed :
    (imageArtifactsChunk8.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk8_genericAndErratumTranscribed :
    (imageArtifactsChunk8.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk8_kindCounts :
    (imageArtifactsChunk8.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 19 ∧
    (imageArtifactsChunk8.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 5 ∧
    (imageArtifactsChunk8.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 1 ∧
    (imageArtifactsChunk8.filter fun data =>
      data.kind = .typographyGlyph).length = 5 := by
  decide

theorem imageArtifactsChunk8_chemicalPartitionCounts :
    (imageArtifactsChunk8.filter fun data =>
      data.kind.requiresMolecularGraph).length = 25 ∧
    (imageArtifactsChunk8.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 5 := by
  decide

theorem imageArtifactsChunk8_graphAuditMaturityCounts :
    (imageArtifactsChunk8.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 6 ∧
    (imageArtifactsChunk8.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 19 ∧
    (imageArtifactsChunk8.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 5 := by
  decide

