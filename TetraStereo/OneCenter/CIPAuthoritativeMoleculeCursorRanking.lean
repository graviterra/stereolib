import TetraStereo.OneCenter.CIPAuthoritativeCursorSupport
import TetraStereo.OneCenter.ProductionCIPExactExpansion

set_option autoImplicit false

namespace TetraStereo.OneCenter.AuthoritativeCIPMoleculeCursorRanking

open RawMolecule
open AuthoritativeCIPCursorSupport

/-!
# A molecule-derived termination ranking for re-rooted CIP occurrences

The occurrence cursor is a directed edge of the finite canonical CIP tree.  A cursor reached from
its canonical parent is descending; a cursor reached from one of its canonical children is
ascending.  Ascending moves shorten the stored history.  A move from an ascending cursor into a
different child changes direction once, after which every move lengthens the duplicate-free real
history until a forced duplicate leaf is reached.

The ranking below turns that argument into the `CursorTerminationRanking` consumed by the uncapped
Rules-1a--6 totality theorem.  Its width premise is stated as the local P-92 bonding-number-six
condition on the canonical tree, not as an operational frontier cap.
-/

/-- Nodes generated by the canonical CIP child relation from one molecular center. -/
inductive CanonicalCenterTreeNode (mol : RawMolecule) (center : Nat) :
    CanonicalBranchNode → Prop
  | root : CanonicalCenterTreeNode mol center (canonicalCenterRoot center)
  | child {parent child : CanonicalBranchNode} :
      CanonicalCenterTreeNode mol center parent →
      child ∈ mol.canonicalChildren parent →
      CanonicalCenterTreeNode mol center child

/-- An oriented edge of the canonical center tree.  These are exactly the cursor states produced
by taking one neighbor and remembering the node just left. -/
inductive CanonicalCenterRerootCursor (mol : RawMolecule) (center : Nat) :
    CanonicalRerootCursor → Prop
  | descending {parent node : CanonicalBranchNode} :
      CanonicalCenterTreeNode mol center parent →
      node ∈ mol.canonicalChildren parent →
      CanonicalCenterRerootCursor mol center
        { node := node, previous? := some parent }
  | ascending {node child : CanonicalBranchNode} :
      CanonicalCenterTreeNode mol center node →
      child ∈ mol.canonicalChildren node →
      CanonicalCenterRerootCursor mol center
        { node := node, previous? := some child }

/-- Local form of the P-92 bonding-number-six applicability boundary.  The uncut canonical
neighborhood has at most six occurrences; deleting the incoming cursor edge therefore leaves the
five forward slots used by the authoritative comparator. -/
def CanonicalCenterBondingNumberSix (mol : RawMolecule) (center : Nat) : Prop :=
  ∀ node, CanonicalCenterTreeNode mol center node →
    (canonicalOriginalParent? node).toList.length + (mol.canonicalChildren node).length ≤ 6

/-- A generated child extends the stored canonical history by exactly one occurrence. -/
theorem child_history_length {mol : RawMolecule} {parent child : CanonicalBranchNode}
    (member : child ∈ mol.canonicalChildren parent) :
    child.history.length = parent.history.length + 1 := by
  rw [mol.canonicalChildren_history parent child member]
  simp

/-- A real generated child is fresh in its parent's path. -/
theorem real_child_not_mem_history {mol : RawMolecule} {parent child : CanonicalBranchNode}
    (member : child ∈ mol.canonicalChildren parent)
    (real : child.provenance = CanonicalNodeProvenance.realAtom) :
    child.atom ∉ parent.history := by
  unfold RawMolecule.canonicalChildren at member
  by_cases leaf : parent.forcedLeaf
  · simp [leaf] at member
  · simp only [leaf, Bool.false_eq_true, ↓reduceIte, List.mem_map] at member
    rcases member with ⟨copy, _copyMember, rfl⟩
    simp only at real
    by_cases multiple : copy.2 != 0
    · simp [multiple] at real
    · by_cases ring : copy.1 ∈ parent.history
      · simp [multiple, ring] at real
      · exact ring

/-- Every atom occurrence emitted as a child of a well-formed raw molecule is in range. -/
theorem child_atom_lt_atomCount {mol : RawMolecule} (wellFormed : mol.WellFormed)
    {parent child : CanonicalBranchNode}
    (member : child ∈ mol.canonicalChildren parent) :
    child.atom < mol.atomCount := by
  unfold RawMolecule.canonicalChildren at member
  by_cases leaf : parent.forcedLeaf
  · simp [leaf] at member
  · simp only [leaf, Bool.false_eq_true, ↓reduceIte, List.mem_map] at member
    rcases member with ⟨copy, copyMember, rfl⟩
    rcases mol.canonicalChildCopies_source parent copy copyMember with
      ⟨bond, bondMember, endpoints, _copyIndex⟩
    have endpointsOK := wellFormed bond bondMember
    rcases endpoints with endpoints | endpoints
    · simpa [endpoints.2] using endpointsOK.2.1
    · simpa [endpoints.2] using endpointsOK.1

/-- Real nodes in a center-generated canonical tree have a duplicate-free, in-range history. -/
theorem CanonicalCenterTreeNode.real_history
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    {node : CanonicalBranchNode} (generated : CanonicalCenterTreeNode mol center node)
    (wellFormed : mol.WellFormed)
    (real : node.provenance = CanonicalNodeProvenance.realAtom) :
    node.history.Nodup ∧ (∀ atom, atom ∈ node.history → atom < mol.atomCount) := by
  induction generated with
  | root =>
      simp [canonicalCenterRoot, centerBound]
  | @child parent child parentGenerated member ih =>
      have parentNotLeaf : parent.forcedLeaf = false := by
        by_contra parentLeaf
        have parentLeafTrue : parent.forcedLeaf = true := Bool.eq_true_of_not_eq_false parentLeaf
        simp [RawMolecule.canonicalChildren, parentLeafTrue] at member
      have parentReal : parent.provenance = CanonicalNodeProvenance.realAtom := by
        cases provenanceEq : parent.provenance <;>
          simp [CanonicalBranchNode.forcedLeaf, provenanceEq] at parentNotLeaf
        rfl
      rcases ih parentReal with ⟨parentNodup, parentBounds⟩
      rw [mol.canonicalChildren_history parent child member]
      refine ⟨List.Nodup.cons (real_child_not_mem_history member real) parentNodup, ?_⟩
      intro atom atomMember
      simp only [List.mem_cons] at atomMember
      rcases atomMember with rfl | atomMember
      · exact child_atom_lt_atomCount wellFormed member
      · exact parentBounds atom atomMember

/-- A real generated history cannot contain more entries than the molecule has atoms. -/
theorem CanonicalCenterTreeNode.real_history_length_le_atomCount
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    {node : CanonicalBranchNode} (generated : CanonicalCenterTreeNode mol center node)
    (wellFormed : mol.WellFormed)
    (real : node.provenance = CanonicalNodeProvenance.realAtom) :
    node.history.length ≤ mol.atomCount := by
  rcases generated.real_history centerBound wellFormed real with ⟨nodup, bounds⟩
  rw [← List.toFinset_card_of_nodup nodup]
  have subset : node.history.toFinset ⊆ Finset.range mol.atomCount := by
    intro atom atomMember
    simp only [List.mem_toFinset, Finset.mem_range] at atomMember ⊢
    exact bounds atom atomMember
  simpa using Finset.card_le_card subset

/-- A generated node with a child is necessarily a real occurrence. -/
theorem real_of_child_mem {mol : RawMolecule} {parent child : CanonicalBranchNode}
    (member : child ∈ mol.canonicalChildren parent) :
    parent.provenance = CanonicalNodeProvenance.realAtom := by
  have notLeaf : parent.forcedLeaf = false := by
    by_contra notFalse
    have leaf : parent.forcedLeaf = true := Bool.eq_true_of_not_eq_false notFalse
    simp [RawMolecule.canonicalChildren, leaf] at member
  cases provenanceEq : parent.provenance <;>
    simp [CanonicalBranchNode.forcedLeaf, provenanceEq] at notLeaf
  rfl

/-- Every generated center-tree node stores its own atom at the head of its history. -/
theorem CanonicalCenterTreeNode.history_head
    {mol : RawMolecule} {center : Nat} {node : CanonicalBranchNode}
    (generated : CanonicalCenterTreeNode mol center node) :
    node.history.head? = some node.atom := by
  cases generated with
  | root => simp [canonicalCenterRoot]
  | child parentGenerated member =>
      exact mol.canonicalChildren_history_head _ _ member

/-- Canonical parent recovery is exact on every generated child occurrence. -/
theorem canonicalOriginalParent?_eq_some_of_child
    {mol : RawMolecule} {center : Nat} {parent child : CanonicalBranchNode}
    (parentGenerated : CanonicalCenterTreeNode mol center parent)
    (member : child ∈ mol.canonicalChildren parent) :
    canonicalOriginalParent? child = some parent := by
  have parentReal := real_of_child_mem member
  have childHistory := mol.canonicalChildren_history parent child member
  induction parentGenerated with
  | root =>
      simp [canonicalOriginalParent?, canonicalCenterRoot, childHistory]
  | @child grandparent parent grandparentGenerated parentMember ih =>
      have grandparentHead := grandparentGenerated.history_head
      have parentHistory := mol.canonicalChildren_history grandparent parent parentMember
      have parentParent : parent.parent = grandparent.atom := by
        unfold RawMolecule.canonicalChildren at parentMember
        by_cases leaf : grandparent.forcedLeaf
        · simp [leaf] at parentMember
        · simp only [leaf, Bool.false_eq_true, ↓reduceIte, List.mem_map] at parentMember
          rcases parentMember with ⟨copy, _copyMember, parentEq⟩
          rw [← parentEq]
      cases historyEq : grandparent.history with
      | nil => simp [historyEq] at grandparentHead
      | cons grandparentAtom rest =>
          have atomEq : grandparentAtom = grandparent.atom := by
            simpa [historyEq] using grandparentHead
          subst grandparentAtom
          unfold canonicalOriginalParent?
          rw [childHistory, parentHistory]
          simp only [historyEq]
          cases parent
          simp_all

/-- Every canonical neighbor of a generated node is either its generated parent or one of its
generated children. -/
theorem CanonicalCenterTreeNode.neighbor_cases
    {mol : RawMolecule} {center : Nat} {node neighbor : CanonicalBranchNode}
    (generated : CanonicalCenterTreeNode mol center node)
    (member : neighbor ∈ ({ node := node } : CanonicalRerootCursor).neighbors mol) :
    (CanonicalCenterTreeNode mol center neighbor ∧
        node ∈ mol.canonicalChildren neighbor) ∨
      (neighbor ∈ mol.canonicalChildren node) := by
  unfold CanonicalRerootCursor.neighbors at member
  simp only [List.mem_append, Option.mem_toList] at member
  rcases member with parentCase | childCase
  · cases generated with
    | root =>
        simp [canonicalOriginalParent?, canonicalCenterRoot] at parentCase
    | @child parent node parentGenerated nodeMember =>
        have recovered := canonicalOriginalParent?_eq_some_of_child parentGenerated nodeMember
        have neighborEq : neighbor = parent := by
          rw [recovered] at parentCase
          exact Option.some.inj parentCase.symm
        subst neighbor
        exact Or.inl ⟨parentGenerated, nodeMember⟩
  · exact Or.inr childCase

/-- Membership in a cursor's filtered forward list exposes the selected uncut neighbor and the
remembered-edge inequality. -/
theorem mem_cursor_children_of_previous
    {mol : RawMolecule} {node previous : CanonicalBranchNode}
    {child : CanonicalRerootCursor}
    (member : child ∈
      ({ node := node, previous? := some previous } : CanonicalRerootCursor).children mol) :
    ∃ neighbor,
      neighbor ∈ ({ node := node } : CanonicalRerootCursor).neighbors mol ∧
      neighbor ≠ previous ∧
      child = { node := neighbor, previous? := some node } := by
  unfold CanonicalRerootCursor.children at member
  by_cases leaf : node.forcedLeaf
  · simp [leaf] at member
  · simp only [leaf, Bool.false_eq_true, ↓reduceIte, List.mem_filterMap] at member
    rcases member with ⟨neighbor, neighborMember, selected⟩
    by_cases same : neighbor == previous
    · simp [same] at selected
    · have different : neighbor ≠ previous := by simpa using same
      simp [same] at selected
      exact ⟨neighbor, neighborMember, different, selected.symm⟩

/-- The molecule-derived cursor domain is closed under every forward reroot child. -/
theorem CanonicalCenterRerootCursor.child
    {mol : RawMolecule} {center : Nat} {cursor child : CanonicalRerootCursor}
    (eligible : CanonicalCenterRerootCursor mol center cursor)
    (member : child ∈ cursor.children mol) :
    CanonicalCenterRerootCursor mol center child := by
  cases eligible with
  | @descending parent node parentGenerated nodeMember =>
      rcases mem_cursor_children_of_previous member with
        ⟨neighbor, neighborMember, different, rfl⟩
      have nodeGenerated := CanonicalCenterTreeNode.child parentGenerated nodeMember
      rcases nodeGenerated.neighbor_cases neighborMember with parentCase | childCase
      · rcases parentCase with ⟨neighborGenerated, nodeFromNeighbor⟩
        have fromParent := canonicalOriginalParent?_eq_some_of_child parentGenerated nodeMember
        have fromNeighbor :=
          canonicalOriginalParent?_eq_some_of_child neighborGenerated nodeFromNeighbor
        have neighborEq : neighbor = parent := by
          rw [fromParent] at fromNeighbor
          exact (Option.some.inj fromNeighbor).symm
        exact False.elim (different neighborEq)
      · exact .descending nodeGenerated childCase
  | @ascending node previous nodeGenerated previousMember =>
      rcases mem_cursor_children_of_previous member with
        ⟨neighbor, neighborMember, _different, rfl⟩
      rcases nodeGenerated.neighbor_cases neighborMember with parentCase | childCase
      · rcases parentCase with ⟨neighborGenerated, nodeFromNeighbor⟩
        exact .ascending neighborGenerated nodeFromNeighbor
      · exact .descending nodeGenerated childCase



def moleculeCursorHeight (mol : RawMolecule) (cursor : CanonicalRerootCursor) : Nat :=
  match cursor.previous? with
  | none => 0
  | some previous =>
      if previous.history.length < cursor.node.history.length then
        mol.atomCount + 1 - cursor.node.history.length
      else
        mol.atomCount + 1 + cursor.node.history.length

@[simp] theorem moleculeCursorHeight_descending
    {mol : RawMolecule} {parent node : CanonicalBranchNode}
    (member : node ∈ mol.canonicalChildren parent) :
    moleculeCursorHeight mol { node := node, previous? := some parent } =
      mol.atomCount + 1 - node.history.length := by
  simp [moleculeCursorHeight, child_history_length member]

@[simp] theorem moleculeCursorHeight_ascending
    {mol : RawMolecule} {node child : CanonicalBranchNode}
    (member : child ∈ mol.canonicalChildren node) :
    moleculeCursorHeight mol { node := node, previous? := some child } =
      mol.atomCount + 1 + node.history.length := by
  have lengthEq := child_history_length member
  simp [moleculeCursorHeight, lengthEq]

/-- General list fact used by the local bonding-number proof: if `filterMap` drops a known member,
its result is strictly shorter than its input. -/
theorem length_filterMap_lt_of_mem_eq_none {α β : Type*} (f : α → Option β)
    {values : List α} {value : α} (member : value ∈ values) (dropped : f value = none) :
    (values.filterMap f).length < values.length := by
  induction values with
  | nil => simp at member
  | cons head tail ih =>
      simp only [List.mem_cons] at member
      rcases member with rfl | member
      · simp only [List.filterMap_cons_none dropped, List.length_cons]
        exact Nat.lt_succ_of_le (List.length_filterMap_le f tail)
      · cases observed : f head with
        | none =>
            simp only [List.filterMap_cons_none observed, List.length_cons]
            exact (ih member).trans_le (Nat.le_succ _)
        | some result =>
            simp only [List.filterMap_cons_some observed, List.length_cons]
            exact Nat.succ_lt_succ (ih member)

/-- The remembered incoming occurrence is present in the uncut neighborhood. -/
theorem CanonicalCenterRerootCursor.previous_mem_neighbors
    {mol : RawMolecule} {center : Nat} {cursor : CanonicalRerootCursor}
    (eligible : CanonicalCenterRerootCursor mol center cursor) :
    ∃ previous, cursor.previous? = some previous ∧
      previous ∈ ({ node := cursor.node } : CanonicalRerootCursor).neighbors mol := by
  cases eligible with
  | @descending parent node parentGenerated nodeMember =>
      have recovered := canonicalOriginalParent?_eq_some_of_child parentGenerated nodeMember
      refine ⟨parent, rfl, ?_⟩
      simp [CanonicalRerootCursor.neighbors, recovered]
  | @ascending node child nodeGenerated childMember =>
      refine ⟨child, rfl, ?_⟩
      simp [CanonicalRerootCursor.neighbors, childMember]

/-- A non-leaf canonical occurrence is real. -/
theorem real_of_forcedLeaf_eq_false {node : CanonicalBranchNode}
    (notLeaf : node.forcedLeaf = false) :
    node.provenance = CanonicalNodeProvenance.realAtom := by
  cases provenanceEq : node.provenance <;>
    simp [CanonicalBranchNode.forcedLeaf, provenanceEq] at notLeaf
  rfl

/-- Height zero is possible only at a terminal duplicate occurrence. -/
theorem moleculeCursorHeight_zero_terminal
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed) (cursor : CanonicalRerootCursor)
    (eligible : CanonicalCenterRerootCursor mol center cursor)
    (heightZero : moleculeCursorHeight mol cursor = 0) :
    cursorTerminal mol cursor = true := by
  cases eligible with
  | @descending parent node parentGenerated nodeMember =>
      by_cases leaf : node.forcedLeaf = true
      · simp [cursorTerminal, leaf]
      · have notLeaf : node.forcedLeaf = false := Bool.eq_false_of_not_eq_true leaf
        have nodeReal := real_of_forcedLeaf_eq_false notLeaf
        have nodeGenerated := CanonicalCenterTreeNode.child parentGenerated nodeMember
        have lengthLe := nodeGenerated.real_history_length_le_atomCount
          centerBound wellFormed nodeReal
        rw [moleculeCursorHeight_descending nodeMember] at heightZero
        omega
  | @ascending node child nodeGenerated childMember =>
      rw [moleculeCursorHeight_ascending childMember] at heightZero
      omega

/-- Removing the remembered incoming occurrence from a bonding-number-six neighborhood leaves at
most the five authoritative forward slots. -/
theorem canonicalCenterRerootCursor_local_width
    {mol : RawMolecule} {center : Nat}
    (bonding : CanonicalCenterBondingNumberSix mol center)
    (cursor : CanonicalRerootCursor)
    (eligible : CanonicalCenterRerootCursor mol center cursor) :
    (cursor.children mol).length ≤ RawMolecule.authoritativeChildSlots := by
  rcases eligible.previous_mem_neighbors with ⟨previous, previousEq, previousMember⟩
  have nodeGenerated : CanonicalCenterTreeNode mol center cursor.node := by
    cases eligible with
    | descending parentGenerated nodeMember => exact .child parentGenerated nodeMember
    | ascending nodeGenerated childMember => exact nodeGenerated
  by_cases leaf : cursor.node.forcedLeaf = true
  · simp [CanonicalRerootCursor.children, leaf]
  · have notLeaf : cursor.node.forcedLeaf = false := Bool.eq_false_of_not_eq_true leaf
    have previousMember' : previous ∈ cursor.neighbors mol := by
      simpa [CanonicalRerootCursor.neighbors] using previousMember
    have neighborBound :
        (cursor.neighbors mol).length ≤ 6 := by
      simpa [CanonicalRerootCursor.neighbors] using bonding cursor.node nodeGenerated
    have dropped :
        ((cursor.neighbors mol).filterMap
          (fun neighbor =>
            if neighbor == previous then none
            else some ({ node := neighbor, previous? := some cursor.node } :
              CanonicalRerootCursor))).length <
          (cursor.neighbors mol).length := by
      apply length_filterMap_lt_of_mem_eq_none _ previousMember'
      simp
    rw [CanonicalRerootCursor.children, notLeaf]
    simp only [Bool.false_eq_true, ↓reduceIte, previousEq]
    unfold RawMolecule.authoritativeChildSlots
    omega

/-- Every reroot child strictly decreases the explicit molecule-derived height. -/
theorem moleculeCursorHeight_child_lt
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed) {cursor child : CanonicalRerootCursor}
    (eligible : CanonicalCenterRerootCursor mol center cursor)
    (member : child ∈ cursor.children mol) :
    moleculeCursorHeight mol child < moleculeCursorHeight mol cursor := by
  cases eligible with
  | @descending parent node parentGenerated nodeMember =>
      rcases mem_cursor_children_of_previous member with
        ⟨neighbor, neighborMember, different, rfl⟩
      have nodeGenerated := CanonicalCenterTreeNode.child parentGenerated nodeMember
      rcases nodeGenerated.neighbor_cases neighborMember with parentCase | childCase
      · rcases parentCase with ⟨neighborGenerated, nodeFromNeighbor⟩
        have fromParent := canonicalOriginalParent?_eq_some_of_child parentGenerated nodeMember
        have fromNeighbor :=
          canonicalOriginalParent?_eq_some_of_child neighborGenerated nodeFromNeighbor
        have neighborEq : neighbor = parent := by
          rw [fromParent] at fromNeighbor
          exact (Option.some.inj fromNeighbor).symm
        exact False.elim (different neighborEq)
      · have nodeReal := real_of_child_mem childCase
        have lengthLe := nodeGenerated.real_history_length_le_atomCount
          centerBound wellFormed nodeReal
        rw [moleculeCursorHeight_descending nodeMember,
          moleculeCursorHeight_descending childCase]
        have childLength := child_history_length childCase
        omega
  | @ascending node previous nodeGenerated previousMember =>
      rcases mem_cursor_children_of_previous member with
        ⟨neighbor, neighborMember, _different, rfl⟩
      rcases nodeGenerated.neighbor_cases neighborMember with parentCase | childCase
      · rcases parentCase with ⟨neighborGenerated, nodeFromNeighbor⟩
        rw [moleculeCursorHeight_ascending previousMember,
          moleculeCursorHeight_ascending nodeFromNeighbor]
        have nodeLength := child_history_length nodeFromNeighbor
        omega
      · rw [moleculeCursorHeight_ascending previousMember,
          moleculeCursorHeight_descending childCase]
        have childLength := child_history_length childCase
        omega

/-- The finite canonical center tree and the local bonding-number-six condition construct the
complete well-founded cursor certificate; recursive support is no longer an independent premise. -/
def canonicalCenterCursorTerminationRanking
    (mol : RawMolecule) (center : Nat) (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed)
    (bonding : CanonicalCenterBondingNumberSix mol center) :
    CursorTerminationRanking mol where
  eligible := CanonicalCenterRerootCursor mol center
  height := moleculeCursorHeight mol
  zero_terminal := moleculeCursorHeight_zero_terminal centerBound wellFormed
  local_width := canonicalCenterRerootCursor_local_width bonding
  child_eligible := fun _cursor _child eligible member => eligible.child member
  child_decreases := fun _cursor _child eligible member =>
    moleculeCursorHeight_child_lt centerBound wellFormed eligible member

/-- Every eligible reroot cursor fits a uniform bound determined solely by the finite atom count.
No number of paths or sphere-frontier cardinality appears in the bound. -/
theorem moleculeCursorHeight_le_two_mul_atomCount_add_one
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed) {cursor : CanonicalRerootCursor}
    (eligible : CanonicalCenterRerootCursor mol center cursor) :
    moleculeCursorHeight mol cursor ≤ 2 * mol.atomCount + 1 := by
  cases eligible with
  | @descending parent node parentGenerated nodeMember =>
      rw [moleculeCursorHeight_descending nodeMember]
      omega
  | @ascending node child nodeGenerated childMember =>
      have nodeReal := real_of_child_mem childMember
      have lengthLe := nodeGenerated.real_history_length_le_atomCount
        centerBound wellFormed nodeReal
      rw [moleculeCursorHeight_ascending childMember]
      omega

/-- The canonical molecule ranking directly supplies recursive comparator support at the uniform
`2 * atomCount + 1` depth. -/
theorem canonicalCenterCursorSupport
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed)
    (bonding : CanonicalCenterBondingNumberSix mol center)
    {cursor : CanonicalRerootCursor}
    (eligible : CanonicalCenterRerootCursor mol center cursor) :
    AuthoritativeCIPRule6Completeness.CursorSupport mol (2 * mol.atomCount + 1) cursor := by
  let ranking := canonicalCenterCursorTerminationRanking mol center centerBound wellFormed bonding
  apply ranking.cursorSupport_of_height_le (2 * mol.atomCount + 1) cursor eligible
  exact moleculeCursorHeight_le_two_mul_atomCount_add_one centerBound wellFormed eligible

/-- A ligand cursor selected from a generated occurrence exposes one uncut canonical neighbor. -/
theorem mem_occurrenceLigandCursors
    {mol : RawMolecule} {occurrence : CanonicalBranchNode} {cursor : CanonicalRerootCursor}
    (member : cursor ∈ occurrenceLigandCursors mol occurrence) :
    ∃ neighbor,
      neighbor ∈ ({ node := occurrence } : CanonicalRerootCursor).neighbors mol ∧
      cursor = { node := neighbor, previous? := some occurrence } := by
  unfold occurrenceLigandCursors CanonicalRerootCursor.children at member
  by_cases leaf : occurrence.forcedLeaf
  · simp [leaf] at member
  · simp only [leaf, Bool.false_eq_true, ↓reduceIte, List.mem_filterMap] at member
    rcases member with ⟨neighbor, neighborMember, selected⟩
    exact ⟨neighbor, neighborMember, by simpa using selected.symm⟩

/-- Every actual ligand cursor around a generated occurrence belongs to the canonical reroot
domain, whether it points toward the original root or away into a child branch. -/
theorem occurrenceLigandCursor_eligible
    {mol : RawMolecule} {center : Nat} {occurrence : CanonicalBranchNode}
    (occurrenceGenerated : CanonicalCenterTreeNode mol center occurrence)
    {cursor : CanonicalRerootCursor}
    (member : cursor ∈ occurrenceLigandCursors mol occurrence) :
    CanonicalCenterRerootCursor mol center cursor := by
  rcases mem_occurrenceLigandCursors member with ⟨neighbor, neighborMember, rfl⟩
  rcases occurrenceGenerated.neighbor_cases neighborMember with parentCase | childCase
  · rcases parentCase with ⟨neighborGenerated, occurrenceFromNeighbor⟩
    exact .ascending neighborGenerated occurrenceFromNeighbor
  · exact .descending occurrenceGenerated childCase

/-- All actual ligand cursors at a generated occurrence have recursive support at the uniform
molecule-size bound. -/
theorem occurrenceLigandCursors_supported
    {mol : RawMolecule} {center : Nat} (centerBound : center < mol.atomCount)
    (wellFormed : mol.WellFormed)
    (bonding : CanonicalCenterBondingNumberSix mol center)
    {occurrence : CanonicalBranchNode}
    (occurrenceGenerated : CanonicalCenterTreeNode mol center occurrence) :
    ∀ cursor, cursor ∈ occurrenceLigandCursors mol occurrence →
      AuthoritativeCIPRule6Completeness.CursorSupport mol (2 * mol.atomCount + 1) cursor := by
  intro cursor member
  exact canonicalCenterCursorSupport centerBound wellFormed bonding
    (occurrenceLigandCursor_eligible occurrenceGenerated member)

/-- The first canonical ligand edge at a center belongs to the molecule-derived cursor domain. -/
theorem canonicalRootCursor_eligible
    {mol : RawMolecule} {center ligand : Nat}
    (member : canonicalRoot center ligand ∈
      mol.canonicalChildren (canonicalCenterRoot center)) :
    CanonicalCenterRerootCursor mol center
      { node := canonicalRoot center ligand,
        previous? := some (canonicalCenterRoot center) } :=
  .descending .root member

end TetraStereo.OneCenter.AuthoritativeCIPMoleculeCursorRanking
