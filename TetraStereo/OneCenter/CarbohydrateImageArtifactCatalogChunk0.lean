@[simp] theorem imageArtifactsChunk0_length : imageArtifactsChunk0.length = 50 := by rfl

def imageArtifactPathsChunk0 : List String :=
  imageArtifactsChunk0.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk0_isChain :
    imageArtifactPathsChunk0.IsChain (· < ·) := by decide

theorem imageArtifactsChunk0_transcribedCount :
    (imageArtifactsChunk0.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk0_transcribedTemplatesWellFormed :
    (imageArtifactsChunk0.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk0_genericAndErratumTranscribed :
    (imageArtifactsChunk0.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk0_kindCounts :
    (imageArtifactsChunk0.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk0.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk0.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk0.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk0_chemicalPartitionCounts :
    (imageArtifactsChunk0.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk0.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk0_graphAuditMaturityCounts :
    (imageArtifactsChunk0.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk0.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk0.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

