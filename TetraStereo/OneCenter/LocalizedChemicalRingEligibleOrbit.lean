import TetraStereo.OneCenter.LocalizedChemicalRingMovedSlotEligibility
import TetraStereo.KernelOnly

set_option autoImplicit false
set_option maxHeartbeats 1600000

/-!
# Local eligibility is one actual-key class, and its actual-action orbit

At a real detected four-ligand occurrence reached inside a Rule-1a-tied carrier root
branch, the actual incoming frame slot (`parent`) is absent from the actual eligible
reference population.  The remaining eligible slots are exactly one ordinary-key class:
the parent key is a singleton class, and any two eligible slots (each has a partner with
the same empty-state key) have equal keys.  The proof is combinatorial on `Fin 4`; it does
not assume transitivity of the comparator relation, only the exact tie characterization
`eligible_iff_other` and the comparator equality law already used to prove it.

An actual frame action is a molecular automorphism fixing the node history together with
the slot permutation it induces on the four-ligand frame, transporting reference atoms and
preserving the ordinary keys.  Such actions exist from the actual comparison transport
(`actual_slot_key_action`).  Every actual frame action fixes the excluded parent slot.
Keys are invariant along the reachability relation generated by these actions, and
eligibility is preserved by it.  Consequently, if every slot with the reference's
ordinary key is reachable by an actual frame action (the explicit `ReachComplete`
hypothesis, i.e. the missing reconstruction completeness), then the eligible population
is exactly the actual-action reachable set from any eligible reference.  Under the further
explicit hypothesis that actual frame actions preserve the generated physical reading, all
eligible local readings agree.

The unconditional results are parent exclusion, uniqueness of the eligible key class,
parent fixation by actual actions, and `Reachable ⊆ eligible`.  The two hypotheses of the
orbit/reading corollaries isolate the residual reconstruction and generated-label
orientation transport; they are not derived here and no physical properness or global
consensus claim is made.
-/
namespace TetraStereo.OneCenter.LocalizedChemicalRingEligibleOrbit

open CertifiedLocalizedCIPInput DeclarativeCIP
open LocalizedChemicalRingInheritedRefusalCases
open LocalizedChemicalRingSelectedParentEligibility
open LocalizedChemicalRingSelectedRefusalWitness
open LocalizedChemicalRingMovedSlotEligibility
open LocalizedChemicalRingPhysicalSense
open LocalizedMarkedReachableConfigurations (Reached)
open LocalizedMarkedRetainedPromotedRanking (frames)
open LocalizedGenericMarkedRecalculation (Geometry)

noncomputable section
open scoped Classical

/-! ## Combinatorial uniqueness of the nonsingleton key class -/

/-- Four pairwise distinct elements of `Fin 4` cover every slot.  This is the finite
pigeonhole step, checked in the kernel (`decide +kernel`), not an assumption. -/
private theorem fin_four_cover (a a' b b' p : Fin 4)
    (haa' : a ≠ a') (hbb' : b ≠ b') (hab : a ≠ b) (hab' : a ≠ b')
    (ha'b : a' ≠ b) (ha'b' : a' ≠ b') :
    p = a ∨ p = a' ∨ p = b ∨ p = b' := by
  have finite : ∀ a a' b b' p : Fin 4,
      a ≠ a' → b ≠ b' → a ≠ b → a ≠ b' → a' ≠ b → a' ≠ b' →
        (p = a ∨ p = a' ∨ p = b ∨ p = b') := by
    decide +kernel
  exact finite a a' b b' p haa' hbb' hab hab' ha'b ha'b'

/-- In `Fin 4`, a slot whose key class is a singleton separates two nontrivial key
classes: two slots with equal-key partners cannot have different keys. -/
theorem key_eq_of_two_partners {K : Type*} (key : Fin 4 → K) (parent : Fin 4)
    (parentSingleton : ∀ other, other ≠ parent → key other ≠ key parent)
    (a b : Fin 4)
    (ha : ∃ a', a' ≠ a ∧ key a' = key a)
    (hb : ∃ b', b' ≠ b ∧ key b' = key b) :
    key a = key b := by
  by_contra hne
  obtain ⟨a', ha'ne, ha'eq⟩ := ha
  obtain ⟨b', hb'ne, hb'eq⟩ := hb
  have haa' : a ≠ a' := fun same => ha'ne same.symm
  have hbb' : b ≠ b' := fun same => hb'ne same.symm
  have hab : a ≠ b := fun same => hne (by rw [same])
  have hab' : a ≠ b' := fun same => hne (by rw [same, hb'eq])
  have ha'b : a' ≠ b := fun same => hne (by rw [← ha'eq, same])
  have ha'b' : a' ≠ b' := fun same => hne (by rw [← ha'eq, same, hb'eq])
  have haP : a ≠ parent := by
    intro same
    have distinct : a' ≠ parent := fun h => ha'ne (h.trans same.symm)
    exact parentSingleton a' distinct (by rw [ha'eq, same])
  have ha'P : a' ≠ parent := by
    intro same
    exact parentSingleton a haP (by rw [← ha'eq, same])
  have hbP : b ≠ parent := by
    intro same
    have distinct : b' ≠ parent := fun h => hb'ne (h.trans same.symm)
    exact parentSingleton b' distinct (by rw [hb'eq, same])
  have hb'P : b' ≠ parent := by
    intro same
    exact parentSingleton b hbP (by rw [← hb'eq, same])
  rcases fin_four_cover a a' b b' parent haa' hbb' hab hab' ha'b ha'b' with
    same | same | same | same
  · exact haP same.symm
  · exact ha'P same.symm
  · exact hbP same.symm
  · exact hb'P same.symm

/-! ## The actual eligible class -/

section Eligibility

variable (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
  (single : input.moleculeGraph.SimpleBonded)
  (c : input.detectedMultiCenterMolecule.Center)
  (node : RawMolecule.CanonicalBranchNode)
  (data : OccurrenceData input mol c node)

/-- The excluded parent key is a singleton class among the four frame slots. -/
theorem parent_key_ne (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data) :
    ∀ other, other ≠ parent →
      ordinaryKeys input mol single c node data other ≠
        ordinaryKeys input mol single c node data parent := by
  intro other different equal
  exact parentOut ((eligible_iff_other input mol single c node data parent).mpr
    ⟨other, different, equal⟩)

/-- Actual eligible slots with a globally excluded parent have one common ordinary key. -/
theorem eligible_keys_eq (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data)
    {a b : Fin 4}
    (ha : a ∈ eligibleSlots input mol single c node data)
    (hb : b ∈ eligibleSlots input mol single c node data) :
    ordinaryKeys input mol single c node data a =
      ordinaryKeys input mol single c node data b := by
  obtain ⟨a', ha'ne, ha'eq⟩ :=
    (eligible_iff_other input mol single c node data a).mp ha
  obtain ⟨b', hb'ne, hb'eq⟩ :=
    (eligible_iff_other input mol single c node data b).mp hb
  exact key_eq_of_two_partners (ordinaryKeys input mol single c node data) parent
    (parent_key_ne input mol single c node data parent parentOut) a b
    ⟨a', ha'ne, ha'eq⟩ ⟨b', hb'ne, hb'eq⟩

/-- No eligible reference is the excluded parent slot. -/
theorem eligible_ne_parent (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data)
    {slot : Fin 4} (member : slot ∈ eligibleSlots input mol single c node data) :
    slot ≠ parent := by
  intro same
  obtain ⟨other, otherNe, equal⟩ :=
    (eligible_iff_other input mol single c node data slot).mp member
  have different : other ≠ parent := fun h => otherNe (h.trans same.symm)
  exact (parent_key_ne input mol single c node data parent parentOut other different)
    (by rw [equal, same])

/-- Eligibility is exactly the key class of any eligible reference.  This is the unique
nonsingleton equivalence class of the actual ordinary comparison. -/
theorem eligible_iff_key_eq (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data)
    (base : Fin 4) (baseMem : base ∈ eligibleSlots input mol single c node data)
    (slot : Fin 4) :
    slot ∈ eligibleSlots input mol single c node data ↔
      ordinaryKeys input mol single c node data slot =
        ordinaryKeys input mol single c node data base := by
  constructor
  · intro slotMem
    exact eligible_keys_eq input mol single c node data parent parentOut slotMem baseMem
  · intro equal
    by_cases same : slot = base
    · rw [same]
      exact baseMem
    · exact (eligible_iff_other input mol single c node data slot).mpr
        ⟨base, fun h => same h.symm, equal.symm⟩

/-- Every eligible reference has another eligible reference with the same key: the class is
nonsingleton. -/
theorem eligible_exists_partner {slot : Fin 4}
    (member : slot ∈ eligibleSlots input mol single c node data) :
    ∃ other ∈ eligibleSlots input mol single c node data,
      other ≠ slot ∧ ordinaryKeys input mol single c node data other =
        ordinaryKeys input mol single c node data slot := by
  obtain ⟨other, otherNe, equal⟩ :=
    (eligible_iff_other input mol single c node data slot).mp member
  refine ⟨other, ?_, otherNe, equal⟩
  exact (eligible_iff_other input mol single c node data other).mpr
    ⟨slot, otherNe.symm, equal.symm⟩

/-- A nonempty eligible class contains at least two distinct slots. -/
theorem two_le_eligible_card {slot : Fin 4}
    (member : slot ∈ eligibleSlots input mol single c node data) :
    2 ≤ (eligibleSlots input mol single c node data).toFinset.card := by
  obtain ⟨other, otherMember, otherNe, _⟩ :=
    eligible_exists_partner input mol single c node data member
  have subset : ({slot, other} : Finset (Fin 4)) ⊆
      (eligibleSlots input mol single c node data).toFinset := by
    intro value present
    rcases Finset.mem_insert.mp present with same | rest
    · rw [same]
      exact (List.mem_toFinset).mpr member
    · rw [Finset.mem_singleton.mp rest]
      exact (List.mem_toFinset).mpr otherMember
  calc
    2 = ({slot, other} : Finset (Fin 4)).card :=
      (Finset.card_pair otherNe.symm).symm
    _ ≤ (eligibleSlots input mol single c node data).toFinset.card :=
      Finset.card_le_card subset

/-- The eligible class lies in the at most three slots remaining after the parent. -/
theorem eligible_card_le_three (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data) :
    (eligibleSlots input mol single c node data).toFinset.card ≤ 3 := by
  have subset : (eligibleSlots input mol single c node data).toFinset ⊆
      (Finset.univ : Finset (Fin 4)).erase parent := by
    intro slot member
    rw [Finset.mem_erase]
    exact ⟨eligible_ne_parent input mol single c node data parent parentOut
      ((List.mem_toFinset).mp member), Finset.mem_univ slot⟩
  calc
    (eligibleSlots input mol single c node data).toFinset.card ≤
        ((Finset.univ : Finset (Fin 4)).erase parent).card :=
      Finset.card_le_card subset
    _ = 3 := by
      rw [Finset.card_erase_of_mem (Finset.mem_univ parent), Finset.card_univ,
        Fintype.card_fin]

/-- A noninjective actual ordinary key function has a nonempty eligible population. -/
theorem exists_eligible_of_not_injective
    (notInj : ¬ Function.Injective (ordinaryKeys input mol single c node data)) :
    ∃ base, base ∈ eligibleSlots input mol single c node data := by
  obtain ⟨base, member⟩ := List.exists_mem_of_ne_nil _
    (eligible_ne_nil input mol single c node data notInj)
  exact ⟨base, member⟩

/-- Bundled actual local eligibility structure: the parent is excluded and its key class is
a singleton; all eligible slots have one common key; and eligibility is exactly the key
class of any eligible reference.  The separate `parent_not_eligible` additionally pins the
parent to the actual incoming frame cursor. -/
theorem local_eligibility_structure (branch : TiedRootBranch input data.target) :
    ∃ parent : Fin 4,
      parent ∉ eligibleSlots input mol single c node data ∧
      (∀ other, other ≠ parent →
        ordinaryKeys input mol single c node data other ≠
          ordinaryKeys input mol single c node data parent) ∧
      (∀ a, a ∈ eligibleSlots input mol single c node data →
        ∀ b, b ∈ eligibleSlots input mol single c node data →
          ordinaryKeys input mol single c node data a =
            ordinaryKeys input mol single c node data b) ∧
      (∀ base, base ∈ eligibleSlots input mol single c node data →
        ∀ slot, slot ∈ eligibleSlots input mol single c node data ↔
          ordinaryKeys input mol single c node data slot =
            ordinaryKeys input mol single c node data base) := by
  obtain ⟨parent, _, parentOut⟩ :=
    parent_not_eligible input mol single c node data branch
  exact ⟨parent, parentOut,
    parent_key_ne input mol single c node data parent parentOut,
    fun a ha b hb =>
      eligible_keys_eq input mol single c node data parent parentOut ha hb,
    fun base baseMem slot =>
      eligible_iff_key_eq input mol single c node data parent parentOut base baseMem slot⟩

end Eligibility

/-! ## Actual frame actions and their reachable orbit -/

/-- An actual frame action: a molecular automorphism fixing the node history, its induced
permutation of the four frame slots, transport of the reference atoms, and preservation of
the actual empty-state ordinary keys.  These are exactly the fields supplied by
`actual_slot_key_action`; generated-label orientation transport is deliberately not a field. -/
structure ActualFrameAction
    (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
    (single : input.moleculeGraph.SimpleBonded)
    (c : input.detectedMultiCenterMolecule.Center)
    (node : RawMolecule.CanonicalBranchNode)
    (data : OccurrenceData input mol c node) where
  symmetry : input.detectedMultiCenterMolecule.Aut
  fixedHistory : ∀ atom ∈ node.history,
    relabelOf input (symmetry : Equiv.Perm input.Atom) atom = atom
  slotPerm : Equiv.Perm (Fin 4)
  reference : ∀ i, referenceAt input mol c node data (slotPerm i) =
    (symmetry : Equiv.Perm input.Atom) (referenceAt input mol c node data i)
  key : ∀ i, ordinaryKeys input mol single c node data (slotPerm i) =
    ordinaryKeys input mol single c node data i

/-- A slot is reachable from a base slot when some actual frame action maps the base to it. -/
def Reachable
    (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
    (single : input.moleculeGraph.SimpleBonded)
    (c : input.detectedMultiCenterMolecule.Center)
    (node : RawMolecule.CanonicalBranchNode)
    (data : OccurrenceData input mol c node) (base target : Fin 4) : Prop :=
  ∃ action : ActualFrameAction input mol single c node data, action.slotPerm base = target

/-- Explicit reconstruction completeness: every slot with the base ordinary key is
reachable from the base by an actual frame action.  This is the missing converse of
`reachable_key_eq`; it is not derived in this module. -/
def ReachComplete
    (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
    (single : input.moleculeGraph.SimpleBonded)
    (c : input.detectedMultiCenterMolecule.Center)
    (node : RawMolecule.CanonicalBranchNode)
    (data : OccurrenceData input mol c node) (base : Fin 4) : Prop :=
  ∀ target : Fin 4,
    ordinaryKeys input mol single c node data target =
      ordinaryKeys input mol single c node data base →
    Reachable input mol single c node data base target

section Orbit

variable (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
  (single : input.moleculeGraph.SimpleBonded)
  (c : input.detectedMultiCenterMolecule.Center)
  (node : RawMolecule.CanonicalBranchNode)
  (data : OccurrenceData input mol c node)

/-- The actual frame transport supplies an actual frame action at every history-fixed
automorphism.  This is the concrete producer of `ActualFrameAction`. -/
theorem exists_actualFrameAction
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (admissible : mol.StereochemicalAdmissible)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (e : input.detectedMultiCenterMolecule.Aut)
    (reached : Reached mol node)
    (historyFixed : ∀ atom ∈ node.history,
      relabelOf input (e : Equiv.Perm input.Atom) atom = atom) :
    ∃ action : ActualFrameAction input mol single c node data, action.symmetry = e := by
  obtain ⟨slotPerm, reference, key⟩ :=
    actual_slot_key_action input mol agreement admissible supported single e c node data
      reached historyFixed
  exact ⟨⟨e, historyFixed, slotPerm, reference, key⟩, rfl⟩

/-- Every actual frame action fixes the excluded parent slot. -/
theorem slotPerm_parent (action : ActualFrameAction input mol single c node data)
    (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data) :
    action.slotPerm parent = parent := by
  by_contra moved
  apply parentOut
  exact (eligible_iff_other input mol single c node data parent).mpr
    ⟨action.slotPerm parent, moved, action.key parent⟩

/-- Reachability preserves the ordinary key. -/
theorem reachable_key_eq {base target : Fin 4}
    (reach : Reachable input mol single c node data base target) :
    ordinaryKeys input mol single c node data target =
      ordinaryKeys input mol single c node data base := by
  obtain ⟨action, image⟩ := reach
  rw [← image]
  exact action.key base

/-- Reachability from an eligible base stays inside the eligible population. -/
theorem reachable_eligible {base target : Fin 4}
    (baseMem : base ∈ eligibleSlots input mol single c node data)
    (reach : Reachable input mol single c node data base target) :
    target ∈ eligibleSlots input mol single c node data := by
  obtain ⟨action, image⟩ := reach
  obtain ⟨other, otherNe, equal⟩ :=
    (eligible_iff_other input mol single c node data base).mp baseMem
  have partnerNe : action.slotPerm other ≠ action.slotPerm base :=
    fun same => otherNe (action.slotPerm.injective same)
  have keys : ordinaryKeys input mol single c node data (action.slotPerm other) =
      ordinaryKeys input mol single c node data (action.slotPerm base) := by
    rw [action.key other, action.key base, equal]
  rw [← image]
  exact (eligible_iff_other input mol single c node data (action.slotPerm base)).mpr
    ⟨action.slotPerm other, partnerNe, keys⟩

/-- Under explicit reconstruction completeness, the eligible class of an eligible
reference is exactly its actual-action reachable set: one actual orbit, not merely a
common key. -/
theorem eligible_eq_reachable_of_complete (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data)
    (base : Fin 4) (baseMem : base ∈ eligibleSlots input mol single c node data)
    (complete : ReachComplete input mol single c node data base) :
    ∀ target : Fin 4,
      target ∈ eligibleSlots input mol single c node data ↔
        Reachable input mol single c node data base target := by
  intro target
  constructor
  · intro targetMem
    exact complete target
      (eligible_keys_eq input mol single c node data parent parentOut targetMem baseMem)
  · intro reach
    exact reachable_eligible input mol single c node data baseMem reach

/-- If actual frame actions preserve a local reading, then all eligible local readings
agree.  Reading transport is the explicit generated-label orientation premise; it is not
supplied by `ActualFrameAction`. -/
theorem eligible_readings_eq (parent : Fin 4)
    (parentOut : parent ∉ eligibleSlots input mol single c node data)
    (base : Fin 4) (baseMem : base ∈ eligibleSlots input mol single c node data)
    (complete : ReachComplete input mol single c node data base)
    {α : Type*} (reading : Fin 4 → α)
    (transport : ∀ (action : ActualFrameAction input mol single c node data) (slot : Fin 4),
      reading (action.slotPerm slot) = reading slot)
    {i j : Fin 4}
    (iMem : i ∈ eligibleSlots input mol single c node data)
    (jMem : j ∈ eligibleSlots input mol single c node data) :
    reading j = reading i := by
  have iReach : Reachable input mol single c node data base i :=
    (eligible_eq_reachable_of_complete input mol single c node data parent parentOut
      base baseMem complete i).mp iMem
  have jReach : Reachable input mol single c node data base j :=
    (eligible_eq_reachable_of_complete input mol single c node data parent parentOut
      base baseMem complete j).mp jMem
  obtain ⟨iAction, iImage⟩ := iReach
  obtain ⟨jAction, jImage⟩ := jReach
  rw [← jImage, transport jAction base, ← transport iAction base, iImage]

end Orbit

end

