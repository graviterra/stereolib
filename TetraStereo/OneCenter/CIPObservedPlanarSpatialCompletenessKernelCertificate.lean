import TetraStereo.OneCenter.CIPObservedPlanarSpatialCompleteness
import TetraStereo.KernelOnly

set_option autoImplicit false

/-!
# Kernel-only certificate for observation-scoped planar completeness

This certificate covers exact retention, explicit conflict/ownership refusal, readiness
normalization, zero multiplicity on exclusion, and the `Rₚ/Sₚ` output-family boundary.
-/

assert_kernel_only TetraStereo.OneCenter.planarDerivedConflictFreeAssignmentJudgment_iff_agreement
assert_kernel_only TetraStereo.OneCenter.not_planarDerivedAssignmentAgreement_iff_conflict
assert_kernel_only TetraStereo.OneCenter.not_planarDerivedAssignmentHasNoEarlierOwner_iff_hasEarlierOwner
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.planarDerivedAssignment_mem_iff_agreement
assert_kernel_only TetraStereo.OneCenter.ChemistryNormalizationResult.planarDerivedAssignment_not_mem_iff_conflict
assert_kernel_only TetraStereo.OneCenter.planarDerivedPublicContributionJudgment_iff_agreement_and_noEarlierOwner
assert_kernel_only TetraStereo.OneCenter.planarDerivedObservationAssignment_mem_public_iff
assert_kernel_only TetraStereo.OneCenter.planarDerivedObservationAssignment_not_mem_public_iff
assert_kernel_only TetraStereo.OneCenter.planarDerivedObservationPublicReady_iff_explicit
assert_kernel_only TetraStereo.OneCenter.excluded_planarDerivedObservationAssignment_count_eq_zero
assert_kernel_only TetraStereo.OneCenter.newlyContributedDerivedPlanarAssignment_is_Rp_or_Sp
