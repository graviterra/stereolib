import TetraStereo.OneCenter.LocalizedRetainedCoherentSymmetry
import TetraStereo.OneCenter.LocalizedActualMolecularEvidenceRefinement
import TetraStereo.OneCenter.AcyclicCutBranchAutomorphism
import TetraStereo.OneCenter.Rule1bSourceProfileFidelity
import TetraStereo.KernelOnly

set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

/-!
# Residual simple paths realized in an actual generated source tree

Let `tree` be an official source tree generated by `executableOfficialCIPChildren` whose root is
the real node of an entry atom `x` below an ordered boundary `B`, root first
(`BoundaryRootedTree`). Its history is `B ++ [x]`, newest atom first. Under single bonding:

* every simple residual path from `x` avoiding `B` is the history of a ranked address of `tree`
  (`exists_address_of_residualObsPath`), that address is unique (`address_unique`), and every
  real node of `tree` is such a path (`exists_residualObsPath_of_real`);
* the parent of a real address is the real address of the path without its last atom
  (`parent_address`);
* at a real node there is a ring-duplicate child with Rule-1b distance `j` exactly when `j` is the
  root-first index of a boundary or ancestor atom other than the parent, bonded to the terminal atom
  (`ringDuplicateChild_iff`);
* every addressed node is real exactly when its Rule-1b value is its depth `|B| + |address|`, and
  is otherwise the ring duplicate carrying that value (`provenance_eq_provenanceOfRule1b`).

`residualPathTreeEquivOfSameObservations` combines these facts for two such trees with the same
label/provenance observation at every ranked address (`ObservedTreePair`). The paths correspond
when they sit at the same address (`residualPathTreeEquivOfSameObservations_correspond`).
Parentage, terminal labels, every indexed boundary bond, every non-parent ancestor bond and the
parent bond are read from the observations. Constant formal charge supplies the charge column.
By the Rule-1b readback, equal label/Rule-1b observations and boundaries of equal length already
give an observed pair (`observedTreePair_of_constitutional`). Executable reachability keeps real
histories duplicate-free (`unbounded_real_history_nodup`). Acyclicity, a supplied path map,
endpoint consistency, a Hamiltonian path and an automorphism are not hypotheses.
-/

namespace TetraStereo.OneCenter
namespace LocalizedActualBoundaryPathRealization

open CertifiedLocalizedCIPInput
open RetainedCoherentSymmetry
open RetainedRingSymmetryReconstruction

noncomputable section

/-! ## List and path helpers -/

section ListHelpers

theorem getElem_eq_of_index_eq {α : Type*} (l : List α) {i j : ℕ} (hij : i = j)
    (hi : i < l.length) (hj : j < l.length) : l[i] = l[j] := by
  subst hij
  rfl

/-- In a duplicate-free list, the first index of an entry is its position. -/
theorem firstIndexOf?_getElem_of_nodup {α : Type*} [DecidableEq α] :
    ∀ (values : List α) (index : ℕ) (hindex : index < values.length), values.Nodup →
      firstIndexOf? values[index] values = some index
  | [], index, hindex, _ => by simp at hindex
  | value :: values, 0, _, _ => by simp
  | value :: values, index + 1, hindex, nodup => by
      rw [List.nodup_cons] at nodup
      have hlt : index < values.length := by simpa using hindex
      have hne : ¬ value = values[index] := by
        intro h
        apply nodup.1
        rw [h]
        exact List.getElem_mem hlt
      have ih := firstIndexOf?_getElem_of_nodup values index hlt nodup.2
      rw [List.getElem_cons_succ]
      unfold firstIndexOf?
      rw [if_neg hne, ih]
      rfl

variable {V : Type} [Fintype V] [DecidableEq V]

theorem bond_eq_of_adj_iff {m : MoleculeGraph V} (simple : m.SimpleBonded) {a b c d : V}
    (h : m.Adj a b ↔ m.Adj c d) : m.bond a b = m.bond c d := by
  by_cases hab : m.Adj a b
  · rw [simple a b hab, simple c d (h.mp hab)]
  · have hcd : ¬ m.Adj c d := fun hcd => hab (h.mpr hcd)
    unfold MoleculeGraph.Adj at hab hcd
    rw [Nat.eq_zero_of_not_pos hab, Nat.eq_zero_of_not_pos hcd]

theorem bondedChain_getElem {m : MoleculeGraph V} :
    ∀ {p : List V}, BondedChain m p → ∀ (i : ℕ) (hi : i + 1 < p.length),
      0 < m.bond (p[i]'(by omega)) p[i + 1]
  | [], _, i, hi => by simp at hi
  | [_], _, i, hi => by simp at hi
  | a :: b :: rest, h, 0, _ => by
      have h' : 0 < m.bond a b ∧ BondedChain m (b :: rest) := by simpa [BondedChain] using h
      simpa using h'.1
  | a :: b :: rest, h, i + 1, hi => by
      have h' : 0 < m.bond a b ∧ BondedChain m (b :: rest) := by simpa [BondedChain] using h
      have ih := bondedChain_getElem h'.2 i (by simpa using hi)
      simpa using ih

/-- The last edge of a residual path is a bond, of order one under single bonding. -/
theorem parent_bond_eq_one {m : MoleculeGraph V} (simple : m.SimpleBonded) {B : List V} {x : V}
    {p : List V} (hp : ResidualObsPath m B x p) (hlen : 1 < p.length) :
    m.bond (pathTerminal p hp.nonempty) (p.get ⟨p.length - 2, nat_parent_index_lt hlen⟩) = 1 := by
  have hchain := bondedChain_getElem hp.chain (p.length - 2) (by omega)
  have hlast : pathTerminal p hp.nonempty = p[p.length - 1]'(by omega) := by
    unfold pathTerminal
    exact List.getLast_eq_getElem hp.nonempty
  have hnext : p[p.length - 2 + 1]'(by omega) = p[p.length - 1]'(by omega) :=
    getElem_eq_of_index_eq p (by omega) _ _
  rw [hnext] at hchain
  rw [hlast, List.get_eq_getElem, m.bond_symm]
  exact simple _ _ hchain

theorem residualObsPath_eq_cons {m : MoleculeGraph V} {B : List V} {x : V} {p : List V}
    (hp : ResidualObsPath m B x p) : p = x :: p.tail := by
  cases p with
  | nil => exact absurd rfl hp.nonempty
  | cons a rest =>
      have ha : a = x := by simpa using hp.head
      rw [ha]
      rfl

theorem not_mem_of_nodup_append_singleton {B : List V} {x : V} (h : (B ++ [x]).Nodup) :
    x ∉ B := by
  intro hx
  exact (List.nodup_append.mp h).2.2 x hx x (List.mem_singleton_self x) rfl

theorem nodup_of_nodup_append_singleton {B : List V} {x : V} (h : (B ++ [x]).Nodup) :
    B.Nodup :=
  (List.nodup_append.mp h).1

/-- A residual path below a duplicate-free boundary is duplicate-free together with it. -/
theorem nodup_boundary_append {m : MoleculeGraph V} {B : List V} {x : V} {p : List V}
    (hB : B.Nodup) (hp : ResidualObsPath m B x p) : (B ++ p).Nodup := by
  rw [List.nodup_append]
  refine ⟨hB, hp.nodup, ?_⟩
  intro a ha b hb hab
  subst hab
  exact hp.outside a hb ha

end ListHelpers

/-! ## Boundary nodes -/

section BoundaryNode

variable {V : Type} [DecidableEq V]

/-- The real node of a residual path `p` below the ordered boundary `B`. Its stored history is
`B ++ p`, newest atom first, and its current atom is the terminal of `p`. -/
def boundaryNode (B p : List V) : OfficialCIPNode V where
  current? := p.getLast?
  history := (B ++ p).reverse
  provenance := .realAtom

@[simp] theorem boundaryNode_current? (B p : List V) :
    (boundaryNode B p).current? = p.getLast? := rfl

@[simp] theorem boundaryNode_history (B p : List V) :
    (boundaryNode B p).history = (B ++ p).reverse := rfl

@[simp] theorem boundaryNode_provenance (B p : List V) :
    (boundaryNode B p).provenance = .realAtom := rfl

/-- The original-root ligand node is the boundary node of the ligand below the center. -/
theorem rootFromEdge_eq_boundaryNode (center ligand : V) :
    OfficialCIPNode.rootFromEdge center ligand = boundaryNode [center] [ligand] := by
  unfold OfficialCIPNode.rootFromEdge boundaryNode
  simp

theorem boundaryNode_injective {B p q : List V} (h : boundaryNode B p = boundaryNode B q) :
    p = q := by
  have hh := congrArg OfficialCIPNode.history h
  simp only [boundaryNode_history, List.reverse_inj] at hh
  exact List.append_cancel_left hh

theorem boundaryNode_cons (B : List V) (x : V) {rest : List V} (hrest : rest ≠ []) :
    boundaryNode B (x :: rest) = boundaryNode (B ++ [x]) rest := by
  cases rest with
  | nil => exact absurd rfl hrest
  | cons z rest =>
      unfold boundaryNode
      congr 1
      simp

/-- The parent read by the executable child enumerator is the second stored history atom. -/
theorem parent?_eq_history_getElem? (node : OfficialCIPNode V) :
    node.parent? = node.history[1]? := by
  rcases node with ⟨current, history, provenance⟩
  rcases history with _ | ⟨a, _ | ⟨b, rest⟩⟩ <;> rfl

theorem extend_boundaryNode {B p : List V} {z : V} (hz : z ∉ B ++ p) :
    (boundaryNode B p).extend z 0 = boundaryNode B (p ++ [z]) := by
  have hfresh : z ∉ (boundaryNode B p).history := by
    rw [boundaryNode_history, List.mem_reverse]
    exact hz
  show OfficialCIPNode.mk (some z) (z :: (boundaryNode B p).history)
      ((boundaryNode B p).childProvenance z 0) = boundaryNode B (p ++ [z])
  rw [OfficialCIPNode.childProvenance_real _ _ hfresh]
  unfold boundaryNode
  congr 1 <;> simp

/-- A fresh zero-index extension of any node is the boundary node of its atom below the node's
whole root-first history. -/
theorem extend_eq_boundaryNode_history {node : OfficialCIPNode V} {z : V}
    (hz : z ∉ node.history) :
    node.extend z 0 = boundaryNode node.history.reverse [z] := by
  show OfficialCIPNode.mk (some z) (z :: node.history) (node.childProvenance z 0) = _
  rw [OfficialCIPNode.childProvenance_real _ _ hz]
  unfold boundaryNode
  simp

/-- A fresh zero-index extension is real, with Rule-1b value the length of the parent history. -/
theorem extend_rule1b_of_not_mem {node : OfficialCIPNode V} {z : V} (hz : z ∉ node.history) :
    (node.extend z 0).provenance = .realAtom ∧
      (node.extend z 0).rule1bRootDistance = node.history.length := by
  have hprov : (node.extend z 0).provenance = .realAtom := by
    rw [OfficialCIPNode.extend_provenance, OfficialCIPNode.childProvenance_real _ _ hz]
  refine ⟨hprov, ?_⟩
  unfold OfficialCIPNode.rule1bRootDistance
  rw [hprov]
  simp [OfficialCIPNode.depth]

/-- A visited zero-index extension is the ring duplicate of the root-first index of its atom in
the parent history, which is smaller than the parent history length. -/
theorem extend_rule1b_of_mem {node : OfficialCIPNode V} {z : V} (hz : z ∈ node.history) :
    ∃ k, node.history.reverse[k]? = some z ∧
      (node.extend z 0).provenance = .ringDuplicate k ∧
      (node.extend z 0).rule1bRootDistance = k ∧ k < node.history.length := by
  obtain ⟨k, hk⟩ := Rule1bSourceProfile.firstIndexOf?_eq_some_of_mem z (List.mem_reverse.mpr hz)
  have hget := Rule1bSourceProfile.firstIndexOf?_eq_some_imp_getElem? z _ k hk
  have hprov : (node.extend z 0).provenance = .ringDuplicate k := by
    rw [OfficialCIPNode.extend_provenance, OfficialCIPNode.childProvenance_ring_duplicate _ _ hz]
    unfold OfficialCIPNode.duplicateRootDistance
    rw [hk]
    rfl
  refine ⟨k, hget, hprov, ?_, ?_⟩
  · unfold OfficialCIPNode.rule1bRootDistance
    rw [hprov]
  · have hlt := (List.getElem?_eq_some_iff.mp hget).1
    simpa using hlt

theorem parent?_boundaryNode_singleton_ne {B : List V} {x z : V} (hz : z ∉ B) :
    (boundaryNode B [x]).parent? ≠ some z := by
  rw [parent?_eq_history_getElem?, boundaryNode_history]
  have hrev : (B ++ [x]).reverse = x :: B.reverse := by simp
  rw [hrev, List.getElem?_cons_succ]
  intro h
  exact hz (List.mem_reverse.mp (List.mem_of_getElem? h))

end BoundaryNode

/-! ## Executable children under single bonding -/

section Executable

variable (input : CertifiedLocalizedCIPInput)

theorem mem_executableOfficialNeighborCopies_iff (simple : input.moleculeGraph.SimpleBonded)
    (atom neighbor : input.Atom) (copy : ℕ) :
    (neighbor, copy) ∈ input.executableOfficialNeighborCopies atom ↔
      input.moleculeGraph.Adj atom neighbor ∧ copy = 0 := by
  unfold CertifiedLocalizedCIPInput.executableOfficialNeighborCopies
  rw [List.mem_flatMap]
  constructor
  · rintro ⟨source, hsource, hmapped⟩
    obtain ⟨index, hindex, hpair⟩ := List.mem_map.mp hmapped
    have hsrc : source = neighbor := (Prod.mk.inj hpair).1
    have hidx : index = copy := (Prod.mk.inj hpair).2
    subst hsrc hidx
    have hadj := (input.moleculeGraph.mem_neighborFinset _ _).mp
      ((Finset.mem_sort (r := (· ≤ ·))).mp hsource)
    refine ⟨hadj, ?_⟩
    rw [List.mem_range, simple _ _ hadj] at hindex
    omega
  · rintro ⟨hadj, rfl⟩
    refine ⟨neighbor, (Finset.mem_sort (r := (· ≤ ·))).mpr
      ((input.moleculeGraph.mem_neighborFinset atom neighbor).mpr hadj), ?_⟩
    rw [List.mem_map]
    exact ⟨0, List.mem_range.mpr hadj, rfl⟩

theorem mem_executableOfficialChildCopies_iff (simple : input.moleculeGraph.SimpleBonded)
    (node : OfficialCIPNode input.Atom) {current : input.Atom}
    (hcurrent : node.current? = some current) (neighbor : input.Atom) (copy : ℕ) :
    (neighbor, copy) ∈ input.executableOfficialChildCopies node ↔
      input.moleculeGraph.Adj current neighbor ∧ copy = 0 ∧ node.parent? ≠ some neighbor := by
  unfold CertifiedLocalizedCIPInput.executableOfficialChildCopies
  simp only [hcurrent]
  cases hparent : node.parent? with
  | none =>
      simp only [mem_executableOfficialNeighborCopies_iff input simple]
      constructor
      · rintro ⟨hadj, hcopy⟩
        exact ⟨hadj, hcopy, by simp⟩
      · rintro ⟨hadj, hcopy, _⟩
        exact ⟨hadj, hcopy⟩
  | some parent =>
      simp only [List.mem_filter, mem_executableOfficialNeighborCopies_iff input simple]
      constructor
      · rintro ⟨⟨hadj, hcopy⟩, hkeep⟩
        refine ⟨hadj, hcopy, ?_⟩
        intro hsame
        have hp : parent = neighbor := Option.some.inj hsame
        subst hp hcopy
        simp at hkeep
      · rintro ⟨hadj, hcopy, hne⟩
        refine ⟨⟨hadj, hcopy⟩, ?_⟩
        have hne' : neighbor ≠ parent := fun h => hne (by rw [h])
        simp [hne']

theorem copy_zero_of_mem_childCopies (simple : input.moleculeGraph.SimpleBonded)
    {node : OfficialCIPNode input.Atom} {copy : input.Atom × ℕ}
    (h : copy ∈ input.executableOfficialChildCopies node) : copy.2 = 0 := by
  unfold CertifiedLocalizedCIPInput.executableOfficialChildCopies at h
  split at h
  · simp at h
  · split at h
    · exact ((mem_executableOfficialNeighborCopies_iff input simple _ copy.1 copy.2).mp h).2
    · exact ((mem_executableOfficialNeighborCopies_iff input simple _ copy.1 copy.2).mp
        (List.mem_of_mem_filter h)).2

theorem isDuplicateLeaf_of_real {node : OfficialCIPNode input.Atom}
    (h : node.provenance = .realAtom) : node.isDuplicateLeaf = false := by
  simp [OfficialCIPNode.isDuplicateLeaf, h]

/-- The executable children of a real node under single bonding: one zero-index extension per
bonded atom other than the stored parent. -/
theorem mem_executableOfficialCIPChildren_iff (simple : input.moleculeGraph.SimpleBonded)
    (node : OfficialCIPNode input.Atom) {current : input.Atom}
    (hcurrent : node.current? = some current) (hreal : node.provenance = .realAtom)
    (child : OfficialCIPNode input.Atom) :
    child ∈ input.executableOfficialCIPChildren node ↔
      ∃ neighbor, child = node.extend neighbor 0 ∧ input.moleculeGraph.Adj current neighbor ∧
        node.parent? ≠ some neighbor := by
  unfold CertifiedLocalizedCIPInput.executableOfficialCIPChildren
  rw [if_neg (by simp [isDuplicateLeaf_of_real input hreal]), List.mem_map]
  constructor
  · rintro ⟨⟨neighbor, copy⟩, hcopy, rfl⟩
    obtain ⟨hadj, rfl, hparent⟩ :=
      (mem_executableOfficialChildCopies_iff input simple node hcurrent neighbor copy).mp hcopy
    exact ⟨neighbor, rfl, hadj, hparent⟩
  · rintro ⟨neighbor, rfl, hadj, hparent⟩
    exact ⟨(neighbor, 0),
      (mem_executableOfficialChildCopies_iff input simple node hcurrent neighbor 0).mpr
        ⟨hadj, rfl, hparent⟩, rfl⟩

theorem exists_extend_zero_of_mem (simple : input.moleculeGraph.SimpleBonded)
    {node child : OfficialCIPNode input.Atom}
    (h : child ∈ input.executableOfficialCIPChildren node) :
    ∃ neighbor, child = node.extend neighbor 0 := by
  unfold CertifiedLocalizedCIPInput.executableOfficialCIPChildren at h
  split at h
  · simp at h
  · obtain ⟨copy, hcopy, rfl⟩ := List.mem_map.mp h
    refine ⟨copy.1, ?_⟩
    rw [copy_zero_of_mem_childCopies input simple hcopy]

/-- A node with an executable child bears an atom. -/
theorem exists_current_of_mem_children {node child : OfficialCIPNode input.Atom}
    (h : child ∈ input.executableOfficialCIPChildren node) : ∃ t, node.current? = some t := by
  cases hcur : node.current? with
  | none =>
      exfalso
      unfold CertifiedLocalizedCIPInput.executableOfficialCIPChildren at h
      split at h
      · simp at h
      · unfold CertifiedLocalizedCIPInput.executableOfficialChildCopies at h
        rw [hcur] at h
        simp at h
  | some t => exact ⟨t, rfl⟩

theorem executableOfficialNeighborCopies_nodup (atom : input.Atom) :
    (input.executableOfficialNeighborCopies atom).Nodup := by
  unfold CertifiedLocalizedCIPInput.executableOfficialNeighborCopies
  rw [List.nodup_flatMap]
  refine ⟨?_, ?_⟩
  · intro neighbor _
    exact List.Nodup.map (fun a b h => (Prod.mk.inj h).2) List.nodup_range
  · exact (Finset.sort_nodup _ _).imp fun {a₁ a₂} n pair h₁ h₂ => by
      rcases List.mem_map.1 h₁ with ⟨b₁, _, rfl⟩
      rcases List.mem_map.1 h₂ with ⟨b₂, _, h⟩
      exact n (Prod.mk.inj h).1.symm

theorem executableOfficialChildCopies_nodup (node : OfficialCIPNode input.Atom) :
    (input.executableOfficialChildCopies node).Nodup := by
  unfold CertifiedLocalizedCIPInput.executableOfficialChildCopies
  split
  · exact List.nodup_nil
  · split
    · exact executableOfficialNeighborCopies_nodup input _
    · exact (executableOfficialNeighborCopies_nodup input _).filter _

/-- Under single bonding no executable child occurs twice. -/
theorem executableOfficialCIPChildren_nodup (simple : input.moleculeGraph.SimpleBonded)
    (node : OfficialCIPNode input.Atom) : (input.executableOfficialCIPChildren node).Nodup := by
  unfold CertifiedLocalizedCIPInput.executableOfficialCIPChildren
  split
  · exact List.nodup_nil
  · refine List.Nodup.map_on ?_ (executableOfficialChildCopies_nodup input node)
    intro first hfirst second hsecond hsame
    have zeroFirst := copy_zero_of_mem_childCopies input simple hfirst
    have zeroSecond := copy_zero_of_mem_childCopies input simple hsecond
    have hcur := congrArg OfficialCIPNode.current? hsame
    simp only [OfficialCIPNode.extend_current?, Option.some.injEq] at hcur
    exact Prod.ext hcur (zeroFirst.trans zeroSecond.symm)

end Executable

/-! ## Generated source trees -/

section Generated

variable {input : CertifiedLocalizedCIPInput}

theorem child_generated_and_mem {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)}
    (gen : (OfficialCIPSourceTree.node src children).GeneratedBy
      input.executableOfficialCIPChildren)
    {slot : ℕ} {child : OfficialCIPSourceTree input.Atom} (hchild : children[slot]? = some child) :
    child.GeneratedBy input.executableOfficialCIPChildren ∧
      child.source ∈ input.executableOfficialCIPChildren src := by
  have hmem : child ∈ children := List.mem_of_getElem? hchild
  refine ⟨(OfficialCIPSourceTree.forestGeneratedBy_iff_forall _ children).1 gen.2 child hmem, ?_⟩
  exact gen.1.subset (List.mem_map_of_mem hmem)

theorem exists_slot_of_mem {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)}
    (gen : (OfficialCIPSourceTree.node src children).GeneratedBy
      input.executableOfficialCIPChildren)
    {node : OfficialCIPNode input.Atom} (h : node ∈ input.executableOfficialCIPChildren src) :
    ∃ (slot : ℕ) (child : OfficialCIPSourceTree input.Atom),
      children[slot]? = some child ∧ child.source = node := by
  have hmap : node ∈ children.map OfficialCIPSourceTree.source := gen.1.mem_iff.mpr h
  obtain ⟨child, hchild, hsource⟩ := List.mem_map.mp hmap
  obtain ⟨slot, hslot⟩ := List.mem_iff_getElem?.mp hchild
  exact ⟨slot, child, hslot, hsource⟩

/-- Two sibling slots with the same source node are the same slot. -/
theorem slot_unique (simple : input.moleculeGraph.SimpleBonded) {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)}
    (gen : (OfficialCIPSourceTree.node src children).GeneratedBy
      input.executableOfficialCIPChildren)
    {slot₁ slot₂ : ℕ} {child₁ child₂ : OfficialCIPSourceTree input.Atom}
    (h₁ : children[slot₁]? = some child₁) (h₂ : children[slot₂]? = some child₂)
    (hsame : child₁.source = child₂.source) : slot₁ = slot₂ := by
  have hnodup : (children.map OfficialCIPSourceTree.source).Nodup :=
    gen.1.nodup_iff.mpr (executableOfficialCIPChildren_nodup input simple src)
  have hlt : slot₁ < (children.map OfficialCIPSourceTree.source).length := by
    rw [List.length_map]
    exact (List.getElem?_eq_some_iff.mp h₁).1
  apply List.getElem?_inj hlt hnodup
  rw [List.getElem?_map, List.getElem?_map, h₁, h₂]
  simp [hsame]

theorem sourceAtAddress?_nil (tree : OfficialCIPSourceTree input.Atom) :
    tree.sourceAtAddress? [] = some tree.source := rfl

theorem sourceAtAddress?_cons {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)} {slot : ℕ}
    {child : OfficialCIPSourceTree input.Atom} (hchild : children[slot]? = some child)
    (address : List ℕ) :
    (OfficialCIPSourceTree.node src children).sourceAtAddress? (slot :: address) =
      child.sourceAtAddress? address := by
  simp [OfficialCIPSourceTree.sourceAtAddress?, OfficialCIPSourceTree.subtreeAt?, hchild]

theorem exists_child_of_sourceAtAddress?_cons {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)} {slot : ℕ} {address : List ℕ}
    {node : OfficialCIPNode input.Atom}
    (h : (OfficialCIPSourceTree.node src children).sourceAtAddress? (slot :: address) =
      some node) :
    ∃ child, children[slot]? = some child ∧ child.sourceAtAddress? address = some node := by
  unfold OfficialCIPSourceTree.sourceAtAddress? at h
  obtain ⟨subtree, hsub, hsrc⟩ := Option.map_eq_some_iff.mp h
  obtain ⟨child, hchild, hlookup⟩ := MolecularEvidenceTree.subtreeAt?_cons_child hsub
  refine ⟨child, hchild, ?_⟩
  simp [OfficialCIPSourceTree.sourceAtAddress?, hlookup, hsrc]

theorem source_eq_of_sourceAtAddress?_nil {tree : OfficialCIPSourceTree input.Atom}
    {node : OfficialCIPNode input.Atom} (h : tree.sourceAtAddress? [] = some node) :
    tree.source = node := by
  rw [sourceAtAddress?_nil] at h
  exact Option.some.inj h

/-- Every addressed node extends the root history by one atom per address slot. -/
theorem history_suffix :
    ∀ (address : List ℕ) (tree : OfficialCIPSourceTree input.Atom)
      (node : OfficialCIPNode input.Atom),
      tree.GeneratedBy input.executableOfficialCIPChildren →
        tree.sourceAtAddress? address = some node →
          ∃ newer : List input.Atom, node.history = newer ++ tree.source.history ∧
            newer.length = address.length
  | [], tree, node, _, lookup => by
      have hsame := source_eq_of_sourceAtAddress?_nil lookup
      exact ⟨[], by rw [hsame]; rfl, rfl⟩
  | slot :: address, .node src children, node, gen, lookup => by
      obtain ⟨child, hchild, hlookup⟩ := exists_child_of_sourceAtAddress?_cons lookup
      obtain ⟨childGen, childMem⟩ := child_generated_and_mem gen hchild
      obtain ⟨next, copy, hext⟩ :=
        MolecularEvidenceTree.executableOfficialCIPChildren_extend input src child.source childMem
      obtain ⟨newer, hhist, hlen⟩ := history_suffix address child node childGen hlookup
      refine ⟨newer ++ [next], ?_, by simp [hlen]⟩
      rw [hhist, hext]
      simp [OfficialCIPSourceTree.source]

/-- Graph-generated descendants are real or terminal duplicate leaves. -/
theorem real_or_duplicateLeaf :
    ∀ (address : List ℕ) (tree : OfficialCIPSourceTree input.Atom)
      (node : OfficialCIPNode input.Atom),
      tree.GeneratedBy input.executableOfficialCIPChildren →
      (tree.source.provenance = .realAtom ∨ tree.source.isDuplicateLeaf = true) →
        tree.sourceAtAddress? address = some node →
          node.provenance = .realAtom ∨ node.isDuplicateLeaf = true
  | [], tree, node, _, hroot, lookup => by
      rw [← source_eq_of_sourceAtAddress?_nil lookup]
      exact hroot
  | slot :: address, .node src children, node, gen, _, lookup => by
      obtain ⟨child, hchild, hlookup⟩ := exists_child_of_sourceAtAddress?_cons lookup
      obtain ⟨childGen, childMem⟩ := child_generated_and_mem gen hchild
      obtain ⟨next, copy, hext⟩ :=
        MolecularEvidenceTree.executableOfficialCIPChildren_extend input src child.source childMem
      apply real_or_duplicateLeaf address child node childGen _ hlookup
      by_cases hreal : child.source.provenance = .realAtom
      · exact Or.inl hreal
      · right
        rw [hext] at hreal ⊢
        exact MolecularEvidenceTree.isDuplicateLeaf_extend_of_ne src next copy hreal

theorem sourceAtAddress?_append_singleton {tree : OfficialCIPSourceTree input.Atom}
    {address : List ℕ} {src : OfficialCIPNode input.Atom}
    {children : List (OfficialCIPSourceTree input.Atom)}
    (h : tree.subtreeAt? address = some (.node src children)) (slot : ℕ) :
    tree.sourceAtAddress? (address ++ [slot]) =
      (children[slot]?).map OfficialCIPSourceTree.source := by
  unfold OfficialCIPSourceTree.sourceAtAddress?
  rw [OfficialCIPSourceTree.subtreeAt?_append, h]
  cases hc : children[slot]? with
  | none => simp [OfficialCIPSourceTree.subtreeAt?, hc]
  | some c => simp [OfficialCIPSourceTree.subtreeAt?, hc]

/-- Executable children of an addressed node are exactly the nodes at its one-slot extensions. -/
theorem exists_child_iff_address {tree : OfficialCIPSourceTree input.Atom}
    (gen : tree.GeneratedBy input.executableOfficialCIPChildren) {address : List ℕ}
    {node : OfficialCIPNode input.Atom} (h : tree.sourceAtAddress? address = some node)
    (P : OfficialCIPNode input.Atom → Prop) :
    (∃ child ∈ input.executableOfficialCIPChildren node, P child) ↔
      ∃ slot child, tree.sourceAtAddress? (address ++ [slot]) = some child ∧ P child := by
  unfold OfficialCIPSourceTree.sourceAtAddress? at h
  obtain ⟨sub, hsub, hsrc⟩ := Option.map_eq_some_iff.mp h
  have subGen := OfficialCIPSourceTree.GeneratedBy.of_subtreeAt? _ address tree sub gen hsub
  cases sub with
  | node src children =>
      have hsrc' : src = node := hsrc
      subst hsrc'
      constructor
      · rintro ⟨child, hmem, hP⟩
        obtain ⟨slot, c, hc, hcs⟩ := exists_slot_of_mem subGen hmem
        refine ⟨slot, child, ?_, hP⟩
        rw [sourceAtAddress?_append_singleton hsub slot, hc]
        simp [hcs]
      · rintro ⟨slot, child, hlook, hP⟩
        rw [sourceAtAddress?_append_singleton hsub slot] at hlook
        obtain ⟨c, hc, hcs⟩ := Option.map_eq_some_iff.mp hlook
        refine ⟨child, ?_, hP⟩
        rw [← hcs]
        exact (child_generated_and_mem subGen hc).2

/-- Along executable expansion, a real descendant of a node with a duplicate-free history has a
duplicate-free history. -/
theorem unbounded_real_history_nodup :
    ∀ {start : OfficialCIPNode input.Atom} {address : List ℕ}
      {node : OfficialCIPNode input.Atom},
      input.UnboundedOfficialSubtree start address node → start.history.Nodup →
        node.provenance = .realAtom → node.history.Nodup := by
  intro start address node reach
  induction reach with
  | refl node =>
      intro hstart _
      exact hstart
  | @step node child inner descendant slot childAtSlot rest ih =>
      intro hstart hreal
      have hmem : child ∈ input.executableOfficialCIPChildren node :=
        List.fst_mem_of_mem_zipIdx childAtSlot
      obtain ⟨next, copy, hext⟩ :=
        MolecularEvidenceTree.executableOfficialCIPChildren_extend input node child hmem
      by_cases hchildReal : child.provenance = .realAtom
      · apply ih _ hreal
        have hfresh : next ∉ node.history := by
          rw [hext] at hchildReal
          exact ((MolecularEvidenceTree.childProvenance_eq_realAtom_iff node next copy).1
            hchildReal).2
        rw [hext]
        exact List.nodup_cons.2 ⟨hfresh, hstart⟩
      · exfalso
        have hleaf : child.isDuplicateLeaf = true := by
          rw [hext] at hchildReal ⊢
          exact MolecularEvidenceTree.isDuplicateLeaf_extend_of_ne node next copy hchildReal
        have hnil := MolecularEvidenceTree.executableOfficialCIPChildren_terminal input child hleaf
        cases rest with
        | refl => exact hchildReal hreal
        | step childAtSlot' _ =>
            rw [hnil] at childAtSlot'
            simp at childAtSlot'

/-- Along executable expansion the current atom stays the newest history atom. -/
theorem unbounded_current_eq_head :
    ∀ {start : OfficialCIPNode input.Atom} {address : List ℕ}
      {node : OfficialCIPNode input.Atom},
      input.UnboundedOfficialSubtree start address node →
        start.current? = start.history.head? → node.current? = node.history.head? := by
  intro start address node reach
  induction reach with
  | refl node =>
      intro hstart
      exact hstart
  | @step node child inner descendant slot childAtSlot rest ih =>
      intro _
      apply ih
      have hmem : child ∈ input.executableOfficialCIPChildren node :=
        List.fst_mem_of_mem_zipIdx childAtSlot
      obtain ⟨next, copy, hext⟩ :=
        MolecularEvidenceTree.executableOfficialCIPChildren_extend input node child hmem
      rw [hext]
      rfl

/-- Ranked addresses of a generated tree are determined by their source nodes. -/
theorem address_unique (simple : input.moleculeGraph.SimpleBonded) :
    ∀ (first second : List ℕ) (tree : OfficialCIPSourceTree input.Atom)
      (node : OfficialCIPNode input.Atom),
      tree.GeneratedBy input.executableOfficialCIPChildren →
        tree.sourceAtAddress? first = some node → tree.sourceAtAddress? second = some node →
          first = second
  | [], [], _, _, _, _, _ => rfl
  | [], slot :: second, tree, node, gen, h₁, h₂ => by
      exfalso
      obtain ⟨newer, hhist, hlen⟩ := history_suffix (slot :: second) tree node gen h₂
      have hsame := source_eq_of_sourceAtAddress?_nil h₁
      have hlength := congrArg List.length hhist
      rw [← hsame, List.length_append] at hlength
      simp at hlen
      omega
  | slot :: first, [], tree, node, gen, h₁, h₂ => by
      exfalso
      obtain ⟨newer, hhist, hlen⟩ := history_suffix (slot :: first) tree node gen h₁
      have hsame := source_eq_of_sourceAtAddress?_nil h₂
      have hlength := congrArg List.length hhist
      rw [← hsame, List.length_append] at hlength
      simp at hlen
      omega
  | slot₁ :: first, slot₂ :: second, .node src children, node, gen, h₁, h₂ => by
      obtain ⟨child₁, hchild₁, hlookup₁⟩ := exists_child_of_sourceAtAddress?_cons h₁
      obtain ⟨child₂, hchild₂, hlookup₂⟩ := exists_child_of_sourceAtAddress?_cons h₂
      obtain ⟨gen₁, mem₁⟩ := child_generated_and_mem gen hchild₁
      obtain ⟨gen₂, mem₂⟩ := child_generated_and_mem gen hchild₂
      obtain ⟨z₁, hz₁⟩ := exists_extend_zero_of_mem input simple mem₁
      obtain ⟨z₂, hz₂⟩ := exists_extend_zero_of_mem input simple mem₂
      obtain ⟨newer₁, hhist₁, hlen₁⟩ := history_suffix first child₁ node gen₁ hlookup₁
      obtain ⟨newer₂, hhist₂, hlen₂⟩ := history_suffix second child₂ node gen₂ hlookup₂
      rw [hz₁, OfficialCIPNode.extend_history] at hhist₁
      rw [hz₂, OfficialCIPNode.extend_history] at hhist₂
      have hjoin := hhist₁.symm.trans hhist₂
      have hlenEq : newer₁.length = newer₂.length := by
        have := congrArg List.length hjoin
        simp at this
        omega
      have hsplit := List.append_inj hjoin hlenEq
      have hzz : z₁ = z₂ := (List.cons.inj hsplit.2).1
      have hsources : child₁.source = child₂.source := by rw [hz₁, hz₂, hzz]
      have hslot := slot_unique simple gen hchild₁ hchild₂ hsources
      rw [← hslot] at hchild₂
      have hchildEq : child₂ = child₁ := Option.some.inj (hchild₂.symm.trans hchild₁)
      rw [hchildEq] at hlookup₂
      rw [hslot, address_unique simple first second child₁ node gen₁ hlookup₁ hlookup₂]

end Generated

/-! ## Boundary-rooted trees -/

section Rooted

variable {input : CertifiedLocalizedCIPInput}

/-- A generated source tree rooted at the real node of the entry `x` below the ordered boundary
`B`; the stored root history `B ++ [x]` is duplicate-free. -/
structure BoundaryRootedTree (input : CertifiedLocalizedCIPInput) (B : List input.Atom)
    (x : input.Atom) (tree : OfficialCIPSourceTree input.Atom) : Prop where
  generated : tree.GeneratedBy input.executableOfficialCIPChildren
  root : tree.source = boundaryNode B [x]
  nodup : (B ++ [x]).Nodup

/-- **Path realization.** Every simple residual path from the entry, avoiding the boundary, is
the history of an actual ranked address. -/
theorem exists_address_of_cons (simple : input.moleculeGraph.SimpleBonded) :
    ∀ (rest B : List input.Atom) (x : input.Atom) (tree : OfficialCIPSourceTree input.Atom),
      BoundaryRootedTree input B x tree →
        ResidualObsPath input.moleculeGraph B x (x :: rest) →
          ∃ address, tree.sourceAtAddress? address = some (boundaryNode B (x :: rest))
  | [], B, x, tree, rooted, _ => ⟨[], by rw [sourceAtAddress?_nil, rooted.root]⟩
  | z :: rest, B, x, .node src children, rooted, hp => by
      have hroot : src = boundaryNode B [x] := rooted.root
      have hchain : 0 < input.moleculeGraph.bond x z ∧
          BondedChain input.moleculeGraph (z :: rest) := by
        simpa [BondedChain] using hp.chain
      have hzB : z ∉ B := hp.outside z (by simp)
      have hzx : z ≠ x := by
        have hnd := hp.nodup
        rw [List.nodup_cons] at hnd
        intro h
        exact hnd.1 (by simp [h])
      have hfresh : z ∉ B ++ [x] := by simp [hzB, hzx]
      have htail : ResidualObsPath input.moleculeGraph (B ++ [x]) z (z :: rest) :=
        obs_tail input.moleculeGraph hp (by simp)
      have hchildNode : (boundaryNode B [x]).extend z 0 = boundaryNode (B ++ [x]) [z] := by
        rw [extend_boundaryNode hfresh]
        exact boundaryNode_cons B x (List.cons_ne_nil z [])
      have hmem : boundaryNode (B ++ [x]) [z] ∈ input.executableOfficialCIPChildren src := by
        rw [hroot, mem_executableOfficialCIPChildren_iff input simple _ (current := x)
          (by simp) rfl]
        exact ⟨z, hchildNode.symm, hchain.1, parent?_boundaryNode_singleton_ne hzB⟩
      obtain ⟨slot, child, hchild, hsource⟩ := exists_slot_of_mem rooted.generated hmem
      obtain ⟨childGen, _⟩ := child_generated_and_mem rooted.generated hchild
      have childRooted : BoundaryRootedTree input (B ++ [x]) z child :=
        ⟨childGen, hsource, nodup_append_singleton rooted.nodup hfresh⟩
      obtain ⟨address, haddress⟩ :=
        exists_address_of_cons simple rest (B ++ [x]) z child childRooted htail
      refine ⟨slot :: address, ?_⟩
      rw [sourceAtAddress?_cons hchild, haddress, boundaryNode_cons B x (List.cons_ne_nil z rest)]

theorem exists_address_of_residualObsPath (simple : input.moleculeGraph.SimpleBonded)
    {B : List input.Atom} {x : input.Atom} {tree : OfficialCIPSourceTree input.Atom}
    (rooted : BoundaryRootedTree input B x tree) {p : List input.Atom}
    (hp : ResidualObsPath input.moleculeGraph B x p) :
    ∃ address, tree.sourceAtAddress? address = some (boundaryNode B p) := by
  have hcons := residualObsPath_eq_cons hp
  rw [hcons] at hp ⊢
  exact exists_address_of_cons simple p.tail B x tree rooted hp

/-- **Path readback.** Every real addressed node of a boundary-rooted tree is the boundary node
of a simple residual path from the entry. -/
theorem exists_residualObsPath_of_real (simple : input.moleculeGraph.SimpleBonded) :
    ∀ (address : List ℕ) (B : List input.Atom) (x : input.Atom)
      (tree : OfficialCIPSourceTree input.Atom) (node : OfficialCIPNode input.Atom),
      BoundaryRootedTree input B x tree → tree.sourceAtAddress? address = some node →
        node.provenance = .realAtom →
          ∃ p, ResidualObsPath input.moleculeGraph B x p ∧ node = boundaryNode B p
  | [], B, x, tree, node, rooted, lookup, _ => by
      have hsame := source_eq_of_sourceAtAddress?_nil lookup
      refine ⟨[x], obs_singleton input.moleculeGraph
        (not_mem_of_nodup_append_singleton rooted.nodup), ?_⟩
      rw [← hsame, rooted.root]
  | slot :: address, B, x, .node src children, node, rooted, lookup, hreal => by
      have hroot : src = boundaryNode B [x] := rooted.root
      have hxB : x ∉ B := not_mem_of_nodup_append_singleton rooted.nodup
      obtain ⟨child, hchild, hlookup⟩ := exists_child_of_sourceAtAddress?_cons lookup
      obtain ⟨childGen, childMem⟩ := child_generated_and_mem rooted.generated hchild
      rw [hroot] at childMem
      obtain ⟨z, hz, hadj, hparent⟩ :=
        (mem_executableOfficialCIPChildren_iff input simple _ (current := x) (by simp) rfl
          _).mp childMem
      cases child with
      | node childSrc grandchildren =>
          have hz' : childSrc = (boundaryNode B [x]).extend z 0 := hz
          have childReal : childSrc.provenance = .realAtom := by
            by_contra hnot
            have hleaf : childSrc.isDuplicateLeaf = true := by
              rw [hz'] at hnot ⊢
              exact MolecularEvidenceTree.isDuplicateLeaf_extend_of_ne _ z 0 hnot
            have hterm :=
              MolecularEvidenceTree.executableOfficialCIPChildren_terminal input childSrc hleaf
            have hperm : (grandchildren.map OfficialCIPSourceTree.source).Perm [] := by
              have hgen := childGen.1
              rw [hterm] at hgen
              exact hgen
            have hnil : grandchildren = [] := by
              have := hperm.eq_nil
              simpa using this
            cases address with
            | nil =>
                have hsame : childSrc = node := source_eq_of_sourceAtAddress?_nil hlookup
                exact hnot (by rw [hsame]; exact hreal)
            | cons s rest =>
                subst hnil
                simp [OfficialCIPSourceTree.sourceAtAddress?,
                  OfficialCIPSourceTree.subtreeAt?] at hlookup
          have hfreshHistory : z ∉ (boundaryNode B [x]).history := by
            intro hmem
            rw [hz', OfficialCIPNode.extend_provenance,
              OfficialCIPNode.childProvenance_ring_duplicate _ _ hmem] at childReal
            exact OfficialCIPNodeProvenance.noConfusion childReal
          have hfresh : z ∉ B ++ [x] := by
            intro h
            apply hfreshHistory
            rw [boundaryNode_history, List.mem_reverse]
            exact h
          have hzB : z ∉ B := fun h => hfresh (List.mem_append_left _ h)
          have childRooted : BoundaryRootedTree input (B ++ [x]) z
              (OfficialCIPSourceTree.node childSrc grandchildren) := by
            refine ⟨childGen, ?_, nodup_append_singleton rooted.nodup hfresh⟩
            show childSrc = boundaryNode (B ++ [x]) [z]
            rw [hz', extend_boundaryNode hfresh]
            exact boundaryNode_cons B x (List.cons_ne_nil z [])
          obtain ⟨p, hp, hnode⟩ := exists_residualObsPath_of_real simple address (B ++ [x]) z
            _ node childRooted hlookup hreal
          refine ⟨x :: p, obs_cons_child input.moleculeGraph hxB hadj hzB hp, ?_⟩
          rw [hnode, boundaryNode_cons B x hp.nonempty]

theorem path_length_of_address {B : List input.Atom} {x : input.Atom}
    {tree : OfficialCIPSourceTree input.Atom} (rooted : BoundaryRootedTree input B x tree)
    {address : List ℕ} {p : List input.Atom}
    (h : tree.sourceAtAddress? address = some (boundaryNode B p)) :
    p.length = address.length + 1 := by
  obtain ⟨newer, hhist, hlen⟩ := history_suffix address tree _ rooted.generated h
  have hlength := congrArg List.length hhist
  rw [rooted.root] at hlength
  simp at hlength
  omega

/-- **Parentage.** The parent of a real address is the real address of the path without its last
atom. -/
theorem parent_address (simple : input.moleculeGraph.SimpleBonded) {B : List input.Atom}
    {x : input.Atom} {tree : OfficialCIPSourceTree input.Atom}
    (rooted : BoundaryRootedTree input B x tree) {address : List ℕ} {p : List input.Atom}
    (h : tree.sourceAtAddress? address = some (boundaryNode B p)) (hp : 1 < p.length) :
    ∃ parentAddress slot, address = parentAddress ++ [slot] ∧
      tree.sourceAtAddress? parentAddress = some (boundaryNode B p.dropLast) := by
  have hlen := path_length_of_address rooted h
  have hne : address ≠ [] := by
    intro h0
    rw [h0] at hlen
    simp at hlen
    omega
  have hsplitAddress := (List.dropLast_concat_getLast hne).symm
  refine ⟨address.dropLast, address.getLast hne, hsplitAddress, ?_⟩
  unfold OfficialCIPSourceTree.sourceAtAddress? at h
  obtain ⟨sub, hsub, hsrc⟩ := Option.map_eq_some_iff.mp h
  rw [hsplitAddress, OfficialCIPSourceTree.subtreeAt?_append] at hsub
  obtain ⟨parent, hparent, hstep⟩ := Option.bind_eq_some_iff.mp hsub
  have parentGen := OfficialCIPSourceTree.GeneratedBy.of_subtreeAt? _ _ tree parent
    rooted.generated hparent
  cases parent with
  | node psrc pchildren =>
      have hslot : pchildren[address.getLast hne]? = some sub := by
        simp only [OfficialCIPSourceTree.subtreeAt?] at hstep
        cases hc : pchildren[address.getLast hne]? with
        | none => simp [hc] at hstep
        | some c =>
            rw [hc] at hstep
            simpa [OfficialCIPSourceTree.subtreeAt?] using hstep
      have hmem := (child_generated_and_mem parentGen hslot).2
      obtain ⟨z, hz⟩ := exists_extend_zero_of_mem input simple hmem
      have hparentLookup : tree.sourceAtAddress? address.dropLast = some psrc := by
        unfold OfficialCIPSourceTree.sourceAtAddress?
        rw [hparent]
        rfl
      have hparentReal : psrc.provenance = .realAtom := by
        rcases real_or_duplicateLeaf _ tree psrc rooted.generated
            (Or.inl (by rw [rooted.root]; rfl)) hparentLookup with hreal | hleaf
        · exact hreal
        · exfalso
          rw [MolecularEvidenceTree.executableOfficialCIPChildren_terminal input psrc hleaf]
            at hmem
          simp at hmem
      obtain ⟨p', hp', hnode⟩ := exists_residualObsPath_of_real simple _ B x tree psrc rooted
        hparentLookup hparentReal
      rw [hparentLookup, hnode]
      have hhist := congrArg OfficialCIPNode.history (hsrc.symm.trans hz)
      rw [hnode, OfficialCIPNode.extend_history] at hhist
      simp only [boundaryNode_history] at hhist
      have hrev : (B ++ p).reverse = (B ++ (p' ++ [z])).reverse := by
        rw [hhist]
        simp
      have hpath : p = p' ++ [z] := List.append_cancel_left (List.reverse_inj.mp hrev)
      rw [hpath, List.dropLast_concat]

end Rooted

/-! ## Ring-duplicate children decode non-parent bonds -/

section Ring

variable (input : CertifiedLocalizedCIPInput)

/-- **Indexed ring readback.** At the real node of a residual path, a ring-duplicate child with
Rule-1b distance `j` exists exactly when `j` indexes, root first, an atom of `B ++ p` other than
the terminal and its parent, and that atom is bonded to the terminal. -/
theorem ringDuplicateChild_iff (simple : input.moleculeGraph.SimpleBonded)
    {B p : List input.Atom} (hnodup : (B ++ p).Nodup) (hp : p ≠ []) (j : ℕ) :
    (∃ child ∈ input.executableOfficialCIPChildren (boundaryNode B p),
        child.provenance = .ringDuplicate j) ↔
      ∃ z, (B ++ p)[j]? = some z ∧ j + 2 < (B ++ p).length ∧
        input.moleculeGraph.Adj (p.getLast hp) z := by
  have hcurrent : (boundaryNode B p).current? = some (p.getLast hp) := by
    simp [List.getLast?_eq_some_getLast hp]
  have hlenPos : 0 < (B ++ p).length := by
    have : 0 < p.length := List.length_pos_iff.mpr hp
    simp
    omega
  have hlastIndex : (B ++ p)[(B ++ p).length - 1]? = some (p.getLast hp) := by
    rw [← List.getLast?_eq_getElem?]
    simp [List.getLast?_eq_some_getLast hp]
  have hparent : ∀ (h2 : 2 ≤ (B ++ p).length),
      (boundaryNode B p).parent? = (B ++ p)[(B ++ p).length - 2]? := by
    intro h2
    rw [parent?_eq_history_getElem?, boundaryNode_history,
      List.getElem?_reverse (by omega)]
    congr 1
  constructor
  · rintro ⟨child, hmem, hprov⟩
    obtain ⟨z, rfl, hadj, hpz⟩ :=
      (mem_executableOfficialCIPChildren_iff input simple _ hcurrent rfl child).mp hmem
    rw [OfficialCIPNode.extend_provenance] at hprov
    by_cases hzHistory : z ∈ (boundaryNode B p).history
    · rw [OfficialCIPNode.childProvenance_ring_duplicate _ _ hzHistory] at hprov
      have hdist : (boundaryNode B p).duplicateRootDistance z = j :=
        OfficialCIPNodeProvenance.ringDuplicate.inj hprov
      have hzL : z ∈ B ++ p := List.mem_reverse.mp hzHistory
      obtain ⟨k, hk⟩ := Rule1bSourceProfile.firstIndexOf?_eq_some_of_mem z hzL
      have hrev : (boundaryNode B p).history.reverse = B ++ p := by simp
      have hkj : k = j := by
        unfold OfficialCIPNode.duplicateRootDistance at hdist
        rw [hrev, hk] at hdist
        exact hdist
      subst hkj
      have hget := Rule1bSourceProfile.firstIndexOf?_eq_some_imp_getElem? z (B ++ p) k hk
      refine ⟨z, hget, ?_, hadj⟩
      have hklt : k < (B ++ p).length := (List.getElem?_eq_some_iff.mp hget).1
      have hnotLast : k ≠ (B ++ p).length - 1 := by
        intro hkl
        rw [hkl, hlastIndex] at hget
        exact ne_of_adj input.moleculeGraph hadj (Option.some.inj hget)
      have hnotParent : 2 ≤ (B ++ p).length → k ≠ (B ++ p).length - 2 := by
        intro h2 hkp
        apply hpz
        rw [hparent h2, ← hkp, hget]
      by_cases h2 : 2 ≤ (B ++ p).length
      · have := hnotParent h2
        omega
      · omega
    · rw [OfficialCIPNode.childProvenance_real _ _ hzHistory] at hprov
      exact OfficialCIPNodeProvenance.noConfusion hprov
  · rintro ⟨z, hz, hj, hadj⟩
    obtain ⟨hjlt, hzget⟩ := List.getElem?_eq_some_iff.mp hz
    have hzL : z ∈ B ++ p := List.mem_of_getElem? hz
    have hzHistory : z ∈ (boundaryNode B p).history := List.mem_reverse.mpr hzL
    have hpz : (boundaryNode B p).parent? ≠ some z := by
      rw [hparent (by omega)]
      intro hsame
      have hidx := List.getElem?_inj hjlt hnodup (hz.trans hsame.symm)
      omega
    refine ⟨(boundaryNode B p).extend z 0,
      (mem_executableOfficialCIPChildren_iff input simple _ hcurrent rfl _).mpr
        ⟨z, rfl, hadj, hpz⟩, ?_⟩
    rw [OfficialCIPNode.extend_provenance,
      OfficialCIPNode.childProvenance_ring_duplicate _ _ hzHistory]
    congr 1
    unfold OfficialCIPNode.duplicateRootDistance
    have hrev : (boundaryNode B p).history.reverse = B ++ p := by simp
    rw [hrev, ← hzget, firstIndexOf?_getElem_of_nodup (B ++ p) j hjlt hnodup]
    rfl

end Ring

/-! ## Provenance read from Rule 1b -/

section Rule1b

variable {input : CertifiedLocalizedCIPInput}

/-- The provenance decoded from a Rule-1b value at a known depth: the depth itself is a real atom,
any other value the ring duplicate of that root-first index. -/
def provenanceOfRule1b (depth distance : ℕ) : OfficialCIPNodeProvenance :=
  if distance = depth then .realAtom else .ringDuplicate distance

theorem rule1bRootDistance_boundaryNode (B p : List input.Atom) :
    (boundaryNode B p).rule1bRootDistance = B.length + p.length - 1 := by
  have h : (boundaryNode B p).rule1bRootDistance = (boundaryNode B p).history.length - 1 := rfl
  rw [h, boundaryNode_history, List.length_reverse, List.length_append]

/-- **Rule-1b provenance readback.** In a boundary-rooted tree under single bonding, the node at a
ranked address is real exactly when its Rule-1b value is its depth `|B| + |address|`; otherwise it
is the ring duplicate carrying that value. -/
theorem provenance_eq_provenanceOfRule1b (simple : input.moleculeGraph.SimpleBonded)
    {B : List input.Atom} {x : input.Atom} {tree : OfficialCIPSourceTree input.Atom}
    (rooted : BoundaryRootedTree input B x tree) {address : List ℕ}
    {node : OfficialCIPNode input.Atom} (h : tree.sourceAtAddress? address = some node) :
    node.provenance = provenanceOfRule1b (B.length + address.length) node.rule1bRootDistance := by
  rcases List.eq_nil_or_concat address with hnil | ⟨parentAddress, slot, hsnoc⟩
  · subst hnil
    have hroot : node = boundaryNode B [x] := by
      rw [← source_eq_of_sourceAtAddress?_nil h, rooted.root]
    subst hroot
    simp [provenanceOfRule1b, rule1bRootDistance_boundaryNode]
  · rw [List.concat_eq_append] at hsnoc
    subst hsnoc
    unfold OfficialCIPSourceTree.sourceAtAddress? at h
    obtain ⟨sub, hsub, hsrc⟩ := Option.map_eq_some_iff.mp h
    rw [OfficialCIPSourceTree.subtreeAt?_append] at hsub
    obtain ⟨parent, hparent, hstep⟩ := Option.bind_eq_some_iff.mp hsub
    have parentGen := OfficialCIPSourceTree.GeneratedBy.of_subtreeAt? _ _ tree parent
      rooted.generated hparent
    cases parent with
    | node psrc pchildren =>
        have hslot : pchildren[slot]? = some sub := by
          simp only [OfficialCIPSourceTree.subtreeAt?] at hstep
          cases hc : pchildren[slot]? with
          | none => simp [hc] at hstep
          | some c =>
              rw [hc] at hstep
              simpa [OfficialCIPSourceTree.subtreeAt?] using hstep
        have hmem := (child_generated_and_mem parentGen hslot).2
        have hparentLookup : tree.sourceAtAddress? parentAddress = some psrc := by
          unfold OfficialCIPSourceTree.sourceAtAddress?
          rw [hparent]
          rfl
        have hparentReal : psrc.provenance = .realAtom := by
          rcases real_or_duplicateLeaf _ tree psrc rooted.generated
              (Or.inl (by rw [rooted.root]; rfl)) hparentLookup with hreal | hleaf
          · exact hreal
          · exfalso
            rw [MolecularEvidenceTree.executableOfficialCIPChildren_terminal input psrc hleaf]
              at hmem
            simp at hmem
        obtain ⟨p, hp, hnode⟩ := exists_residualObsPath_of_real simple _ B x tree psrc rooted
          hparentLookup hparentReal
        have hplen : p.length = parentAddress.length + 1 := by
          rw [hnode] at hparentLookup
          exact path_length_of_address rooted hparentLookup
        subst hnode
        rw [← hsrc]
        have hcurrent : (boundaryNode B p).current? = some (p.getLast hp.nonempty) := by
          simp [List.getLast?_eq_some_getLast hp.nonempty]
        obtain ⟨z, hz, hadj, hpz⟩ :=
          (mem_executableOfficialCIPChildren_iff input simple _ hcurrent rfl _).mp hmem
        by_cases hzHistory : z ∈ (boundaryNode B p).history
        · have hprov : sub.source.provenance =
              .ringDuplicate ((boundaryNode B p).duplicateRootDistance z) := by
            rw [hz, OfficialCIPNode.extend_provenance,
              OfficialCIPNode.childProvenance_ring_duplicate _ _ hzHistory]
          have hrule : sub.source.rule1bRootDistance =
              (boundaryNode B p).duplicateRootDistance z := by
            unfold OfficialCIPNode.rule1bRootDistance
            rw [hprov]
          have hnodup := nodup_boundary_append (nodup_of_nodup_append_singleton rooted.nodup) hp
          obtain ⟨w, _, hbound, _⟩ :=
            (ringDuplicateChild_iff input simple hnodup hp.nonempty _).mp
              ⟨sub.source, hmem, hprov⟩
          rw [hprov, hrule]
          unfold provenanceOfRule1b
          rw [if_neg]
          simp only [List.length_append, List.length_singleton] at hbound ⊢
          omega
        · have hprov : sub.source.provenance = .realAtom := by
            rw [hz, OfficialCIPNode.extend_provenance,
              OfficialCIPNode.childProvenance_real _ _ hzHistory]
          have hrule : sub.source.rule1bRootDistance = B.length + p.length := by
            rw [hz]
            simp only [OfficialCIPNode.rule1bRootDistance, OfficialCIPNode.extend_provenance,
              OfficialCIPNode.childProvenance_real _ _ hzHistory, OfficialCIPNode.depth,
              OfficialCIPNode.extend_history, boundaryNode_history, List.length_cons,
              List.length_reverse, List.length_append]
            omega
          rw [hprov, hrule]
          unfold provenanceOfRule1b
          rw [if_pos]
          simp only [List.length_append, List.length_singleton]
          omega

end Rule1b

/-! ## Observations at ranked addresses -/

section Observation

variable {V : Type} [Fintype V] [DecidableEq V]

/-- The constitutional observation of one source node: its official label and its provenance. -/
def nodeObservation (m : MoleculeGraph V) (node : OfficialCIPNode V) :
    MoleculeGraph.AtomLabel × OfficialCIPNodeProvenance :=
  (m.officialNodeAtomLabel node, node.provenance)

/-- The observation at one ranked address, `none` at an unoccupied address. -/
def observationAt (m : MoleculeGraph V) (tree : OfficialCIPSourceTree V) (address : List ℕ) :
    Option (MoleculeGraph.AtomLabel × OfficialCIPNodeProvenance) :=
  (tree.sourceAtAddress? address).map (nodeObservation m)

/-- The constitutional observation read by Rules 1a, 1b and 2 at one ranked address: the official
label of the addressed node and its Rule-1b value. -/
def constitutionalObservationAt (m : MoleculeGraph V) (tree : OfficialCIPSourceTree V)
    (address : List ℕ) : Option (MoleculeGraph.AtomLabel × ℕ) :=
  (tree.sourceAtAddress? address).map fun node =>
    (m.officialNodeAtomLabel node, node.rule1bRootDistance)

theorem observation_transfer {m : MoleculeGraph V} {S₁ S₂ : OfficialCIPSourceTree V}
    (same : ∀ address, observationAt m S₁ address = observationAt m S₂ address)
    {address : List ℕ} {node₁ : OfficialCIPNode V}
    (h : S₁.sourceAtAddress? address = some node₁) :
    ∃ node₂, S₂.sourceAtAddress? address = some node₂ ∧
      nodeObservation m node₂ = nodeObservation m node₁ := by
  have h₁ : observationAt m S₁ address = some (nodeObservation m node₁) := by
    simp [observationAt, h]
  rw [same address] at h₁
  exact Option.map_eq_some_iff.mp h₁

theorem officialNodeAtomLabel_boundaryNode (m : MoleculeGraph V) (B : List V) {p : List V}
    (hp : p ≠ []) :
    m.officialNodeAtomLabel (boundaryNode B p) = m.rawCIPAtomLabel (p.getLast hp) := by
  unfold MoleculeGraph.officialNodeAtomLabel
  rw [boundaryNode_current?, List.getLast?_eq_some_getLast hp]
  rfl

end Observation

/-! ## The residual path-tree equivalence -/

section Assembly

variable {input : CertifiedLocalizedCIPInput}

/-- Two residual paths occupy one common ranked address of the two source trees. -/
def PathsCorrespond (S₁ S₂ : OfficialCIPSourceTree input.Atom) (B₁ B₂ p q : List input.Atom) :
    Prop :=
  ∃ address, S₁.sourceAtAddress? address = some (boundaryNode B₁ p) ∧
    S₂.sourceAtAddress? address = some (boundaryNode B₂ q)

theorem PathsCorrespond.symm {S₁ S₂ : OfficialCIPSourceTree input.Atom}
    {B₁ B₂ p q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q) :
    PathsCorrespond S₂ S₁ B₂ B₁ q p := by
  obtain ⟨address, h₁, h₂⟩ := h
  exact ⟨address, h₂, h₁⟩

variable {B₁ B₂ : List input.Atom} {x y : input.Atom}
variable {S₁ S₂ : OfficialCIPSourceTree input.Atom}

/-- Two boundary-rooted generated trees, under single bonding, with equal label/provenance
observations at every ranked address. -/
structure ObservedTreePair (input : CertifiedLocalizedCIPInput) (B₁ B₂ : List input.Atom)
    (x y : input.Atom) (S₁ S₂ : OfficialCIPSourceTree input.Atom) : Prop where
  simple : input.moleculeGraph.SimpleBonded
  rooted₁ : BoundaryRootedTree input B₁ x S₁
  rooted₂ : BoundaryRootedTree input B₂ y S₂
  same : ∀ address, observationAt input.moleculeGraph S₁ address =
    observationAt input.moleculeGraph S₂ address

theorem ObservedTreePair.symm (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂) :
    ObservedTreePair input B₂ B₁ y x S₂ S₁ :=
  ⟨pair.simple, pair.rooted₂, pair.rooted₁, fun address => (pair.same address).symm⟩

theorem exists_correspond (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p : List input.Atom} (hp : ResidualObsPath input.moleculeGraph B₁ x p) :
    ∃ q, ResidualObsPath input.moleculeGraph B₂ y q ∧ PathsCorrespond S₁ S₂ B₁ B₂ p q := by
  obtain ⟨address, haddress⟩ :=
    exists_address_of_residualObsPath pair.simple pair.rooted₁ hp
  obtain ⟨node₂, h₂, hobs⟩ := observation_transfer pair.same haddress
  have hreal : node₂.provenance = .realAtom := by
    have := congrArg Prod.snd hobs
    simpa [nodeObservation] using this
  obtain ⟨q, hq, hnode⟩ := exists_residualObsPath_of_real pair.simple address B₂ y S₂ node₂
    pair.rooted₂ h₂ hreal
  refine ⟨q, hq, address, haddress, ?_⟩
  rw [← hnode]
  exact h₂

theorem correspond_unique_right (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q q' : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q)
    (h' : PathsCorrespond S₁ S₂ B₁ B₂ p q') : q = q' := by
  obtain ⟨a, ha₁, ha₂⟩ := h
  obtain ⟨a', ha₁', ha₂'⟩ := h'
  have hsame : a = a' :=
    address_unique pair.simple a a' S₁ _ pair.rooted₁.generated ha₁ ha₁'
  rw [← hsame] at ha₂'
  exact boundaryNode_injective (Option.some.inj (ha₂.symm.trans ha₂'))

theorem correspond_unique_left (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p p' q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q)
    (h' : PathsCorrespond S₁ S₂ B₁ B₂ p' q) : p = p' :=
  correspond_unique_right pair.symm h.symm h'.symm

/-- The path of the second tree at the ranked address of a path of the first. -/
def correspondingPath (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    (p : {p : List input.Atom // ResidualObsPath input.moleculeGraph B₁ x p}) :
    {q : List input.Atom // ResidualObsPath input.moleculeGraph B₂ y q} :=
  ⟨Classical.choose (exists_correspond pair p.2),
    (Classical.choose_spec (exists_correspond pair p.2)).1⟩

theorem correspondingPath_spec (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    (p : {p : List input.Atom // ResidualObsPath input.moleculeGraph B₁ x p}) :
    PathsCorrespond S₁ S₂ B₁ B₂ p.1 (correspondingPath pair p).1 :=
  (Classical.choose_spec (exists_correspond pair p.2)).2

theorem correspondingPath_bijective (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂) :
    Function.Bijective (correspondingPath pair) := by
  constructor
  · intro p p' hpp'
    apply Subtype.ext
    have h := correspondingPath_spec pair p
    have h' := correspondingPath_spec pair p'
    rw [hpp'] at h
    exact correspond_unique_left pair h h'
  · intro q
    obtain ⟨p, hp, hcorr⟩ := exists_correspond pair.symm q.2
    refine ⟨⟨p, hp⟩, ?_⟩
    apply Subtype.ext
    exact correspond_unique_right pair (correspondingPath_spec pair ⟨p, hp⟩) hcorr.symm

/-- The address-preserving bijection of residual paths. -/
def pathEquiv (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂) :
    {p : List input.Atom // ResidualObsPath input.moleculeGraph B₁ x p} ≃
      {q : List input.Atom // ResidualObsPath input.moleculeGraph B₂ y q} :=
  Equiv.ofBijective _ (correspondingPath_bijective pair)

theorem pathEquiv_apply (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    (p : {p : List input.Atom // ResidualObsPath input.moleculeGraph B₁ x p}) :
    pathEquiv pair p = correspondingPath pair p :=
  rfl

theorem correspond_length (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q) :
    q.length = p.length := by
  obtain ⟨a, h₁, h₂⟩ := h
  rw [path_length_of_address pair.rooted₁ h₁, path_length_of_address pair.rooted₂ h₂]

theorem correspond_dropLast (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q) (hp : 1 < p.length) :
    PathsCorrespond S₁ S₂ B₁ B₂ p.dropLast q.dropLast := by
  have hq : 1 < q.length := by
    rw [correspond_length pair h]
    exact hp
  obtain ⟨a, h₁, h₂⟩ := h
  obtain ⟨pa, s, ha, hpa⟩ := parent_address pair.simple pair.rooted₁ h₁ hp
  obtain ⟨pa', s', ha', hpa'⟩ := parent_address pair.simple pair.rooted₂ h₂ hq
  have hpaEq : pa = pa' := by
    have := congrArg List.dropLast (ha.symm.trans ha')
    simpa using this
  rw [← hpaEq] at hpa'
  exact ⟨pa, hpa, hpa'⟩

theorem correspond_labels (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q)
    (hp : p ≠ []) (hq : q ≠ []) :
    input.moleculeGraph.atomZ (q.getLast hq) = input.moleculeGraph.atomZ (p.getLast hp) ∧
      input.moleculeGraph.atomMass (q.getLast hq) =
        input.moleculeGraph.atomMass (p.getLast hp) := by
  obtain ⟨a, h₁, h₂⟩ := h
  have o₁ : observationAt input.moleculeGraph S₁ a =
      some (nodeObservation input.moleculeGraph (boundaryNode B₁ p)) := by
    simp [observationAt, h₁]
  have o₂ : observationAt input.moleculeGraph S₂ a =
      some (nodeObservation input.moleculeGraph (boundaryNode B₂ q)) := by
    simp [observationAt, h₂]
  have hobs := Option.some.inj (o₂.symm.trans ((pair.same a).symm.trans o₁))
  have hlabel := congrArg Prod.fst hobs
  simp only [nodeObservation] at hlabel
  rw [officialNodeAtomLabel_boundaryNode _ _ hq, officialNodeAtomLabel_boundaryNode _ _ hp]
    at hlabel
  simp only [MoleculeGraph.rawCIPAtomLabel, toLex_inj, Prod.mk.injEq] at hlabel
  exact hlabel

/-- Ring-duplicate children with one Rule-1b distance correspond at matching addresses. -/
theorem correspond_ringChild (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (h : PathsCorrespond S₁ S₂ B₁ B₂ p q) (j : ℕ) :
    (∃ child ∈ input.executableOfficialCIPChildren (boundaryNode B₁ p),
        child.provenance = .ringDuplicate j) ↔
      ∃ child ∈ input.executableOfficialCIPChildren (boundaryNode B₂ q),
        child.provenance = .ringDuplicate j := by
  obtain ⟨a, h₁, h₂⟩ := h
  rw [exists_child_iff_address pair.rooted₁.generated h₁,
    exists_child_iff_address pair.rooted₂.generated h₂]
  constructor
  · rintro ⟨slot, child, hc, hprov⟩
    obtain ⟨child₂, hc₂, hobs⟩ := observation_transfer pair.same hc
    refine ⟨slot, child₂, hc₂, ?_⟩
    have := congrArg Prod.snd hobs
    simp only [nodeObservation] at this
    rw [this, hprov]
  · rintro ⟨slot, child, hc, hprov⟩
    obtain ⟨child₁, hc₁, hobs⟩ := observation_transfer pair.symm.same hc
    refine ⟨slot, child₁, hc₁, ?_⟩
    have := congrArg Prod.snd hobs
    simp only [nodeObservation] at this
    rw [this, hprov]

/-- Adjacency of the terminal to every root-first non-parent index of `B ++ p` is the same at
corresponding paths. -/
theorem correspond_adj_iff (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom}
    (hp : ResidualObsPath input.moleculeGraph B₁ x p)
    (hq : ResidualObsPath input.moleculeGraph B₂ y q)
    (h : PathsCorrespond S₁ S₂ B₁ B₂ p q) (hlen : (B₁ ++ p).length = (B₂ ++ q).length)
    (j : ℕ) (hj : j + 2 < (B₁ ++ p).length) :
    input.moleculeGraph.Adj (p.getLast hp.nonempty) ((B₁ ++ p)[j]'(by omega)) ↔
      input.moleculeGraph.Adj (q.getLast hq.nonempty) ((B₂ ++ q)[j]'(by omega)) := by
  have nodup₁ :=
    nodup_boundary_append (nodup_of_nodup_append_singleton pair.rooted₁.nodup) hp
  have nodup₂ :=
    nodup_boundary_append (nodup_of_nodup_append_singleton pair.rooted₂.nodup) hq
  have hring := correspond_ringChild pair h j
  rw [ringDuplicateChild_iff input pair.simple nodup₁ hp.nonempty j,
    ringDuplicateChild_iff input pair.simple nodup₂ hq.nonempty j] at hring
  constructor
  · intro hadj
    obtain ⟨z, hz, _, hadj₂⟩ := hring.mp ⟨_, List.getElem?_eq_getElem (by omega), hj, hadj⟩
    rw [List.getElem?_eq_getElem (by omega)] at hz
    rw [Option.some.inj hz]
    exact hadj₂
  · intro hadj
    obtain ⟨z, hz, _, hadj₁⟩ := hring.mpr ⟨_, List.getElem?_eq_getElem (by omega),
      by omega, hadj⟩
    rw [List.getElem?_eq_getElem (by omega)] at hz
    rw [Option.some.inj hz]
    exact hadj₁

/-- Bonds from corresponding terminals to every indexed boundary atom agree. Away from the entry
they are read from ring-duplicate children; at the entry the last boundary atom is its parent. -/
theorem correspond_boundaryBond (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (hp : ResidualObsPath input.moleculeGraph B₁ x p)
    (hq : ResidualObsPath input.moleculeGraph B₂ y q) (hcorr : PathsCorrespond S₁ S₂ B₁ B₂ p q)
    (len : B₁.length = B₂.length)
    (parent₁ : ∀ z, B₁.getLast? = some z → input.moleculeGraph.Adj x z)
    (parent₂ : ∀ z, B₂.getLast? = some z → input.moleculeGraph.Adj y z)
    (i : ℕ) (hi : i < B₁.length) (hi₂ : i < B₂.length) :
    input.moleculeGraph.bond (q.getLast hq.nonempty) (B₂[i]'hi₂) =
      input.moleculeGraph.bond (p.getLast hp.nonempty) (B₁[i]'hi) := by
  have hlenPQ : q.length = p.length := correspond_length pair hcorr
  have hlen : (B₁ ++ p).length = (B₂ ++ q).length := by
    simp [len, hlenPQ]
  have hplen : 0 < p.length := List.length_pos_iff.mpr hp.nonempty
  by_cases hj : i + 2 < (B₁ ++ p).length
  · have hiff := correspond_adj_iff pair hp hq hcorr hlen i hj
    have hsrc : (B₁ ++ p)[i]'(by omega) = B₁[i]'hi := List.getElem_append_left hi
    have htgt : (B₂ ++ q)[i]'(by omega) = B₂[i]'hi₂ := List.getElem_append_left hi₂
    rw [hsrc, htgt] at hiff
    exact bond_eq_of_adj_iff pair.simple hiff.symm
  · -- The entry path: `i` indexes the parent of the entry on the boundary.
    have hp1 : p.length = 1 := by simp at hj; omega
    have hq1 : q.length = 1 := by omega
    have hiLast : i = B₁.length - 1 := by simp at hj; omega
    have hpx : p = [x] := by
      have hcons := residualObsPath_eq_cons hp
      have htail : p.tail = [] := by
        apply List.eq_nil_of_length_eq_zero
        rw [List.length_tail]
        omega
      rw [hcons, htail]
    have hqy : q = [y] := by
      have hcons := residualObsPath_eq_cons hq
      have htail : q.tail = [] := by
        apply List.eq_nil_of_length_eq_zero
        rw [List.length_tail]
        omega
      rw [hcons, htail]
    have hlast₁ : B₁.getLast? = some (B₁[i]'hi) := by
      rw [List.getLast?_eq_getElem?]
      have hidx : B₁.length - 1 = i := by omega
      rw [hidx, List.getElem?_eq_getElem hi]
    have hlast₂ : B₂.getLast? = some (B₂[i]'hi₂) := by
      rw [List.getLast?_eq_getElem?]
      have hidx : B₂.length - 1 = i := by omega
      rw [hidx, List.getElem?_eq_getElem hi₂]
    have getLast_singleton_of_eq : ∀ (l : List input.Atom) (h : l ≠ []) (a : input.Atom),
        l = [a] → l.getLast h = a := by
      intro l h a hl
      subst hl
      rfl
    rw [getLast_singleton_of_eq _ _ _ hpx, getLast_singleton_of_eq _ _ _ hqy,
      pair.simple _ _ (parent₁ _ hlast₁), pair.simple _ _ (parent₂ _ hlast₂)]

/-- Bonds from corresponding terminals to every non-parent earlier path atom agree. -/
theorem correspond_ancestorBond (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    {p q : List input.Atom} (hp : ResidualObsPath input.moleculeGraph B₁ x p)
    (hq : ResidualObsPath input.moleculeGraph B₂ y q) (hcorr : PathsCorrespond S₁ S₂ B₁ B₂ p q)
    (len : B₁.length = B₂.length) (i : ℕ) (hi : i + 2 < p.length) (hiq : i < q.length) :
    input.moleculeGraph.bond (q.getLast hq.nonempty) (q[i]'hiq) =
      input.moleculeGraph.bond (p.getLast hp.nonempty) (p[i]'(by omega)) := by
  have hlenPQ : q.length = p.length := correspond_length pair hcorr
  have hlen : (B₁ ++ p).length = (B₂ ++ q).length := by
    simp [len, hlenPQ]
  have hj : B₁.length + i + 2 < (B₁ ++ p).length := by simp; omega
  have hiff := correspond_adj_iff pair hp hq hcorr hlen (B₁.length + i) hj
  have hsrc : (B₁ ++ p)[B₁.length + i]'(by omega) = p[i]'(by omega) := by
    rw [List.getElem_append_right (by omega)]
    exact getElem_eq_of_index_eq p (by omega) _ _
  have htgt : (B₂ ++ q)[B₁.length + i]'(by omega) = q[i]'hiq := by
    rw [List.getElem_append_right (by omega)]
    exact getElem_eq_of_index_eq q (by omega) _ _
  rw [hsrc, htgt] at hiff
  exact bond_eq_of_adj_iff pair.simple hiff.symm

/-- **Residual path-tree equivalence from equal addressed observations.** Two boundary-rooted
generated trees with the same ordered-boundary length, entries bonded to their boundary parents,
and equal label/provenance observations at every ranked address carry a full
`ResidualPathTreeEquiv`. -/
def residualPathTreeEquivOfSameObservations (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    (charge : AcyclicCutBranchAutomorphism.ConstantFormalCharge input.moleculeGraph)
    (len : B₁.length = B₂.length)
    (parent₁ : ∀ z, B₁.getLast? = some z → input.moleculeGraph.Adj x z)
    (parent₂ : ∀ z, B₂.getLast? = some z → input.moleculeGraph.Adj y z) :
    ResidualPathTreeEquiv input.moleculeGraph B₁ B₂ x y where
  len_eq := len
  toEquiv := pathEquiv pair
  length_eq := by
    intro p
    rw [pathEquiv_apply]
    exact correspond_length pair (correspondingPath_spec pair p)
  dropLast_eq := by
    intro p hp
    rw [pathEquiv_apply, pathEquiv_apply]
    exact correspond_unique_right pair (correspondingPath_spec pair _)
      (correspond_dropLast pair (correspondingPath_spec pair p) hp)
  atomZ_eq := by
    intro p
    rw [pathEquiv_apply]
    exact (correspond_labels pair (correspondingPath_spec pair p) _ _).1
  atomMass_eq := by
    intro p
    rw [pathEquiv_apply]
    exact (correspond_labels pair (correspondingPath_spec pair p) _ _).2
  formalCharge_eq := by
    intro p
    obtain ⟨c, hc⟩ := charge
    rw [hc, hc]
  boundaryBond_eq := by
    intro p i hi
    simp only [pathTerminal, List.get_eq_getElem]
    exact correspond_boundaryBond pair p.2 (pathEquiv pair p).2 (correspondingPath_spec pair p)
      len parent₁ parent₂ i hi _
  ancestorBond_eq := by
    intro p i hi
    simp only [pathTerminal, List.get_eq_getElem]
    exact correspond_ancestorBond pair p.2 (pathEquiv pair p).2 (correspondingPath_spec pair p)
      len i hi _
  parentBond_eq := by
    intro p hp
    have hq : 1 < (pathEquiv pair p).1.length := by
      rw [pathEquiv_apply, correspond_length pair (correspondingPath_spec pair p)]
      exact hp
    rw [parent_bond_eq_one pair.simple (pathEquiv pair p).2 hq,
      parent_bond_eq_one pair.simple p.2 hp]

/-- The constructed equivalence is the address correspondence: every path and its image are the
real nodes at one common ranked address of the two trees. -/
theorem residualPathTreeEquivOfSameObservations_correspond
    (pair : ObservedTreePair input B₁ B₂ x y S₁ S₂)
    (charge : AcyclicCutBranchAutomorphism.ConstantFormalCharge input.moleculeGraph)
    (len : B₁.length = B₂.length)
    (parent₁ : ∀ z, B₁.getLast? = some z → input.moleculeGraph.Adj x z)
    (parent₂ : ∀ z, B₂.getLast? = some z → input.moleculeGraph.Adj y z)
    (p : {p : List input.Atom // ResidualObsPath input.moleculeGraph B₁ x p}) :
    PathsCorrespond S₁ S₂ B₁ B₂ p.1
      ((residualPathTreeEquivOfSameObservations pair charge len parent₁ parent₂).toEquiv p).1 :=
  correspondingPath_spec pair p

/-- **Constitutional frontdoor.** Equal label and Rule-1b observations at every ranked address of
two boundary-rooted trees with boundaries of equal length already give equal provenance there,
hence an observed tree pair. -/
theorem observedTreePair_of_constitutional (simple : input.moleculeGraph.SimpleBonded)
    (rooted₁ : BoundaryRootedTree input B₁ x S₁) (rooted₂ : BoundaryRootedTree input B₂ y S₂)
    (len : B₁.length = B₂.length)
    (same : ∀ address, constitutionalObservationAt input.moleculeGraph S₁ address =
      constitutionalObservationAt input.moleculeGraph S₂ address) :
    ObservedTreePair input B₁ B₂ x y S₁ S₂ := by
  refine ⟨simple, rooted₁, rooted₂, ?_⟩
  intro address
  have hsame := same address
  unfold constitutionalObservationAt at hsame
  unfold observationAt
  cases h₁ : S₁.sourceAtAddress? address with
  | none =>
      rw [h₁] at hsame
      cases h₂ : S₂.sourceAtAddress? address with
      | none => rfl
      | some node₂ =>
          rw [h₂] at hsame
          simp at hsame
  | some node₁ =>
      rw [h₁] at hsame
      cases h₂ : S₂.sourceAtAddress? address with
      | none =>
          rw [h₂] at hsame
          simp at hsame
      | some node₂ =>
          rw [h₂] at hsame
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hsame
          obtain ⟨hlabel, hrule⟩ := hsame
          have hp₁ := provenance_eq_provenanceOfRule1b simple rooted₁ h₁
          have hp₂ := provenance_eq_provenanceOfRule1b simple rooted₂ h₂
          simp only [Option.map_some, nodeObservation, Option.some.injEq, Prod.mk.injEq]
          refine ⟨hlabel, ?_⟩
          rw [hp₁, hp₂, hrule, len]

end Assembly

end

