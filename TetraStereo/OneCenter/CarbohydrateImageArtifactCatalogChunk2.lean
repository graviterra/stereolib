@[simp] theorem imageArtifactsChunk2_length : imageArtifactsChunk2.length = 50 := by rfl

def imageArtifactPathsChunk2 : List String :=
  imageArtifactsChunk2.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk2_isChain :
    imageArtifactPathsChunk2.IsChain (· < ·) := by decide

theorem imageArtifactsChunk2_transcribedCount :
    (imageArtifactsChunk2.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk2_transcribedTemplatesWellFormed :
    (imageArtifactsChunk2.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk2_genericAndErratumTranscribed :
    (imageArtifactsChunk2.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk2_kindCounts :
    (imageArtifactsChunk2.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk2.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk2.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk2.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk2_chemicalPartitionCounts :
    (imageArtifactsChunk2.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk2.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk2_graphAuditMaturityCounts :
    (imageArtifactsChunk2.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk2.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk2.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

