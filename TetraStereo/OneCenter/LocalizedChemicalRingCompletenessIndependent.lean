import TetraStereo.OneCenter.LocalizedChemicalRingCompletenessMarked
import TetraStereo.OneCenter.LocalizedMarkedRetainedReachDegree
import TetraStereo.KernelOnly

set_option autoImplicit false
set_option maxHeartbeats 800000

/-!
# The generated facts of the actual evaluator are those of the independent specification

`LocalizedChemicalRingCompletenessMarked.assignCenter_eq` expresses the actual output through the
independent marked orders on the facts `generated` by the actual recursion. Here those facts are
identified with the facts generated by the independent operations record of
`LocalizedMarkedRetainedIndependentOperations` (no runtime comparator), on all admitted intake-agreeing localized single-bond inputs, including three-coordinate atoms. The recursive reference and consensus policy remains the experimental policy on both sides.
`separated_iff_independent` and `assignCenter_eq_independent` transport the decision condition
to the comparator-independent formulation; they do not derive separation from physical
distinguishability or establish chemical completeness.
-/

namespace TetraStereo.OneCenter.LocalizedChemicalRingCompletenessIndependent

open CertifiedLocalizedCIPInput DeclarativeCIP
open LocalizedChemicalRingPhysicalSense LocalizedChemicalRingCompletenessStrict
open LocalizedChemicalRingCompletenessMarked
open LocalizedMarkedRetainedIndependentOperations LocalizedMarkedRetainedReachDegree
open LocalizedMarkedRetainedSparsePromotedOperations (sparseOperations sparseOperations_eq)
open LocalizedMarkedOperationEvaluator (underWith tiedChildren mem_tiedChildren_actual)
open LocalizedMarkedReachableConfigurations (reached_root reached_child)
open LocalizedMarkedCertifiedTerminalRefusal (raw_atom_bound)
open LocalizedGenericMarkedRecalculation (Geometry consensus caseFromMirror? mirror structuralDepth
  flatMap_congr_mem)
open LocalizedRecursiveAuxiliaryPhysicalDomain (ActualPhysicalCalibratedCoordinates)
open scoped Classical

variable (input : CertifiedLocalizedCIPInput) (mol : RawMolecule)
  (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
  (admissible : mol.StereochemicalAdmissible)
  (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
  (single : input.moleculeGraph.SimpleBonded)
  (fallback : CompleteLigandRule5Key)
  (c : input.detectedMultiCenterMolecule.Center)

/-- The tied-children facts generated by the independent operations under an inherited reference. -/
noncomputable def independentGenerated (geom : Geometry) : Nat → OccurrenceAuxState :=
  underWith mol (independentOperations input single fallback mol) geom [] (canonicalCenterRoot c.1.val)
    (LocalizedMarkedOperationEvaluator.facts mol (independentOperations input single fallback mol)
      (structuralDepth mol (canonicalCenterRoot c.1.val)))

include agreement admissible supported in
/-- **The actually generated facts are the independently specified ones.** -/
theorem generated_eq_independent (data : RootData input mol c)
    (geom : Geometry) (r : Nat) :
    generated input mol c geom r = independentGenerated input mol single fallback c geom r := by
  have reached := reached_root mol c.1.val (raw_atom_bound mol input agreement c.1)
  have agree := agreeAt_general input single fallback mol agreement admissible supported
    (canonicalCenterRoot c.1.val) reached data.atoms data.rawFrame
  unfold generated independentGenerated underWith
  rw [sparseOperations_eq, tiedChildren_congr mol _ _ _ agree]
  apply flatMap_congr_mem
  intro child member
  exact facts_eq_independent_general input single fallback mol agreement admissible supported _ geom
    [] (some r) child (reached_child mol _ child reached (mem_tiedChildren_actual mol _ [] _ child member))

include agreement admissible supported in
/-- Separation by the actual generated facts is separation by the independent specification. -/
theorem separated_iff_independent (data : RootData input mol c)
    (geom : Geometry) (h : ℝ) :
    Separated input mol single c data (generated input mol c geom) h ↔
      Separated input mol single c data (independentGenerated input mol single fallback c geom) h := by
  unfold Separated
  simp only [generated_eq_independent input mol agreement admissible supported single fallback c
    data geom]

variable (cfg : input.detectedMultiCenterMolecule.Configuration)
  (calibrated : ActualPhysicalCalibratedCoordinates input input.detectedMultiCenterMolecule cfg c)

include agreement admissible supported calibrated in
/-- **The actual output at any detected centre in terms of the independent specification only**:
the physical configuration sign and the independent key orders on independently generated facts. -/
theorem assignCenter_eq_independent (data : RootData input mol c) :
    LocalizedMarkedOperationEvaluator.assignCenter? mol (sparseOperations input mol)
        (inputGeometry input) c.1.val =
      if Function.Injective (rootKeys input single data.target data.real data.detected) then
        some (.chiral (letterOfSign (input.detectedMultiCenterMolecule.configurationSign cfg c *
          permHandedness (priorityPerm input mol single c data))))
      else caseFromMirror?
        (consensus ((tiedLigands input mol single c data).map
          (readingOf input mol single c data (inputGeometry input)
            (independentGenerated input mol single fallback c (inputGeometry input)))))
        (consensus ((tiedLigands input mol single c data).map
          (readingOf input mol single c data (mirror (inputGeometry input))
            (independentGenerated input mol single fallback c (mirror (inputGeometry input)))))) := by
  rw [assignCenter_eq input mol single cfg c calibrated data]
  have eq : ∀ geom, generated input mol c geom = independentGenerated input mol single fallback c geom :=
    fun geom => funext fun r =>
      generated_eq_independent input mol agreement admissible supported single fallback c
        data geom r
  rw [eq, eq]

end TetraStereo.OneCenter.LocalizedChemicalRingCompletenessIndependent

assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingCompletenessIndependent.generated_eq_independent
assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingCompletenessIndependent.separated_iff_independent
assert_kernel_only TetraStereo.OneCenter.LocalizedChemicalRingCompletenessIndependent.assignCenter_eq_independent
