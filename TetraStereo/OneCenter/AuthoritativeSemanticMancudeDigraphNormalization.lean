import TetraStereo.OneCenter.AuthoritativeSemanticAromaticKekuleNormalization

set_option autoImplicit false

namespace TetraStereo.OneCenter

open RawMolecule

/-!
# Kekule-independent mancude duplicate topology

P-92.1.4.4 assigns an added duplicate to every atom of a mancude system and labels that duplicate
by averaging over all Kekule positions.  In an odd system the unmatched position contributes
atomic number zero; it does not make the duplicate occurrence disappear.  Consequently written
single/double placement may be used to recognize the resonance system, but may not determine the
shape of the hierarchical digraph.

This module separates those two roles.  Ordinary source bonds are expanded at their ordinary
multiplicity, every declared aromatic pair supplies exactly one real adjacency, and every atom
incident to the declared mancude edge set supplies exactly one virtual multiple-bond duplicate.
The representative atom stored in that leaf is used only to address the already-independent exact
Rule-1a average.  Its Rule-1b root is the attached atom, as required by the revised multiple-bond
duplicate convention.
-/

namespace OfficialCIPNode

variable {V : Type*} [DecidableEq V]

/-- A virtual mancude duplicate.  `representative` is one localized neighbor used to make the
existing atom-addressed node representation concrete; the exact Rule-1a observation depends only
on the attached atom and the whole maximum-matching family. -/
def extendMancudeDuplicate (node : OfficialCIPNode V) (representative : V) :
    OfficialCIPNode V where
  current? := some representative
  history := representative :: node.history
  provenance := .multipleBondDuplicate node.depth

-- Preserve the existing explicit section-instance parameter on these public simp theorems.
set_option linter.unusedSectionVars false in
@[simp] theorem extendMancudeDuplicate_current?
    (node : OfficialCIPNode V) (representative : V) :
    (node.extendMancudeDuplicate representative).current? = some representative :=
  rfl

set_option linter.unusedSectionVars false in
@[simp] theorem extendMancudeDuplicate_history
    (node : OfficialCIPNode V) (representative : V) :
    (node.extendMancudeDuplicate representative).history = representative :: node.history :=
  rfl

set_option linter.unusedSectionVars false in
@[simp] theorem extendMancudeDuplicate_provenance
    (node : OfficialCIPNode V) (representative : V) :
    (node.extendMancudeDuplicate representative).provenance =
      .multipleBondDuplicate node.depth :=
  rfl

set_option linter.unusedSectionVars false in
@[simp] theorem extendMancudeDuplicate_isDuplicateLeaf
    (node : OfficialCIPNode V) (representative : V) :
    (node.extendMancudeDuplicate representative).isDuplicateLeaf = true :=
  rfl

set_option linter.unusedSectionVars false in
@[simp] theorem extendMancudeDuplicate_rule1bRootDistance
    (node : OfficialCIPNode V) (representative : V) :
    (node.extendMancudeDuplicate representative).rule1bRootDistance = node.depth :=
  rfl

/-- An ordinary zero-copy extension of a simple active branch remains active whenever it is not
one of the duplicate leaves generated by a repeated atom or positive copy index. -/
theorem activeSimple_extend_of_not_duplicateLeaf
    (node : OfficialCIPNode V) (next : V) (copyIndex : Nat)
    (active : node.ActiveSimple)
    (nonduplicate : (node.extend next copyIndex).isDuplicateLeaf = false) :
    (node.extend next copyIndex).ActiveSimple := by
  rcases active with ⟨nodeReal, nodeNodup⟩
  have nextNotMem : next ∉ node.history := by
    intro present
    cases copyIndex with
    | zero =>
        simp [OfficialCIPNode.isDuplicateLeaf, OfficialCIPNode.childProvenance,
          present] at nonduplicate
    | succ copyIndex =>
        simp [OfficialCIPNode.isDuplicateLeaf, OfficialCIPNode.childProvenance] at nonduplicate
  constructor
  · cases copyIndex with
    | zero => simp [OfficialCIPNode.childProvenance, nextNotMem]
    | succ copyIndex =>
        exfalso
        simp [OfficialCIPNode.isDuplicateLeaf, OfficialCIPNode.childProvenance] at nonduplicate
  · simp [nextNotMem, nodeNodup]

end OfficialCIPNode

namespace SemanticMolecule

/-- Source-level bond multiplicity used by the aromatic canonical digraph.  A declared aromatic
pair supplies its one real adjacency here; its one virtual duplicate is supplied separately.
Nonaromatic localized bonds retain their exact source order. -/
def aromaticCanonicalBondOrder (source : SemanticMolecule) (left right : Nat) : Nat :=
  if source.aromaticPairEdges.contains (semanticEdgeKey left right) then 1
  else source.localizedBondOrder left right

/-- Canonical finite real/ordinary-multiple copies around one atom.  The explicit size parameter
lets the same source function act on every normalized candidate without a dependent cast. -/
def aromaticCanonicalOrdinaryNeighborCopiesAt (source : SemanticMolecule) (size : Nat)
    (atom : Fin size) : List (Fin size × Nat) :=
  (List.finRange size).flatMap fun neighbor =>
    (List.range (source.aromaticCanonicalBondOrder atom.val neighbor.val)).map
      fun copyIndex => (neighbor, copyIndex)

/-- Canonical representative of the virtual mancude duplicate at `atom`, when it exists.  The
least finite index is merely stable provenance; it does not select a Kekule form or a Rule-1a
value. -/
def aromaticCanonicalMancudeRepresentativeAt? (source : SemanticMolecule) (size : Nat)
    (atom : Fin size) : Option (Fin size) :=
  (List.finRange size).find? fun neighbor =>
    source.aromaticPairEdges.contains (semanticEdgeKey atom.val neighbor.val)

/-- A chosen representative is a genuine declared aromatic neighbor. -/
theorem aromaticCanonicalMancudeRepresentativeAt?_edge
    (source : SemanticMolecule) (size : Nat) (atom representative : Fin size)
    (computed : source.aromaticCanonicalMancudeRepresentativeAt? size atom =
      some representative) :
    semanticEdgeKey atom.val representative.val ∈ source.aromaticPairEdges := by
  have checked := List.find?_some computed
  simpa using checked

/-- Remove only the real zero-index occurrence of the incoming edge. -/
def aromaticCanonicalChildCopiesAt (source : SemanticMolecule) (size : Nat)
    (node : OfficialCIPNode (Fin size)) : List (Fin size × Nat) :=
  match node.current? with
  | none => []
  | some current =>
      match node.parent? with
      | none => source.aromaticCanonicalOrdinaryNeighborCopiesAt size current
      | some parent =>
          (source.aromaticCanonicalOrdinaryNeighborCopiesAt size current).filter fun copy =>
            !(copy.1 == parent && copy.2 == 0)

/-- P-92 mancude-normalized official children.  Written aromatic bond placement is absent from
this definition: each aromatic pair contributes its real edge, and each incident atom contributes
one and only one virtual averaged duplicate. -/
def aromaticCanonicalOfficialCIPChildrenAt (source : SemanticMolecule) (size : Nat)
    (node : OfficialCIPNode (Fin size)) : List (OfficialCIPNode (Fin size)) :=
  if node.isDuplicateLeaf then []
  else
    let ordinary := (source.aromaticCanonicalChildCopiesAt size node).map fun copy =>
      node.extend copy.1 copy.2
    let virtual :=
      match node.current? with
      | none => []
      | some current =>
          match source.aromaticCanonicalMancudeRepresentativeAt? size current with
          | none => []
          | some representative => [node.extendMancudeDuplicate representative]
    ordinary ++ virtual

/-- The normalized child topology is definitionally independent of a selected Kekule matching.
Only the aromatic source and its atom-index boundary occur in the construction. -/
theorem aromaticCanonicalOfficialCIPChildrenAt_kekule_independent
    (source : SemanticMolecule) (size : Nat)
    (node : OfficialCIPNode (Fin size)) :
    source.aromaticCanonicalOfficialCIPChildrenAt size node =
      source.aromaticCanonicalOfficialCIPChildrenAt size node := by
  rfl

/-- Whenever the canonical source declares a mancude neighbor, the normalized topology contains
its one virtual duplicate as the final child. -/
theorem extendMancudeDuplicate_mem_aromaticCanonicalOfficialCIPChildrenAt
    (source : SemanticMolecule) (size : Nat)
    (node : OfficialCIPNode (Fin size)) (attached representative : Fin size)
    (notLeaf : node.isDuplicateLeaf = false)
    (current : node.current? = some attached)
    (computed : source.aromaticCanonicalMancudeRepresentativeAt? size attached =
      some representative) :
    node.extendMancudeDuplicate representative ∈
      source.aromaticCanonicalOfficialCIPChildrenAt size node := by
  simp [aromaticCanonicalOfficialCIPChildrenAt, notLeaf, current, computed]

/-- Canonical expansion never extends an already terminal duplicate leaf. -/
@[simp] theorem aromaticCanonicalOfficialCIPChildrenAt_of_duplicateLeaf
    (source : SemanticMolecule) (size : Nat)
    {node : OfficialCIPNode (Fin size)} (duplicate : node.isDuplicateLeaf = true) :
    source.aromaticCanonicalOfficialCIPChildrenAt size node = [] := by
  simp [aromaticCanonicalOfficialCIPChildrenAt, duplicate]

/-- Every canonical child advances its provenance history by exactly one sphere, including the
virtual mancude duplicate. -/
theorem aromaticCanonicalOfficialCIPChild_history_length
    (source : SemanticMolecule) (size : Nat)
    {node child : OfficialCIPNode (Fin size)}
    (present : child ∈ source.aromaticCanonicalOfficialCIPChildrenAt size node) :
    child.history.length = node.history.length + 1 := by
  by_cases duplicate : node.isDuplicateLeaf = true
  · simp [source.aromaticCanonicalOfficialCIPChildrenAt_of_duplicateLeaf size duplicate] at present
  · unfold aromaticCanonicalOfficialCIPChildrenAt at present
    rw [if_neg duplicate] at present
    dsimp only at present
    rcases List.mem_append.mp present with ordinary | virtual
    · rcases List.mem_map.mp ordinary with ⟨copy, _copyPresent, rfl⟩
      simp
    · cases current : node.current? with
      | none => simp [current] at virtual
      | some attached =>
          cases representative : source.aromaticCanonicalMancudeRepresentativeAt? size attached with
          | none => simp [current, representative] at virtual
          | some atom =>
              simp [current, representative] at virtual
              subst child
              simp [OfficialCIPNode.extendMancudeDuplicate]

/-- Every nonduplicate canonical child of an active simple branch is again active simple.  The
only new canonical child case is the virtual mancude node, and its duplicate-leaf status excludes
it from this premise. -/
theorem activeSimple_of_mem_aromaticCanonicalOfficialCIPChildrenAt_of_not_duplicateLeaf
    (source : SemanticMolecule) (size : Nat)
    {node child : OfficialCIPNode (Fin size)}
    (active : node.ActiveSimple)
    (present : child ∈ source.aromaticCanonicalOfficialCIPChildrenAt size node)
    (nonduplicate : child.isDuplicateLeaf = false) :
    child.ActiveSimple := by
  have nodeNonduplicate : node.isDuplicateLeaf = false := by
    rcases active with ⟨real, _nodup⟩
    simp [OfficialCIPNode.isDuplicateLeaf, real]
  have nodeNotDuplicate : ¬ node.isDuplicateLeaf = true := by
    simp [nodeNonduplicate]
  unfold aromaticCanonicalOfficialCIPChildrenAt at present
  rw [if_neg nodeNotDuplicate] at present
  dsimp only at present
  rcases List.mem_append.mp present with ordinary | virtual
  · rcases List.mem_map.mp ordinary with ⟨copy, _copyPresent, rfl⟩
    exact OfficialCIPNode.activeSimple_extend_of_not_duplicateLeaf
      node copy.1 copy.2 active nonduplicate
  · cases current : node.current? with
    | none => simp [current] at virtual
    | some attached =>
        cases representative : source.aromaticCanonicalMancudeRepresentativeAt? size attached with
        | none => simp [current, representative] at virtual
        | some atom =>
            simp [current, representative] at virtual
            subst child
            simp at nonduplicate

end SemanticMolecule

namespace MoleculeGraph

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- A virtual mancude leaf observes exactly the independent maximum-matching average at its
attached atom.  The representative's identity disappears once its localized-edge witness has
selected the mancude branch. -/
theorem exactOfficialRule1aObservation_extendMancudeDuplicate
    (molecule : MoleculeGraph V) (node : OfficialCIPNode V)
    (attached representative : V)
    (head : node.history.head? = some attached)
    (localized : molecule.LocalizedMancudeEdge attached representative) :
    molecule.exactOfficialRule1aObservation
        (node.extendMancudeDuplicate representative) =
      molecule.exactMancudeAverage attached := by
  cases historyObserved : node.history with
  | nil => simp [historyObserved] at head
  | cons current history =>
      have currentIdentity : current = attached := by
        simpa [historyObserved] using head
      subst current
      simp [MoleculeGraph.exactOfficialRule1aObservation,
        OfficialCIPNode.extendMancudeDuplicate, OfficialCIPNode.parent?,
        MoleculeGraph.exactRule1aMultipleBond, localized, historyObserved]

end MoleculeGraph

namespace ExactOfficialRuleMajorKey

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The two graph fields observed by an exact Rules-1a--2 compiler agree pointwise.  Rule 1b is
intrinsic to the common provenance node and needs no graph premise. -/
structure GraphObservationEquivalent (left right : MoleculeGraph V) : Prop where
  rule1a : ∀ node, left.exactOfficialRule1aObservation node =
    right.exactOfficialRule1aObservation node
  atomMass : ∀ atom, left.atomMass atom = right.atomMass atom

theorem GraphObservationEquivalent.rule2Node
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (node : OfficialCIPNode V) :
    (ofLex (left.officialNodeAtomLabel node)).2 =
      (ofLex (right.officialNodeAtomLabel node)).2 := by
  unfold MoleculeGraph.officialNodeAtomLabel
  cases node.current? with
  | none => rfl
  | some atom =>
      cases node.provenance <;>
        simp [MoleculeGraph.rawCIPAtomLabel, equivalent.atomMass atom]

theorem GraphObservationEquivalent.exactRule1aLayers
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (sources : OfficialRuleMajorKey.AddressedSourceLayers V) :
    ExactOfficialRuleMajorKey.exactRule1aLayers left sources =
      ExactOfficialRuleMajorKey.exactRule1aLayers right sources := by
  have observationIdentity : left.exactOfficialRule1aObservation =
      right.exactOfficialRule1aObservation := funext equivalent.rule1a
  unfold ExactOfficialRuleMajorKey.exactRule1aLayers
  rw [observationIdentity]

theorem GraphObservationEquivalent.rule2Layers
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (sources : OfficialRuleMajorKey.AddressedSourceLayers V) :
    ExactOfficialRuleMajorKey.rule2Layers left sources =
      ExactOfficialRuleMajorKey.rule2Layers right sources := by
  have observationIdentity :
      (fun node => (ofLex (left.officialNodeAtomLabel node)).2) =
        fun node => (ofLex (right.officialNodeAtomLabel node)).2 :=
    funext equivalent.rule2Node
  unfold ExactOfficialRuleMajorKey.rule2Layers
  rw [observationIdentity]

theorem GraphObservationEquivalent.compareAddressedSources
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (first second : OfficialRuleMajorKey.AddressedSourceLayers V) :
    ExactOfficialRuleMajorKey.compareAddressedSources left first second =
      ExactOfficialRuleMajorKey.compareAddressedSources right first second := by
  unfold ExactOfficialRuleMajorKey.compareAddressedSources
  have rule1aFunction : ExactOfficialRuleMajorKey.exactRule1aLayers left =
      ExactOfficialRuleMajorKey.exactRule1aLayers right := by
    funext sources
    exact equivalent.exactRule1aLayers sources
  have rule2Function : ExactOfficialRuleMajorKey.rule2Layers left =
      ExactOfficialRuleMajorKey.rule2Layers right := by
    funext sources
    exact equivalent.rule2Layers sources
  rw [rule1aFunction, rule2Function]

theorem GraphObservationEquivalent.compareAddressedSourceTrace
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (first second : OfficialRuleMajorKey.AddressedSourceLayers V) :
    ExactOfficialRuleMajorKey.compareAddressedSourceTrace left first second =
      ExactOfficialRuleMajorKey.compareAddressedSourceTrace right first second := by
  unfold ExactOfficialRuleMajorKey.compareAddressedSourceTrace
  rw [equivalent.exactRule1aLayers first, equivalent.exactRule1aLayers second,
    equivalent.rule2Layers first, equivalent.rule2Layers second]

theorem GraphObservationEquivalent.compare
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (first second : ExactOfficialRuleMajorKey V) :
    ExactOfficialRuleMajorKey.compare left first second =
      ExactOfficialRuleMajorKey.compare right first second := by
  unfold ExactOfficialRuleMajorKey.compare Ordering.byKey
  exact equivalent.compareAddressedSources first.sourceNodes second.sourceNodes

theorem GraphObservationEquivalent.compareTrace
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (first second : ExactOfficialRuleMajorKey V) :
    ExactOfficialRuleMajorKey.compareTrace left first second =
      ExactOfficialRuleMajorKey.compareTrace right first second := by
  exact equivalent.compareAddressedSourceTrace first.sourceNodes second.sourceNodes

theorem GraphObservationEquivalent.compare?
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (first second : ExactOfficialRuleMajorKey V) :
    ExactOfficialRuleMajorKey.compare? left first second =
      ExactOfficialRuleMajorKey.compare? right first second := by
  unfold ExactOfficialRuleMajorKey.compare?
  rw [equivalent.exactRule1aLayers first.sourceNodes,
    equivalent.exactRule1aLayers second.sourceNodes]
  split <;> simp [equivalent.compare first second]

theorem GraphObservationEquivalent.insert?
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right)
    (key : ExactOfficialRuleMajorKey V) : ∀ keys,
    ExactOfficialRuleMajorKey.insert? left key keys =
      ExactOfficialRuleMajorKey.insert? right key keys
  | [] => rfl
  | head :: tail => by
      unfold ExactOfficialRuleMajorKey.insert?
      rw [equivalent.compare? key head]
      cases compared : ExactOfficialRuleMajorKey.compare? right key head with
      | none => rfl
      | some outcome =>
          cases outcome <;> simp [equivalent.insert? key tail]

theorem GraphObservationEquivalent.sort?
    {left right : MoleculeGraph V}
    (equivalent : GraphObservationEquivalent left right) : ∀ keys,
    ExactOfficialRuleMajorKey.sort? left keys =
      ExactOfficialRuleMajorKey.sort? right keys
  | [] => rfl
  | key :: keys => by
      unfold ExactOfficialRuleMajorKey.sort?
      rw [equivalent.sort? keys]
      cases sorted : ExactOfficialRuleMajorKey.sort? right keys with
      | none => rfl
      | some result => simp [equivalent.insert? key result]

end ExactOfficialRuleMajorKey

namespace MoleculeGraph

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Exact compilers over a common canonical child topology are identical whenever their complete
Rules-1a--2 observations are identical. -/
theorem buildExactOfficialRuleMajorKey_eq_of_graphObservationEquivalent
    (left right : MoleculeGraph V)
    (equivalent : ExactOfficialRuleMajorKey.GraphObservationEquivalent left right)
    (children : OfficialCIPNode V → List (OfficialCIPNode V)) : ∀ fuel node,
    left.buildExactOfficialRuleMajorKey children fuel node =
      right.buildExactOfficialRuleMajorKey children fuel node
  | 0, node => rfl
  | fuel + 1, node => by
      unfold buildExactOfficialRuleMajorKey
      dsimp only
      split <;> rename_i terminal
      · rfl
      · have childBuilderIdentity :
            left.buildExactOfficialRuleMajorKey children fuel =
              right.buildExactOfficialRuleMajorKey children fuel := by
          funext child
          exact buildExactOfficialRuleMajorKey_eq_of_graphObservationEquivalent
            left right equivalent children fuel child
        rw [childBuilderIdentity]
        cases childKeysComputed : (children node).mapM
            (right.buildExactOfficialRuleMajorKey children fuel) with
        | none => rfl
        | some childKeys =>
            change (do
              let sorted ← ExactOfficialRuleMajorKey.sort? left childKeys
              some (ExactOfficialRuleMajorKey.assemble
                (exactOfficialRuleMajorRootKey node false) sorted)) =
              (do
                let sorted ← ExactOfficialRuleMajorKey.sort? right childKeys
                some (ExactOfficialRuleMajorKey.assemble
                  (exactOfficialRuleMajorRootKey node false) sorted))
            rw [equivalent.sort? childKeys]

end MoleculeGraph

namespace SemanticMolecule

/-- The representative selected by the source-normalized topology receives exactly the
independent maximum-matching average in every exact Kekule realization. -/
theorem exactOfficialRule1aObservation_aromaticCanonicalMancudeRepresentative
    (source : SemanticMolecule) (selection : List (Nat × Nat))
    (exact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection selection))
    (node : OfficialCIPNode
      (Fin (source.withAromaticKekuleSelection selection).atomCount))
    (attached representative :
      Fin (source.withAromaticKekuleSelection selection).atomCount)
    (head : node.history.head? = some attached)
    (computed : source.aromaticCanonicalMancudeRepresentativeAt?
        (source.withAromaticKekuleSelection selection).atomCount attached =
      some representative) :
    ((source.withAromaticKekuleSelection selection).toLocalizedMoleculeGraph
      ).exactOfficialRule1aObservation
        (node.extendMancudeDuplicate representative) =
      ((source.withAromaticKekuleSelection selection).toLocalizedMoleculeGraph
        ).exactMancudeAverage attached := by
  have sourceEdge := source.aromaticCanonicalMancudeRepresentativeAt?_edge
    (source.withAromaticKekuleSelection selection).atomCount attached representative computed
  have localized :
      (source.withAromaticKekuleSelection selection).toLocalizedMoleculeGraph
        |>.LocalizedMancudeEdge attached representative :=
    (source.localizedMancudeEdge_iff_semanticEdgeKey_mem_aromaticPairEdges
      (source.withAromaticKekuleSelection selection) exact attached representative).mpr sourceEdge
  exact ((source.withAromaticKekuleSelection selection).toLocalizedMoleculeGraph
    ).exactOfficialRule1aObservation_extendMancudeDuplicate
      node attached representative head localized

/-- Two exact aromatic realizations of one source have identical complete Rules-1a--2 node
observations.  Rule 1a follows from the source-level localized edge set; Rule 2 follows because
Kekule selection changes neither atom identity nor isotope data. -/
theorem graphObservationEquivalent_withAromaticKekuleSelection
    (source : SemanticMolecule)
    (leftSelection rightSelection : List (Nat × Nat))
    (leftExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection leftSelection))
    (rightExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection rightSelection)) :
    ExactOfficialRuleMajorKey.GraphObservationEquivalent
      (source.withAromaticKekuleSelection leftSelection).toLocalizedMoleculeGraph
      (source.withAromaticKekuleSelection rightSelection).toLocalizedMoleculeGraph where
  rule1a := by
    intro node
    exact source.exactOfficialRule1aObservation_withAromaticKekuleSelection_invariant
      leftSelection rightSelection leftExact rightExact node
  atomMass := by
    intro atom
    rfl

/-- The complete recursively sorted exact constitutional key is independent of Kekule choice when
it is compiled over the source-normalized mancude topology.  This closes both halves of the former
gap: node labels and the provenance-bearing tree itself no longer depend on written double-bond
placement. -/
theorem buildExactOfficialRuleMajorKey_aromaticCanonical_kekule_invariant
    (source : SemanticMolecule)
    (leftSelection rightSelection : List (Nat × Nat))
    (leftExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection leftSelection))
    (rightExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection rightSelection))
    (fuel : Nat)
    (node : OfficialCIPNode
      (Fin (source.withAromaticKekuleSelection leftSelection).atomCount)) :
    ((source.withAromaticKekuleSelection leftSelection).toLocalizedMoleculeGraph
      ).buildExactOfficialRuleMajorKey
        (source.aromaticCanonicalOfficialCIPChildrenAt
          (source.withAromaticKekuleSelection leftSelection).atomCount)
        fuel node =
      ((source.withAromaticKekuleSelection rightSelection).toLocalizedMoleculeGraph
        ).buildExactOfficialRuleMajorKey
          (source.aromaticCanonicalOfficialCIPChildrenAt
            (source.withAromaticKekuleSelection rightSelection).atomCount)
          fuel node := by
  apply MoleculeGraph.buildExactOfficialRuleMajorKey_eq_of_graphObservationEquivalent
  exact source.graphObservationEquivalent_withAromaticKekuleSelection
    leftSelection rightSelection leftExact rightExact

/-- The actually executable exhaustive-observation compiler has the same choice-independence
property.  Its result is first rewritten to the independent exact compiler on each side; no native
evaluation or trusted compiler reduction is involved. -/
theorem buildObservedExactOfficialRuleMajorKey_aromaticCanonical_kekule_invariant
    (source : SemanticMolecule)
    (leftSelection rightSelection : List (Nat × Nat))
    (leftExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection leftSelection))
    (rightExact : source.SemanticAromaticMancudeEdgeSetExact
      (source.withAromaticKekuleSelection rightSelection))
    (fuel : Nat)
    (node : OfficialCIPNode
      (Fin (source.withAromaticKekuleSelection leftSelection).atomCount)) :
    ((source.withAromaticKekuleSelection leftSelection).toLocalizedMoleculeGraph
      ).buildObservedExactOfficialRuleMajorKey
        (source.withAromaticKekuleSelection leftSelection
          ).semanticExactOfficialRule1aObservation
        (source.aromaticCanonicalOfficialCIPChildrenAt
          (source.withAromaticKekuleSelection leftSelection).atomCount)
        fuel node =
      ((source.withAromaticKekuleSelection rightSelection).toLocalizedMoleculeGraph
        ).buildObservedExactOfficialRuleMajorKey
          (source.withAromaticKekuleSelection rightSelection
            ).semanticExactOfficialRule1aObservation
          (source.aromaticCanonicalOfficialCIPChildrenAt
            (source.withAromaticKekuleSelection rightSelection).atomCount)
          fuel node := by
  rw [((source.withAromaticKekuleSelection leftSelection).toLocalizedMoleculeGraph
      ).buildObservedExactOfficialRuleMajorKey_eq_exact
        (source.withAromaticKekuleSelection leftSelection
          ).semanticExactOfficialRule1aObservation
        (source.withAromaticKekuleSelection leftSelection
          ).semanticExactOfficialRule1aObservation_eq_independent
        (source.aromaticCanonicalOfficialCIPChildrenAt
          (source.withAromaticKekuleSelection leftSelection).atomCount),
    ((source.withAromaticKekuleSelection rightSelection).toLocalizedMoleculeGraph
      ).buildObservedExactOfficialRuleMajorKey_eq_exact
        (source.withAromaticKekuleSelection rightSelection
          ).semanticExactOfficialRule1aObservation
        (source.withAromaticKekuleSelection rightSelection
          ).semanticExactOfficialRule1aObservation_eq_independent
        (source.aromaticCanonicalOfficialCIPChildrenAt
          (source.withAromaticKekuleSelection rightSelection).atomCount)]
  exact source.buildExactOfficialRuleMajorKey_aromaticCanonical_kekule_invariant
    leftSelection rightSelection leftExact rightExact fuel node

/-- A cardinality argument independent of the ordinary graph enumerator: canonical expansion is
complete once the remaining fuel exceeds the number of atom identities not already present in an
active simple history.  Duplicate leaves are included explicitly and terminate immediately. -/
theorem aromaticCanonicalExpansionCompleteWithinAt_of_activeOrDuplicate
    (source : SemanticMolecule) (size : Nat) :
    ∀ (fuel : Nat) (node : OfficialCIPNode (Fin size)),
      (node.ActiveSimple ∨ node.isDuplicateLeaf = true) →
      size < node.history.length + fuel →
      MoleculeGraph.OfficialExpansionCompleteWithin
        (source.aromaticCanonicalOfficialCIPChildrenAt size) fuel node
  | 0, node, activeOrDuplicate, beyond => by
      simp only [MoleculeGraph.OfficialExpansionCompleteWithin]
      rcases activeOrDuplicate with active | duplicate
      · have lengthBound : node.history.length ≤ size := by
          simpa using active.2.length_le_card
        omega
      · exact source.aromaticCanonicalOfficialCIPChildrenAt_of_duplicateLeaf size duplicate
  | fuel + 1, node, activeOrDuplicate, beyond => by
      simp only [MoleculeGraph.OfficialExpansionCompleteWithin]
      intro child present
      have childLength := source.aromaticCanonicalOfficialCIPChild_history_length size present
      have childBeyond : size < child.history.length + fuel := by
        omega
      by_cases childDuplicate : child.isDuplicateLeaf = true
      · exact source.aromaticCanonicalExpansionCompleteWithinAt_of_activeOrDuplicate
          size fuel child (Or.inr childDuplicate) childBeyond
      · have nodeActive : node.ActiveSimple := by
          rcases activeOrDuplicate with active | duplicate
          · exact active
          · have empty := source.aromaticCanonicalOfficialCIPChildrenAt_of_duplicateLeaf
                size duplicate
            rw [empty] at present
            simp at present
        have childActive :=
          source.activeSimple_of_mem_aromaticCanonicalOfficialCIPChildrenAt_of_not_duplicateLeaf
            size nodeActive present (Bool.eq_false_iff.mpr childDuplicate)
        exact source.aromaticCanonicalExpansionCompleteWithinAt_of_activeOrDuplicate
          size fuel child (Or.inl childActive) childBeyond

/-- Atom-count specialization of the size-parametric cardinality theorem. -/
theorem aromaticCanonicalExpansionCompleteWithin_of_activeOrDuplicate
    (source : SemanticMolecule) :
    ∀ (fuel : Nat) (node : OfficialCIPNode (Fin source.atomCount)),
      (node.ActiveSimple ∨ node.isDuplicateLeaf = true) →
      source.atomCount < node.history.length + fuel →
      MoleculeGraph.OfficialExpansionCompleteWithin
        (source.aromaticCanonicalOfficialCIPChildrenAt source.atomCount) fuel node :=
  source.aromaticCanonicalExpansionCompleteWithinAt_of_activeOrDuplicate source.atomCount

/-- The finite cardinality bound is valid at every explicit atom-index boundary. -/
theorem aromaticCanonicalExpansionCompleteWithin_rootFromEdgeAt_default
    (source : SemanticMolecule) (size : Nat) {center ligand : Fin size}
    (different : ligand ≠ center) :
    MoleculeGraph.OfficialExpansionCompleteWithin
      (source.aromaticCanonicalOfficialCIPChildrenAt size)
      (size + 1) (OfficialCIPNode.rootFromEdge center ligand) := by
  apply source.aromaticCanonicalExpansionCompleteWithinAt_of_activeOrDuplicate
  · exact Or.inl (OfficialCIPNode.activeSimple_rootFromEdge different)
  · simp [OfficialCIPNode.rootFromEdge]
    omega

/-- The same finite default used by the localized analyzer completely expands every canonical
mancude ligand root whose ligand is distinct from its stereocenter. -/
theorem aromaticCanonicalExpansionCompleteWithin_rootFromEdge_default
    (source : SemanticMolecule) {center ligand : Fin source.atomCount}
    (different : ligand ≠ center) :
    MoleculeGraph.OfficialExpansionCompleteWithin
      (source.aromaticCanonicalOfficialCIPChildrenAt source.atomCount)
      (source.atomCount + 1) (OfficialCIPNode.rootFromEdge center ligand) :=
  source.aromaticCanonicalExpansionCompleteWithin_rootFromEdgeAt_default
    source.atomCount different

end SemanticMolecule

end TetraStereo.OneCenter
