@[simp] theorem imageArtifactsChunk5_length : imageArtifactsChunk5.length = 50 := by rfl

def imageArtifactPathsChunk5 : List String :=
  imageArtifactsChunk5.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk5_isChain :
    imageArtifactPathsChunk5.IsChain (· < ·) := by decide

theorem imageArtifactsChunk5_transcribedCount :
    (imageArtifactsChunk5.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk5_transcribedTemplatesWellFormed :
    (imageArtifactsChunk5.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk5_genericAndErratumTranscribed :
    (imageArtifactsChunk5.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk5_kindCounts :
    (imageArtifactsChunk5.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk5.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk5.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk5.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk5_chemicalPartitionCounts :
    (imageArtifactsChunk5.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk5.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk5_graphAuditMaturityCounts :
    (imageArtifactsChunk5.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk5.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk5.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

