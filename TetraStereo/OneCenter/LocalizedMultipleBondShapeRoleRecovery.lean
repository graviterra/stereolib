namespace TetraStereo.OneCenter

/-! ## Provenance generated by the official expansion

Only three provenance constructors can be produced by `OfficialCIPNode.childProvenance` from a
root whose provenance is real: real atoms, multiple-bond duplicates and ring duplicates.  The
placeholder constructors are never generated.  This is the structural fact needed to read
"not a duplicate leaf" as "real atom" without assuming the intended role. -/

/-- Provenance constructors reachable from the official root by executable expansion. -/
inductive OfficialGeneratedProvenance : OfficialCIPNodeProvenance → Prop where
  | realAtom :
      OfficialGeneratedProvenance OfficialCIPNodeProvenance.realAtom
  | multipleBondDuplicate (distance : Nat) :
      OfficialGeneratedProvenance
        (OfficialCIPNodeProvenance.multipleBondDuplicate distance)
  | ringDuplicate (distance : Nat) :
      OfficialGeneratedProvenance
        (OfficialCIPNodeProvenance.ringDuplicate distance)

namespace OfficialGeneratedProvenance

/-- A generated provenance that is not a duplicate leaf is real.  Placeholders are impossible for
generated provenance, and both duplicate constructors make `isDuplicateLeaf` true. -/
theorem real_of_isDuplicateLeaf_eq_false {provenance : OfficialCIPNodeProvenance}
    (generated : OfficialGeneratedProvenance provenance)
    (notDuplicate : provenance.isDuplicateLeaf = false) :
    provenance = OfficialCIPNodeProvenance.realAtom := by
  cases generated with
  | realAtom => rfl
  | multipleBondDuplicate distance =>
      simp [OfficialCIPNodeProvenance.isDuplicateLeaf] at notDuplicate
  | ringDuplicate distance =>
      simp [OfficialCIPNodeProvenance.isDuplicateLeaf] at notDuplicate

end OfficialGeneratedProvenance

/-! ## Shape-side role masks

The mask is the preorder list of "duplicate role" bits computed from the comparison-visible
shape alone.  The root bit is compared against an external parent distance; every other bit is
compared against its own parent's visible distance.  The canonical root mask makes the root real
by comparing its distance with an impossible parent distance. -/

namespace LocalizedCumulativeBranchShape

mutual
  /-- Preorder role mask of one shape, relative to the visible distance of its parent. -/
  def duplicateRoleMaskWithParent (parentDistance : Nat) :
      LocalizedCumulativeBranchShape → List Bool
    | ⟨_atomicNumber, rule1bDistance, _isotopeMass, children⟩ =>
        (rule1bDistance == parentDistance) ::
          duplicateRoleMaskListWithParent rule1bDistance children
    termination_by shape => sizeOf shape
    decreasing_by
      simp_wf

  /-- Preorder role mask of a sibling list; all siblings share the parent's visible distance. -/
  def duplicateRoleMaskListWithParent (parentDistance : Nat) :
      List LocalizedCumulativeBranchShape → List Bool
    | [] => []
    | shape :: shapes =>
        duplicateRoleMaskWithParent parentDistance shape ++
          duplicateRoleMaskListWithParent parentDistance shapes
    termination_by shapes => sizeOf shapes
    decreasing_by
      all_goals (simp_wf <;> omega)
end

/-- Canonical mask of a shape viewed as a real root: the root is never marked as a duplicate and
its children are compared with the root's visible distance. -/
def duplicateRoleMask (shape : LocalizedCumulativeBranchShape) : List Bool :=
  duplicateRoleMaskWithParent (shape.rule1bDistance + 1) shape

/-- Unfolding equation at one shape node. -/
theorem duplicateRoleMaskWithParent_mk (parentDistance : Nat)
    (atomicNumber rule1bDistance isotopeMass : Nat)
    (children : List LocalizedCumulativeBranchShape) :
    duplicateRoleMaskWithParent parentDistance
      { atomicNumber := atomicNumber
        rule1bDistance := rule1bDistance
        isotopeMass := isotopeMass
        children := children } =
      (rule1bDistance == parentDistance) ::
        duplicateRoleMaskListWithParent rule1bDistance children := by
  rw [duplicateRoleMaskWithParent]

/-- Unfolding equation at the empty sibling list. -/
theorem duplicateRoleMaskListWithParent_nil (parentDistance : Nat) :
    duplicateRoleMaskListWithParent parentDistance
      ([] : List LocalizedCumulativeBranchShape) = [] := by
  rw [duplicateRoleMaskListWithParent]

/-- Unfolding equation at a nonempty sibling list. -/
theorem duplicateRoleMaskListWithParent_cons (parentDistance : Nat)
    (shape : LocalizedCumulativeBranchShape)
    (shapes : List LocalizedCumulativeBranchShape) :
    duplicateRoleMaskListWithParent parentDistance (shape :: shapes) =
      duplicateRoleMaskWithParent parentDistance shape ++
        duplicateRoleMaskListWithParent parentDistance shapes := by
  rw [duplicateRoleMaskListWithParent]

end LocalizedCumulativeBranchShape

/-! ## Actual role masks

The actual mask reads `isDuplicateLeaf` from the real source cursor at every preorder position.
No shape or erasure information is used. -/

namespace LocalizedCumulativeDecoratedTree

mutual
  /-- Preorder list of actual `isDuplicateLeaf` bits of a decorated tree. -/
  def actualDuplicateRoleMask {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat} :
      LocalizedCumulativeDecoratedTree input carrierFuel → List Bool
    | ⟨source, _atomicNumber, _rule1bDistance, _isotopeMass, _label, children⟩ =>
        source.occurrence.1.node.isDuplicateLeaf :: actualDuplicateRoleMaskList children
    termination_by tree => sizeOf tree
    decreasing_by
      simp_wf

  /-- Preorder list of actual `isDuplicateLeaf` bits over a sibling forest. -/
  def actualDuplicateRoleMaskList {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat} :
      List (LocalizedCumulativeDecoratedTree input carrierFuel) → List Bool
    | [] => []
    | tree :: trees =>
        actualDuplicateRoleMask tree ++ actualDuplicateRoleMaskList trees
    termination_by trees => sizeOf trees
    decreasing_by
      all_goals (simp_wf <;> omega)
end

/-- Unfolding equation of the actual mask at the empty forest. -/
theorem table_actualDuplicateRoleMaskList_nil {input : CertifiedLocalizedCIPInput}
    {carrierFuel : Nat} :
    actualDuplicateRoleMaskList
      ([] : List (LocalizedCumulativeDecoratedTree input carrierFuel)) = [] := by
  rw [actualDuplicateRoleMaskList]

/-- Unfolding equation of the actual mask at a nonempty forest. -/
theorem table_actualDuplicateRoleMaskList_cons {input : CertifiedLocalizedCIPInput}
    {carrierFuel : Nat}
    (tree : LocalizedCumulativeDecoratedTree input carrierFuel)
    (trees : List (LocalizedCumulativeDecoratedTree input carrierFuel)) :
    actualDuplicateRoleMaskList (tree :: trees) =
      actualDuplicateRoleMask tree ++ actualDuplicateRoleMaskList trees := by
  rw [actualDuplicateRoleMaskList]

/-- The erased shape keeps the Rule-1b distance field. -/
theorem table_shape_rule1bDistance {input : CertifiedLocalizedCIPInput}
    {carrierFuel : Nat} (tree : LocalizedCumulativeDecoratedTree input carrierFuel) :
    (shape tree).rule1bDistance = tree.rule1bDistance := by
  cases tree with
  | mk source atomicNumber rule1bDistance isotopeMass label children =>
      rw [table_shape_mk]

end LocalizedCumulativeDecoratedTree

open LocalizedCumulativeDecoratedTree
open LocalizedCumulativeBranchShape

/-! ## Local role recovery at a real reroot cursor -/

namespace CertifiedLocalizedCIPInput

/-- Every executable child provenance is generated. -/
theorem childProvenance_generated (input : CertifiedLocalizedCIPInput)
    (node : OfficialCIPNode input.Atom) (next : input.Atom) (copyIndex : Nat) :
    OfficialGeneratedProvenance
      (OfficialCIPNode.childProvenance node next copyIndex) := by
  by_cases zero : copyIndex = 0
  · rw [OfficialCIPNode.childProvenance, if_pos zero]
    by_cases visited : next ∈ node.history
    · rw [if_pos visited]
      exact OfficialGeneratedProvenance.ringDuplicate _
    · rw [if_neg visited]
      exact OfficialGeneratedProvenance.realAtom
  · rw [OfficialCIPNode.childProvenance, if_neg zero]
    exact OfficialGeneratedProvenance.multipleBondDuplicate _

/-- Generated provenance propagates down any declarative occurrence subtree. -/
theorem declarativeLocalizedOccurrenceSubtree_generated
    (input : CertifiedLocalizedCIPInput) {root : input.Atom} {path : List Nat}
    {fuel : Nat} {node : OfficialCIPNode input.Atom}
    {occurrence : input.LocalizedCIPOccurrenceFrame}
    (derived : input.DeclarativeLocalizedOccurrenceSubtree root path fuel node occurrence) :
    OfficialGeneratedProvenance node.provenance →
      OfficialGeneratedProvenance occurrence.node.provenance := by
  induction derived with
  | subtreeRoot =>
      intro inherited
      exact inherited
  | @subtreeDescendant path fuel node child slot occurrence childAtSlot descendant
      inductionHypothesis =>
      intro inherited
      apply inductionHypothesis
      have childPresent : child ∈ input.executableOfficialCIPChildren node :=
        List.fst_mem_of_mem_zipIdx childAtSlot
      obtain ⟨next, copyIndex, childExtend⟩ :=
        input.mem_executableOfficialCIPChildren_extend node child childPresent
      rw [childExtend, OfficialCIPNode.extend_provenance]
      exact input.childProvenance_generated node next copyIndex

/-- Every carrier occurrence has generated provenance. -/
theorem carrierOccurrence_generatedProvenance
    (input : CertifiedLocalizedCIPInput) {fuel : Nat}
    (occurrence : input.LocalizedCIPOccurrence fuel) :
    OfficialGeneratedProvenance occurrence.1.node.provenance := by
  have derived :=
    (input.mem_localizedOccurrences_iff fuel occurrence.1).mp occurrence.2
  exact input.declarativeLocalizedOccurrenceSubtree_generated
    (input.declarativeLocalizedOccurrence_as_rootSubtree derived)
    OfficialGeneratedProvenance.realAtom

/-- A carrier occurrence that is not a duplicate leaf is a real atom. -/
theorem provenance_real_of_isDuplicateLeaf_false
    (input : CertifiedLocalizedCIPInput) {fuel : Nat}
    (occurrence : input.LocalizedCIPOccurrence fuel)
    (notDuplicate : occurrence.1.node.isDuplicateLeaf = false) :
    occurrence.1.node.provenance = OfficialCIPNodeProvenance.realAtom :=
  OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
    (input.carrierOccurrence_generatedProvenance occurrence) notDuplicate

/-- At a real carrier occurrence the visible Rule-1b distance is the sibling address length. -/
theorem rule1bRootDistance_eq_address_length_of_real
    (input : CertifiedLocalizedCIPInput) {fuel : Nat}
    (occurrence : input.LocalizedCIPOccurrence fuel)
    (real : occurrence.1.node.provenance = OfficialCIPNodeProvenance.realAtom) :
    occurrence.1.node.rule1bRootDistance = occurrence.1.address.length := by
  simpa [OfficialCIPNode.rule1bRootDistance, real] using
    input.realCarrierOccurrence_depth_eq_address_length occurrence

/-- **Three-way role recovery for the emitted children of a real reroot cursor.**

Every intended child frame of a real cursor is exactly one of:

1. an outward real child: real provenance and visible distance one more than the cursor's;
2. an outward multiple-bond duplicate: a `multipleBondDuplicate` whose visible distance equals
   the cursor's and which is a duplicate leaf;
3. the actual reverse carrier parent: real provenance and visible distance one less than the
   cursor's.

The ring-duplicate possibility is excluded by acyclicity through the real-spine simple path.
This classification is the role bridge: it reads the provenance of the child from the visible
distance comparison, not from an assumed desired role. -/
theorem child_role_recovery_of_real_cursor
    (input : CertifiedLocalizedCIPInput) {carrierFuel : Nat}
    (acyclic : input.moleculeGraph.Acyclic)
    (cursor : input.LocalizedRerootCursor carrierFuel)
    (cursorReal : cursor.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (frame : input.LocalizedCIPOccurrenceFrame)
    (framePresent : frame ∈ input.intendedLocalizedRerootChildFrames cursor) :
    (frame.node.provenance = OfficialCIPNodeProvenance.realAtom ∧
        frame.node.rule1bRootDistance =
          cursor.occurrence.1.node.rule1bRootDistance + 1 ∧
        frame.node.isDuplicateLeaf = false) ∨
      (∃ distance, frame.node.provenance =
          OfficialCIPNodeProvenance.multipleBondDuplicate distance ∧
        frame.node.rule1bRootDistance =
          cursor.occurrence.1.node.rule1bRootDistance ∧
        frame.node.isDuplicateLeaf = true) ∨
      (frame.node.provenance = OfficialCIPNodeProvenance.realAtom ∧
        frame.node.rule1bRootDistance + 1 =
          cursor.occurrence.1.node.rule1bRootDistance ∧
        frame.node.isDuplicateLeaf = false) := by
  have cursorNotDup : cursor.occurrence.1.node.isDuplicateLeaf = false :=
    input.isDuplicateLeaf_eq_false_of_provenance_real _ cursorReal
  have cursorDistance : cursor.occurrence.1.node.rule1bRootDistance =
      cursor.occurrence.1.address.length :=
    input.rule1bRootDistance_eq_address_length_of_real cursor.occurrence cursorReal
  have neighborPresent :
      frame ∈ input.localizedRerootNeighborFrames (fuel := carrierFuel)
        cursor.occurrence.1 := by
    unfold intendedLocalizedRerootChildFrames at framePresent
    rw [if_neg (by simpa using cursorNotDup)] at framePresent
    cases previousEq : cursor.previous? with
    | none => simpa only [previousEq] using framePresent
    | some previous =>
        exact List.mem_of_mem_filter (by
          simpa only [previousEq] using framePresent)
  rw [localizedRerootNeighborFrames, List.mem_append] at neighborPresent
  rcases neighborPresent with parentMem | outwardMem
  · -- The actual reverse carrier parent.
    rw [localizedCarrierParentFrames, List.mem_filter] at parentMem
    obtain ⟨frameCarrier, conditions⟩ := parentMem
    simp only [Bool.and_eq_true, beq_iff_eq] at conditions
    obtain ⟨⟨frameRoot, frameLength⟩, frameDrop⟩ := conditions
    have cursorNonroot : cursor.occurrence.1.address ≠ [] := by
      intro empty
      rw [empty] at frameLength
      simp at frameLength
    obtain ⟨parent, parentPresent, parentRoot, parentAddress, _parentRemaining,
      parentActive, ⟨_next, _copyIndex, _cursorExtend⟩, _parentCurrent⟩ :=
      input.exists_parentFrame_of_mem_localizedOccurrences
        (fuel := carrierFuel) cursor.occurrence.2 cursorNonroot
    have frameDerived : input.DeclarativeLocalizedOccurrence carrierFuel frame :=
      (input.mem_localizedOccurrences_iff carrierFuel frame).mp frameCarrier
    have parentDerived : input.DeclarativeLocalizedOccurrence carrierFuel parent :=
      (input.mem_localizedOccurrences_iff carrierFuel parent).mp parentPresent
    have sameRoot : frame.root = parent.root := by
      rw [frameRoot, parentRoot]
    have sameAddress : frame.address = parent.address := by
      rw [frameDrop, parentAddress]
    have frameEqParent : frame = parent :=
      input.declarativeLocalizedOccurrence_functional_at_root_address
        frameDerived parentDerived sameRoot sameAddress
    have frameReal : frame.node.provenance =
        OfficialCIPNodeProvenance.realAtom := by
      rw [frameEqParent]
      exact parentActive.1
    have frameDistance : frame.node.rule1bRootDistance =
        frame.address.length :=
      input.rule1bRootDistance_eq_address_length_of_real
        ⟨frame, frameCarrier⟩ frameReal
    refine Or.inr (Or.inr ⟨frameReal, ?_, ?_⟩)
    · omega
    · exact input.isDuplicateLeaf_eq_false_of_provenance_real _ frameReal
  · -- An outward child.
    rw [localizedCarrierOutwardChildFrames, List.mem_filter] at outwardMem
    obtain ⟨frameCarrier, conditions⟩ := outwardMem
    simp only [Bool.and_eq_true, beq_iff_eq] at conditions
    obtain ⟨⟨frameRoot, frameLength⟩, frameDrop⟩ := conditions
    have frameNonempty : frame.address ≠ [] := by
      intro empty
      rw [empty] at frameLength
      simp at frameLength
    have cursorDerived :
        input.DeclarativeLocalizedOccurrence carrierFuel cursor.occurrence.1 :=
      (input.mem_localizedOccurrences_iff carrierFuel cursor.occurrence.1).mp
        cursor.occurrence.2
    have frameDerived : input.DeclarativeLocalizedOccurrence carrierFuel frame :=
      (input.mem_localizedOccurrences_iff carrierFuel frame).mp frameCarrier
    have frameAddress : frame.address =
        cursor.occurrence.1.address ++ [frame.address.getLast frameNonempty] := by
      calc frame.address
          = frame.address.dropLast ++ [frame.address.getLast frameNonempty] :=
              (List.dropLast_concat_getLast frameNonempty).symm
        _ = cursor.occurrence.1.address ++ [frame.address.getLast frameNonempty] := by
              rw [frameDrop]
    obtain ⟨child, childAtSlot, childFrameEq⟩ :=
      input.declarativeLocalizedOccurrence_immediate_child cursorDerived frameDerived
        frameRoot (frame.address.getLast frameNonempty) frameAddress
    have childPresent :
        child ∈ input.executableOfficialCIPChildren cursor.occurrence.1.node :=
      List.fst_mem_of_mem_zipIdx childAtSlot
    have frameNode : frame.node = child := by
      simpa using congrArg
        (fun frame : input.LocalizedCIPOccurrenceFrame => frame.node) childFrameEq
    obtain ⟨next, copyIndex, childExtend⟩ :=
      input.mem_executableOfficialCIPChildren_extend cursor.occurrence.1.node child
        childPresent
    have realPath :
        input.RealPathNode cursor.occurrence.1.root cursor.occurrence.1.node :=
      input.carrierOccurrence_realPath_of_provenance_real cursor.occurrence cursorReal
    have realPathData := realPath
    obtain ⟨current, _path, cursorCurrent, _cursorHead, _cursorProvenance, _pathIsPath,
      _supportReverse, _penultimateEq⟩ := realPathData
    have childCurrent : child.current? = some next := by
      rw [childExtend]
      rfl
    have adjacent : input.moleculeGraph.Adj current next :=
      input.adj_of_mem_executableOfficialCIPChildren cursor.occurrence.1.node child
        current next cursorCurrent childCurrent childPresent
    by_cases zero : copyIndex = 0
    · subst copyIndex
      by_cases visited : next ∈ cursor.occurrence.1.node.history
      · exfalso
        have ringProvenance : child.provenance =
            OfficialCIPNodeProvenance.ringDuplicate
              (cursor.occurrence.1.node.duplicateRootDistance next) := by
          rw [childExtend, OfficialCIPNode.extend_provenance]
          exact OfficialCIPNode.childProvenance_ring_duplicate _ _ visited
        obtain ⟨next', childZero, notParent⟩ :=
          input.eq_extend_zero_and_not_parent_of_mem_executableOfficialCIPChildren
            cursor.occurrence.1.node child childPresent (Or.inr ⟨_, ringProvenance⟩)
        have observed' : child.current? = some next' := by
          rw [childZero]
          rfl
        have nextEq : next' = next :=
          Option.some.inj (observed'.symm.trans childCurrent)
        have notParentNext : cursor.occurrence.1.node.parent? ≠ some next := by
          rw [← nextEq]
          exact notParent
        exact absurd visited
          (input.not_mem_history_of_real_zero_step acyclic realPath cursorCurrent
            adjacent notParentNext)
      · -- Outward real zero-copy child.
        have realProvenance : child.provenance =
            OfficialCIPNodeProvenance.realAtom := by
          rw [childExtend, OfficialCIPNode.extend_provenance]
          exact OfficialCIPNode.childProvenance_real _ _ visited
        have frameReal : frame.node.provenance =
            OfficialCIPNodeProvenance.realAtom := by
          rw [frameNode]
          exact realProvenance
        have frameDistance : frame.node.rule1bRootDistance =
            frame.address.length :=
          input.rule1bRootDistance_eq_address_length_of_real
            ⟨frame, frameCarrier⟩ frameReal
        refine Or.inl ⟨frameReal, ?_, ?_⟩
        · omega
        · exact input.isDuplicateLeaf_eq_false_of_provenance_real _ frameReal
    · -- Outward positive-copy multiple-bond duplicate.
      have duplicateProvenance : child.provenance =
          OfficialCIPNodeProvenance.multipleBondDuplicate
            cursor.occurrence.1.node.depth := by
        rw [childExtend, OfficialCIPNode.extend_provenance]
        exact OfficialCIPNode.childProvenance_copy_pos _ _ zero
      have frameProvenance : frame.node.provenance =
          OfficialCIPNodeProvenance.multipleBondDuplicate
            cursor.occurrence.1.node.depth := by
        rw [frameNode]
        exact duplicateProvenance
      have cursorDepth : cursor.occurrence.1.node.rule1bRootDistance =
          cursor.occurrence.1.node.depth := by
        simp [OfficialCIPNode.rule1bRootDistance, cursorReal]
      have frameDistance : frame.node.rule1bRootDistance =
          cursor.occurrence.1.node.rule1bRootDistance := by
        simp [OfficialCIPNode.rule1bRootDistance, frameProvenance, cursorReal]
      refine Or.inr (Or.inl ⟨cursor.occurrence.1.node.depth, frameProvenance,
        frameDistance, ?_⟩)
      simp [OfficialCIPNode.isDuplicateLeaf, frameProvenance]

/-- **Visible Bool form of the role bridge.**  At a real reroot cursor, the child's actual
`isDuplicateLeaf` bit is exactly the comparison of its visible Rule-1b distance with the cursor's
visible distance. -/
theorem child_isDuplicateLeaf_classification_of_real_cursor
    (input : CertifiedLocalizedCIPInput) {carrierFuel : Nat}
    (acyclic : input.moleculeGraph.Acyclic)
    (cursor : input.LocalizedRerootCursor carrierFuel)
    (cursorReal : cursor.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (frame : input.LocalizedCIPOccurrenceFrame)
    (framePresent : frame ∈ input.intendedLocalizedRerootChildFrames cursor) :
    frame.node.isDuplicateLeaf =
      (frame.node.rule1bRootDistance ==
        cursor.occurrence.1.node.rule1bRootDistance) := by
  rcases input.child_role_recovery_of_real_cursor acyclic cursor cursorReal frame
    framePresent with
    ⟨_real, distance, notDuplicate⟩ |
      ⟨_distance, provenance, distance, duplicate⟩ |
      ⟨_real, distance, notDuplicate⟩
  · have hbeq : (frame.node.rule1bRootDistance ==
        cursor.occurrence.1.node.rule1bRootDistance) = false :=
      beq_eq_false_iff_ne.mpr (by omega)
    rw [notDuplicate, hbeq]
  · have hbeq : (frame.node.rule1bRootDistance ==
        cursor.occurrence.1.node.rule1bRootDistance) = true := by
      rw [distance]
      exact beq_self_eq_true _
    rw [duplicate, hbeq]
  · have hbeq : (frame.node.rule1bRootDistance ==
        cursor.occurrence.1.node.rule1bRootDistance) = false :=
      beq_eq_false_iff_ne.mpr (by omega)
    rw [notDuplicate, hbeq]

/-! ## Equal shape determines the actual role mask -/

/-- **Node-level shape/role bridge.**  For a realized tree whose source cursor carries generated
provenance, and whose root `isDuplicateLeaf` bit agrees with the visible comparison against an
external parent distance, the actual preorder `isDuplicateLeaf` mask equals the shape-computed
mask.  Every child role is recovered by the local classification above; duplicate nodes are
terminal, so their empty child lists need no further classification. -/
theorem actualDuplicateRoleMask_eq_duplicateRoleMaskWithParent
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (tree : LocalizedCumulativeDecoratedTree input carrierFuel)
    (realizes : LocalizedCumulativeTreeRealizes input read tree)
    (parentDistance : Nat)
    (generated : OfficialGeneratedProvenance tree.source.occurrence.1.node.provenance)
    (interface : tree.source.occurrence.1.node.isDuplicateLeaf =
      (tree.source.occurrence.1.node.rule1bRootDistance == parentDistance)) :
    actualDuplicateRoleMask tree =
      duplicateRoleMaskWithParent parentDistance (shape tree) := by
  have main : ∀ bound : Nat,
      ∀ tree : LocalizedCumulativeDecoratedTree input carrierFuel,
        height tree ≤ bound →
        LocalizedCumulativeTreeRealizes input read tree →
        ∀ parentDistance : Nat,
          OfficialGeneratedProvenance tree.source.occurrence.1.node.provenance →
          tree.source.occurrence.1.node.isDuplicateLeaf =
            (tree.source.occurrence.1.node.rule1bRootDistance == parentDistance) →
          actualDuplicateRoleMask tree =
            duplicateRoleMaskWithParent parentDistance (shape tree) := by
    intro bound
    refine Nat.strong_induction_on bound ?_
    intro k ih tree treeBound realizes parentDistance generated interface
    cases realizes with
    | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize =>
        have declarativeChildren :=
          input.localizedRerootChildren?_sound cursor children childrenComputed
        simp only [localizedRootTree] at interface generated ⊢
        rw [actualDuplicateRoleMask, table_shape_mk, duplicateRoleMaskWithParent]
        rw [interface]
        refine congrArg
          (List.cons (cursor.occurrence.1.node.rule1bRootDistance == parentDistance)) ?_
        by_cases duplicate : cursor.occurrence.1.node.isDuplicateLeaf = true
        · -- Duplicate nodes are terminal: the intended and sorted child lists are empty.
          have intendedNil : input.intendedLocalizedRerootChildFrames cursor = [] := by
            unfold intendedLocalizedRerootChildFrames
            rw [if_pos duplicate]
          have childrenNil : children = [] := by
            have mapNil : children.map (fun child => child.occurrence.1) = [] := by
              rw [declarativeChildren.1, intendedNil]
            exact List.map_eq_nil_iff.mp mapNil
          have sortedNil : sortedChildren = [] := by
            have mapNil : sortedChildren.map (fun child => child.source) = [] := by
              have permNil :
                  (sortedChildren.map (fun child => child.source)).Perm children :=
                sourcePerm
              rw [childrenNil] at permNil
              exact permNil.eq_nil
            exact List.map_eq_nil_iff.mp mapNil
          rw [sortedNil, shapeList, actualDuplicateRoleMaskList,
            duplicateRoleMaskListWithParent]
        · have cursorNotDup : cursor.occurrence.1.node.isDuplicateLeaf = false :=
            Bool.eq_false_iff.mpr duplicate
          have cursorReal : cursor.occurrence.1.node.provenance =
              OfficialCIPNodeProvenance.realAtom :=
            OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
              generated cursorNotDup
          have childIntended : ∀ child ∈ sortedChildren,
              child.source.occurrence.1 ∈
                input.intendedLocalizedRerootChildFrames cursor := by
            intro child childPresent
            have memMap :
                child.source ∈ sortedChildren.map (fun tree => tree.source) :=
              List.mem_map.mpr ⟨child, childPresent, rfl⟩
            have memChildren : child.source ∈ children :=
              sourcePerm.mem_iff.mp memMap
            have mapped : child.source.occurrence.1 ∈
                children.map (fun child => child.occurrence.1) :=
              List.mem_map.mpr ⟨child.source, memChildren, rfl⟩
            rwa [declarativeChildren.1] at mapped
          have childFacts : ∀ child ∈ sortedChildren,
              OfficialGeneratedProvenance child.source.occurrence.1.node.provenance ∧
              (child.source.occurrence.1.node.isDuplicateLeaf =
                (child.source.occurrence.1.node.rule1bRootDistance ==
                  cursor.occurrence.1.node.rule1bRootDistance)) := by
            intro child childPresent
            rcases input.child_role_recovery_of_real_cursor acyclic cursor cursorReal
              child.source.occurrence.1 (childIntended child childPresent) with
              ⟨real, distance, notDuplicate⟩ |
                ⟨d, provenance, distance, duplicateChild⟩ |
                ⟨real, distance, notDuplicate⟩
            · exact ⟨by
                  rw [real]
                  exact OfficialGeneratedProvenance.realAtom, by
                  have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                      cursor.occurrence.1.node.rule1bRootDistance) = false :=
                    beq_eq_false_iff_ne.mpr (by omega)
                  rw [notDuplicate, hbeq]⟩
            · exact ⟨by
                  rw [provenance]
                  exact OfficialGeneratedProvenance.multipleBondDuplicate d, by
                  have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                      cursor.occurrence.1.node.rule1bRootDistance) = true := by
                    rw [distance]
                    exact beq_self_eq_true _
                  rw [duplicateChild, hbeq]⟩
            · exact ⟨by
                  rw [real]
                  exact OfficialGeneratedProvenance.realAtom, by
                  have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                      cursor.occurrence.1.node.rule1bRootDistance) = false :=
                    beq_eq_false_iff_ne.mpr (by omega)
                  rw [notDuplicate, hbeq]⟩
          have childHeight : ∀ child ∈ sortedChildren, height child < k := by
            intro child childPresent
            have smaller := height_lt_height_of_mem
              (localizedRootTree input cursor (read cursor) sortedChildren) childPresent
            omega
          have listEq :
              ∀ list : List (LocalizedCumulativeDecoratedTree input carrierFuel),
                (∀ child ∈ list, height child < k) →
                (∀ child ∈ list, LocalizedCumulativeTreeRealizes input read child) →
                (∀ child ∈ list, child.source.occurrence.1 ∈
                  input.intendedLocalizedRerootChildFrames cursor) →
                (∀ child ∈ list,
                  OfficialGeneratedProvenance child.source.occurrence.1.node.provenance ∧
                  (child.source.occurrence.1.node.isDuplicateLeaf =
                    (child.source.occurrence.1.node.rule1bRootDistance ==
                      cursor.occurrence.1.node.rule1bRootDistance))) →
                actualDuplicateRoleMaskList list =
                  duplicateRoleMaskListWithParent
                    cursor.occurrence.1.node.rule1bRootDistance (shapeList list) := by
            intro list
            induction list with
            | nil =>
                intro _ _ _ _
                rw [actualDuplicateRoleMaskList, shapeList,
                  duplicateRoleMaskListWithParent]
            | cons child rest ihList =>
                intro bounds realizesList intendedList facts
                rw [actualDuplicateRoleMaskList, shapeList,
                  duplicateRoleMaskListWithParent]
                rw [ihList (fun tree present => bounds tree (by simp [present]))
                  (fun tree present => realizesList tree (by simp [present]))
                  (fun tree present => intendedList tree (by simp [present]))
                  (fun tree present => facts tree (by simp [present]))]
                have childEq := ih (height child) (bounds child (by simp)) child le_rfl
                  (realizesList child (by simp))
                  cursor.occurrence.1.node.rule1bRootDistance
                  (facts child (by simp)).1 (facts child (by simp)).2
                rw [childEq]
          exact listEq sortedChildren childHeight childrenRealize childIntended childFacts
  exact main (height tree) tree le_rfl realizes parentDistance generated interface

/-- **Root-level bridge.**  A realized tree with a real root provenance has actual role mask
exactly the canonical shape mask. -/
theorem actualDuplicateRoleMask_eq_duplicateRoleMask
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (tree : LocalizedCumulativeDecoratedTree input carrierFuel)
    (realizes : LocalizedCumulativeTreeRealizes input read tree)
    (rootReal : tree.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom) :
    actualDuplicateRoleMask tree = duplicateRoleMask (shape tree) := by
  have storedDistance : tree.rule1bDistance =
      tree.source.occurrence.1.node.rule1bRootDistance := by
    cases realizes with
    | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize =>
        rfl
  have rootNotDup : tree.source.occurrence.1.node.isDuplicateLeaf = false :=
    input.isDuplicateLeaf_eq_false_of_provenance_real _ rootReal
  have interface : tree.source.occurrence.1.node.isDuplicateLeaf =
      (tree.source.occurrence.1.node.rule1bRootDistance ==
        (tree.source.occurrence.1.node.rule1bRootDistance + 1)) := by
    rw [rootNotDup]
    exact (beq_eq_false_iff_ne.mpr (by omega)).symm
  have generated : OfficialGeneratedProvenance
      tree.source.occurrence.1.node.provenance := by
    rw [rootReal]
    exact OfficialGeneratedProvenance.realAtom
  rw [actualDuplicateRoleMask_eq_duplicateRoleMaskWithParent acyclic tree realizes
    (tree.source.occurrence.1.node.rule1bRootDistance + 1)
    generated interface,
    duplicateRoleMask, table_shape_rule1bDistance tree, storedDistance]

/-! ## Preservation from equal shapes and equal comparison-visible tables -/

/-- **Equal erased shape preserves real-versus-multiple-bond positions.**  Two realized trees at
real roots with the same comparison-visible shape have the same actual preorder duplicate-role
mask. -/
theorem actualDuplicateRoleMask_eq_of_shape_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input read right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameShape : shape left = shape right) :
    actualDuplicateRoleMask left = actualDuplicateRoleMask right := by
  rw [actualDuplicateRoleMask_eq_duplicateRoleMask acyclic left leftRealizes leftRootReal,
    actualDuplicateRoleMask_eq_duplicateRoleMask acyclic right rightRealizes rightRootReal,
    sameShape]

/-- **Equal erased shape preserves real-versus-multiple-bond positions for independently read
trees.**  The two realized trees may be produced under different auxiliary-label readers; the
readers never enter the role mask, so only the actual sources and the erased shape matter. -/
theorem actualDuplicateRoleMask_eq_of_shape_eq_independent_readers
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {readRight : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input readRight right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameShape : shape left = shape right) :
    actualDuplicateRoleMask left = actualDuplicateRoleMask right := by
  rw [actualDuplicateRoleMask_eq_duplicateRoleMask acyclic left leftRealizes leftRootReal,
    actualDuplicateRoleMask_eq_duplicateRoleMask acyclic right rightRealizes rightRootReal,
    sameShape]

/-- Positional form: at every preorder slot the two masks agree. -/
theorem actualDuplicateRoleMask_getElem?_eq_of_shape_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input read right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameShape : shape left = shape right) (slot : Nat) :
    (actualDuplicateRoleMask left)[slot]? =
      (actualDuplicateRoleMask right)[slot]? := by
  rw [actualDuplicateRoleMask_eq_of_shape_eq acyclic left right leftRealizes
    rightRealizes leftRootReal rightRootReal sameShape]

/-- **Equal addressed tables preserve real-versus-multiple-bond positions.**  Equality of the
complete comparison-visible table structure at one stage determines the shape, hence the role
mask. -/
theorem actualDuplicateRoleMask_eq_of_tables_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (stage : LocalizedCumulativeRule45Stage)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input read right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameTables : tables stage left = tables stage right) :
    actualDuplicateRoleMask left = actualDuplicateRoleMask right :=
  actualDuplicateRoleMask_eq_of_shape_eq acyclic left right leftRealizes
    rightRealizes leftRootReal rightRootReal
    (table_shape_eq_of_tables_eq stage left right sameTables)

/-- **Column-wise tables preserve real-versus-multiple-bond positions.**  The two trees may be
compared at different Rule-4b/5 stages; equality of the three constitutional columns at those
stages already determines the shape and hence the role mask. -/
theorem actualDuplicateRoleMask_eq_of_columns_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (stageLeft stageRight : LocalizedCumulativeRule45Stage)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input read right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameRule1a : (tables stageLeft left).rule1a = (tables stageRight right).rule1a)
    (sameRule1b : (tables stageLeft left).rule1b = (tables stageRight right).rule1b)
    (sameRule2 : (tables stageLeft left).rule2 = (tables stageRight right).rule2) :
    actualDuplicateRoleMask left = actualDuplicateRoleMask right :=
  actualDuplicateRoleMask_eq_of_shape_eq acyclic left right leftRealizes
    rightRealizes leftRootReal rightRootReal
    (table_shape_eq_of_columns_eq stageLeft stageRight left right
      sameRule1a sameRule1b sameRule2)














/-- The stored Rule-1b column of a realized tree is its source node's visible root distance. -/
theorem tree_rule1bDistance_eq_source
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {tree : LocalizedCumulativeDecoratedTree input carrierFuel}
    (realizes : LocalizedCumulativeTreeRealizes input read tree) :
    tree.rule1bDistance = tree.source.occurrence.1.node.rule1bRootDistance := by
  cases realizes with
  | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize => rfl

/-- Child lookup on an erased shape is the pointwise erased child list. -/
theorem table_shape_children_getElem?
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    (tree : LocalizedCumulativeDecoratedTree input carrierFuel) (slot : Nat) :
    (shape tree).children[slot]? = (tree.children[slot]?).map shape := by
  cases tree with
  | mk source atomicNumber rule1bDistance isotopeMass label children =>
      rw [table_shape_mk, table_shapeList_eq_map]
      simp [List.getElem?_map]

/-- Equal erased shapes give equal visible Rule-1b root distances.  The two realized trees may be
read by independent auxiliary-label readers. -/
theorem visible_rule1bRootDistance_eq_of_shape_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {readRight : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {left right : LocalizedCumulativeDecoratedTree input carrierFuel}
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input readRight right)
    (sameShape : shape left = shape right) :
    left.source.occurrence.1.node.rule1bRootDistance =
      right.source.occurrence.1.node.rule1bRootDistance := by
  have shapeDistance : (shape left).rule1bDistance = (shape right).rule1bDistance :=
    congrArg LocalizedCumulativeBranchShape.rule1bDistance sameShape
  rw [table_shape_rule1bDistance, table_shape_rule1bDistance] at shapeDistance
  rw [← tree_rule1bDistance_eq_source leftRealizes,
    ← tree_rule1bDistance_eq_source rightRealizes]
  exact shapeDistance

/-- A realized child tree is realized and its source is an intended reroot child of the parent. -/
theorem realized_child_realizes_and_intended
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {tree : LocalizedCumulativeDecoratedTree input carrierFuel}
    (realizes : LocalizedCumulativeTreeRealizes input read tree)
    {child : LocalizedCumulativeDecoratedTree input carrierFuel}
    (present : child ∈ tree.children) :
    LocalizedCumulativeTreeRealizes input read child ∧
      child.source.occurrence.1 ∈
        input.intendedLocalizedRerootChildFrames tree.source := by
  cases realizes with
  | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize =>
      have declarativeChildren :=
        input.localizedRerootChildren?_sound cursor children childrenComputed
      simp only [localizedRootTree] at present ⊢
      have memMap : child.source ∈ sortedChildren.map (fun tree => tree.source) :=
        List.mem_map.mpr ⟨child, present, rfl⟩
      have memChildren : child.source ∈ children := sourcePerm.mem_iff.mp memMap
      have mapped : child.source.occurrence.1 ∈
          children.map (fun child => child.occurrence.1) :=
        List.mem_map.mpr ⟨child.source, memChildren, rfl⟩
      exact ⟨childrenRealize child present, by
        rwa [declarativeChildren.1] at mapped⟩

/-- **Child classification at a realized real root.**  Every child of a realized tree with a real
source root has generated provenance, and its actual `isDuplicateLeaf` bit is exactly the visible
comparison of its Rule-1b distance with the parent's. -/
theorem realized_child_isDuplicateLeaf_classification
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    {tree : LocalizedCumulativeDecoratedTree input carrierFuel}
    (realizes : LocalizedCumulativeTreeRealizes input read tree)
    (rootReal : tree.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    {child : LocalizedCumulativeDecoratedTree input carrierFuel}
    (present : child ∈ tree.children) :
    OfficialGeneratedProvenance child.source.occurrence.1.node.provenance ∧
      (child.source.occurrence.1.node.isDuplicateLeaf =
        (child.source.occurrence.1.node.rule1bRootDistance ==
          tree.source.occurrence.1.node.rule1bRootDistance)) := by
  have childIntended :=
    (realized_child_realizes_and_intended realizes present).2
  cases realizes with
  | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize =>
      simp only [localizedRootTree] at childIntended rootReal ⊢
      rcases input.child_role_recovery_of_real_cursor acyclic cursor rootReal
        child.source.occurrence.1 childIntended with
        ⟨real, distance, notDuplicate⟩ |
          ⟨d, provenanceEq, distance, duplicateChild⟩ |
          ⟨real, distance, notDuplicate⟩
      · exact ⟨by
            rw [real]
            exact OfficialGeneratedProvenance.realAtom, by
            have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                cursor.occurrence.1.node.rule1bRootDistance) = false :=
              beq_eq_false_iff_ne.mpr (by omega)
            rw [notDuplicate, hbeq]⟩
      · exact ⟨by
            rw [provenanceEq]
            exact OfficialGeneratedProvenance.multipleBondDuplicate d, by
            have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                cursor.occurrence.1.node.rule1bRootDistance) = true := by
              rw [distance]
              exact beq_self_eq_true _
            rw [duplicateChild, hbeq]⟩
      · exact ⟨by
            rw [real]
            exact OfficialGeneratedProvenance.realAtom, by
            have hbeq : (child.source.occurrence.1.node.rule1bRootDistance ==
                cursor.occurrence.1.node.rule1bRootDistance) = false :=
              beq_eq_false_iff_ne.mpr (by omega)
            rw [notDuplicate, hbeq]⟩

/-- A realized tree whose root is a duplicate leaf has no children. -/
theorem children_eq_nil_of_isDuplicateLeaf_true
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {tree : LocalizedCumulativeDecoratedTree input carrierFuel}
    (realizes : LocalizedCumulativeTreeRealizes input read tree)
    (duplicate : tree.source.occurrence.1.node.isDuplicateLeaf = true) :
    tree.children = [] := by
  cases realizes with
  | mk cursor children sortedChildren childrenComputed sourcePerm childrenRealize =>
      have declarativeChildren :=
        input.localizedRerootChildren?_sound cursor children childrenComputed
      simp only [localizedRootTree] at duplicate ⊢
      have intendedNil : input.intendedLocalizedRerootChildFrames cursor = [] := by
        unfold intendedLocalizedRerootChildFrames
        rw [if_pos duplicate]
      have childrenNil : children = [] := by
        have mapNil : children.map (fun child => child.occurrence.1) = [] := by
          rw [declarativeChildren.1, intendedNil]
        exact List.map_eq_nil_iff.mp mapNil
      have sortedNil : sortedChildren = [] := by
        have mapNil : sortedChildren.map (fun tree => tree.source) = [] := by
          have permNil : (sortedChildren.map (fun tree => tree.source)).Perm children :=
            sourcePerm
          rw [childrenNil] at permNil
          exact permNil.eq_nil
        exact List.map_eq_nil_iff.mp mapNil
      exact sortedNil

/-- **Address induction for same-address provenance recovery.**  Under equal erased shape and
matching root flag interfaces, a successful lookup on both sides at the same address finds real
provenance on one side exactly when it finds real provenance on the other.  The two sides keep
independent auxiliary-label readers (`read` on the left, `readRight` on the right); the induction
hypothesis preserves both readers unchanged. -/
theorem provenance_real_iff_at_address_of_shape_eq_aux
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {readRight : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input readRight right)
    (sameShape : shape left = shape right)
    (parentDistance : Nat)
    (leftFlag : left.source.occurrence.1.node.isDuplicateLeaf =
      (left.source.occurrence.1.node.rule1bRootDistance == parentDistance))
    (rightFlag : right.source.occurrence.1.node.isDuplicateLeaf =
      (right.source.occurrence.1.node.rule1bRootDistance == parentDistance))
    (address : List Nat) :
    ∀ {leftNode rightNode : LocalizedCumulativeDecoratedTree input carrierFuel},
      subtreeAt? left address = some leftNode →
      subtreeAt? right address = some rightNode →
        (leftNode.source.occurrence.1.node.provenance =
            OfficialCIPNodeProvenance.realAtom ↔
          rightNode.source.occurrence.1.node.provenance =
            OfficialCIPNodeProvenance.realAtom) := by
  induction address generalizing left right leftRealizes rightRealizes sameShape
    parentDistance leftFlag rightFlag with
  | nil =>
      intro leftNode rightNode leftAt rightAt
      simp only [subtreeAt?_nil, Option.some.injEq] at leftAt rightAt
      subst leftNode
      subst rightNode
      have visibleDistance :=
        visible_rule1bRootDistance_eq_of_shape_eq leftRealizes rightRealizes sameShape
      have flagEq : left.source.occurrence.1.node.isDuplicateLeaf =
          right.source.occurrence.1.node.isDuplicateLeaf := by
        rw [leftFlag, rightFlag, visibleDistance]
      have leftGenerated :=
        input.carrierOccurrence_generatedProvenance left.source.occurrence
      have rightGenerated :=
        input.carrierOccurrence_generatedProvenance right.source.occurrence
      constructor
      · intro real
        have notDuplicate :=
          input.isDuplicateLeaf_eq_false_of_provenance_real _ real
        have rightNotDuplicate :
            right.source.occurrence.1.node.isDuplicateLeaf = false := by
          rw [← flagEq]
          exact notDuplicate
        exact OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
          rightGenerated rightNotDuplicate
      · intro real
        have notDuplicate :=
          input.isDuplicateLeaf_eq_false_of_provenance_real _ real
        have leftNotDuplicate :
            left.source.occurrence.1.node.isDuplicateLeaf = false := by
          rw [flagEq]
          exact notDuplicate
        exact OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
          leftGenerated leftNotDuplicate
  | cons slot rest inductionHypothesis =>
      intro leftNode rightNode leftAt rightAt
      obtain ⟨leftChild, leftChildAt, leftRestAt⟩ :=
        subtreeAt?_cons_eq_some_iff.mp leftAt
      obtain ⟨rightChild, rightChildAt, rightRestAt⟩ :=
        subtreeAt?_cons_eq_some_iff.mp rightAt
      have slotShapeEq : (shape left).children[slot]? = (shape right).children[slot]? :=
        congrArg (fun erased => erased.children[slot]?) sameShape
      have childShapeEq : shape leftChild = shape rightChild := by
        have transported := slotShapeEq
        rw [table_shape_children_getElem? left slot,
          table_shape_children_getElem? right slot, leftChildAt, rightChildAt] at transported
        exact Option.some.inj (by simpa using transported)
      have parentVisibleDistance :=
        visible_rule1bRootDistance_eq_of_shape_eq leftRealizes rightRealizes sameShape
      have leftRootReal : left.source.occurrence.1.node.provenance =
          OfficialCIPNodeProvenance.realAtom := by
        by_cases duplicate : left.source.occurrence.1.node.isDuplicateLeaf = true
        · have childrenNil :=
            children_eq_nil_of_isDuplicateLeaf_true leftRealizes duplicate
          rw [childrenNil] at leftChildAt
          exact absurd leftChildAt (by simp)
        · have notDuplicate : left.source.occurrence.1.node.isDuplicateLeaf = false :=
            Bool.eq_false_iff.mpr duplicate
          exact OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
            (input.carrierOccurrence_generatedProvenance left.source.occurrence)
            notDuplicate
      have rightRootReal : right.source.occurrence.1.node.provenance =
          OfficialCIPNodeProvenance.realAtom := by
        by_cases duplicate : right.source.occurrence.1.node.isDuplicateLeaf = true
        · have childrenNil :=
            children_eq_nil_of_isDuplicateLeaf_true rightRealizes duplicate
          rw [childrenNil] at rightChildAt
          exact absurd rightChildAt (by simp)
        · have notDuplicate : right.source.occurrence.1.node.isDuplicateLeaf = false :=
            Bool.eq_false_iff.mpr duplicate
          exact OfficialGeneratedProvenance.real_of_isDuplicateLeaf_eq_false
            (input.carrierOccurrence_generatedProvenance right.source.occurrence)
            notDuplicate
      have leftChildFacts :=
        realized_child_isDuplicateLeaf_classification acyclic leftRealizes leftRootReal
          (List.mem_of_getElem? leftChildAt)
      have rightChildFacts :=
        realized_child_isDuplicateLeaf_classification acyclic rightRealizes rightRootReal
          (List.mem_of_getElem? rightChildAt)
      have rightChildFlag : rightChild.source.occurrence.1.node.isDuplicateLeaf =
          (rightChild.source.occurrence.1.node.rule1bRootDistance ==
            left.source.occurrence.1.node.rule1bRootDistance) := by
        rw [rightChildFacts.2, ← parentVisibleDistance]
      exact inductionHypothesis leftChild rightChild
        (realized_child_realizes_and_intended leftRealizes
          (List.mem_of_getElem? leftChildAt)).1
        (realized_child_realizes_and_intended rightRealizes
          (List.mem_of_getElem? rightChildAt)).1
        childShapeEq
        left.source.occurrence.1.node.rule1bRootDistance
        leftChildFacts.2 rightChildFlag
        leftRestAt rightRestAt

/-- **Same-address real-versus-multiple-bond role preservation.**  Two actually realized trees
with equal comparison-visible shape and real source roots have real provenance at the same
successful address on one side exactly when they have it on the other.  Thus a position that is a
real atom versus a multiple-bond duplicate is preserved by equality of the shared shape; the two
trees need not have equal sources, an assumed child alignment, or even the same auxiliary-label
reader. -/
theorem provenance_real_iff_at_same_address_of_shape_eq
    {input : CertifiedLocalizedCIPInput} {carrierFuel : Nat}
    {read : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    {readRight : input.LocalizedRerootCursor carrierFuel → Option LocalizedAuxiliaryLabel}
    (acyclic : input.moleculeGraph.Acyclic)
    (left right : LocalizedCumulativeDecoratedTree input carrierFuel)
    (leftRealizes : LocalizedCumulativeTreeRealizes input read left)
    (rightRealizes : LocalizedCumulativeTreeRealizes input readRight right)
    (leftRootReal : left.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (rightRootReal : right.source.occurrence.1.node.provenance =
      OfficialCIPNodeProvenance.realAtom)
    (sameShape : shape left = shape right)
    {address : List Nat}
    {leftNode rightNode : LocalizedCumulativeDecoratedTree input carrierFuel}
    (leftAt : subtreeAt? left address = some leftNode)
    (rightAt : subtreeAt? right address = some rightNode) :
    (leftNode.source.occurrence.1.node.provenance =
        OfficialCIPNodeProvenance.realAtom ↔
      rightNode.source.occurrence.1.node.provenance =
        OfficialCIPNodeProvenance.realAtom) := by
  have visibleDistance :=
    visible_rule1bRootDistance_eq_of_shape_eq leftRealizes rightRealizes sameShape
  have leftFlag : left.source.occurrence.1.node.isDuplicateLeaf =
      (left.source.occurrence.1.node.rule1bRootDistance ==
        (left.source.occurrence.1.node.rule1bRootDistance + 1)) := by
    rw [input.isDuplicateLeaf_eq_false_of_provenance_real _ leftRootReal]
    exact (beq_eq_false_iff_ne.mpr (by omega)).symm
  have rightFlag : right.source.occurrence.1.node.isDuplicateLeaf =
      (right.source.occurrence.1.node.rule1bRootDistance ==
        (left.source.occurrence.1.node.rule1bRootDistance + 1)) := by
    rw [input.isDuplicateLeaf_eq_false_of_provenance_real _ rightRootReal,
      visibleDistance]
    exact (beq_eq_false_iff_ne.mpr (by omega)).symm
  exact provenance_real_iff_at_address_of_shape_eq_aux acyclic left right leftRealizes
    rightRealizes sameShape (left.source.occurrence.1.node.rule1bRootDistance + 1)
    leftFlag rightFlag address leftAt rightAt

end CertifiedLocalizedCIPInput

