import TetraStereo.OneCenter.IUPACPrimitive35GlobalProductionAdapter
import TetraStereo.OneCenter.IUPACNext54ReviewedNonvacuity
import TetraStereo.OneCenter.IUPACP93CanonicalAll56Nonvacuity
import TetraStereo.OneCenter.IUPACProvisionBulkClosure

set_option autoImplicit false

/-!
# Fixed production refinement over a parameterized reviewed program

The positive interpreter is a definitionally fixed join of the three named implementations;
callers cannot supply an interpreter or substitute a reviewed relation as production.
Production/reference correctness is proved for all 152 descriptor-bearing rows.  Primitive-35,
the complete 46-row next-54 family, and the complete 12-row P-94 schema family are
theorem-generated; the complete 56-row P-93 witness family is now compiled from one finite,
proof-carrying source program.

Once that reviewed nonvacuity boundary is available, the generic compiler assembly
adds all 2,300 negative rows and yields one compiler-wide production/reference theorem.  This
module now instantiates that boundary with the frozen finite P-93 source program covering all 56
clauses.  The independent non-descriptor source program remains an explicit parameter, and the
fixed P-94 schema still needs its release-level frozen-package coherence seal, so this is not yet
the root issuer.
-/

namespace TetraStereo.OneCenter
namespace IUPACNormativeProvision

noncomputable section

noncomputable abbrev parameterizedGlobalReviewedSemantics
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) :
    GlobalReviewedSemantics policies negative :=
  assembleGlobalReviewedSemantics policies negative

/-- The full descriptor-bearing policy bundle compiled from the frozen canonical P-93 program
and the fixed P-94 schema. -/
noncomputable abbrev IUPACP93CanonicalDescriptorBearingPolicies :
    DescriptorBearingReviewedPolicies :=
  P93CanonicalSourceProgram.iupacP93CanonicalSourceProgram.compiledPolicies
    |>.toDescriptorBearingWithP94Schema

/-- Every primitive row, including the complete Rules-4b/5 dependent family, has a canonical
reviewed witness.  No primitive-family witness is supplied by a caller. -/
theorem parameterizedGlobalReviewedSemantics_primitive35_nonvacuous
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (row : Primitive35AuthorityRow) :
    ∃ input, ∃ observation :
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Observation,
      (parameterizedGlobalReviewedSemantics policies negative).reviewed.ChemicallyAdmitted
          input ∧
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Applicable input ∧
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Judges input observation := by
  rw [globalReviewedSemantics_primitive35_exact
    (parameterizedGlobalReviewedSemantics policies negative) row]
  simpa [parameterizedGlobalReviewedSemantics, assembleGlobalReviewedSemantics,
    assembledGlobalReviewedTable] using row.reference_nonvacuous

abbrev ParameterizedNext54ReviewedNonvacuity
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) : Prop :=
  ∀ row : Next54DescriptorBearingReviewedRow,
    ∃ input, ∃ observation :
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Observation,
      (parameterizedGlobalReviewedSemantics policies negative).reviewed.ChemicallyAdmitted
          input ∧
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Applicable input ∧
        ((parameterizedGlobalReviewedSemantics policies negative).reviewed.row
          row.provision).reference.Judges input observation

/-- The complete 46-row next-54 witness family is theorem-generated from its fixed four-family
partition; callers cannot supply or alter any next-54 witness. -/
theorem parameterizedGlobalReviewedSemantics_next54_nonvacuous
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) :
    ParameterizedNext54ReviewedNonvacuity policies negative :=
  assembledGlobalReviewedSemantics_next54_nonvacuous policies negative

/-- The reviewed global nonvacuity program now has one exact 68-row source-program boundary.
Primitive-35, all 46 next-54 rows, and all three authority-data rows are generated by
mathematical family/table theorems. -/
noncomputable def parameterizedGlobalReviewedNonvacuity_of_remaining68
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (remaining68 : ParameterizedRemaining68ReviewedNonvacuity policies negative) :
    DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative) :=
  DescriptorBearingReviewedNonvacuityFamilies.toReviewedNonvacuity
    { primitive35 := parameterizedGlobalReviewedSemantics_primitive35_nonvacuous
        policies negative
      next54 := parameterizedGlobalReviewedSemantics_next54_nonvacuous policies negative
      remaining71 :=
        assembledGlobalReviewedSemantics_remaining71_nonvacuous_of_remaining68
          policies negative remaining68 }

/-- Strongest positive assembly theorem: P-94 is fixed to its proof-carrying source-package
schema and all twelve P-94 witnesses are generated by one family theorem.  Only the exact 56-row
P-93 source-program boundary remains. -/
noncomputable def parameterizedGlobalReviewedNonvacuity_of_remaining56P93
    (policies : Remaining56P93ReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (remaining56 : ParameterizedRemaining56P93ReviewedNonvacuity policies negative) :
    DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics
        policies.toDescriptorBearingWithP94Schema negative) :=
  parameterizedGlobalReviewedNonvacuity_of_remaining68
    policies.toDescriptorBearingWithP94Schema negative
    (assembledGlobalReviewedSemantics_remaining68_nonvacuous_of_remaining56P93
      policies negative remaining56)

/-- The complete 152-row descriptor-bearing reviewed witness family, instantiated from the
frozen canonical P-93 source program.  Only the independent non-descriptor source semantics
remains as a parameter. -/
noncomputable def iupacP93CanonicalGlobalReviewedNonvacuity
    (negative : GlobalNonDescriptorReviewedSemantics) :
    DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics
        IUPACP93CanonicalDescriptorBearingPolicies negative) :=
  parameterizedGlobalReviewedNonvacuity_of_remaining56P93
    P93CanonicalSourceProgram.iupacP93CanonicalSourceProgram.compiledPolicies negative
    (P93CanonicalSourceProgram.iupacP93CanonicalRemaining56ReviewedNonvacuity negative)

noncomputable abbrev ParameterizedGlobalProductionCorpus
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) : FrozenProvisionCorpus :=
  (globalDescriptorAssignmentProjection
    (parameterizedGlobalReviewedSemantics policies negative).toFrozenCorpus).toCorpus

/-- The only positive interpreter used by the global refinement theorem. -/
noncomputable def fixedGlobalPositiveInterpreter
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) :
    ProvisionInterpreter (ParameterizedGlobalProductionCorpus policies negative) where
  Produces := fun provision input observation =>
    if provision ∈ primitive35Provisions then
      (primitive35GlobalInterpreter
        (parameterizedGlobalReviewedSemantics policies negative)).Produces
          provision input observation
    else if provision ∈ next54DescriptorBearingProvisions then
      (next54GlobalProductionInterpreter policies negative).Produces
        provision input observation
    else if provision ∈ remaining71DescriptorBearingProvisions then
      (remaining71GlobalKernelDispatchInterpreter
        (parameterizedGlobalReviewedSemantics policies negative)).Produces
          provision input observation
    else False

/-! Exact current observation-refinement frontier.  Mathematical family theorems discharge
production/reference correctness for every P-92, P-93, P-94, and authority-data row.  All 96
positive witnesses outside P-93 are closed, and the complete P-93 witness family is compiled from
one frozen proof-carrying finite source program.  What remains is not another P-93 production
theorem: it is the P-94 package seal and the independent non-descriptor source program. -/
private theorem next54DescriptorBearing_mem_next54
    {provision : IUPACNormativeProvision}
    (member : provision ∈ next54DescriptorBearingProvisions) :
    provision ∈ next54Provisions :=
  Next54DescriptorBearingReviewedRow.member_next54Provisions ⟨provision, member⟩

private theorem primitive35_not_next54DescriptorBearing
    {provision : IUPACNormativeProvision}
    (primitive : provision ∈ primitive35Provisions) :
    provision ∉ next54DescriptorBearingProvisions := by
  intro next54
  exact (List.disjoint_left.mp next54Provisions_disjoint_primitive35)
    (next54DescriptorBearing_mem_next54 next54) primitive

private theorem next54DescriptorBearing_not_primitive35
    {provision : IUPACNormativeProvision}
    (next54 : provision ∈ next54DescriptorBearingProvisions) :
    provision ∉ primitive35Provisions := by
  intro primitive
  exact primitive35_not_next54DescriptorBearing primitive next54

private theorem remaining71_not_primitive35
    {provision : IUPACNormativeProvision}
    (remaining : provision ∈ remaining71DescriptorBearingProvisions) :
    provision ∉ primitive35Provisions := by
  intro primitive
  exact remaining71_not_reviewed81 remaining
    (by simp [reviewed81DescriptorBearingProvisions, primitive])

private theorem remaining71_not_next54DescriptorBearing
    {provision : IUPACNormativeProvision}
    (remaining : provision ∈ remaining71DescriptorBearingProvisions) :
    provision ∉ next54DescriptorBearingProvisions := by
  intro next54
  exact remaining71_not_reviewed81 remaining
    (by simp [reviewed81DescriptorBearingProvisions, next54])

private theorem fixedGlobalPositiveInterpreter_primitive35_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (row : Primitive35AuthorityRow) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (fixedGlobalPositiveInterpreter policies negative) row.provision := by
  intro input admitted observation
  simpa [fixedGlobalPositiveInterpreter, row.provision_mem_primitive35] using
    primitive35GlobalProduction_correct
      (parameterizedGlobalReviewedSemantics policies negative) row input admitted observation

/-- The fixed global positive program closes the whole canonical Rules-4b/5 family through one
dependent projection.  This is the public integration boundary used by downstream release
contracts; its proof contains no per-provision branch. -/
theorem fixedGlobalPositiveInterpreter_rule45Family_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (family : Rule45CanonicalProvisionFamily) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (fixedGlobalPositiveInterpreter policies negative) family.provision := by
  simpa using fixedGlobalPositiveInterpreter_primitive35_correct
    policies negative (.p92Rule45 family)

private theorem fixedNext54ProductionInterpreter_row_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (row : Next54ProductionFamilyRow) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (next54GlobalProductionInterpreter policies negative) row.provision := by
  cases row with
  | p92Foundational child =>
      exact next54GlobalJoinedP92Foundational_correct policies negative child
  | p92DigraphRule1a child =>
      exact next54GlobalProduction_correct_of_ready policies negative _
        (.digraphRule1a child)
  | p93Residual child =>
      exact next54GlobalProduction_correct_of_ready policies negative _ (.p93Residual child)
  | ir9Residual child =>
      exact next54GlobalProduction_correct_of_ready policies negative _ (.ir9Residual child)

private theorem fixedNext54ProductionInterpreter_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (provision : IUPACNormativeProvision)
    (member : provision ∈ next54DescriptorBearingProvisions) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (next54GlobalProductionInterpreter policies negative) provision := by
  let row := Next54ProductionFamilyRow.familyRowOf ⟨provision, member⟩
  have rowProvision : row.provision = provision :=
    Next54ProductionFamilyRow.familyRowOf_provision ⟨provision, member⟩
  rw [← rowProvision]
  exact fixedNext54ProductionInterpreter_row_correct policies negative row

private theorem fixedGlobalPositiveInterpreter_next54_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    {provision : IUPACNormativeProvision}
    (member : provision ∈ next54DescriptorBearingProvisions) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (fixedGlobalPositiveInterpreter policies negative) provision := by
  intro input admitted observation
  simpa [fixedGlobalPositiveInterpreter,
    next54DescriptorBearing_not_primitive35 member, member] using
      fixedNext54ProductionInterpreter_correct
        policies negative provision member input admitted observation

private theorem fixedRemaining71KernelDispatch_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (provision : IUPACNormativeProvision)
    (member : provision ∈ remaining71DescriptorBearingProvisions) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (remaining71GlobalKernelDispatchInterpreter
        (parameterizedGlobalReviewedSemantics policies negative)) provision := by
  have scopeMember : provision ∈ remaining71GlobalKernelDispatchScope := by
    rw [remaining71GlobalKernelDispatchScope_exact]
    exact member
  have split : provision ∈ Remaining71P93DescriptorKernelRow.provisions ∨
      provision ∈ p94ReviewedSemanticsSlice ∨
      provision ∈ authorityDataReviewedSemanticsSlice := by
    simpa [remaining71GlobalKernelDispatchScope, List.mem_append] using scopeMember
  rcases split with p93 | p94 | authority
  · exact remaining71GlobalKernelDispatchInterpreter_p93_closed_correct
      (parameterizedGlobalReviewedSemantics policies negative) provision
      (p93DescriptorProvisions_subset_closedProductionProvisions p93)
  · have p93Absent : provision ∉ Remaining71P93DescriptorKernelRow.provisions := by
      intro p93
      have rightMember : provision ∈
          p94ReviewedSemanticsSlice ++ authorityDataReviewedSemanticsSlice :=
        List.mem_append.mpr (Or.inl p94)
      exact (List.disjoint_left.mp remaining71P93_disjoint_p94Authority)
        p93 rightMember
    exact remaining71GlobalKernelDispatchInterpreter_p94_correct
      (parameterizedGlobalReviewedSemantics policies negative)
      provision p94 p93Absent
  · have p93Absent : provision ∉ Remaining71P93DescriptorKernelRow.provisions := by
      intro p93
      have rightMember : provision ∈
          p94ReviewedSemanticsSlice ++ authorityDataReviewedSemanticsSlice :=
        List.mem_append.mpr (Or.inr authority)
      exact (List.disjoint_left.mp remaining71P93_disjoint_p94Authority)
        p93 rightMember
    have p94Absent : provision ∉ p94ReviewedSemanticsSlice := by
      intro p94
      exact (List.disjoint_left.mp remaining71P94_disjoint_authorityData) p94 authority
    exact remaining71GlobalKernelDispatchInterpreter_authority_correct
      (parameterizedGlobalReviewedSemantics policies negative)
      provision authority p93Absent p94Absent

private theorem fixedGlobalPositiveInterpreter_remaining71_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    {provision : IUPACNormativeProvision}
    (member : provision ∈ remaining71DescriptorBearingProvisions) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (fixedGlobalPositiveInterpreter policies negative) provision := by
  intro input admitted observation
  simpa [fixedGlobalPositiveInterpreter, remaining71_not_primitive35 member,
    remaining71_not_next54DescriptorBearing member, member] using
      fixedRemaining71KernelDispatch_correct
        policies negative provision member input admitted observation

theorem fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (provision : IUPACNormativeProvision)
    (bearing : DescriptorAssignmentBearing provision) :
    ProvisionCorrect (ParameterizedGlobalProductionCorpus policies negative)
      (fixedGlobalPositiveInterpreter policies negative) provision := by
  rcases descriptorBearing_mem_reviewed81_or_remaining71 bearing with reviewed81 | remaining71
  · have firstTwo : provision ∈ primitive35Provisions ∨
        provision ∈ next54DescriptorBearingProvisions := by
      simpa [reviewed81DescriptorBearingProvisions] using reviewed81
    cases firstTwo with
    | inl primitive =>
        let row := primitive35AuthorityRowOf provision primitive
        have rowExact := primitive35AuthorityRowOf_provision provision primitive
        rw [← rowExact]
        exact fixedGlobalPositiveInterpreter_primitive35_correct policies negative row
    | inr next54 =>
        exact fixedGlobalPositiveInterpreter_next54_correct
          policies negative next54
  · exact fixedGlobalPositiveInterpreter_remaining71_correct
      policies negative remaining71

/-- All 152 positive rows are correct for the one fixed positive interpreter. -/
def fixedGlobalDescriptorBearingCompilerCorrect
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative)) :
    ScopedProvisionCompilerCorrect
      (generatedGlobalDescriptorBearingCompiler
        (parameterizedGlobalReviewedSemantics policies negative) witnesses)
      (fixedGlobalPositiveInterpreter policies negative) where
  sequenceRule_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  perception_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  spatialDescriptor_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  depiction_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  nomenclature_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  authorityData_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)
  sourceOnly_correct := by
    intro provision member _kind
    exact fixedGlobalPositiveInterpreter_every_descriptorBearing_correct
      policies negative provision
        (descriptorBearingOfReviewedMember provision member)

/-- Global compiler generated from the supplied reviewed program. -/
noncomputable def fixedGlobalProvisionCompiler
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative)) :
    ProvisionCompiler (ParameterizedGlobalProductionCorpus policies negative) :=
  (generatedGlobalProvisionCompilerPieces
    (parameterizedGlobalReviewedSemantics policies negative)
    (generatedGlobalDescriptorBearingCompiler
      (parameterizedGlobalReviewedSemantics policies negative) witnesses)).toCompiler

/-- One dependent theorem inserts every canonical Rules-4b/5 projection into the total global
compiler.  Its parameters contain only the exact 68-row P-93/P-94 source-program witness family;
no primitive, next-54, or authority-data witness can be hand supplied. -/
theorem fixedGlobalProvisionCompiler_rule45Family_conformant
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (remaining68 : ParameterizedRemaining68ReviewedNonvacuity policies negative)
    (family : Rule45CanonicalProvisionFamily) :
    (((fixedGlobalProvisionCompiler policies negative
      (parameterizedGlobalReviewedNonvacuity_of_remaining68
        policies negative remaining68)).spec family.provision).disposition).IsConformant := by
  have bearing : DescriptorAssignmentBearing family.provision := by
    simpa using Primitive35AuthorityRow.descriptorAssignmentBearing (.p92Rule45 family)
  have member : family.provision ∈ descriptorBearingReviewedSemanticsSlice.toFinset :=
    descriptorBearingReviewedMember family.provision bearing
  unfold fixedGlobalProvisionCompiler
  rw [GlobalProvisionCompilerPieces.toCompiler_descriptorBearing_exact _ _ bearing]
  exact generatedGlobalDescriptorBearingCompiler_conformant
    (parameterizedGlobalReviewedSemantics policies negative)
    (parameterizedGlobalReviewedNonvacuity_of_remaining68
      policies negative remaining68)
    family.provision member

/-- Canonical global interpreter: the fixed positive join plus the generated silent negative
branch. -/
noncomputable def fixedGlobalProvisionInterpreter
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics) :
    ProvisionInterpreter (ParameterizedGlobalProductionCorpus policies negative) :=
  generatedGlobalDescriptorAssignmentInterpreter
    (fixedGlobalPositiveInterpreter policies negative)

/-- The whole 2,452-row compiler is correct once the exact fixed positive frontier is complete.
The 2,300 negative rows are discharged generically by the descriptor-assignment projection. -/
noncomputable def fixedGlobalProvisionCompilerCorrect
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative)) :
    ProvisionCompilerCorrect
      (fixedGlobalProvisionCompiler policies negative witnesses)
      (fixedGlobalProvisionInterpreter policies negative) :=
  (generatedGlobalProvisionCompilerPiecesCorrect
    (parameterizedGlobalReviewedSemantics policies negative)
    (generatedGlobalDescriptorBearingCompiler
      (parameterizedGlobalReviewedSemantics policies negative) witnesses)
    (fixedGlobalPositiveInterpreter policies negative)
    (fixedGlobalDescriptorBearingCompilerCorrect
      policies negative witnesses)).toCompilerCorrect

/-- The generated total compiler is conformant exactly on the exhaustive 152-row positive
partition.  This wrapper exposes the fixed compiler's disposition theorem needed by the eventual
private authority-certificate issuer. -/
theorem fixedGlobalProvisionCompiler_conformant_iff_descriptorBearing
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative))
    (provision : IUPACNormativeProvision) :
    ProvisionDisposition.IsConformant
        ((fixedGlobalProvisionCompiler policies negative witnesses).spec provision).disposition ↔
      DescriptorAssignmentBearing provision := by
  let global := parameterizedGlobalReviewedSemantics policies negative
  let positive := generatedGlobalDescriptorBearingCompiler global witnesses
  exact (generatedGlobalProvisionDispositionPartition global positive
    (generatedGlobalDescriptorBearingCompiler_conformant global witnesses))
      |>.isConformant_iff_descriptorBearing provision

/-- On a non-descriptor row, the fixed compiler chooses `notApplicable` exactly when the
independent source corpus says that the authority supplies the rule. -/
theorem fixedGlobalProvisionCompiler_notApplicable_iff_sourcePresent
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative))
    (provision : IUPACNormativeProvision)
    (nonDescriptor : ¬DescriptorAssignmentBearing provision) :
    ProvisionDisposition.IsNotApplicable
        ((fixedGlobalProvisionCompiler policies negative witnesses).spec provision).disposition ↔
      (parameterizedGlobalReviewedSemantics policies negative).toFrozenCorpus.SourceSuppliesRule
        provision := by
  unfold fixedGlobalProvisionCompiler
  rw [GlobalProvisionCompilerPieces.toCompiler_nonDescriptor_exact _ provision nonDescriptor]
  exact generatedGlobalNonDescriptorCompiler_notApplicable_iff_sourcePresent
    (parameterizedGlobalReviewedSemantics policies negative) provision
      (globalNonDescriptorReviewedMember provision nonDescriptor)

/-- On a non-descriptor row, the complementary fixed disposition is `sourceAbsent` exactly when
the independent source corpus says that the authority supplies no rule. -/
theorem fixedGlobalProvisionCompiler_sourceAbsent_iff_sourceAbsent
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (witnesses : DescriptorBearingReviewedNonvacuity
      (parameterizedGlobalReviewedSemantics policies negative))
    (provision : IUPACNormativeProvision)
    (nonDescriptor : ¬DescriptorAssignmentBearing provision) :
    ProvisionDisposition.IsSourceAbsent
        ((fixedGlobalProvisionCompiler policies negative witnesses).spec provision).disposition ↔
      ¬(parameterizedGlobalReviewedSemantics policies negative).toFrozenCorpus.SourceSuppliesRule
        provision := by
  unfold fixedGlobalProvisionCompiler
  rw [GlobalProvisionCompilerPieces.toCompiler_nonDescriptor_exact _ provision nonDescriptor]
  exact generatedGlobalNonDescriptorCompiler_sourceAbsent_iff_sourceAbsent
    (parameterizedGlobalReviewedSemantics policies negative) provision
      (globalNonDescriptorReviewedMember provision nonDescriptor)

/-- One fixed production program equals the supplied independently structured reference program
on every provision and admitted input.  Primitive, next-54, and authority-data witnesses are
constructed internally; callers supply only the exact 68-row P-93/P-94 source-program family. -/
theorem fixedGlobalPipeline_eq_parameterizedReference
    (policies : DescriptorBearingReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (remaining68 : ParameterizedRemaining68ReviewedNonvacuity policies negative)
    (provision : IUPACNormativeProvision)
    (input : AuthoritativeChemicalInput)
    (admitted : (ParameterizedGlobalProductionCorpus policies negative).ChemicallyAdmitted input) :
    (fixedGlobalProvisionInterpreter policies negative).productionAssignments
        provision input =
      (ParameterizedGlobalProductionCorpus policies negative).referenceAssignments provision input :=
  ProvisionCompilerCorrect.pipeline_eq_reference
    (fixedGlobalProvisionCompilerCorrect policies negative
      (parameterizedGlobalReviewedNonvacuity_of_remaining68
        policies negative remaining68))
    provision input admitted

/-- Fixed-P-94 form of the whole 2,452-row production/reference equation.  Primitive-35,
next-54, authority data, and all twelve P-94 rows are populated internally; callers can supply
only the exact P-93 56-row frontier plus the still-unfrozen non-descriptor source program. -/
theorem fixedGlobalPipeline_eq_p94SchemaReference
    (policies : Remaining56P93ReviewedPolicies)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (remaining56 : ParameterizedRemaining56P93ReviewedNonvacuity policies negative)
    (provision : IUPACNormativeProvision)
    (input : AuthoritativeChemicalInput)
    (admitted :
      (ParameterizedGlobalProductionCorpus
        policies.toDescriptorBearingWithP94Schema negative).ChemicallyAdmitted input) :
    (fixedGlobalProvisionInterpreter
      policies.toDescriptorBearingWithP94Schema negative).productionAssignments
        provision input =
      (ParameterizedGlobalProductionCorpus
        policies.toDescriptorBearingWithP94Schema negative).referenceAssignments provision input :=
  fixedGlobalPipeline_eq_parameterizedReference
    policies.toDescriptorBearingWithP94Schema negative
    (assembledGlobalReviewedSemantics_remaining68_nonvacuous_of_remaining56P93
      policies negative remaining56)
    provision input admitted

/-- Canonical-P-93 form of the whole 2,452-row production/reference equation.  The complete
56-row P-93 witness family is compiled from the proof-carrying finite source program; callers
cannot supply P-93 policies or per-row witnesses.  The non-descriptor source program remains the
separate negative boundary. -/
theorem fixedGlobalPipeline_eq_p93CanonicalProgram
    (program : P93CanonicalSourceProgram)
    (negative : GlobalNonDescriptorReviewedSemantics)
    (provision : IUPACNormativeProvision)
    (input : AuthoritativeChemicalInput)
    (admitted :
      (ParameterizedGlobalProductionCorpus
        program.compiledPolicies.toDescriptorBearingWithP94Schema negative).ChemicallyAdmitted
          input) :
    (fixedGlobalProvisionInterpreter
      program.compiledPolicies.toDescriptorBearingWithP94Schema negative).productionAssignments
        provision input =
      (ParameterizedGlobalProductionCorpus
        program.compiledPolicies.toDescriptorBearingWithP94Schema negative).referenceAssignments
          provision input :=
  fixedGlobalPipeline_eq_p94SchemaReference
