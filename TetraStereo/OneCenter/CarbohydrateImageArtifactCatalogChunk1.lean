@[simp] theorem imageArtifactsChunk1_length : imageArtifactsChunk1.length = 50 := by rfl

def imageArtifactPathsChunk1 : List String :=
  imageArtifactsChunk1.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk1_isChain :
    imageArtifactPathsChunk1.IsChain (· < ·) := by decide

theorem imageArtifactsChunk1_transcribedCount :
    (imageArtifactsChunk1.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk1_transcribedTemplatesWellFormed :
    (imageArtifactsChunk1.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk1_genericAndErratumTranscribed :
    (imageArtifactsChunk1.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk1_kindCounts :
    (imageArtifactsChunk1.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk1.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk1.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk1.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk1_chemicalPartitionCounts :
    (imageArtifactsChunk1.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk1.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk1_graphAuditMaturityCounts :
    (imageArtifactsChunk1.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk1.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk1.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

