import TetraStereo.OneCenter.AuthoritativeLocalizedApplicability
import TetraStereo.KernelOnly

set_option autoImplicit false

/-!
# Kernel-only certificate for the independent localized applicability boundary

This certificate checks the complete dependency closures of the source-only applicability
reflection, exact public admission/failure theorems, direct proof-carrying analysis, and
current-scope end-to-end descriptor conformance theorem.
-/

assert_kernel_only TetraStereo.OneCenter.AuthoritativeChemicalInput.localizedCIPApplicable?_eq_true_iff
