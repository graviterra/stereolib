import TetraStereo.OneCenter.ConstitutionAutomorphismSemantics
import TetraStereo.OneCenter.P94CoordinateCrownSymmetry
import TetraStereo.OneCenter.P94MolecularRingCarrier
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Data.Fin.Rev
import Mathlib.Logic.Equiv.Fin.Rotate

set_option autoImplicit false

namespace TetraStereo.OneCenter

open BlueBookP94

/-!
# General finite molecular and geometric symmetry for P-94 crowns

P-94.3.2.4 says that the atoms of a crown are symmetrically equivalent and gives the idealized
point-group examples `D4d` for cyclooctane and `D5d` for cyclodecane.  The earlier exact
coordinate layer used only the adjacent cyclic generator.  That generator is appropriate for the
printed `D_nd` examples, but it is merely one possible finite presentation of a transitive
ring-position symmetry action.

This module gives an independent finite-generator semantics.  A generator is a permutation of
the ordered ring positions which preserves cyclic adjacency and every exact rational pairwise
distance and whose induced atom map extends to a full constitution/label-preserving molecular
automorphism.  The subgroup generated by the finite family must act transitively.  Thus the
definition is independent of a particular point-group name or generator enumeration, while still
expressing molecular and spatial equivalence rather than polygonal edge equality alone.

`DndCrownSymmetry` records the stronger canonical dihedral presentation: both the adjacent
rotation and the reversal generator are admissible.  At the ring-position level those generators
generate the dihedral action underlying the printed `D_nd` examples.  The old adjacent-generator
criterion implies the general transitive relation.  It is not asserted to imply the stronger
`DndCrownSymmetry`, because preservation by the reflection generator is genuinely additional
evidence.
-/

namespace BlueBookP94.CoordinateRing

/-! ## Independent action semantics -/

/-- Exact cyclic adjacency on an ordered finite ring.  It is expressed through the canonical
one-step permutation so that the closing edge is included without a special endpoint case. -/
def CyclicallyAdjacent {count : ℕ} (left right : Fin count) : Prop :=
  finRotate count left = right ∨ finRotate count right = left

/-- A permutation is an automorphism of the abstract cyclic ring-position graph. -/
def PreservesCyclicAdjacency {count : ℕ} (action : Equiv.Perm (Fin count)) : Prop :=
  ∀ left right,
    CyclicallyAdjacent left right ↔ CyclicallyAdjacent (action left) (action right)

/-- A position permutation preserves the complete exact rational distance matrix. -/
def RingMetricIsometry (points : List CartesianPoint3)
    (action : Equiv.Perm (Fin points.length)) : Prop :=
  ∀ left right,
    crownSquaredDistance (points.get left) (points.get right) =
      crownSquaredDistance (points.get (action left)) (points.get (action right))

/-- The target atom traversal induced by a permutation of ring positions. -/
def permutedRingAtoms (atoms : List Nat) (action : Equiv.Perm (Fin atoms.length)) : List Nat :=
  List.ofFn fun index => atoms.get (action index)

@[simp] theorem permutedRingAtoms_length (atoms : List Nat)
    (action : Equiv.Perm (Fin atoms.length)) :
    (permutedRingAtoms atoms action).length = atoms.length := by
  simp [permutedRingAtoms]

/-- A ring-position action is chemically realized only when its induced atom map extends to a
full automorphism of the complete molecule.  Consequently substituents, isotopes, charge and all
bond/nonbond classes participate in the symmetry test. -/
def RingActionConstitutionallyAdmissible (molecule : RawMolecule)
    (unit : P94ConformationUnit) (action : Equiv.Perm (Fin unit.atoms.length)) : Prop :=
  molecule.HasSeededConstitutionAutomorphism molecule.localizedMancudeEdges
    (List.range molecule.atomCount)
    (unit.atoms.zip (permutedRingAtoms unit.atoms action))

/-- One exact molecular-and-geometric generator.  `lengthEq` identifies the molecular traversal
with the coordinate traversal; proof irrelevance makes the particular equality witness
mathematically immaterial. -/
def AdmissibleCrownGenerator (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) (lengthEq : unit.atoms.length = points.length)
    (action : Equiv.Perm (Fin unit.atoms.length)) : Prop :=
  PreservesCyclicAdjacency action ∧
    RingMetricIsometry points
      ((finCongr lengthEq).symm.trans (action.trans (finCongr lengthEq))) ∧
    RingActionConstitutionallyAdmissible molecule unit action

/-- The subgroup generated by a finite family acts transitively on the ring positions. -/
def CrownGeneratorsActTransitively {count : ℕ}
    (generators : Finset (Equiv.Perm (Fin count))) : Prop :=
  ∀ source target,
    ∃ action : Subgroup.closure (↑generators : Set (Equiv.Perm (Fin count))),
      action.1 source = target

/-- General exact meaning of molecularly and spatially symmetric equivalence for a finite crown.

The witness is a finite generator family.  Every generator is an abstract ring automorphism, an
exact isometry of the complete coordinate packet, and a restriction of a full constitutional
automorphism.  Its generated subgroup is required to have one orbit on ring positions. -/
def GeneralCrownSymmetry (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) : Prop :=
  ∃ lengthEq : unit.atoms.length = points.length,
    ∃ generators : Finset (Equiv.Perm (Fin unit.atoms.length)),
      generators.Nonempty ∧
        (∀ action ∈ generators,
          AdmissibleCrownGenerator molecule unit points lengthEq action) ∧
        CrownGeneratorsActTransitively generators

/-! ## Canonical cyclic and `D_nd` presentations -/

/-- The old adjacent cyclic generator, now with both its molecular and geometric obligations made
explicit in the general action language. -/
def CyclicGeneratorCrownSymmetry (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) : Prop :=
  ∃ lengthEq : unit.atoms.length = points.length,
    AdmissibleCrownGenerator molecule unit points lengthEq
      (finRotate unit.atoms.length)

/-- Canonical finite dihedral presentation underlying the ring-position action in the printed
`D4d`, `D5d`, ... crown examples: the adjacent rotation and reversal are both exact molecular and
metric symmetries.  The suffix `d` also describes the spatial placement of symmetry elements;
this predicate formalizes precisely their induced action on the atoms and exact coordinates. -/
def DndCrownSymmetry (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) : Prop :=
  ∃ lengthEq : unit.atoms.length = points.length,
    AdmissibleCrownGenerator molecule unit points lengthEq
        (finRotate unit.atoms.length) ∧
      AdmissibleCrownGenerator molecule unit points lengthEq Fin.revPerm

/-- The canonical one-step permutation preserves the cyclic adjacency relation. -/
theorem finRotate_preservesCyclicAdjacency (count : ℕ) :
    PreservesCyclicAdjacency (finRotate count) := by
  intro left right
  constructor
  · rintro (adjacent | adjacent)
    · exact Or.inl (congrArg (finRotate count) adjacent)
    · exact Or.inr (congrArg (finRotate count) adjacent)
  · rintro (adjacent | adjacent)
    · exact Or.inl ((finRotate count).injective adjacent)
    · exact Or.inr ((finRotate count).injective adjacent)

/-- Powers of the adjacent rotation carry any finite ring position to any other position. -/
private theorem finRotate_mem_closure_implies_transitive
    {count : ℕ} {generators : Finset (Equiv.Perm (Fin count))}
    (rotationMem : finRotate count ∈
      Subgroup.closure (↑generators : Set (Equiv.Perm (Fin count)))) :
    CrownGeneratorsActTransitively generators := by
  intro source target
  letI : NeZero count := source.neZero
  let offset : Fin count := target - source
  let powered : Equiv.Perm (Fin count) := (finRotate count) ^ offset.val
  have poweredMem : powered ∈
      Subgroup.closure (↑generators : Set (Equiv.Perm (Fin count))) :=
    Subgroup.pow_mem _ rotationMem offset.val
  refine ⟨⟨powered, poweredMem⟩, ?_⟩
  change ((finRotate count) ^ offset.val) source = target
  change (finRotate count)^[offset.val] source = target
  rw [← finCycle_eq_finRotate_iterate (k := offset)]
  change source + (target - source) = target
  simp [sub_eq_add_neg]

/-- The adjacent-generator presentation is a special case of the finite transitive-group
semantics. -/
theorem cyclicGenerator_implies_generalCrownSymmetry
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3}
    (cyclic : CyclicGeneratorCrownSymmetry molecule unit points) :
    GeneralCrownSymmetry molecule unit points := by
  rcases cyclic with ⟨lengthEq, admissible⟩
  refine ⟨lengthEq, {finRotate unit.atoms.length}, by simp, ?_, ?_⟩
  · intro action actionMem
    simp only [Finset.mem_singleton] at actionMem
    subst action
    exact admissible
  · apply finRotate_mem_closure_implies_transitive
    exact Subgroup.subset_closure (by simp)

/-- The printed canonical `D_nd` presentation contains the old adjacent generator. -/
theorem dndCrownSymmetry_implies_cyclicGenerator
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3}
    (dnd : DndCrownSymmetry molecule unit points) :
    CyclicGeneratorCrownSymmetry molecule unit points := by
  rcases dnd with ⟨lengthEq, rotation, _reflection⟩
  exact ⟨lengthEq, rotation⟩

/-- Hence every canonical `D_nd` witness is admitted by the general finite transitive relation. -/
theorem dndCrownSymmetry_implies_generalCrownSymmetry
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3}
    (dnd : DndCrownSymmetry molecule unit points) :
    GeneralCrownSymmetry molecule unit points :=
  cyclicGenerator_implies_generalCrownSymmetry
    (dndCrownSymmetry_implies_cyclicGenerator dnd)

/-! ## Compatibility with the earlier list-rotation presentation -/

/-- The entry at the unchanged list index after a one-place list rotation is the entry selected
by the canonical adjacent permutation in the original list. -/
private theorem get_rotate_one_corresponding_finRotate {Alpha : Type*}
    (values : List Alpha) (index : Fin values.length) :
    (values.rotate 1).get ⟨index.val, by simp⟩ =
      values.get (finRotate values.length index) := by
  rw [List.get_rotate_one]
  congr 1
  apply Fin.ext
  cases values with
  | nil => exact Fin.elim0 index
  | cons head tail =>
      simp only [List.length_cons]
      rw [finRotate_succ_apply]
      simp [Fin.val_add]

/-- Applying the canonical adjacent permutation to a list produces its one-place rotation. -/
theorem permutedRingAtoms_finRotate (atoms : List Nat) :
    permutedRingAtoms atoms (finRotate atoms.length) = atoms.rotate 1 := by
  apply List.ext_get
  · simp [permutedRingAtoms]
  · intro index leftBound rightBound
    simp only [permutedRingAtoms, List.get_ofFn]
    rw [List.get_rotate_one]
    congr 1
    apply Fin.ext
    cases atoms with
    | nil => simp at leftBound
    | cons head tail =>
        simp only [List.length_cons]
        rw [finRotate_succ_apply]
        simp [Fin.val_add]

/-- The earlier complete-distance-matrix one-step test is exactly metric preservation by the
canonical adjacent permutation. -/
theorem cyclicShiftPreservesSquaredDistances_iff_finRotate
    (points : List CartesianPoint3) :
    CyclicShiftPreservesSquaredDistances points ↔
      RingMetricIsometry points (finRotate points.length) := by
  constructor
  · intro shifted
    unfold CyclicShiftPreservesSquaredDistances at shifted
    intro left right
    have preserved := shifted left right
    change crownSquaredDistance (points.get left) (points.get right) =
      crownSquaredDistance
        ((points.rotate 1).get ⟨left.val, by simp⟩)
        ((points.rotate 1).get ⟨right.val, by simp⟩) at preserved
    rw [get_rotate_one_corresponding_finRotate,
      get_rotate_one_corresponding_finRotate] at preserved
    exact preserved
  · intro isometry
    unfold CyclicShiftPreservesSquaredDistances
    intro left right
    have preserved := isometry left right
    change crownSquaredDistance (points.get left) (points.get right) =
      crownSquaredDistance
        ((points.rotate 1).get ⟨left.val, by simp⟩)
        ((points.rotate 1).get ⟨right.val, by simp⟩)
    rw [get_rotate_one_corresponding_finRotate,
      get_rotate_one_corresponding_finRotate]
    exact preserved

/-- The old coordinate and seeded-molecule witnesses construct the explicit cyclic-generator
predicate.  This is the compatibility theorem used by the molecule-facing P-94 layer. -/
theorem cyclicGeneratorCrownSymmetry_of_existing
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3}
    (lengthEq : unit.atoms.length = points.length)
    (spatial : CyclicallySymmetricallyEquivalent points)
    (constitutional :
      molecule.HasSeededConstitutionAutomorphism molecule.localizedMancudeEdges
        (List.range molecule.atomCount)
        (unit.atoms.zip (unit.atoms.rotate 1))) :
    CyclicGeneratorCrownSymmetry molecule unit points := by
  refine ⟨lengthEq, finRotate_preservesCyclicAdjacency _, ?_, ?_⟩
  · have metric :=
      (cyclicShiftPreservesSquaredDistances_iff_finRotate points).mp spatial.2
    have transportedAction :
        (finCongr lengthEq).symm.trans
            ((finRotate unit.atoms.length).trans (finCongr lengthEq)) =
          finRotate points.length := by
      generalize unitLengthEq : unit.atoms.length = unitLength at lengthEq ⊢
      generalize pointsLengthEq : points.length = pointsLength at lengthEq ⊢
      subst pointsLength
      cases lengthEq
      rfl
    rw [transportedAction]
    exact metric
  · simpa [RingActionConstitutionallyAdmissible, permutedRingAtoms_finRotate] using constitutional

/-! ## Complete crown judgment and exact selector -/

/-- The geometry common to all exact crown symmetries, without selecting a particular point-group
presentation. -/
def GeneralCrownCoordinateGeometry (points : List CartesianPoint3) : Prop :=
  8 ≤ points.length ∧
    Even points.length ∧
    LiesAlternatelyInParallelPlanes points ∧
    points.Nodup

/-- Complete independent molecule-and-coordinate crown judgment.  Saturation and cycle validity
come from the actual molecule, while symmetric equivalence is the transitive finite action above. -/
def GeneralCrownJudgment (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) (sides : List PlaneSide) : Prop :=
  unit.kind = .crownRing ∧
    unit.ValidFor molecule ∧
    unit.SaturatedCyclic molecule ∧
    GeneralCrownCoordinateGeometry points ∧
    GeneralCrownSymmetry molecule unit points ∧
    canonicalCrownSides points = sides

/-- Exact specification selector.  It is noncomputable only because it decides the independent
finite symmetry proposition classically; the emitted side ledger itself is canonical. -/
noncomputable def generalCrownSides? (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) : Option (List PlaneSide) := by
  classical
  exact if accepted :
      unit.kind = .crownRing ∧
        unit.ValidFor molecule ∧
        unit.SaturatedCyclic molecule ∧
        GeneralCrownCoordinateGeometry points ∧
        GeneralCrownSymmetry molecule unit points then
    some (canonicalCrownSides points)
  else
    none

/-- Success is exactly the independent general crown judgment. -/
theorem generalCrownSides?_eq_some_iff (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3)
    (sides : List PlaneSide) :
    generalCrownSides? molecule unit points = some sides ↔
      GeneralCrownJudgment molecule unit points sides := by
  classical
  by_cases accepted :
      unit.kind = .crownRing ∧
        unit.ValidFor molecule ∧
        unit.SaturatedCyclic molecule ∧
        GeneralCrownCoordinateGeometry points ∧
        GeneralCrownSymmetry molecule unit points
  · simp [generalCrownSides?, GeneralCrownJudgment, accepted]
  · have noJudgment :
        ¬∃ sides, GeneralCrownJudgment molecule unit points sides := by
      rintro ⟨sides, kind, valid, saturated, geometry, symmetry, _sidesEq⟩
      exact accepted ⟨kind, valid, saturated, geometry, symmetry⟩
    have thisJudgmentAbsent :
        ¬GeneralCrownJudgment molecule unit points sides := by
      exact fun judged => noJudgment ⟨sides, judged⟩
    simp [generalCrownSides?, accepted, thisJudgmentAbsent]

/-- Refusal is exhaustive: precisely no general crown judgment exists. -/
theorem generalCrownSides?_eq_none_iff (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) :
    generalCrownSides? molecule unit points = none ↔
      ¬∃ sides, GeneralCrownJudgment molecule unit points sides := by
  classical
  by_cases accepted :
      unit.kind = .crownRing ∧
        unit.ValidFor molecule ∧
        unit.SaturatedCyclic molecule ∧
        GeneralCrownCoordinateGeometry points ∧
        GeneralCrownSymmetry molecule unit points
  · have existsJudgment :
        ∃ sides, GeneralCrownJudgment molecule unit points sides := by
      exact ⟨canonicalCrownSides points,
        accepted.1, accepted.2.1, accepted.2.2.1,
        accepted.2.2.2.1, accepted.2.2.2.2, rfl⟩
    simp [generalCrownSides?, accepted, existsJudgment]
  · have noJudgment :
        ¬∃ sides, GeneralCrownJudgment molecule unit points sides := by
      rintro ⟨sides, kind, valid, saturated, geometry, symmetry, _sidesEq⟩
      exact accepted ⟨kind, valid, saturated, geometry, symmetry⟩
    simp [generalCrownSides?, accepted, noJudgment]

/-- Every accepted general judgment supplies exactly the source-level crown side relation with
the independently formalized finite molecular/geometric symmetry proposition. -/
theorem generalCrownJudgment_isCrown
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3} {sides : List PlaneSide}
    (judged : GeneralCrownJudgment molecule unit points sides) :
    IsCrown sides (GeneralCrownSymmetry molecule unit points) := by
  rcases judged with
    ⟨_kind, _valid, _saturated,
      ⟨atLeastEight, even, _parallelPlanes, _nodup⟩, symmetry, sidesEq⟩
  rw [← sidesEq]
  exact ⟨by simpa using atLeastEight, by simpa using even,
    canonicalCrownSides_alternating points, symmetry⟩

/-! ## Molecule-facing P-94 evidence and exact-once public report -/

/-- The concrete evidence type used by the complete P-94 report for this stateless crown path. -/
abbrev GeneralCrownEvidence := P94ConformationEvidence Unit Unit

/-- Construct the ordinary P-94 crown record from the independent general judgment.  The two
propositional fields are not caller assertions: they are the actual molecular saturation
predicate and the general molecular/geometric symmetry relation proved above. -/
def generalCrownRecord (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) (sides : List PlaneSide) : GeneralCrownEvidence :=
  .ringPlane
    { unit := unit
      sides := sides
      saturatedCyclic := unit.SaturatedCyclic molecule
      symmetricallyEquivalent := GeneralCrownSymmetry molecule unit points }

/-- Independent exact judgment for the evidence object handed to the complete P-94 analyzer. -/
def GeneralCrownEvidenceJudgment (molecule : RawMolecule) (unit : P94ConformationUnit)
    (points : List CartesianPoint3) (output : GeneralCrownEvidence) : Prop :=
  ∃ sides,
    GeneralCrownJudgment molecule unit points sides ∧
      output = generalCrownRecord molecule unit points sides

/-- Molecule-facing selector obtained by mapping the exact general-crown side selector. -/
noncomputable def generalCrownEvidence? (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) :
    Option GeneralCrownEvidence :=
  (generalCrownSides? molecule unit points).map
    (generalCrownRecord molecule unit points)

/-- Evidence success is exactly the independent evidence judgment. -/
theorem generalCrownEvidence?_eq_some_iff (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3)
    (output : GeneralCrownEvidence) :
    generalCrownEvidence? molecule unit points = some output ↔
      GeneralCrownEvidenceJudgment molecule unit points output := by
  constructor
  · intro computed
    unfold generalCrownEvidence? at computed
    cases sidesComputed : generalCrownSides? molecule unit points with
    | none => simp [sidesComputed] at computed
    | some sides =>
        have outputEq : generalCrownRecord molecule unit points sides = output := by
          simpa [sidesComputed] using computed
        exact ⟨sides,
          (generalCrownSides?_eq_some_iff molecule unit points sides).mp sidesComputed,
          outputEq.symm⟩
  · rintro ⟨sides, judged, rfl⟩
    unfold generalCrownEvidence?
    rw [(generalCrownSides?_eq_some_iff molecule unit points sides).mpr judged]
    rfl

/-- Evidence refusal is exhaustive. -/
theorem generalCrownEvidence?_eq_none_iff (molecule : RawMolecule)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) :
    generalCrownEvidence? molecule unit points = none ↔
      ¬∃ output, GeneralCrownEvidenceJudgment molecule unit points output := by
  constructor
  · intro computed ⟨output, judged⟩
    have some :=
      (generalCrownEvidence?_eq_some_iff molecule unit points output).mpr judged
    rw [computed] at some
    contradiction
  · intro absent
    cases computed : generalCrownEvidence? molecule unit points with
    | none => rfl
    | some output =>
        exact False.elim (absent ⟨output,
          (generalCrownEvidence?_eq_some_iff molecule unit points output).mp computed⟩)

/-- Every derived general-crown record is molecule-valid, has valid molecular roles, and supports
the P-94 crown descriptor with the general symmetry proposition itself as its source witness. -/
theorem generalCrownEvidenceJudgment_supports
    {molecule : RawMolecule} {unit : P94ConformationUnit}
    {points : List CartesianPoint3} {output : GeneralCrownEvidence}
    (judged : GeneralCrownEvidenceJudgment molecule unit points output) :
    output.unit.ValidFor molecule ∧
      output.MolecularRolesValid molecule ∧
      output.Supports .crown := by
  rcases judged with ⟨sides, crownJudged, rfl⟩
  rcases crownJudged with
    ⟨kind, valid, saturated, geometry, symmetry, sidesEq⟩
  have lengthEq : unit.atoms.length = points.length := symmetry.choose
  have sidesLength : sides.length = unit.atoms.length := by
    rw [← sidesEq, canonicalCrownSides_length, ← lengthEq]
  have crown : IsCrown sides (GeneralCrownSymmetry molecule unit points) :=
    generalCrownJudgment_isCrown
      ⟨kind, valid, saturated, geometry, symmetry, sidesEq⟩
  refine ⟨valid, ?_, ?_⟩
  · simpa [generalCrownRecord, P94ConformationEvidence.MolecularRolesValid, kind]
      using saturated
  · exact ⟨kind, sidesLength, saturated, crown⟩

/-- Public assignments for one general crown input. -/
noncomputable def generalCrownAssignments
    (certified : CertifiedChemistryNormalizationResult)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) :
    List P94ConformationAssignment :=
  match generalCrownEvidence? certified.result.parsed unit points with
  | none => []
  | some output => certified.analyzeP94Conformation [output]

/-- Public membership is exactly the independent general-crown evidence and assignment relation. -/
theorem generalCrownAssignments_mem_iff
    (certified : CertifiedChemistryNormalizationResult)
    (unit : P94ConformationUnit) (points : List CartesianPoint3)
    (assignment : P94ConformationAssignment) :
    assignment ∈ generalCrownAssignments certified unit points ↔
      ∃ output,
        GeneralCrownEvidenceJudgment certified.result.parsed unit points output ∧
          IndependentP94ConformationAssignment certified.result.parsed [output] assignment := by
  classical
  cases computed : generalCrownEvidence? certified.result.parsed unit points with
  | none =>
      constructor
      · intro present
        unfold generalCrownAssignments at present
        rw [computed] at present
        simp at present
      · rintro ⟨output, judged, _independent⟩
        have some := (generalCrownEvidence?_eq_some_iff
          certified.result.parsed unit points output).mpr judged
        rw [computed] at some
        contradiction
  | some output =>
      constructor
      · intro present
        have analyzedPresent :
            assignment ∈ certified.analyzeP94Conformation [output] := by
          unfold generalCrownAssignments at present
          rw [computed] at present
          exact present
        exact ⟨output,
          (generalCrownEvidence?_eq_some_iff
            certified.result.parsed unit points output).mp computed,
          (mem_analyzeP94Conformation_iff_independent
            certified [output] assignment).mp analyzedPresent⟩
      · rintro ⟨other, judged, independent⟩
        have otherComputed := (generalCrownEvidence?_eq_some_iff
          certified.result.parsed unit points other).mpr judged
        rw [computed] at otherComputed
        have outputEq : output = other := Option.some.inj otherComputed
        subst other
        unfold generalCrownAssignments
        rw [computed]
        exact (mem_analyzeP94Conformation_iff_independent
          certified [output] assignment).mpr independent

/-- The public general-crown report contains no duplicate assignments. -/
theorem generalCrownAssignments_nodup
    (certified : CertifiedChemistryNormalizationResult)
    (unit : P94ConformationUnit) (points : List CartesianPoint3) :
    (generalCrownAssignments certified unit points).Nodup := by
  classical
  cases computed : generalCrownEvidence? certified.result.parsed unit points with
  | none =>
      unfold generalCrownAssignments
      rw [computed]
      simp
  | some output =>
      unfold generalCrownAssignments
      rw [computed]
      exact analyzeP94Conformation_nodup certified [output]

/-- Exact-once public multiplicity is equivalent to the independent judgment. -/
theorem generalCrownAssignment_count_eq_one_iff
    (certified : CertifiedChemistryNormalizationResult)
    (unit : P94ConformationUnit) (points : List CartesianPoint3)
    (assignment : P94ConformationAssignment) :
    List.count assignment (generalCrownAssignments certified unit points) = 1 ↔
      ∃ output,
        GeneralCrownEvidenceJudgment certified.result.parsed unit points output ∧
          IndependentP94ConformationAssignment certified.result.parsed [output] assignment := by
  classical
  rw [← generalCrownAssignments_mem_iff]
  constructor
  · intro countOne
    by_contra absent
    have countZero :
        List.count assignment (generalCrownAssignments certified unit points) = 0 :=
      List.count_eq_zero_of_not_mem absent
    omega
  · exact List.count_eq_one_of_mem
      (generalCrownAssignments_nodup certified unit points)

/-- A successful molecule-facing general-crown derivation emits `.crown` exactly once in the
complete P-94 public report. -/
theorem generalCrownEvidence_success_emits_crown_exactly_once
    (certified : CertifiedChemistryNormalizationResult)
    (unit : P94ConformationUnit) (points : List CartesianPoint3)
    (output : GeneralCrownEvidence)
    (computed :
      generalCrownEvidence? certified.result.parsed unit points = some output) :
    List.count
        ({ unit := output.unit, descriptor := .crown } : P94ConformationAssignment)
        (generalCrownAssignments certified unit points) = 1 := by
  have judged := (generalCrownEvidence?_eq_some_iff
    certified.result.parsed unit points output).mp computed
  rcases generalCrownEvidenceJudgment_supports judged with ⟨valid, roles, support⟩
  apply (generalCrownAssignment_count_eq_one_iff certified unit points _).mpr
  exact ⟨output, judged, output, by simp, rfl, valid, roles, support⟩

end BlueBookP94.CoordinateRing
end TetraStereo.OneCenter
