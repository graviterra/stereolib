import TetraStereo.OneCenter.AuthoritativeCIPGraph
import TetraStereo.OneCenter.MultiCenterDetection
import TetraStereo.OneCenter.OfficialCIPEngine
import TetraStereo.OneCenter.OfficialRuleMajorCompilerProjectionFidelity

set_option autoImplicit false

namespace TetraStereo.OneCenter

open scoped List

/-!
# Universal localized molecule to official CIP analysis

This module carries a certified, format-neutral localized molecule beyond the constitutional graph
record. It automatically detects every graph vertex with exactly four bonded neighbors, constructs
the corresponding `OneCenterMolecule`, and runs the corrected exhaustive rule-major official
comparator. The bridge theorems below retain the semantic input as the authority boundary:

* detected neighbors are exactly positive localized covalent records in the semantic molecule;
* every real official root label contains the original atomic number and exact frozen Rule-2 mass;
* every official child atom is backed by a positive semantic covalent record; and
* the safe official permutation succeeds exactly when all six distinct ligand comparisons decide.

## Migration note (exhaustive rule-major)

The historical `compareAt` compared one breadth-first sphere at a time, so a root-sphere Rule-2
isotope decision could pre-empt a deeper-sphere Rule-1a atomic-number decision. That schedule is
the kernel-confirmed public counterexample `f4_rule_major_public_counterexample`. The migrated
`compareAt` therefore compiles each canonical branch root with the shared
`MoleculeGraph.buildOfficialRuleMajorKey` compiler over the executable child enumeration, gates
both compiled keys through `OfficialRuleMajorKey.compare?`, and only then applies the supplied
Rule 3/4/5 context. It returns `Option CIPTraceCertificate`; refusal is explicit (`none`) rather
than disguised as equality.

The legacy layer-major trace declarations (`executableOfficialHierarchicalDigraphTrace` and its
reference equality) are retained below unchanged as standalone facts so existing independent
callers keep compiling. They are **not** used by the corrected comparison path.

## Runtime / reference bridge at the default fuel

`executableOfficialCIPChildren` (sorted `Finset.sort`) and
`moleculeGraph.officialCIPChildren` (proof-facing `Finset.toList`) enumerate the same children in
different orders, so the compiled keys can differ in provenance (`sourceNodes`) order. Whole-key
equality is therefore **not** available and is never assumed. The
`CompilerProjectionFidelity` module proves that pointwise-permuted child enumerators produce keys
with the same Rule-1a, Rule-1b and Rule-2 projections and the same `complete` flag, and that the
rule-tagged `compareTrace` consequently agrees.

At the default fuel `Fintype.card Atom + 1` both sides are known to succeed from existing
structural completeness (`officialExpansionCompleteWithin_rootFromEdge_default` transported across
the enumeration permutation, and `buildOfficialRuleMajorKey_complete_of_expansionCompleteWithin`),
so the projection invariance is applicable without any success or failure premise. Transporting the
common trace through `CIPRuleEngine.compareDigraphThenOfficialCertificate` with the **unchanged**
per-ligand contexts yields the unconditional certificate identity
`compareAt = some referenceCompareAt` and the matching unconditional order, resolution and
permutation coherence theorems at the end of this file.
-/

namespace MoleculeGraph

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Membership in the multiplicity list retains the underlying positive adjacency. -/
theorem adj_of_mem_officialNeighborCopies
    (molecule : MoleculeGraph V) (atom neighbor : V) (copyIndex : ℕ)
    (present : (neighbor, copyIndex) ∈ molecule.officialNeighborCopies atom) :
    molecule.Adj atom neighbor := by
  rw [officialNeighborCopies, List.mem_flatMap] at present
  obtain ⟨source, sourcePresent, mappedPresent⟩ := present
  rw [List.mem_map] at mappedPresent
  obtain ⟨index, _indexPresent, pairEquality⟩ := mappedPresent
  cases pairEquality
  apply (molecule.mem_neighborFinset atom neighbor).mp
  simpa using sourcePresent

/-- Every atom-bearing child generated by the generic official hierarchy follows a positive edge
of the molecular graph. -/
theorem adj_of_mem_officialCIPChildren
    (molecule : MoleculeGraph V) (parent child : OfficialCIPNode V)
    (parentAtom childAtom : V)
    (parentObserved : parent.current? = some parentAtom)
    (childObserved : child.current? = some childAtom)
    (present : child ∈ molecule.officialCIPChildren parent) :
    molecule.Adj parentAtom childAtom := by
  by_cases duplicate : parent.isDuplicateLeaf = true
  · simp [officialCIPChildren, duplicate] at present
  · rw [officialCIPChildren, if_neg (by simpa using duplicate), List.mem_map] at present
    obtain ⟨copy, copyPresent, childIdentity⟩ := present
    rcases copy with ⟨neighbor, copyIndex⟩
    have neighborCopyPresent :
        (neighbor, copyIndex) ∈ molecule.officialNeighborCopies parentAtom := by
      unfold officialChildCopies at copyPresent
      rw [parentObserved] at copyPresent
      cases parentParentObserved : parent.parent? with
      | none => simpa [parentParentObserved] using copyPresent
      | some previous =>
          have simplified :
              (neighbor, copyIndex) ∈ molecule.officialNeighborCopies parentAtom ∧
                (neighbor ≠ previous ∨ copyIndex ≠ 0) := by
            simpa [parentParentObserved] using copyPresent
          exact simplified.1
    have neighborIdentity : neighbor = childAtom := by
      have currentEquality := congrArg OfficialCIPNode.current? childIdentity
      simp only [OfficialCIPNode.extend_current?] at currentEquality
      rw [childObserved] at currentEquality
      exact Option.some.inj currentEquality
    subst neighbor
    exact molecule.adj_of_mem_officialNeighborCopies parentAtom childAtom copyIndex
      neighborCopyPresent

/-- Two rule-major root comparisons built with different child enumerations agree whenever both
enumerations compile the two roots to the same pair of keys. This is the exact interface expected
from the generic permutation-projection invariance of the shared key compiler; it assumes no
output oracle and no child completeness. -/
theorem compareRuleMajorRootsWithFuel_eq_of_key_equalities
    (m : MoleculeGraph V)
    (firstChildren secondChildren : OfficialCIPNode V → List (OfficialCIPNode V))
    (fuel : ℕ) (leftRoot rightRoot : OfficialCIPNode V)
    (leftContext rightContext : CIPRuleEngine.OfficialLigandRuleContext)
    (leftKey rightKey : OfficialRuleMajorKey V)
    (firstLeft : m.buildOfficialRuleMajorKey firstChildren fuel leftRoot = some leftKey)
    (firstRight : m.buildOfficialRuleMajorKey firstChildren fuel rightRoot = some rightKey)
    (secondLeft : m.buildOfficialRuleMajorKey secondChildren fuel leftRoot = some leftKey)
    (secondRight : m.buildOfficialRuleMajorKey secondChildren fuel rightRoot = some rightKey) :
    m.compareRuleMajorRootsWithFuel firstChildren fuel leftRoot rightRoot
        leftContext rightContext =
      m.compareRuleMajorRootsWithFuel secondChildren fuel leftRoot rightRoot
        leftContext rightContext := by
  unfold compareRuleMajorRootsWithFuel ruleMajorConstitutionalTraceWithFuel
  simp only [firstLeft, firstRight, secondLeft, secondRight]

/-- Compute the shared solver once both actual roots have compiled to keys that pass the
completed-key gate.  This is the child-enumeration-agnostic form used by both the executable and
the proof-facing entry points. -/
theorem compareRuleMajorRootsWithFuel_eq_some_of_compare?
    (m : MoleculeGraph V)
    (children : OfficialCIPNode V → List (OfficialCIPNode V)) (fuel : ℕ)
    (leftRoot rightRoot : OfficialCIPNode V)
    (leftContext rightContext : CIPRuleEngine.OfficialLigandRuleContext)
    (leftKey rightKey : OfficialRuleMajorKey V)
    (leftComputed : m.buildOfficialRuleMajorKey children fuel leftRoot = some leftKey)
    (rightComputed : m.buildOfficialRuleMajorKey children fuel rightRoot = some rightKey)
    (outcome : Ordering)
    (compared : OfficialRuleMajorKey.compare? leftKey rightKey = some outcome) :
    m.compareRuleMajorRootsWithFuel children fuel leftRoot rightRoot
        leftContext rightContext =
      some (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace leftKey rightKey)
        leftContext rightContext) := by
  unfold compareRuleMajorRootsWithFuel ruleMajorConstitutionalTraceWithFuel
  simp only [leftComputed, rightComputed, compared, Option.map_some]

end MoleculeGraph

namespace CertifiedLocalizedCIPInput

abbrev Atom (input : CertifiedLocalizedCIPInput) : Type :=
  Fin input.certified.input.molecule.atomCount

/-- Semantic positive-record neighbors of one atom, independent of the graph's adjacency storage. -/
noncomputable def semanticLocalizedNeighborFinset (input : CertifiedLocalizedCIPInput)
    (center : input.Atom) : Finset input.Atom := by
  classical
  exact Finset.univ.filter fun neighbor =>
    center ≠ neighbor ∧
      ∃ order,
        (semanticEdgeKey center.val neighbor.val, order) ∈
          input.certified.input.molecule.localizedCovalentRecords ∧ 0 < order

/-- Graph neighbors and semantic positive localized records are extensionally identical. -/
theorem neighborFinset_eq_semanticLocalizedNeighborFinset
    (input : CertifiedLocalizedCIPInput) (center : input.Atom) :
    input.moleculeGraph.neighborFinset center = input.semanticLocalizedNeighborFinset center := by
  classical
  ext neighbor
  rw [MoleculeGraph.mem_neighborFinset]
  rw [show neighbor ∈ input.semanticLocalizedNeighborFinset center ↔
      center ≠ neighbor ∧
        ∃ order,
          (semanticEdgeKey center.val neighbor.val, order) ∈
            input.certified.input.molecule.localizedCovalentRecords ∧ 0 < order by
    simp only [semanticLocalizedNeighborFinset, Finset.mem_filter, Finset.mem_univ, true_and]]
  constructor
  · intro adjacent
    have distinct : center ≠ neighbor := by
      intro equality
      subst neighbor
      simp [MoleculeGraph.Adj, input.moleculeGraph.bond_self] at adjacent
    refine ⟨distinct, ?_⟩
    exact (input.certified.input.molecule.toLocalizedMoleculeGraph_adj_iff_record
      input.graphReady center neighbor distinct).mp adjacent
  · rintro ⟨distinct, record⟩
    exact (input.certified.input.molecule.toLocalizedMoleculeGraph_adj_iff_record
      input.graphReady center neighbor distinct).mpr record

/-- Automatically detected localized tetrahedral candidates. This is deliberately the graph shape
predicate (four bonded neighbors), before independent stereogenicity and geometry applicability. -/
def tetrahedralCenterSet (input : CertifiedLocalizedCIPInput) : Finset input.Atom :=
  input.moleculeGraph.tetrahedralCenterSet

abbrev TetrahedralCenter (input : CertifiedLocalizedCIPInput) : Type :=
  { center : input.Atom // center ∈ input.tetrahedralCenterSet }

/-- All detected four-neighbor candidates in ascending semantic atom-index order. -/
def canonicalTetrahedralCenters (input : CertifiedLocalizedCIPInput) :
    List input.TetrahedralCenter :=
  let sorted := input.tetrahedralCenterSet.sort (· ≤ ·)
  sorted.attach.map fun center =>
    ⟨center.1, (Finset.mem_sort (r := (· ≤ ·))).mp center.2⟩

theorem mem_canonicalTetrahedralCenters_iff
    (input : CertifiedLocalizedCIPInput) (center : input.TetrahedralCenter) :
    center ∈ input.canonicalTetrahedralCenters ↔ center.1 ∈ input.tetrahedralCenterSet := by
  constructor
  · intro _present
    exact center.2
  · intro detected
    unfold canonicalTetrahedralCenters
    rw [List.mem_map]
    let value : input.Atom := center.1
    have sortedPresent : value ∈ input.tetrahedralCenterSet.sort (· ≤ ·) :=
      (Finset.mem_sort (r := (· ≤ ·))).mpr detected
    refine ⟨⟨value, sortedPresent⟩, List.mem_attach _ _, ?_⟩
    exact Subtype.ext rfl

/-- Semantic characterization of automatic four-neighbor detection. -/
theorem mem_tetrahedralCenterSet_iff_semantic_neighbor_count
    (input : CertifiedLocalizedCIPInput) (center : input.Atom) :
    center ∈ input.tetrahedralCenterSet ↔
      (input.semanticLocalizedNeighborFinset center).card = 4 := by
  rw [tetrahedralCenterSet, MoleculeGraph.mem_tetrahedralCenterSet,
    input.moleculeGraph.isTetrahedralCenter_iff_neighborFinset_card,
    input.neighborFinset_eq_semanticLocalizedNeighborFinset center]

/-- Canonical ascending-atom-index enumeration of the detected center's neighbors. Unlike the
generic finite-type enumeration, this list is executable and contains no choice. -/
def canonicalNeighborList (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) : List input.Atom :=
  (input.moleculeGraph.neighborFinset center.1).sort (· ≤ ·)

@[simp] theorem canonicalNeighborList_length (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) :
    (input.canonicalNeighborList center).length = 4 := by
  rw [canonicalNeighborList, Finset.length_sort]
  have detected : center.1 ∈ input.moleculeGraph.tetrahedralCenterSet := center.2
  exact (input.moleculeGraph.isTetrahedralCenter_iff_neighborFinset_card center.1).mp
    ((input.moleculeGraph.mem_tetrahedralCenterSet center.1).mp detected)

/-- The ligand atom in canonical ascending-index position. -/
def canonicalLigandAtom (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) : input.Atom :=
  (input.canonicalNeighborList center).get
    (Fin.cast (input.canonicalNeighborList_length center).symm index)

theorem canonicalLigandAtom_adj (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) :
    input.moleculeGraph.Adj center.1 (input.canonicalLigandAtom center index) := by
  apply (input.moleculeGraph.mem_neighborFinset center.1
    (input.canonicalLigandAtom center index)).mp
  apply (Finset.mem_sort (r := (· ≤ ·))).mp
  exact List.get_mem (input.canonicalNeighborList center)
    (Fin.cast (input.canonicalNeighborList_length center).symm index)

theorem canonicalLigandAtom_injective (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) :
    Function.Injective (input.canonicalLigandAtom center) := by
  intro left right equality
  apply Fin.cast_injective (input.canonicalNeighborList_length center).symm
  apply (Finset.sort_nodup (input.moleculeGraph.neighborFinset center.1) (· ≤ ·)).get_inj_iff.mp
  exact equality

/-- The canonical ligand atom together with its proved center adjacency. -/
def canonicalLigandNeighbor (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) :
    input.moleculeGraph.Neighbor center.1 :=
  ⟨input.canonicalLigandAtom center index, input.canonicalLigandAtom_adj center index⟩

theorem canonicalLigandNeighbor_bijective (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) :
    Function.Bijective (input.canonicalLigandNeighbor center) := by
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  constructor
  · intro left right equality
    apply input.canonicalLigandAtom_injective center
    exact congrArg Subtype.val equality
  · have detected : center.1 ∈ input.moleculeGraph.tetrahedralCenterSet := by
      exact center.2
    have fourNeighbors :=
      (input.moleculeGraph.mem_tetrahedralCenterSet center.1).mp detected
    simpa using fourNeighbors.symm

/-- The canonical, executable one-center graph at an automatically detected semantic candidate. -/
def detectedOneCenterMolecule (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) : OneCenterMolecule input.Atom where
  mol := input.moleculeGraph
  center := center.1
  ligandAtom := input.canonicalLigandAtom center
  ligandAtom_adj := input.canonicalLigandAtom_adj center
  ligandAtom_injective := input.canonicalLigandAtom_injective center
  ligandAtom_surjective := by
    intro atom adjacent
    obtain ⟨index, equality⟩ :=
      (input.canonicalLigandNeighbor_bijective center).2 ⟨atom, adjacent⟩
    exact ⟨index, congrArg Subtype.val equality⟩

/-- All automatically detected four-neighbor candidates in one multi-center graph. -/
noncomputable def detectedMultiCenterMolecule (input : CertifiedLocalizedCIPInput) :
    MultiCenterMolecule input.Atom :=
  input.moleculeGraph.detectedMultiCenterMolecule

/-- Exact semantic label of any real official hierarchy root. -/
theorem official_root_label_exact
    (input : CertifiedLocalizedCIPInput) (parent atom : input.Atom) :
    ∃ mass,
      (input.certified.input.molecule.atoms.get atom).rule2MassPico? = some mass ∧
        input.moleculeGraph.officialNodeAtomLabel
            (OfficialCIPNode.rootFromEdge parent atom) =
          toLex ((input.certified.input.molecule.atoms.get atom).element.atomicNumber, mass) := by
  obtain ⟨mass, observed, _graphMass⟩ :=
    input.certified.input.molecule.toLocalizedMoleculeGraph_atomMass_eq_of_ready
      input.graphReady atom
  refine ⟨mass, observed, ?_⟩
  change
    toLex ((input.certified.input.molecule.atoms.get atom).element.atomicNumber,
      (input.certified.input.molecule.atoms.get atom).rule2MassPico?.getD 0) =
    toLex ((input.certified.input.molecule.atoms.get atom).element.atomicNumber, mass)
  rw [observed]
  rfl

/-- The first official hierarchy comparison uses the exact semantic labels in normative order:
Rule 1a, total Rule 1b, then Rule 2. -/
theorem official_root_trace_exact
    (input : CertifiedLocalizedCIPInput) (parent left right : input.Atom) :
    ∃ leftMass rightMass,
      (input.certified.input.molecule.atoms.get left).rule2MassPico? = some leftMass ∧
      (input.certified.input.molecule.atoms.get right).rule2MassPico? = some rightMass ∧
      input.moleculeGraph.compareOfficialNodeTrace
          (OfficialCIPNode.rootFromEdge parent left)
          (OfficialCIPNode.rootFromEdge parent right) =
        [CIPRuleEngine.priorityNatDecision CIPRuleFamily.atomicNumber
            (input.certified.input.molecule.atoms.get left).element.atomicNumber
            (input.certified.input.molecule.atoms.get right).element.atomicNumber,
          MoleculeGraph.duplicateRootDistanceDecision
            (OfficialCIPNode.rootFromEdge parent left)
            (OfficialCIPNode.rootFromEdge parent right),
          CIPRuleEngine.priorityNatDecision CIPRuleFamily.isotopeMass leftMass rightMass] := by
  obtain ⟨leftMass, leftObserved, leftLabel⟩ := input.official_root_label_exact parent left
  obtain ⟨rightMass, rightObserved, rightLabel⟩ := input.official_root_label_exact parent right
  refine ⟨leftMass, rightMass, leftObserved, rightObserved, ?_⟩
  simp only [MoleculeGraph.compareOfficialNodeTrace, leftLabel, rightLabel, ofLex_toLex]

/-- Exact atomic number decides the official real-root comparison before Rules 1b and 2. -/
theorem official_root_trace_outcome_lt_of_atomicNumber_lt
    (input : CertifiedLocalizedCIPInput) (parent left right : input.Atom)
    (atomicNumberLower :
      (input.certified.input.molecule.atoms.get left).element.atomicNumber <
        (input.certified.input.molecule.atoms.get right).element.atomicNumber) :
    cipTraceOutcome
      (input.moleculeGraph.compareOfficialNodeTrace
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right)) = Ordering.lt := by
  change cipTraceOutcome
    [CIPRuleEngine.priorityNatDecision CIPRuleFamily.atomicNumber
        (input.certified.input.molecule.atoms.get left).element.atomicNumber
        (input.certified.input.molecule.atoms.get right).element.atomicNumber,
      MoleculeGraph.duplicateRootDistanceDecision
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right),
      CIPRuleEngine.priorityNatDecision CIPRuleFamily.isotopeMass
        ((input.certified.input.molecule.atoms.get left).rule2MassPico?.getD 0)
        ((input.certified.input.molecule.atoms.get right).rule2MassPico?.getD 0)] = Ordering.lt
  simp only [cipTraceOutcome, CIPRuleEngine.priorityNatDecision_outcome]
  rw [CIPRuleEngine.comparePriorityNat_eq_lt_of_lt atomicNumberLower]
  rfl

/-- Exact atomic number likewise decides the reverse official real-root comparison. -/
theorem official_root_trace_outcome_gt_of_atomicNumber_gt
    (input : CertifiedLocalizedCIPInput) (parent left right : input.Atom)
    (atomicNumberHigher :
      (input.certified.input.molecule.atoms.get right).element.atomicNumber <
        (input.certified.input.molecule.atoms.get left).element.atomicNumber) :
    cipTraceOutcome
      (input.moleculeGraph.compareOfficialNodeTrace
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right)) = Ordering.gt := by
  change cipTraceOutcome
    [CIPRuleEngine.priorityNatDecision CIPRuleFamily.atomicNumber
        (input.certified.input.molecule.atoms.get left).element.atomicNumber
        (input.certified.input.molecule.atoms.get right).element.atomicNumber,
      MoleculeGraph.duplicateRootDistanceDecision
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right),
      CIPRuleEngine.priorityNatDecision CIPRuleFamily.isotopeMass
        ((input.certified.input.molecule.atoms.get left).rule2MassPico?.getD 0)
        ((input.certified.input.molecule.atoms.get right).rule2MassPico?.getD 0)] = Ordering.gt
  simp only [cipTraceOutcome, CIPRuleEngine.priorityNatDecision_outcome]
  rw [CIPRuleEngine.comparePriorityNat_eq_gt_of_lt atomicNumberHigher]
  rfl

/-- At equal atomic number, exact frozen Rule-2 mass decides the official real-root comparison. -/
theorem official_root_trace_outcome_lt_of_rule2_mass_lt
    (input : CertifiedLocalizedCIPInput) (parent left right : input.Atom)
    (sameElement :
      (input.certified.input.molecule.atoms.get left).element.atomicNumber =
        (input.certified.input.molecule.atoms.get right).element.atomicNumber)
    (massLower :
      (input.certified.input.molecule.atoms.get left).rule2MassPico?.getD 0 <
        (input.certified.input.molecule.atoms.get right).rule2MassPico?.getD 0) :
    cipTraceOutcome
      (input.moleculeGraph.compareOfficialNodeTrace
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right)) = Ordering.lt := by
  change cipTraceOutcome
    [CIPRuleEngine.priorityNatDecision CIPRuleFamily.atomicNumber
        (input.certified.input.molecule.atoms.get left).element.atomicNumber
        (input.certified.input.molecule.atoms.get right).element.atomicNumber,
      MoleculeGraph.duplicateRootDistanceDecision
        (OfficialCIPNode.rootFromEdge parent left)
        (OfficialCIPNode.rootFromEdge parent right),
      CIPRuleEngine.priorityNatDecision CIPRuleFamily.isotopeMass
        ((input.certified.input.molecule.atoms.get left).rule2MassPico?.getD 0)
        ((input.certified.input.molecule.atoms.get right).rule2MassPico?.getD 0)] = Ordering.lt
  have atomicTie :
      CIPRuleEngine.comparePriorityNat
          (input.certified.input.molecule.atoms.get left).element.atomicNumber
          (input.certified.input.molecule.atoms.get right).element.atomicNumber = Ordering.eq :=
    CIPRuleEngine.comparePriorityNat_eq_eq_of_eq sameElement
  have rootTie :
      (MoleculeGraph.duplicateRootDistanceDecision
          (OfficialCIPNode.rootFromEdge parent left)
          (OfficialCIPNode.rootFromEdge parent right)).outcome = Ordering.eq := by
    rfl
  simp only [cipTraceOutcome, CIPRuleEngine.priorityNatDecision_outcome]
  rw [atomicTie, rootTie, CIPRuleEngine.comparePriorityNat_eq_lt_of_lt massLower]
  rfl

/-- Every atom-bearing child in the official hierarchy is backed by a positive semantic localized
covalent record. No graph-only edge can appear during CIP expansion. -/
theorem official_child_has_semantic_record
    (input : CertifiedLocalizedCIPInput) (parent child : OfficialCIPNode input.Atom)
    (parentAtom childAtom : input.Atom)
    (parentObserved : parent.current? = some parentAtom)
    (childObserved : child.current? = some childAtom)
    (present : child ∈ input.moleculeGraph.officialCIPChildren parent) :
    ∃ order,
      (semanticEdgeKey parentAtom.val childAtom.val, order) ∈
        input.certified.input.molecule.localizedCovalentRecords ∧ 0 < order := by
  have adjacent := input.moleculeGraph.adj_of_mem_officialCIPChildren parent child
    parentAtom childAtom parentObserved childObserved present
  have distinct : parentAtom ≠ childAtom := by
    intro equality
    subst childAtom
    simp [MoleculeGraph.Adj, input.moleculeGraph.bond_self] at adjacent
  exact (input.certified.input.molecule.toLocalizedMoleculeGraph_adj_iff_record
    input.graphReady parentAtom childAtom distinct).mp adjacent

/-- Executable neighbor copies in canonical atom-index order. This is the `Fin n` specialization
of the generic proof-facing construction, whose `Finset.toList` enumeration is noncomputable. -/
def executableOfficialNeighborCopies (input : CertifiedLocalizedCIPInput) (atom : input.Atom) :
    List (input.Atom × ℕ) :=
  (input.moleculeGraph.neighborFinset atom).sort (· ≤ ·) |>.flatMap fun neighbor =>
    (List.range (input.moleculeGraph.bond atom neighbor)).map fun copyIndex =>
      (neighbor, copyIndex)

/-- Every executable neighbor copy retains the underlying positive graph adjacency. -/
theorem adj_of_mem_executableOfficialNeighborCopies
    (input : CertifiedLocalizedCIPInput) (atom neighbor : input.Atom) (copyIndex : ℕ)
    (present : (neighbor, copyIndex) ∈ input.executableOfficialNeighborCopies atom) :
    input.moleculeGraph.Adj atom neighbor := by
  rw [executableOfficialNeighborCopies, List.mem_flatMap] at present
  obtain ⟨source, sourcePresent, mappedPresent⟩ := present
  rw [List.mem_map] at mappedPresent
  obtain ⟨index, _indexPresent, pairEquality⟩ := mappedPresent
  cases pairEquality
  apply (input.moleculeGraph.mem_neighborFinset atom neighbor).mp
  exact (Finset.mem_sort (r := (· ≤ ·))).mp sourcePresent

/-- Canonical runtime enumeration and the generic proof-facing enumeration contain exactly the
same neighbor copies, differing only in list order. -/
theorem executableOfficialNeighborCopies_perm_officialNeighborCopies
    (input : CertifiedLocalizedCIPInput) (atom : input.Atom) :
    input.executableOfficialNeighborCopies atom ~
      input.moleculeGraph.officialNeighborCopies atom := by
  unfold executableOfficialNeighborCopies MoleculeGraph.officialNeighborCopies
  exact
    (Finset.sort_perm_toList (input.moleculeGraph.neighborFinset atom) (· ≤ ·)).flatMap_right
      (fun neighbor =>
        (List.range (input.moleculeGraph.bond atom neighbor)).map fun copyIndex =>
          (neighbor, copyIndex))

/-- Executable official child copies with the zero-index parent occurrence removed. -/
def executableOfficialChildCopies (input : CertifiedLocalizedCIPInput)
    (node : OfficialCIPNode input.Atom) : List (input.Atom × ℕ) :=
  match node.current? with
  | none => []
  | some current =>
      match node.parent? with
      | none => input.executableOfficialNeighborCopies current
      | some parent =>
          (input.executableOfficialNeighborCopies current).filter fun copy =>
            !(copy.1 == parent && copy.2 == 0)

/-- Runtime and proof-facing child-copy lists have the same multiplicities and provenance inputs. -/
theorem executableOfficialChildCopies_perm_officialChildCopies
    (input : CertifiedLocalizedCIPInput) (node : OfficialCIPNode input.Atom) :
    input.executableOfficialChildCopies node ~
      input.moleculeGraph.officialChildCopies node := by
  unfold executableOfficialChildCopies MoleculeGraph.officialChildCopies
  cases node.current? with
  | none => exact List.Perm.refl []
  | some current =>
      cases node.parent? with
      | none => exact input.executableOfficialNeighborCopies_perm_officialNeighborCopies current
      | some parent =>
          exact (input.executableOfficialNeighborCopies_perm_officialNeighborCopies current).filter
            (fun copy => !(copy.1 == parent && copy.2 == 0))

/-- Executable official children; duplicate and placeholder nodes remain terminal. -/
def executableOfficialCIPChildren (input : CertifiedLocalizedCIPInput)
    (node : OfficialCIPNode input.Atom) : List (OfficialCIPNode input.Atom) :=
  if node.isDuplicateLeaf then []
  else
    (input.executableOfficialChildCopies node).map fun copy =>
      node.extend copy.1 copy.2

/-- Runtime and proof-facing official children are the same provenance-bearing multiset. -/
theorem executableOfficialCIPChildren_perm_officialCIPChildren
    (input : CertifiedLocalizedCIPInput) (node : OfficialCIPNode input.Atom) :
    input.executableOfficialCIPChildren node ~
      input.moleculeGraph.officialCIPChildren node := by
  cases duplicate : node.isDuplicateLeaf with
  | true => simp [executableOfficialCIPChildren, MoleculeGraph.officialCIPChildren, duplicate]
  | false =>
    simp only [executableOfficialCIPChildren, MoleculeGraph.officialCIPChildren, duplicate,
      Bool.false_eq_true, ↓reduceIte]
    exact (input.executableOfficialChildCopies_perm_officialChildCopies node).map
      (fun copy => node.extend copy.1 copy.2)

/-- Every atom-bearing runtime child follows a positive graph edge. -/
theorem adj_of_mem_executableOfficialCIPChildren
    (input : CertifiedLocalizedCIPInput) (parent child : OfficialCIPNode input.Atom)
    (parentAtom childAtom : input.Atom)
    (parentObserved : parent.current? = some parentAtom)
    (childObserved : child.current? = some childAtom)
    (present : child ∈ input.executableOfficialCIPChildren parent) :
    input.moleculeGraph.Adj parentAtom childAtom := by
  by_cases duplicate : parent.isDuplicateLeaf = true
  · simp [executableOfficialCIPChildren, duplicate] at present
  · rw [executableOfficialCIPChildren, if_neg (by simpa using duplicate),
      List.mem_map] at present
    obtain ⟨copy, copyPresent, childIdentity⟩ := present
    rcases copy with ⟨neighbor, copyIndex⟩
    have neighborCopyPresent :
        (neighbor, copyIndex) ∈ input.executableOfficialNeighborCopies parentAtom := by
      unfold executableOfficialChildCopies at copyPresent
      rw [parentObserved] at copyPresent
      cases parentParentObserved : parent.parent? with
      | none => simpa [parentParentObserved] using copyPresent
      | some previous =>
          have filtered :
              (neighbor, copyIndex) ∈
                (input.executableOfficialNeighborCopies parentAtom).filter fun copy =>
                  !(copy.1 == previous && copy.2 == 0) := by
            simpa [parentParentObserved] using copyPresent
          exact List.mem_of_mem_filter filtered
    have neighborIdentity : neighbor = childAtom := by
      have currentEquality := congrArg OfficialCIPNode.current? childIdentity
      simp only [OfficialCIPNode.extend_current?] at currentEquality
      rw [childObserved] at currentEquality
      exact Option.some.inj currentEquality
    subst neighbor
    exact input.adj_of_mem_executableOfficialNeighborCopies
      parentAtom childAtom copyIndex neighborCopyPresent

/-- Every atom-bearing runtime child is backed by a positive semantic localized covalent record. -/
theorem executableOfficial_child_has_semantic_record
    (input : CertifiedLocalizedCIPInput) (parent child : OfficialCIPNode input.Atom)
    (parentAtom childAtom : input.Atom)
    (parentObserved : parent.current? = some parentAtom)
    (childObserved : child.current? = some childAtom)
    (present : child ∈ input.executableOfficialCIPChildren parent) :
    ∃ order,
      (semanticEdgeKey parentAtom.val childAtom.val, order) ∈
        input.certified.input.molecule.localizedCovalentRecords ∧ 0 < order := by
  have adjacent := input.adj_of_mem_executableOfficialCIPChildren parent child
    parentAtom childAtom parentObserved childObserved present
  have distinct : parentAtom ≠ childAtom := by
    intro equality
    subst childAtom
    simp [MoleculeGraph.Adj, input.moleculeGraph.bond_self] at adjacent
  exact (input.certified.input.molecule.toLocalizedMoleculeGraph_adj_iff_record
    input.graphReady parentAtom childAtom distinct).mp adjacent

/-- One executable breadth-first expansion step. -/
def executableOfficialCIPNextFrontier (input : CertifiedLocalizedCIPInput)
    (frontier : List (OfficialCIPNode input.Atom)) : List (OfficialCIPNode input.Atom) :=
  frontier.flatMap input.executableOfficialCIPChildren

/-- A runtime frontier step preserves the complete proof-facing child multiset, even when its input
frontier is already only permutation-equivalent to the proof-facing input. -/
theorem executableOfficialCIPNextFrontier_perm_officialCIPNextFrontier
    (input : CertifiedLocalizedCIPInput)
    {runtime reference : List (OfficialCIPNode input.Atom)}
    (sameFrontier : runtime ~ reference) :
    input.executableOfficialCIPNextFrontier runtime ~
      input.moleculeGraph.officialCIPNextFrontier reference := by
  unfold executableOfficialCIPNextFrontier MoleculeGraph.officialCIPNextFrontier
  exact sameFrontier.flatMap fun node _present =>
    input.executableOfficialCIPChildren_perm_officialCIPChildren node

/-- Runtime breadth-first frontier iteration. -/
def executableOfficialCIPFrontier (input : CertifiedLocalizedCIPInput) :
    ℕ → List (OfficialCIPNode input.Atom) → List (OfficialCIPNode input.Atom)
  | 0, frontier => frontier
  | fuel + 1, frontier =>
      input.executableOfficialCIPFrontier fuel
        (input.executableOfficialCIPNextFrontier frontier)

/-- At every depth, the runtime and proof-facing hierarchical digraphs contain exactly the same
provenance-bearing node multiset. -/
theorem executableOfficialCIPFrontier_perm_officialCIPFrontier
    (input : CertifiedLocalizedCIPInput) :
    ∀ fuel {runtime reference : List (OfficialCIPNode input.Atom)}, runtime ~ reference →
      input.executableOfficialCIPFrontier fuel runtime ~
        input.moleculeGraph.officialCIPFrontier fuel reference
  | 0, _runtime, _reference, sameFrontier => sameFrontier
  | fuel + 1, runtime, reference, sameFrontier => by
      exact input.executableOfficialCIPFrontier_perm_officialCIPFrontier fuel
        (input.executableOfficialCIPNextFrontier_perm_officialCIPNextFrontier sameFrontier)

/-! ## Retained legacy layer-major trace

The following declarations describe the historical per-node layer-major schedule. They are kept as
standalone executable facts for independent callers and are not used by `compareAt` below. -/

/-- Executable fuelled official comparison. Each compared layer is canonically sorted by the
official node order before its trace is inspected. -/
def executableOfficialHierarchicalDigraphTrace (input : CertifiedLocalizedCIPInput) :
    ℕ → List (OfficialCIPNode input.Atom) → List (OfficialCIPNode input.Atom) →
      List CIPRuleDecision
  | 0, _, _ => []
  | fuel + 1, left, right =>
      let layerTrace := input.moleculeGraph.compareOfficialLayerTrace left right
      if cipTraceOutcome layerTrace = Ordering.eq then
        layerTrace ++
          input.executableOfficialHierarchicalDigraphTrace fuel
            (input.executableOfficialCIPNextFrontier left)
            (input.executableOfficialCIPNextFrontier right)
      else layerTrace

/-- The executable canonical enumeration and the proof-facing arbitrary enumeration produce the
same complete hierarchical-digraph trace whenever their starting frontiers are permutations.
This uses layer-trace permutation invariance, not an assumption about the chosen enumeration. -/
theorem executableOfficialHierarchicalDigraphTrace_eq_reference
    (input : CertifiedLocalizedCIPInput) :
    ∀ fuel
      {runtimeLeft referenceLeft runtimeRight referenceRight :
        List (OfficialCIPNode input.Atom)},
      runtimeLeft ~ referenceLeft → runtimeRight ~ referenceRight →
      input.executableOfficialHierarchicalDigraphTrace fuel runtimeLeft runtimeRight =
        input.moleculeGraph.compareOfficialHierarchicalDigraphTrace
          fuel referenceLeft referenceRight
  | 0, _runtimeLeft, _referenceLeft, _runtimeRight, _referenceRight, _, _ => rfl
  | fuel + 1, runtimeLeft, referenceLeft, runtimeRight, referenceRight,
      leftPermutation, rightPermutation => by
      have layerEquality := input.moleculeGraph.compareOfficialLayerTrace_eq_of_perm
        leftPermutation rightPermutation
      have nextLeftPermutation :=
        input.executableOfficialCIPNextFrontier_perm_officialCIPNextFrontier leftPermutation
      have nextRightPermutation :=
        input.executableOfficialCIPNextFrontier_perm_officialCIPNextFrontier rightPermutation
      have nextEquality := input.executableOfficialHierarchicalDigraphTrace_eq_reference fuel
        nextLeftPermutation nextRightPermutation
      unfold executableOfficialHierarchicalDigraphTrace
        MoleculeGraph.compareOfficialHierarchicalDigraphTrace
      rw [layerEquality, nextEquality]

/-! ## Exhaustive rule-major comparison -/

/-- Executable rule-major key of one branch root, compiled by the shared
`MoleculeGraph.buildOfficialRuleMajorKey` over the executable child enumeration. -/
def buildExecutableRuleMajorKey (input : CertifiedLocalizedCIPInput) (fuel : ℕ)
    (node : OfficialCIPNode input.Atom) : Option (OfficialRuleMajorKey input.Atom) :=
  input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren fuel node

/-- The executable child enumeration exhausts every canonical ligand branch within the default
finite-atom depth bound. This follows from the proof-facing completeness theorem through the
child-enumeration permutation equivalence; it does not guess child completeness. -/
theorem executableExpansionComplete_default (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) :
    MoleculeGraph.OfficialExpansionCompleteWithin input.executableOfficialCIPChildren
      (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center index)) := by
  have reference :=
    input.moleculeGraph.officialExpansionCompleteWithin_rootFromEdge_default
      (center := center.1) (ligand := input.canonicalLigandAtom center index)
      ((input.detectedOneCenterMolecule center).ligandAtom_ne_center index)
  have same :=
    MoleculeGraph.officialExpansionCompleteWithin_iff_of_children_perm
      input.executableOfficialCIPChildren input.moleculeGraph.officialCIPChildren
      input.executableOfficialCIPChildren_perm_officialCIPChildren
      (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center index))
  exact same.mpr (by simpa using reference)

/-- Default-fuel executable key construction succeeds and marks every canonical ligand key
complete. This is the existence side needed for proof-backed extraction by the total engine. -/
theorem buildExecutableRuleMajorKey_complete_default
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) :
    ∃ key,
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center index)) = some key ∧
      key.complete = true := by
  unfold buildExecutableRuleMajorKey
  exact input.moleculeGraph.buildOfficialRuleMajorKey_complete_of_expansionCompleteWithin
    input.executableOfficialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center index))
    (input.executableExpansionComplete_default center index)

/-- Default-fuel reference key construction succeeds and marks every canonical ligand key
complete on the proof-facing child enumeration. Symmetric to
`buildExecutableRuleMajorKey_complete_default`; the completeness premise is the established
finite-atom frontier bound for the actual `rootFromEdge` root. -/
theorem buildReferenceRuleMajorKey_complete_default
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter) (index : Fin 4) :
    ∃ key,
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center index)) = some key ∧
      key.complete = true := by
  exact input.moleculeGraph.buildOfficialRuleMajorKey_complete_of_expansionCompleteWithin
    input.moleculeGraph.officialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center index))
    (input.moleculeGraph.officialExpansionCompleteWithin_rootFromEdge_default
      (center := center.1) (ligand := input.canonicalLigandAtom center index)
      (by
        have distinct := (input.detectedOneCenterMolecule center).ligandAtom_ne_center index
        simpa [detectedOneCenterMolecule] using distinct))

/-- Corrected canonical official comparison at a detected center.

Each canonical ligand root is compiled independently with the shared exhaustive rule-major
compiler. The two compiled keys must pass the completed-key gate
`OfficialRuleMajorKey.compare?`; the rule-tagged `OfficialRuleMajorKey.compareTrace` then supplies
the constitutional result, and only afterwards is the supplied Rule 3/4/5 context consulted.
`none` means a key build or the gate refused; it is never coerced to equality. -/
def compareAt (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) : Option CIPTraceCertificate :=
  input.moleculeGraph.compareRuleMajorRootsWithFuel input.executableOfficialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center left))
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center right))
    (context left) (context right)

/-- Compute `compareAt` once both actual roots have compiled to keys that pass the gate. -/
theorem compareAt_eq_some_of_compare?
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (leftKey rightKey : OfficialRuleMajorKey input.Atom)
    (leftComputed :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (rightComputed :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey)
    (outcome : Ordering)
    (compared : OfficialRuleMajorKey.compare? leftKey rightKey = some outcome) :
    input.compareAt center context left right =
      some (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace leftKey rightKey)
        (context left) (context right)) := by
  unfold compareAt MoleculeGraph.compareRuleMajorRootsWithFuel
    MoleculeGraph.ruleMajorConstitutionalTraceWithFuel
  simp only [buildExecutableRuleMajorKey] at leftComputed rightComputed
  simp only [leftComputed, rightComputed, compared, Option.map_some]

/-- At the default finite-atom fuel the corrected comparison never refuses on an actual detected
center: both roots compile to complete keys and complete keys always pass the gate. -/
theorem compareAt_isSome (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    (input.compareAt center context left right).isSome = true := by
  obtain ⟨leftKey, leftComputed, leftComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center left
  obtain ⟨rightKey, rightComputed, rightComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center right
  obtain ⟨outcome, compared⟩ := Option.isSome_iff_exists.mp
    (OfficialRuleMajorKey.compare?_isSome_of_complete leftKey rightKey
      leftComplete rightComplete)
  rw [input.compareAt_eq_some_of_compare? center context left right
    leftKey rightKey leftComputed rightComputed outcome compared]
  rfl

/-- An outcome observation on the bounded result is exactly a successful certificate with that
outcome. Downstream callers can extract the certificate instead of inspecting an `Option`. -/
@[simp] theorem compareAt_map_outcome_eq_some_iff
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) (outcome : Ordering) :
    (input.compareAt center context left right).map
        (fun certificate => certificate.outcome) = some outcome ↔
      ∃ certificate, input.compareAt center context left right = some certificate ∧
        certificate.outcome = outcome := by
  cases computed : input.compareAt center context left right with
  | none => simp
  | some certificate => simp

/-- A strict atomic-number difference at the two real ligand roots decides the corrected
exhaustive rule-major comparison immediately. In particular, no root-sphere Rule-2 isotope entry
can pre-empt this deeper Rule-1a result. -/
theorem compareAt_outcome_lt_of_root_atomicNumber_lt
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (atomicNumberLower :
      (input.certified.input.molecule.atoms.get
        (input.canonicalLigandAtom center left)).element.atomicNumber <
      (input.certified.input.molecule.atoms.get
        (input.canonicalLigandAtom center right)).element.atomicNumber) :
    (input.compareAt center context left right).map
        (fun certificate => certificate.outcome) = some Ordering.lt := by
  obtain ⟨leftMass, _leftMassObserved, leftLabel⟩ :=
    input.official_root_label_exact center.1 (input.canonicalLigandAtom center left)
  obtain ⟨rightMass, _rightMassObserved, rightLabel⟩ :=
    input.official_root_label_exact center.1 (input.canonicalLigandAtom center right)
  obtain ⟨leftKey, leftComputed, _leftComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center left
  obtain ⟨rightKey, rightComputed, _rightComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center right
  have leftComputedRaw :
      input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren
        (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey := by
    simpa [buildExecutableRuleMajorKey] using leftComputed
  have rightComputedRaw :
      input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren
        (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey := by
    simpa [buildExecutableRuleMajorKey] using rightComputed
  have leftHead :
      leftKey.rule1a.head? =
        some [([], (input.certified.input.molecule.atoms.get
          (input.canonicalLigandAtom center left)).element.atomicNumber)] := by
    have raw := input.moleculeGraph.buildOfficialRuleMajorKey_rule1a_head
      input.executableOfficialCIPChildren (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center left)) leftKey leftComputedRaw
    rw [raw, leftLabel]
    simp [ofLex_toLex]
  have rightHead :
      rightKey.rule1a.head? =
        some [([], (input.certified.input.molecule.atoms.get
          (input.canonicalLigandAtom center right)).element.atomicNumber)] := by
    have raw := input.moleculeGraph.buildOfficialRuleMajorKey_rule1a_head
      input.executableOfficialCIPChildren (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center right)) rightKey rightComputedRaw
    rw [raw, rightLabel]
    simp [ofLex_toLex]
  have layerLt :
      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftKey.rule1a rightKey.rule1a = Ordering.lt :=
    MoleculeGraph.officialRuleMajorKey_compare_rule1a_lt_of_heads_lt
      leftHead rightHead atomicNumberLower
  have decisive :
      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftKey.rule1a rightKey.rule1a ≠ Ordering.eq := by
    rw [layerLt]
    decide
  have traceLt :
      cipTraceOutcome (OfficialRuleMajorKey.compareTrace leftKey rightKey) = Ordering.lt := by
    rw [OfficialRuleMajorKey.compareTrace_outcome_eq_rule1a_of_decisive
      leftKey rightKey decisive]
    exact layerLt
  have compared :
      OfficialRuleMajorKey.compare? leftKey rightKey = some Ordering.lt := by
    simp [OfficialRuleMajorKey.compare?, layerLt]
  have computed := input.compareAt_eq_some_of_compare? center context left right
    leftKey rightKey leftComputed rightComputed Ordering.lt compared
  have certificateOutcome :
      (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace leftKey rightKey)
        (context left) (context right)).outcome = Ordering.lt := by
    rw [CIPRuleEngine.compareDigraphThenOfficialCertificate_outcome]
    rw [CIPRuleEngine.compareDigraphThenOfficialTrace_outcome_of_digraph_ne_eq
      (digraphTrace := OfficialRuleMajorKey.compareTrace leftKey rightKey)
      (by rw [traceLt]; decide)]
    exact traceLt
  rw [computed]
  simp only [Option.map_some]
  exact congrArg some certificateOutcome

/-- Reverse strict atomic-number priority decides the corrected comparison as `gt`. -/
theorem compareAt_outcome_gt_of_root_atomicNumber_gt
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (atomicNumberHigher :
      (input.certified.input.molecule.atoms.get
        (input.canonicalLigandAtom center right)).element.atomicNumber <
      (input.certified.input.molecule.atoms.get
        (input.canonicalLigandAtom center left)).element.atomicNumber) :
    (input.compareAt center context left right).map
        (fun certificate => certificate.outcome) = some Ordering.gt := by
  obtain ⟨leftMass, _leftMassObserved, leftLabel⟩ :=
    input.official_root_label_exact center.1 (input.canonicalLigandAtom center left)
  obtain ⟨rightMass, _rightMassObserved, rightLabel⟩ :=
    input.official_root_label_exact center.1 (input.canonicalLigandAtom center right)
  obtain ⟨leftKey, leftComputed, _leftComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center left
  obtain ⟨rightKey, rightComputed, _rightComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center right
  have leftComputedRaw :
      input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren
        (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey := by
    simpa [buildExecutableRuleMajorKey] using leftComputed
  have rightComputedRaw :
      input.moleculeGraph.buildOfficialRuleMajorKey input.executableOfficialCIPChildren
        (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey := by
    simpa [buildExecutableRuleMajorKey] using rightComputed
  have leftHead :
      leftKey.rule1a.head? =
        some [([], (input.certified.input.molecule.atoms.get
          (input.canonicalLigandAtom center left)).element.atomicNumber)] := by
    have raw := input.moleculeGraph.buildOfficialRuleMajorKey_rule1a_head
      input.executableOfficialCIPChildren (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center left)) leftKey leftComputedRaw
    rw [raw, leftLabel]
    simp [ofLex_toLex]
  have rightHead :
      rightKey.rule1a.head? =
        some [([], (input.certified.input.molecule.atoms.get
          (input.canonicalLigandAtom center right)).element.atomicNumber)] := by
    have raw := input.moleculeGraph.buildOfficialRuleMajorKey_rule1a_head
      input.executableOfficialCIPChildren (Fintype.card input.Atom + 1)
      (OfficialCIPNode.rootFromEdge center.1
        (input.canonicalLigandAtom center right)) rightKey rightComputedRaw
    rw [raw, rightLabel]
    simp [ofLex_toLex]
  have layerGt :
      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftKey.rule1a rightKey.rule1a = Ordering.gt :=
    MoleculeGraph.officialRuleMajorKey_compare_rule1a_gt_of_heads_gt
      leftHead rightHead atomicNumberHigher
  have decisive :
      OfficialRuleMajorKey.compareSparseLayers OfficialRuleMajorKey.compareNat
        leftKey.rule1a rightKey.rule1a ≠ Ordering.eq := by
    rw [layerGt]
    decide
  have traceGt :
      cipTraceOutcome (OfficialRuleMajorKey.compareTrace leftKey rightKey) = Ordering.gt := by
    rw [OfficialRuleMajorKey.compareTrace_outcome_eq_rule1a_of_decisive
      leftKey rightKey decisive]
    exact layerGt
  have compared :
      OfficialRuleMajorKey.compare? leftKey rightKey = some Ordering.gt := by
    simp [OfficialRuleMajorKey.compare?, layerGt]
  have computed := input.compareAt_eq_some_of_compare? center context left right
    leftKey rightKey leftComputed rightComputed Ordering.gt compared
  have certificateOutcome :
      (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace leftKey rightKey)
        (context left) (context right)).outcome = Ordering.gt := by
    rw [CIPRuleEngine.compareDigraphThenOfficialCertificate_outcome]
    rw [CIPRuleEngine.compareDigraphThenOfficialTrace_outcome_of_digraph_ne_eq
      (digraphTrace := OfficialRuleMajorKey.compareTrace leftKey rightKey)
      (by rw [traceGt]; decide)]
    exact traceGt
  rw [computed]
  simp only [Option.map_some]
  exact congrArg some certificateOutcome

/-- Comparing one canonical ligand with itself ties through the completed rule-major
constitutional result and the identical supplied later-rule context. -/
@[simp] theorem compareAt_outcome_self (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (index : Fin 4) :
    (input.compareAt center context index index).map
        (fun certificate => certificate.outcome) = some Ordering.eq := by
  obtain ⟨key, computed, complete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center index
  haveI : Std.TransCmp (@OfficialRuleMajorKey.compare input.Atom) :=
    OfficialRuleMajorKey.compare_transCmp
  have selfCompare : OfficialRuleMajorKey.compare key key = Ordering.eq :=
    Std.ReflCmp.compare_self
  have compared : OfficialRuleMajorKey.compare? key key = some Ordering.eq := by
    obtain ⟨outcome, outcomeComputed⟩ := Option.isSome_iff_exists.mp
      (OfficialRuleMajorKey.compare?_isSome_of_complete key key complete complete)
    have outcomeEq : outcome = Ordering.eq := by
      have total :=
        OfficialRuleMajorKey.compare_eq_of_compare?_eq_some key key outcome outcomeComputed
      exact total.symm.trans selfCompare
    simpa [outcomeEq] using outcomeComputed
  have computedAt := input.compareAt_eq_some_of_compare? center context index index
    key key computed computed Ordering.eq compared
  have certificateOutcome :
      (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace key key)
        (context index) (context index)).outcome = Ordering.eq := by
    rw [CIPRuleEngine.compareDigraphThenOfficialCertificate_outcome]
    have traceEq :
        cipTraceOutcome (OfficialRuleMajorKey.compareTrace key key) = Ordering.eq := by
      rw [OfficialRuleMajorKey.compareTrace_outcome]
      exact selfCompare
    rw [CIPRuleEngine.compareDigraphThenOfficialTrace_outcome_of_digraph_eq traceEq]
    exact CIPRuleEngine.compareOfficialContextTrace_self (context index)
  rw [computedAt]
  simp only [Option.map_some]
  exact congrArg some certificateOutcome

/-- Bounded corrected reference comparison on the proof-facing enumeration. -/
noncomputable def referenceCompareAtWithFuel? (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) : Option CIPTraceCertificate :=
  (input.detectedOneCenterMolecule center).cipOfficialCompareWithFuel context
    (Fintype.card input.Atom + 1) left right

/-- The corrected total official comparator on the proof-facing child enumeration. This is the
reference implementation, not the runtime enumeration; it is total by proof-backed extraction at
the finite-atom bound. -/
noncomputable def referenceCompareAt (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) : CIPTraceCertificate :=
  (input.detectedOneCenterMolecule center).cipOfficialCompare context left right

/-- The bounded reference computation is exactly the total reference result. -/
theorem referenceCompareAtWithFuel?_eq_some (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    input.referenceCompareAtWithFuel? center context left right =
      some (input.referenceCompareAt center context left right) := by
  simpa [referenceCompareAt, referenceCompareAtWithFuel?] using
    (input.detectedOneCenterMolecule center).cipOfficialCompareWithFuel_default_eq_some
      context left right

/-! ## Unconditional runtime / reference coherence at the default fuel

The two child enumerations are pointwise permutations.  At the default bound both actual builds
are complete, so the projection-fidelity theorem applies to every pair of roots without a
success premise: the constitutional `compareTrace` is identical, and transporting it through the
unchanged Rule 3/4/5 context identifies the certificates. -/

/-- The runtime sorted enumeration and the proof-facing enumeration compile the same physical
ligand root to keys with the same sorting-visible constitution.  Provenance (`sourceNodes`) order
is deliberately not constrained. -/
theorem buildExecutableRuleMajorKey_sameConstitution_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (index : Fin 4)
    (runtimeKey referenceKey : OfficialRuleMajorKey input.Atom)
    (runtimeComputed :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center index)) = some runtimeKey)
    (referenceComputed :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center index)) = some referenceKey) :
    CompilerProjectionFidelity.SameConstitution runtimeKey referenceKey :=
  CompilerProjectionFidelity.build_sameConstitution_of_children_perm
    input.moleculeGraph
    input.executableOfficialCIPChildren
    input.moleculeGraph.officialCIPChildren
    input.executableOfficialCIPChildren_perm_officialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center index))
    runtimeKey referenceKey
    (by simpa [buildExecutableRuleMajorKey] using runtimeComputed)
    referenceComputed

/-- Pair-level constitutional trace agreement across the runtime and proof-facing child
enumerations.  All four builds are actual successful builds at the default fuel; the conclusion is
projection equality of the rule-tagged traces, not whole-key equality. -/
theorem compareTrace_eq_reference_of_children_perm
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (left right : Fin 4)
    (runtimeLeft runtimeRight referenceLeft referenceRight : OfficialRuleMajorKey input.Atom)
    (runtimeLeftComputed :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some runtimeLeft)
    (runtimeRightComputed :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some runtimeRight)
    (referenceLeftComputed :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some referenceLeft)
    (referenceRightComputed :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some referenceRight) :
    OfficialRuleMajorKey.compareTrace runtimeLeft runtimeRight =
      OfficialRuleMajorKey.compareTrace referenceLeft referenceRight :=
  CompilerProjectionFidelity.compareTrace_eq_of_children_perm
    input.moleculeGraph
    input.executableOfficialCIPChildren
    input.moleculeGraph.officialCIPChildren
    input.executableOfficialCIPChildren_perm_officialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center left))
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center right))
    runtimeLeft referenceLeft runtimeRight referenceRight
    (by simpa [buildExecutableRuleMajorKey] using runtimeLeftComputed)
    referenceLeftComputed
    (by simpa [buildExecutableRuleMajorKey] using runtimeRightComputed)
    referenceRightComputed

/-- Compute the bounded reference comparison once both reference roots have compiled to keys that
pass the gate.  This mirrors `compareAt_eq_some_of_compare?` on the proof-facing enumeration. -/
theorem referenceCompareAtWithFuel?_eq_some_of_compare?
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (leftKey rightKey : OfficialRuleMajorKey input.Atom)
    (leftComputed :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (rightComputed :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey)
    (outcome : Ordering)
    (compared : OfficialRuleMajorKey.compare? leftKey rightKey = some outcome) :
    input.referenceCompareAtWithFuel? center context left right =
      some (CIPRuleEngine.compareDigraphThenOfficialCertificate
        (OfficialRuleMajorKey.compareTrace leftKey rightKey)
        (context left) (context right)) := by
  have generic := MoleculeGraph.compareRuleMajorRootsWithFuel_eq_some_of_compare?
    input.moleculeGraph input.moleculeGraph.officialCIPChildren
    (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center left))
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center right))
    (context left) (context right) leftKey rightKey
    leftComputed rightComputed outcome compared
  simpa [referenceCompareAtWithFuel?,
    OneCenterMolecule.cipOfficialCompareWithFuel, detectedOneCenterMolecule] using generic

/-- **Unconditional default-fuel runtime/reference certificate identity.**

The executable sorted enumeration and the proof-facing enumeration are pointwise permutations;
both actual roots compile to complete keys at `Fintype.card Atom + 1`; the projection-fidelity
theorem therefore identifies the rule-tagged constitutional traces, and the unchanged Rule 3/4/5
context transport yields the same certificate on both sides.  No whole-key equality and no
outcome premise is used or needed. -/
theorem compareAt_eq_referenceCompareAt
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    input.compareAt center context left right =
      some (input.referenceCompareAt center context left right) := by
  obtain ⟨runtimeLeft, runtimeLeftComputed, runtimeLeftComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center left
  obtain ⟨runtimeRight, runtimeRightComputed, runtimeRightComplete⟩ :=
    input.buildExecutableRuleMajorKey_complete_default center right
  obtain ⟨referenceLeft, referenceLeftComputed, referenceLeftComplete⟩ :=
    input.buildReferenceRuleMajorKey_complete_default center left
  obtain ⟨referenceRight, referenceRightComputed, referenceRightComplete⟩ :=
    input.buildReferenceRuleMajorKey_complete_default center right
  have traceEq :
      OfficialRuleMajorKey.compareTrace runtimeLeft runtimeRight =
        OfficialRuleMajorKey.compareTrace referenceLeft referenceRight :=
    input.compareTrace_eq_reference_of_children_perm center left right
      runtimeLeft runtimeRight referenceLeft referenceRight
      runtimeLeftComputed runtimeRightComputed
      referenceLeftComputed referenceRightComputed
  obtain ⟨runtimeOutcome, runtimeCompared⟩ := Option.isSome_iff_exists.mp
    (OfficialRuleMajorKey.compare?_isSome_of_complete
      runtimeLeft runtimeRight runtimeLeftComplete runtimeRightComplete)
  obtain ⟨referenceOutcome, referenceCompared⟩ := Option.isSome_iff_exists.mp
    (OfficialRuleMajorKey.compare?_isSome_of_complete
      referenceLeft referenceRight referenceLeftComplete referenceRightComplete)
  have runtimeEq :
      input.compareAt center context left right =
        some (CIPRuleEngine.compareDigraphThenOfficialCertificate
          (OfficialRuleMajorKey.compareTrace runtimeLeft runtimeRight)
          (context left) (context right)) :=
    input.compareAt_eq_some_of_compare? center context left right
      runtimeLeft runtimeRight runtimeLeftComputed runtimeRightComputed
      runtimeOutcome runtimeCompared
  have referenceEq :
      input.referenceCompareAtWithFuel? center context left right =
        some (CIPRuleEngine.compareDigraphThenOfficialCertificate
          (OfficialRuleMajorKey.compareTrace referenceLeft referenceRight)
          (context left) (context right)) :=
    input.referenceCompareAtWithFuel?_eq_some_of_compare? center context left right
      referenceLeft referenceRight referenceLeftComputed referenceRightComputed
      referenceOutcome referenceCompared
  have bounded := input.referenceCompareAtWithFuel?_eq_some center context left right
  rw [referenceEq, ← traceEq] at bounded
  rw [runtimeEq]
  exact congrArg some (Option.some.inj bounded)

/-- Unconditional runtime/reference identity against the bounded reference computation. -/
theorem compareAt_eq_referenceCompareAtWithFuel_default
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    input.compareAt center context left right =
      input.referenceCompareAtWithFuel? center context left right := by
  rw [input.compareAt_eq_referenceCompareAt center context left right,
    input.referenceCompareAtWithFuel?_eq_some]

/-- The observed outcome of the runtime comparison is the observed outcome of the reference
comparison.  This is the bridge consumed by the unconditional order surface below. -/
theorem compareAt_outcome_eq_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    (input.compareAt center context left right).map
        (fun certificate => certificate.outcome) =
      some ((input.referenceCompareAt center context left right).outcome) := by
  rw [input.compareAt_eq_referenceCompareAt center context left right]
  rfl

/-- Conditional cross-enumeration bridge: if the runtime and proof-facing enumerations compile the
two roots to the same complete-key pair, the runtime comparison equals the bounded reference
computation.  Retained for callers that want an explicit key-equality form; the unconditional
`compareAt_eq_referenceCompareAt` above no longer needs it. -/
theorem compareAt_eq_referenceCompareAtWithFuel_of_keys
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (leftKey rightKey : OfficialRuleMajorKey input.Atom)
    (runtimeLeft :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (runtimeRight :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey)
    (referenceLeft :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (referenceRight :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey) :
    input.compareAt center context left right =
      input.referenceCompareAtWithFuel? center context left right := by
  have generic := MoleculeGraph.compareRuleMajorRootsWithFuel_eq_of_key_equalities
    input.moleculeGraph input.executableOfficialCIPChildren
    input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center left))
    (OfficialCIPNode.rootFromEdge center.1
      (input.canonicalLigandAtom center right))
    (context left) (context right) leftKey rightKey
    (by simpa [buildExecutableRuleMajorKey] using runtimeLeft)
    (by simpa [buildExecutableRuleMajorKey] using runtimeRight)
    referenceLeft referenceRight
  simpa [compareAt, referenceCompareAtWithFuel?,
    OneCenterMolecule.cipOfficialCompareWithFuel, detectedOneCenterMolecule] using generic

/-- Conditional cross-enumeration bridge to the total reference comparison. -/
theorem compareAt_eq_referenceCompareAt_of_keys
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4)
    (leftKey rightKey : OfficialRuleMajorKey input.Atom)
    (runtimeLeft :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (runtimeRight :
      input.buildExecutableRuleMajorKey (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey)
    (referenceLeft :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center left)) = some leftKey)
    (referenceRight :
      input.moleculeGraph.buildOfficialRuleMajorKey
        input.moleculeGraph.officialCIPChildren (Fintype.card input.Atom + 1)
        (OfficialCIPNode.rootFromEdge center.1
          (input.canonicalLigandAtom center right)) = some rightKey) :
    input.compareAt center context left right =
      some (input.referenceCompareAt center context left right) := by
  rw [input.compareAt_eq_referenceCompareAtWithFuel_of_keys center context left right
    leftKey rightKey runtimeLeft runtimeRight referenceLeft referenceRight,
    input.referenceCompareAtWithFuel?_eq_some]

/-! ## Option-aware order and refusal surface -/

/-- One distinct pair is resolved when the corrected bounded comparison succeeds and is decisive. -/
def ligandPairResolvedAt? (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) : Bool :=
  match input.compareAt center context left right with
  | none => false
  | some certificate => decide (certificate.outcome ≠ Ordering.eq)

/-- Characteristic equivalence for one pair: resolution means a successful, decisive certificate. -/
@[simp] theorem ligandPairResolvedAt?_eq_true_iff
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    input.ligandPairResolvedAt? center context left right = true ↔
      ∃ certificate, input.compareAt center context left right = some certificate ∧
        certificate.outcome ≠ Ordering.eq := by
  unfold ligandPairResolvedAt?
  cases computed : input.compareAt center context left right with
  | none => simp
  | some certificate => simp

/-- Executable descending ligand order. Index order breaks an exact comparison tie, and a refused
comparison falls back to index order only to keep the list deterministic; a caller must check
`resolvedAt?` before interpreting the order chemically. -/
def ligandBeforeAt (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) : Bool :=
  match input.compareAt center context left right with
  | none => decide (left ≤ right)
  | some certificate =>
      match certificate.outcome with
      | Ordering.gt => true
      | Ordering.lt => false
      | Ordering.eq => decide (left ≤ right)

def ligandOrderAt (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) : List (Fin 4) :=
  (List.finRange 4).mergeSort (input.ligandBeforeAt center context)

theorem ligandOrderAt_perm_finRange (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    (input.ligandOrderAt center context).Perm (List.finRange 4) := by
  classical
  simpa [ligandOrderAt] using
    (List.mergeSort_perm (List.finRange 4) (input.ligandBeforeAt center context))

theorem ligandOrderAt_length (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    (input.ligandOrderAt center context).length = 4 := by
  classical
  have := (input.ligandOrderAt_perm_finRange center context).length_eq
  simpa [List.length_finRange] using this

theorem ligandOrderAt_nodup (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    (input.ligandOrderAt center context).Nodup := by
  classical
  exact (List.nodup_finRange 4).perm
    (input.ligandOrderAt_perm_finRange center context).symm

theorem ligandOrderAt_mem (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) (index : Fin 4) :
    index ∈ input.ligandOrderAt center context := by
  classical
  exact ((input.ligandOrderAt_perm_finRange center context).mem_iff).2
    (List.mem_finRange index)

/-- Executable refusal check: every distinct ligand pair must compile and compare decisively.
A refused comparison is not treated as a tie or as an equality certificate. -/
def resolvedAt? (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) : Bool :=
  decide (∀ left right : Fin 4, left ≠ right →
    (input.compareAt center context left right).map
      (fun certificate => certificate.outcome) ≠ some Ordering.eq)

@[simp] theorem resolvedAt?_eq_true_iff (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    input.resolvedAt? center context = true ↔
      ∀ left right : Fin 4, left ≠ right →
        (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) ≠ some Ordering.eq := by
  simp [resolvedAt?]

/-- Executable safe ligand order. Ties and refused comparisons return `none`; no proof-irrelevant
permutation object is needed on the runtime path. -/
def ligandOrderAt? (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) : Option (List (Fin 4)) :=
  if input.resolvedAt? center context then some (input.ligandOrderAt center context) else none

theorem ligandOrderAt?_eq_some_of_resolved (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (resolved : input.resolvedAt? center context = true) :
    input.ligandOrderAt? center context = some (input.ligandOrderAt center context) := by
  simp [ligandOrderAt?, resolved]

@[simp] theorem ligandOrderAt?_isSome_iff_resolved (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    (input.ligandOrderAt? center context).isSome = true ↔
      ∀ left right : Fin 4, left ≠ right →
        (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) ≠ some Ordering.eq := by
  rw [← input.resolvedAt?_eq_true_iff center context]
  cases observed : input.resolvedAt? center context <;>
    simp [ligandOrderAt?, observed]

/-- Safe official ligand permutation built from the executable order list. -/
noncomputable def ligandPermutationAt (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) : Equiv.Perm (Fin 4) := by
  classical
  let order : List (Fin 4) := input.ligandOrderAt center context
  have hlen : order.length = 4 := by
    simpa [order] using input.ligandOrderAt_length center context
  have hnodup : order.Nodup := by
    simpa [order] using input.ligandOrderAt_nodup center context
  have hmem : ∀ i : Fin 4, i ∈ order := by
    intro i
    simpa [order] using input.ligandOrderAt_mem center context i
  exact ((Fin.castOrderIso hlen.symm).toEquiv).trans
    (List.Nodup.getEquivOfForallMemList order hnodup hmem)

/-- Safe official ligand permutation at a detected center, refusing unresolved priorities. -/
noncomputable def ligandPermutationAt? (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    Option (Equiv.Perm (Fin 4)) :=
  (input.detectedOneCenterMolecule center).cipOfficialPermutation? context

/-- The safe permutation succeeds exactly when every distinct ligand pair receives a decisive
corrected rule-major plus context comparison. -/
theorem ligandPermutationAt?_isSome_iff_resolved
    (input : CertifiedLocalizedCIPInput) (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    (input.ligandPermutationAt? center context).isSome = true ↔
      ∀ left right : Fin 4, left ≠ right →
        (input.referenceCompareAt center context left right).outcome ≠ Ordering.eq := by
  simpa [OneCenterMolecule.ResolvedOfficialCIP, referenceCompareAt] using
    (input.detectedOneCenterMolecule center).cipOfficialPermutation?_isSome_iff_resolved
      context

/-! ## Conditional reference coherence for the order surface

Retained from the preceding candidate: the following theorems take the pairwise outcome
coherence as an explicit hypothesis.  The unconditional versions below discharge it through
`compareAt_outcome_eq_reference`. -/

theorem ligandBeforeAt_eq_reference_of_outcomes
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (same : ∀ left right : Fin 4,
      (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) =
        some ((input.referenceCompareAt center context left right).outcome))
    (left right : Fin 4) :
    input.ligandBeforeAt center context left right =
      (input.detectedOneCenterMolecule center).cipOfficialBefore context left right := by
  unfold ligandBeforeAt OneCenterMolecule.cipOfficialBefore
  have observed := same left right
  cases computed : input.compareAt center context left right with
  | none =>
      have contradiction : False := by
        rw [computed] at observed
        simp at observed
      exact False.elim contradiction
  | some certificate =>
      have outcomeEq : certificate.outcome =
          ((input.detectedOneCenterMolecule center).cipOfficialCompare
            context left right).outcome := by
        simpa [computed, referenceCompareAt] using observed
      simp only []
      rw [outcomeEq]
      rfl

theorem ligandOrderAt_eq_reference_of_outcomes
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (same : ∀ left right : Fin 4,
      (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) =
        some ((input.referenceCompareAt center context left right).outcome)) :
    input.ligandOrderAt center context =
      (input.detectedOneCenterMolecule center).cipOfficialOrder context := by
  unfold ligandOrderAt OneCenterMolecule.cipOfficialOrder
  congr 1
  funext left right
  exact input.ligandBeforeAt_eq_reference_of_outcomes center context same left right

theorem resolvedAt?_eq_reference_of_outcomes
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (same : ∀ left right : Fin 4,
      (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) =
        some ((input.referenceCompareAt center context left right).outcome)) :
    input.resolvedAt? center context = true ↔
      (input.detectedOneCenterMolecule center).ResolvedOfficialCIP context := by
  rw [input.resolvedAt?_eq_true_iff center context]
  have bridge :
      (∀ left right : Fin 4, left ≠ right →
        (input.compareAt center context left right).map
            (fun certificate => certificate.outcome) ≠ some Ordering.eq) ↔
      (∀ left right : Fin 4, left ≠ right →
        (input.referenceCompareAt center context left right).outcome ≠ Ordering.eq) := by
    constructor
    · intro decided left right distinct equalOutcome
      exact decided left right distinct (by rw [same left right, equalOutcome])
    · intro decided left right distinct mappedEqual
      have someEq :
          some ((input.referenceCompareAt center context left right).outcome) =
            some Ordering.eq := by
        rw [← same left right]
        exact mappedEqual
      exact decided left right distinct (Option.some.inj someEq)
  simpa [OneCenterMolecule.ResolvedOfficialCIP, referenceCompareAt] using bridge

theorem ligandOrderAt?_eq_reference_of_outcomes
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (same : ∀ left right : Fin 4,
      (input.compareAt center context left right).map
          (fun certificate => certificate.outcome) =
        some ((input.referenceCompareAt center context left right).outcome)) :
    input.ligandOrderAt? center context =
      (input.detectedOneCenterMolecule center).cipOfficialOrder? context := by
  classical
  by_cases resolved : (input.detectedOneCenterMolecule center).ResolvedOfficialCIP context
  · have executableResolved : input.resolvedAt? center context = true :=
      (input.resolvedAt?_eq_reference_of_outcomes center context same).mpr resolved
    simp [ligandOrderAt?, executableResolved, OneCenterMolecule.cipOfficialOrder?, resolved,
      input.ligandOrderAt_eq_reference_of_outcomes center context same]
  · have executableUnresolved : input.resolvedAt? center context = false := by
      cases observed : input.resolvedAt? center context with
      | false => rfl
      | true =>
          exact False.elim (resolved
            ((input.resolvedAt?_eq_reference_of_outcomes center context same).mp observed))
    simp [ligandOrderAt?, executableUnresolved, OneCenterMolecule.cipOfficialOrder?, resolved]

/-! ## Unconditional reference coherence for the order surface

These are the final default results.  `compareAt` and `referenceCompareAt` produce the same
certificate at the finite-atom bound, so the executable order, the refusal boundary and the safe
permutation coincide with the proof-facing official API with no residual premise. -/

/-- Executable and reference comparisons induce the same deterministic pairwise ordering. -/
theorem ligandBeforeAt_eq_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext)
    (left right : Fin 4) :
    input.ligandBeforeAt center context left right =
      (input.detectedOneCenterMolecule center).cipOfficialBefore context left right :=
  input.ligandBeforeAt_eq_reference_of_outcomes center context
    (input.compareAt_outcome_eq_reference center context) left right

/-- The complete executable ligand ordering equals the proof-facing official ordering. -/
theorem ligandOrderAt_eq_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    input.ligandOrderAt center context =
      (input.detectedOneCenterMolecule center).cipOfficialOrder context :=
  input.ligandOrderAt_eq_reference_of_outcomes center context
    (input.compareAt_outcome_eq_reference center context)

/-- Executable and proof-facing APIs have exactly the same applicability boundary for a safe
four-ligand priority order. -/
theorem resolvedAt_iff_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    input.resolvedAt? center context = true ↔
      (input.detectedOneCenterMolecule center).ResolvedOfficialCIP context :=
  input.resolvedAt?_eq_reference_of_outcomes center context
    (input.compareAt_outcome_eq_reference center context)

/-- The safe executable order, including refusal, is exactly the proof-facing official safe order.
This is the signature consumed by `AuthoritativeLocalizedTetrahedralDescriptor`. -/
theorem ligandOrderAt?_eq_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    input.ligandOrderAt? center context =
      (input.detectedOneCenterMolecule center).cipOfficialOrder? context :=
  input.ligandOrderAt?_eq_reference_of_outcomes center context
    (input.compareAt_outcome_eq_reference center context)

/-- The safe executable permutation, including refusal, is exactly the proof-facing official safe
permutation. -/
theorem ligandPermutationAt?_eq_reference
    (input : CertifiedLocalizedCIPInput)
    (center : input.TetrahedralCenter)
    (context : Fin 4 → CIPRuleEngine.OfficialLigandRuleContext) :
    input.ligandPermutationAt? center context =
      (input.detectedOneCenterMolecule center).cipOfficialPermutation? context :=
  rfl

