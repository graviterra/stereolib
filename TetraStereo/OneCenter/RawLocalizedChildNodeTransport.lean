/-
  Raw/localized child NODE transport.

  ## Purpose

  `RawLocalizedChildCopyTransport` proves that the raw canonical child-copy enumeration and the
  executable localized child-copy enumeration are permutations, preserving every
  `(atom, copyIndex)` pair, under the source-intake agreement and the explicit
  `NoOxidoRootEdgeHistory` domain.  That theorem is stated on *copies*.  This module lifts it to
  the two actual node constructors that consume those copies:

  * `OfficialCIPNode.extend` (official hierarchical digraph), and
  * `RawMolecule.canonicalChildOfCopy` (the canonical branch constructor, definitionally the body
    of `RawMolecule.canonicalChildren`; re-stated as
    `Rule1bRepresentedAtomObservation.canonicalChildOfCopy`).

  ## What is defined

  `NodeCorresponds toRaw official canonical` is the local correspondence between an official node
  and a canonical branch node at a fixed raw-index map `toRaw : V → ℕ`.  It preserves

  * the current atom (`official.current?.map toRaw = some canonical.atom`),
  * the full mapped history (`official.history.map toRaw = canonical.history`),
  * the real / ring-duplicate / multiple-bond-duplicate provenance, including the stored duplicate
    distances, and
  * the parent convention: `official.parent? = none` exactly when the canonical node is a root
    marker `canonical.parent = canonical.atom`; otherwise the official parent maps to
    `canonical.parent`.

  It also records the actual-node path invariant `official.history.head? = official.current?`,
  which holds for every root and every generated child and is needed to transport the parent
  convention through `extend`.  It is a structural invariant of corresponding nodes, not a
  conclusion about any descriptor or comparison.

  ## What is proved

  * `NodeCorresponds` transports the stored total Rule-1b observation
    (`rule1bRootDistance`, the 2018-profile total distance used by the production constructors),
    the represented-atom 2013 observer (`officialRepresentedSphere?` /
    `canonicalRepresentedSphere?`), and the total represented 2013 observation
    (`officialSourceObservation2013` / `canonicalSourceObservation2013`).
  * The constructor step is closed: a corresponding copy produces corresponding children
    (`nodeCorresponds_extend_childOfCopy`), with equal provenance (including the stored ring
    duplicate distance and positive-copy attachment distance), equal forced-leaf / duplicate-leaf
    flags, and equal observations.
  * The existing copy permutation is lifted by `.map` to a genuine permutation of canonical child
    nodes (the canonical shadows of the official children), and to a `List.Forall₂` correspondence
    on aligned copy enumerations.  Multiplicity is preserved through `countP`, including a
    predicate-respecting version stated directly on the official child nodes.
  * The original root, which the existing copy theorem excludes because it requires
    `parent? = some parent`, is handled separately.  A canonical root marker uses
    `parent = atom`; the erased copy `(atom, 0)` cannot occur in the seed enumeration because
    `bondOrder atom atom = 0`, so the canonical parent erase is inert exactly when the official
    node has `parent? = none`.
  * Generated-child closure: every emitted official child corresponds to the canonical child of
    the same mapped copy, and the canonical node lists are related by permutation / `countP`.

  ## Explicit limits

  The domain is exactly the intake/`NoOxidoRootEdgeHistory` domain of the existing copy theorem;
  no oxido or aromatic exception coverage is added or claimed.  No list equality, key equality or
  comparator equality is assumed: the only enumeration statement used is the existing `List.Perm`
  theorem (their orders genuinely differ).  Complete key transport is left to future work; this
  module stops at nodes, provenance, observations and multiplicity.

  Every public theorem is guarded by `assert_kernel_only`.
-/

import TetraStereo.OneCenter.RawLocalizedChildCopyTransport
import TetraStereo.OneCenter.Rule1bRepresentedAtomObservation

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace TetraStereo
namespace OneCenter
namespace RawLocalizedChildNodeTransport

variable {V : Type*} [DecidableEq V]

/-! ## Local node correspondence -/

/-- Provenance correspondence between an official digraph node and a canonical branch node.

  These are exactly the provenance classes produced by the two child constructors together with
  the real-atom root.  Explicit placeholder/phantom leaves are not generated by the constructors
  and are therefore outside the constructor transport; no oxido or aromatic exception is added. -/
inductive NodeProvenanceCorresponds :
    OfficialCIPNodeProvenance → RawMolecule.CanonicalNodeProvenance → Prop where
  | realAtom :
      NodeProvenanceCorresponds OfficialCIPNodeProvenance.realAtom
        RawMolecule.CanonicalNodeProvenance.realAtom
  | multipleBondDuplicate (distance : ℕ) :
      NodeProvenanceCorresponds
        (OfficialCIPNodeProvenance.multipleBondDuplicate distance)
        (RawMolecule.CanonicalNodeProvenance.multipleBondDuplicate distance)
  | ringDuplicate (distance : ℕ) :
      NodeProvenanceCorresponds
        (OfficialCIPNodeProvenance.ringDuplicate distance)
        (RawMolecule.CanonicalNodeProvenance.ringDuplicate distance)

/-- First-index transport for a raw-index map.  Stated before the node-correspondence lemmas
because the duplicate-distance transport uses it. -/
theorem firstIndexOf?_eq_firstNatIndex?_map (toRaw : V → ℕ)
    (hinj : Function.Injective toRaw) (target : V) :
    ∀ values : List V,
      firstIndexOf? target values =
        RawMolecule.firstNatIndex? (toRaw target) (values.map toRaw)
  | [] => rfl
  | value :: values => by
      by_cases hhead : value = target
      · rw [hhead]
        simp [firstIndexOf?, RawMolecule.firstNatIndex?]
      · have hne : toRaw value ≠ toRaw target := fun equal => hhead (hinj equal)
        simp [firstIndexOf?, RawMolecule.firstNatIndex?, hhead, hne,
          firstIndexOf?_eq_firstNatIndex?_map toRaw hinj target values]

/-- Local correspondence between an official hierarchical-digraph node and a raw canonical branch
node at a fixed raw-index map `toRaw`.

The `head` field is the actual-node path invariant that the current atom is the head of the stored
history.  It holds for the official root and is preserved by `OfficialCIPNode.extend`; it is needed
to transport the parent convention (whose canonical side is `parent = atom` for a root) through the
child constructor. -/
structure NodeCorresponds (toRaw : V → ℕ) (official : OfficialCIPNode V)
    (canonical : RawMolecule.CanonicalBranchNode) : Prop where
  /-- The current atom is mapped to the canonical node's atom. -/
  current : official.current?.map toRaw = some canonical.atom
  /-- The full official history maps to the canonical history. -/
  history : official.history.map toRaw = canonical.history
  /-- Actual-node path invariant: the current atom is the head of the stored history. -/
  head : official.history.head? = official.current?
  /-- Real / ring / multiple provenance with equal stored distances. -/
  provenance : NodeProvenanceCorresponds official.provenance canonical.provenance
  /-- Parent convention: `none` exactly for the canonical self-parent root marker. -/
  parent : official.parent?.map toRaw =
    if canonical.parent = canonical.atom then none else some canonical.parent

namespace NodeCorresponds

/-- A corresponding official node has an observed current atom. -/
theorem exists_current {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    ∃ atom, official.current? = some atom := by
  cases hcurrent : official.current? with
  | none =>
      have hnone : (none : Option ℕ) = some canonical.atom := by
        simpa [hcurrent] using h.current
      cases hnone
  | some atom => exact ⟨atom, rfl⟩

/-- Corresponding nodes have the same depth. -/
theorem depth_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    official.depth = canonical.depth := by
  unfold OfficialCIPNode.depth RawMolecule.CanonicalBranchNode.depth
  have hlen : official.history.length = canonical.history.length := by
    rw [← List.length_map (f := toRaw), h.history]
  rw [hlen]

/-- Membership transport along the mapped full history. -/
theorem mem_iff {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (atom : V) :
    toRaw atom ∈ canonical.history ↔ atom ∈ official.history := by
  rw [← h.history, List.mem_map]
  constructor
  · rintro ⟨other, hother, hmap⟩
    rwa [hinj hmap] at hother
  · intro hmem
    exact ⟨atom, hmem, rfl⟩

/-- Boolean membership transport along the mapped full history. -/
theorem contains_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (atom : V) :
    canonical.history.contains (toRaw atom) = official.history.contains atom := by
  by_cases hmem : toRaw atom ∈ canonical.history
  · have hmemOfficial : atom ∈ official.history := (h.mem_iff hinj atom).mp hmem
    simp [List.contains_eq_mem, hmem, hmemOfficial]
  · have hmemOfficial : atom ∉ official.history := by
      intro hc
      exact hmem ((h.mem_iff hinj atom).mpr hc)
    simp [List.contains_eq_mem, hmem, hmemOfficial]

/-- The canonical history starts at the canonical atom. -/
theorem history_head? {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    canonical.history.head? = some canonical.atom := by
  rw [← h.history, List.head?_map, h.head, h.current]

/-- Root relation: the official parent is absent exactly when the canonical node is the
self-parent root marker. -/
theorem parent_eq_none_iff_selfParent {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    official.parent? = none ↔ canonical.parent = canonical.atom := by
  constructor
  · intro hnone
    have hmap := h.parent
    rw [hnone] at hmap
    simp only [Option.map_none] at hmap
    by_cases hself : canonical.parent = canonical.atom
    · exact hself
    · rw [if_neg hself] at hmap
      cases hmap
  · intro hself
    have hmap : official.parent?.map toRaw = none := by
      simpa [hself] using h.parent
    cases hparent : official.parent? with
    | none => rfl
    | some parent =>
        rw [hparent] at hmap
        cases hmap

/-- Stored duplicate distances agree: the official `duplicateRootDistance` is the canonical
`canonicalHistoryDistance` at the mapped atom.  This is the distance used by ring duplicates and by
backward multiple-bond copies. -/
theorem duplicateRootDistance_eq_canonicalHistoryDistance {toRaw : V → ℕ}
    {official : OfficialCIPNode V} {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (atom : V) :
    official.duplicateRootDistance atom =
      RawMolecule.canonicalHistoryDistance canonical (toRaw atom) := by
  unfold OfficialCIPNode.duplicateRootDistance RawMolecule.canonicalHistoryDistance
  have hreverse : canonical.history.reverse = official.history.reverse.map toRaw := by
    rw [← h.history, List.map_reverse]
  have hfirst : firstIndexOf? atom official.history.reverse =
      RawMolecule.firstNatIndex? (toRaw atom) canonical.history.reverse := by
    rw [hreverse]
    exact firstIndexOf?_eq_firstNatIndex?_map toRaw hinj atom official.history.reverse
  rw [hfirst, h.depth_eq]

/-- Option-level represented-atom observer agreement (the 2013 represented sphere). -/
theorem representedSphere?_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw) :
    Rule1bRepresentedAtomObservation.officialRepresentedSphere? official =
      Rule1bRepresentedAtomObservation.canonicalRepresentedSphere? canonical := by
  obtain ⟨atom, hcurrent⟩ := h.exists_current
  have hto : toRaw atom = canonical.atom := by
    have := h.current
    rw [hcurrent] at this
    simpa using this
  have hofficial :
      Rule1bRepresentedAtomObservation.officialRepresentedSphere? official =
        firstIndexOf? atom official.history.reverse := by
    simp [Rule1bRepresentedAtomObservation.officialRepresentedSphere?, hcurrent]
  have hcanonical :
      Rule1bRepresentedAtomObservation.canonicalRepresentedSphere? canonical =
        RawMolecule.firstNatIndex? canonical.atom canonical.history.reverse := rfl
  have hreverse : canonical.history.reverse = official.history.reverse.map toRaw := by
    rw [← h.history, List.map_reverse]
  rw [hofficial, hcanonical, hreverse, ← hto]
  exact firstIndexOf?_eq_firstNatIndex?_map toRaw hinj atom official.history.reverse

/-- Total represented-atom 2013 observer agreement. -/
theorem representedSphere_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw) :
    Rule1bRepresentedAtomObservation.officialRepresentedSphere official =
      Rule1bRepresentedAtomObservation.canonicalRepresentedSphere canonical := by
  rw [Rule1bRepresentedAtomObservation.officialRepresentedSphere_eq_getD,
    Rule1bRepresentedAtomObservation.canonicalRepresentedSphere_eq_getD,
    h.representedSphere?_eq hinj, h.depth_eq]

end NodeCorresponds

/-! ## Observation transport -/

/-- Stored Rule-1b observation read from provenance and depth.  This value-level presentation is
definitionally the stored observation and lets provenance be destructed as an ordinary variable. -/
def officialRule1bValues (depth : ℕ) : OfficialCIPNodeProvenance → ℕ
  | .realAtom => depth
  | .multipleBondDuplicate distance => distance
  | .ringDuplicate distance => distance
  | .placeholder _ distance => distance

/-- Canonical counterpart of `officialRule1bValues`, in the branch order of the canonical
definition. -/
def canonicalRule1bValues (depth : ℕ) : RawMolecule.CanonicalNodeProvenance → ℕ
  | .multipleBondDuplicate distance => distance
  | .ringDuplicate distance => distance
  | .phantom distance => distance
  | .realAtom => depth

/-- Stored continuous 2013 observation read from provenance, depth and represented sphere. -/
def officialObservationValues (depth sphere : ℕ) : OfficialCIPNodeProvenance → ℕ
  | .realAtom => depth
  | .multipleBondDuplicate _ => sphere
  | .ringDuplicate _ => sphere
  | .placeholder _ distance => distance

/-- Canonical counterpart of `officialObservationValues`. -/
def canonicalObservationValues (depth sphere : ℕ) : RawMolecule.CanonicalNodeProvenance → ℕ
  | .realAtom => depth
  | .multipleBondDuplicate _ => sphere
  | .ringDuplicate _ => sphere
  | .phantom distance => distance

/-- The official stored Rule-1b observation is the value-level reading of provenance and depth. -/
theorem official_rule1bRootDistance_values (node : OfficialCIPNode V) :
    node.rule1bRootDistance = officialRule1bValues node.depth node.provenance := by
  cases hprov : node.provenance <;>
    simp [OfficialCIPNode.rule1bRootDistance, officialRule1bValues, hprov]

/-- The canonical stored Rule-1b observation is the value-level reading of provenance and depth. -/
theorem canonical_rule1bRootDistance_values (node : RawMolecule.CanonicalBranchNode) :
    node.rule1bRootDistance = canonicalRule1bValues node.depth node.provenance := by
  cases hprov : node.provenance <;>
    simp [RawMolecule.CanonicalBranchNode.rule1bRootDistance, canonicalRule1bValues, hprov]

/-- The official total 2013 observation is the value-level reading of provenance, depth and the
represented sphere. -/
theorem official_sourceObservation2013_values (node : OfficialCIPNode V) :
    Rule1bRepresentedAtomObservation.officialSourceObservation2013 node =
      officialObservationValues node.depth
        (Rule1bRepresentedAtomObservation.officialRepresentedSphere node) node.provenance := by
  cases hprov : node.provenance <;>
    simp [Rule1bRepresentedAtomObservation.officialSourceObservation2013,
      officialObservationValues, hprov]

/-- The canonical total 2013 observation is the value-level reading of provenance, depth and the
represented sphere. -/
theorem canonical_sourceObservation2013_values (node : RawMolecule.CanonicalBranchNode) :
    Rule1bRepresentedAtomObservation.canonicalSourceObservation2013 node =
      canonicalObservationValues node.depth
        (Rule1bRepresentedAtomObservation.canonicalRepresentedSphere node) node.provenance := by
  cases hprov : node.provenance <;>
    simp [Rule1bRepresentedAtomObservation.canonicalSourceObservation2013,
      canonicalObservationValues, hprov]

/-- Corresponding provenances have equal stored Rule-1b distances once the depths agree. -/
theorem provenance_rule1bValues_eq {depthO depthC : ℕ} (hdepth : depthO = depthC)
    {provenanceO : OfficialCIPNodeProvenance}
    {provenanceC : RawMolecule.CanonicalNodeProvenance}
    (hprov : NodeProvenanceCorresponds provenanceO provenanceC) :
    officialRule1bValues depthO provenanceO =
      canonicalRule1bValues depthC provenanceC := by
  cases hprov <;> simp [officialRule1bValues, canonicalRule1bValues, hdepth]

/-- Corresponding provenances have equal total 2013 observations once depths and represented
spheres agree. -/
theorem provenance_observationValues_eq {depthO depthC sphereO sphereC : ℕ}
    (hdepth : depthO = depthC) (hsphere : sphereO = sphereC)
    {provenanceO : OfficialCIPNodeProvenance}
    {provenanceC : RawMolecule.CanonicalNodeProvenance}
    (hprov : NodeProvenanceCorresponds provenanceO provenanceC) :
    officialObservationValues depthO sphereO provenanceO =
      canonicalObservationValues depthC sphereC provenanceC := by
  cases hprov <;> simp [officialObservationValues, canonicalObservationValues, hdepth, hsphere]

/-- Total stored Rule-1b observation (the 2018-profile distance used by the production
constructors) is the same on corresponding nodes. -/
theorem rule1bRootDistance_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    official.rule1bRootDistance = canonical.rule1bRootDistance := by
  rw [official_rule1bRootDistance_values, canonical_rule1bRootDistance_values]
  exact provenance_rule1bValues_eq h.depth_eq h.provenance

/-- Total represented 2013 observation is the same on corresponding nodes. -/
theorem sourceObservation2013_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw) :
    Rule1bRepresentedAtomObservation.officialSourceObservation2013 official =
      Rule1bRepresentedAtomObservation.canonicalSourceObservation2013 canonical := by
  rw [official_sourceObservation2013_values, canonical_sourceObservation2013_values,
    h.representedSphere_eq hinj]
  exact provenance_observationValues_eq h.depth_eq rfl h.provenance

/-! ## Constructor correspondence -/

/-- Provenance of the two child constructors corresponds whenever the parent nodes correspond.

The ring-duplicate case uses the transported duplicate distance; the positive-copy case uses the
transported depth.  The canonical constructor's membership test is the Boolean history `contains`,
which is transported by `NodeCorresponds.contains_eq`. -/
theorem provenance_child {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) :
    NodeProvenanceCorresponds (official.extend next copyIndex).provenance
      (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
        (toRaw next, copyIndex)).provenance := by
  by_cases hcopy : copyIndex = 0
  · subst hcopy
    by_cases hmem : next ∈ official.history
    · have hmemCanonical : toRaw next ∈ canonical.history :=
        (h.mem_iff hinj next).mpr hmem
      have hofficial : (official.extend next 0).provenance =
          OfficialCIPNodeProvenance.ringDuplicate (official.duplicateRootDistance next) := by
        simp [OfficialCIPNode.extend, OfficialCIPNode.childProvenance, hmem]
      have hcanonical :=
        Rule1bRepresentedAtomObservation.canonicalChildOfCopy_provenance_ring canonical
          (toRaw next, 0) rfl hmemCanonical
      rw [hofficial, hcanonical,
        h.duplicateRootDistance_eq_canonicalHistoryDistance hinj next]
      exact NodeProvenanceCorresponds.ringDuplicate _
    · have hmemCanonical : toRaw next ∉ canonical.history := by
        intro hc
        exact hmem ((h.mem_iff hinj next).mp hc)
      have hofficial : (official.extend next 0).provenance =
          OfficialCIPNodeProvenance.realAtom := by
        simp [OfficialCIPNode.extend, OfficialCIPNode.childProvenance, hmem]
      have hcanonical :=
        Rule1bRepresentedAtomObservation.canonicalChildOfCopy_provenance_real canonical
          (toRaw next, 0) rfl hmemCanonical
      rw [hofficial, hcanonical]
      exact NodeProvenanceCorresponds.realAtom
  · have hdepth := h.depth_eq
    have hofficial : (official.extend next copyIndex).provenance =
        OfficialCIPNodeProvenance.multipleBondDuplicate official.depth := by
      simp [OfficialCIPNode.extend, OfficialCIPNode.childProvenance, hcopy]
    have hcanonical :=
      Rule1bRepresentedAtomObservation.canonicalChildOfCopy_provenance_positive canonical
        (toRaw next, copyIndex) (fun equal => hcopy equal)
    rw [hofficial, hcanonical, hdepth]
    exact NodeProvenanceCorresponds.multipleBondDuplicate _

/-- Extending a node makes the stored history head its immediate parent. -/
theorem extend_parent?_eq_history_head? (node : OfficialCIPNode V) (next : V)
    (copyIndex : ℕ) :
    (node.extend next copyIndex).parent? = node.history.head? := by
  cases hhist : node.history with
  | nil => simp [OfficialCIPNode.parent?, OfficialCIPNode.extend, hhist]
  | cons first rest => simp [OfficialCIPNode.parent?, OfficialCIPNode.extend, hhist]

/-- Constructor closure of the node correspondence: an official `extend` child corresponds to the
canonical child of the same mapped copy.  The hypothesis `toRaw next ≠ canonical.atom` excludes a
self-copy (the erased parent copy); every emitted copy satisfies it in a well-formed molecule. -/
theorem nodeCorresponds_extend_childOfCopy {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) (hnextNe : toRaw next ≠ canonical.atom) :
    NodeCorresponds toRaw (official.extend next copyIndex)
      (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
        (toRaw next, copyIndex)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [OfficialCIPNode.extend, Rule1bRepresentedAtomObservation.canonicalChildOfCopy]
  · simp [OfficialCIPNode.extend, Rule1bRepresentedAtomObservation.canonicalChildOfCopy,
      h.history]
  · simp [OfficialCIPNode.extend]
  · exact provenance_child h hinj next copyIndex
  · have hchildParent :
        (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
          (toRaw next, copyIndex)).parent = canonical.atom := by
      simp [Rule1bRepresentedAtomObservation.canonicalChildOfCopy]
    have hchildAtom :
        (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
          (toRaw next, copyIndex)).atom = toRaw next := by
      simp [Rule1bRepresentedAtomObservation.canonicalChildOfCopy]
    have hne : canonical.atom ≠ toRaw next := fun equal => hnextNe equal.symm
    rw [hchildParent, hchildAtom]
    calc
      (official.extend next copyIndex).parent?.map toRaw
          = official.history.head?.map toRaw := by
              rw [extend_parent?_eq_history_head?]
      _ = official.current?.map toRaw := by rw [h.head]
      _ = some canonical.atom := h.current
      _ = (if canonical.atom = toRaw next then none else some canonical.atom) := by
              simp [hne]

/-- Canonical forced-leaf status read from provenance, as a function. -/
def canonicalDuplicateLeaf : RawMolecule.CanonicalNodeProvenance → Bool
  | .realAtom => false
  | _ => true

/-- Official duplicate-leaf status and canonical forced-leaf status agree on corresponding
provenances. -/
theorem provenance_isDuplicateLeaf_eq {provenanceO : OfficialCIPNodeProvenance}
    {provenanceC : RawMolecule.CanonicalNodeProvenance}
    (hprov : NodeProvenanceCorresponds provenanceO provenanceC) :
    OfficialCIPNodeProvenance.isDuplicateLeaf provenanceO =
      canonicalDuplicateLeaf provenanceC := by
  cases hprov <;> rfl

/-- **Forced leaf / duplicate leaf.**  A generated canonical child is a forced leaf exactly when the
corresponding official child is a duplicate leaf.  Both flags are read from the constructor-assigned
provenance, and `provenance_child` shows that the two provenances correspond. -/
theorem forcedLeaf_child {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) :
    (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
        (toRaw next, copyIndex)).forcedLeaf =
      (official.extend next copyIndex).isDuplicateLeaf := by
  unfold RawMolecule.CanonicalBranchNode.forcedLeaf OfficialCIPNode.isDuplicateLeaf
  exact (provenance_isDuplicateLeaf_eq (provenance_child h hinj next copyIndex)).symm

/-- Node-level leaf agreement: a corresponding canonical node is a forced leaf exactly when the
official node is a duplicate leaf.  The provenance relation is restricted to the three
constructor-generated classes, so this is not asserted for explicit placeholder/phantom leaves. -/
theorem node_forcedLeaf_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) :
    canonical.forcedLeaf = official.isDuplicateLeaf := by
  unfold RawMolecule.CanonicalBranchNode.forcedLeaf OfficialCIPNode.isDuplicateLeaf
  exact (provenance_isDuplicateLeaf_eq h.provenance).symm

/-! ### Observations on generated children -/

/-- The total stored 2018-profile Rule-1b observation agrees on generated children. -/
theorem child_rule1bRootDistance_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) (hnextNe : toRaw next ≠ canonical.atom) :
    (official.extend next copyIndex).rule1bRootDistance =
      (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
        (toRaw next, copyIndex)).rule1bRootDistance :=
  rule1bRootDistance_eq
    (nodeCorresponds_extend_childOfCopy h hinj next copyIndex hnextNe)

/-- The represented-atom 2013 observer agrees on generated children. -/
theorem child_representedSphere?_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) (hnextNe : toRaw next ≠ canonical.atom) :
    Rule1bRepresentedAtomObservation.officialRepresentedSphere?
        (official.extend next copyIndex) =
      Rule1bRepresentedAtomObservation.canonicalRepresentedSphere?
        (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
          (toRaw next, copyIndex)) :=
  NodeCorresponds.representedSphere?_eq
    (nodeCorresponds_extend_childOfCopy h hinj next copyIndex hnextNe) hinj

/-- The total represented 2013 observation agrees on generated children. -/
theorem child_sourceObservation2013_eq {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (next : V) (copyIndex : ℕ) (hnextNe : toRaw next ≠ canonical.atom) :
    Rule1bRepresentedAtomObservation.officialSourceObservation2013
        (official.extend next copyIndex) =
      Rule1bRepresentedAtomObservation.canonicalSourceObservation2013
        (Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
          (toRaw next, copyIndex)) :=
  sourceObservation2013_eq
    (nodeCorresponds_extend_childOfCopy h hinj next copyIndex hnextNe) hinj

/-! ## Root convention and the root seed bridge -/

/-- Canonical root marker with the local parent convention `parent = atom`.

This is the canonical partner of an official root whose `parent? = none`.  The production raw
expansion never needs to build this node itself; it is the canonical local representative used to
state the root copy bridge. -/
def canonicalSelfParentRoot (atom : ℕ) : RawMolecule.CanonicalBranchNode where
  atom := atom
  parent := atom
  history := [atom]
  provenance := RawMolecule.CanonicalNodeProvenance.realAtom

/-- The official root corresponds to the canonical self-parent root marker. -/
theorem root_corresponds (toRaw : V → ℕ) (atom : V) :
    NodeCorresponds toRaw (OfficialCIPNode.root atom)
      (canonicalSelfParentRoot (toRaw atom)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [OfficialCIPNode.root, canonicalSelfParentRoot]
  · simp [OfficialCIPNode.root, canonicalSelfParentRoot]
  · simp [OfficialCIPNode.root]
  · exact NodeProvenanceCorresponds.realAtom
  · simp [OfficialCIPNode.root, OfficialCIPNode.parent?, canonicalSelfParentRoot]

/-- No self copy occurs in the raw seed enumeration: `bondOrder atom atom = 0`, so the range of copy
indices at the atom itself is empty.  This is what makes erasing `(atom, 0)` inert for a canonical
root marker `parent = atom`. -/
theorem selfCopy_not_mem_canonicalSeedCopies (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) (wellFormed : mol.WellFormed) :
    (node.atom, 0) ∉ mol.canonicalSeedCopies node := by
  intro hmem
  have hinfo :=
    (RawMolecule.mem_canonicalSeedCopies_iff mol node wellFormed node.atom 0).mp hmem
  rw [RawMolecule.bondOrder_self] at hinfo
  exact Nat.lt_irrefl 0 hinfo.1

/-- For a canonical self-parent root marker the real-parent erase is inert, so the canonical child
copies are exactly the seed copies. -/
theorem canonicalChildCopies_eq_seed_of_selfParent (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) (wellFormed : mol.WellFormed)
    (selfParent : node.parent = node.atom) :
    mol.canonicalChildCopies node = mol.canonicalSeedCopies node := by
  rw [RawMolecule.canonicalChildCopies_eq_erase_seed,
    RawMolecule.eraseCanonicalParentCopy_eq_erase, selfParent,
    List.erase_eq_self_iff]
  exact selfCopy_not_mem_canonicalSeedCopies mol node wellFormed

/-- For an official root (`parent? = none`) the executable child copies are exactly the seed
copies: the parent-copy filter is not applied. -/
theorem executableOfficialChildCopies_eq_seed_of_parentNone
    (input : CertifiedLocalizedCIPInput) (onode : OfficialCIPNode input.Atom)
    (current : input.Atom) (currentObserved : onode.current? = some current)
    (parentNone : onode.parent? = none) :
    input.executableOfficialChildCopies onode = input.executableSeedCopies current := by
  simp only [CertifiedLocalizedCIPInput.executableOfficialChildCopies, currentObserved,
    parentNone]
  exact CertifiedLocalizedCIPInput.executableOfficialNeighborCopies_eq_seed input current

/-- **Root seed bridge.**  The existing copy transport theorem requires `parent? = some parent` and
therefore excludes the original root.  When the canonical node is the local self-parent root marker
and the official parents is absent, both child-copy enumerations reduce to their seed
enumerations; the seed permutation then gives the root copy transport. -/
theorem canonicalChildCopies_perm_executableOfficialChildCopies_root
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (selfParent : node.parent = node.atom)
    (noOxido : NoOxidoRootEdgeHistory mol node) :
    List.Perm
      ((input.executableOfficialChildCopies onode).map
        (fun copy => (copy.1.val, copy.2)))
      (mol.canonicalChildCopies node) := by
  have hofficial := executableOfficialChildCopies_eq_seed_of_parentNone input onode
    (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩) currentObserved parentNone
  have hcanonical := canonicalChildCopies_eq_seed_of_selfParent mol node wellFormed selfParent
  have hseed := canonicalSeedCopies_perm_executableSeedCopies mol input agreement wellFormed
    unique supported node atomBound noOxido
  rw [hofficial, hcanonical]
  exact hseed.symm

/-! ## Child-node lists -/

/-- Official child nodes for an executable copy enumeration. -/
def executableOfficialChildNodes (input : CertifiedLocalizedCIPInput)
    (node : OfficialCIPNode input.Atom) : List (OfficialCIPNode input.Atom) :=
  (input.executableOfficialChildCopies node).map fun copy => node.extend copy.1 copy.2

/-- Canonical child nodes for a canonical copy enumeration. -/
def canonicalChildNodes (mol : RawMolecule) (node : RawMolecule.CanonicalBranchNode) :
    List RawMolecule.CanonicalBranchNode :=
  (mol.canonicalChildCopies node).map
    (Rule1bRepresentedAtomObservation.canonicalChildOfCopy node)

/-- At a non-duplicate-leaf official node the executable child list is the child-node list. -/
theorem executableOfficialCIPChildren_eq_childNodes_of_not_duplicate
    (input : CertifiedLocalizedCIPInput) (node : OfficialCIPNode input.Atom)
    (notDuplicate : node.isDuplicateLeaf = false) :
    input.executableOfficialCIPChildren node = executableOfficialChildNodes input node := by
  simp [CertifiedLocalizedCIPInput.executableOfficialCIPChildren,
    executableOfficialChildNodes, notDuplicate]

/-- At a non-forced-leaf canonical node `canonicalChildren` is the child-node list. -/
theorem canonicalChildren_eq_childNodes_of_not_forcedLeaf (mol : RawMolecule)
    (node : RawMolecule.CanonicalBranchNode) (notForced : node.forcedLeaf = false) :
    mol.canonicalChildren node = canonicalChildNodes mol node := by
  rw [Rule1bRepresentedAtomObservation.canonicalChildren_eq_map_canonicalChildOfCopy]
  simp [canonicalChildNodes, notForced]

/-- **`Forall₂` constructor lift.**  On an aligned copy enumeration every official child is related
to the canonical child of the same mapped copy. -/
theorem officialChildNodes_forall₂_shadows {toRaw : V → ℕ} {official : OfficialCIPNode V}
    {canonical : RawMolecule.CanonicalBranchNode}
    (h : NodeCorresponds toRaw official canonical) (hinj : Function.Injective toRaw)
    (copies : List (V × ℕ))
    (hnoSelf : ∀ copy ∈ copies, toRaw copy.1 ≠ canonical.atom) :
    List.Forall₂ (NodeCorresponds toRaw)
      (copies.map fun copy => official.extend copy.1 copy.2)
      (copies.map fun copy =>
        Rule1bRepresentedAtomObservation.canonicalChildOfCopy canonical
          (toRaw copy.1, copy.2)) := by
  induction copies with
  | nil => exact List.Forall₂.nil
  | cons copy rest ih =>
      exact List.Forall₂.cons
        (nodeCorresponds_extend_childOfCopy h hinj copy.1 copy.2
          (hnoSelf copy (by simp)))
        (ih (fun other hmem => hnoSelf other (List.mem_cons_of_mem copy hmem)))

/-! ## Production no-self-edge facts -/

/-- A neighbor copy is never a copy of the current atom itself: the localized graph has zero
diagonal bond order. -/
theorem neighbor_val_ne_current_val (input : CertifiedLocalizedCIPInput)
    (current neighbor : input.Atom) (copyIndex : ℕ)
    (present : (neighbor, copyIndex) ∈ input.executableOfficialNeighborCopies current) :
    neighbor.val ≠ current.val := by
  have adjacent := input.adj_of_mem_executableOfficialNeighborCopies current neighbor copyIndex
    present
  intro hval
  have hsame : neighbor = current := Fin.ext hval
  rw [hsame] at adjacent
  have hzero : input.moleculeGraph.bond current current = 0 :=
    input.moleculeGraph.bond_self current
  unfold MoleculeGraph.Adj at adjacent
  rw [hzero] at adjacent
  exact Nat.lt_irrefl 0 adjacent

/-- Every executable official child copy stays away from the current atom. -/
theorem officialChildCopy_val_ne_current (input : CertifiedLocalizedCIPInput)
    (onode : OfficialCIPNode input.Atom) (current : input.Atom)
    (currentObserved : onode.current? = some current)
    {neighbor : input.Atom} {copyIndex : ℕ}
    (present : (neighbor, copyIndex) ∈ input.executableOfficialChildCopies onode) :
    neighbor.val ≠ current.val := by
  have neighborPresent :
      (neighbor, copyIndex) ∈ input.executableOfficialNeighborCopies current := by
    simp only [CertifiedLocalizedCIPInput.executableOfficialChildCopies, currentObserved]
      at present
    cases hparent : onode.parent? with
    | none => simpa [hparent] using present
    | some parent =>
        have hconj : (neighbor, copyIndex) ∈ input.executableOfficialNeighborCopies current ∧
            (¬ neighbor = parent ∨ ¬ copyIndex = 0) := by
          simpa [hparent] using present
        exact hconj.1
  exact neighbor_val_ne_current_val input current neighbor copyIndex neighborPresent

/-- In the production correspondence the mapped copy neighbor is not the canonical atom, so the
constructor closure applies to every emitted copy. -/
theorem productionCopy_noSelf (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    {neighbor : input.Atom} {copyIndex : ℕ}
    (present : (neighbor, copyIndex) ∈ input.executableOfficialChildCopies onode) :
    neighbor.val ≠ node.atom := by
  have hne := officialChildCopy_val_ne_current input onode
    (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩) currentObserved present
  simpa [localizedIndexOf] using hne

/-! ## Lifting the copy permutation to child nodes -/

/-- **Actual child-NODE permutation (parent observed).**  Mapping the existing copy permutation
through the canonical child constructor gives a genuine `List.Perm` of canonical child nodes: the
canonical shadows of the official child enumeration permute the canonical child-node enumeration.
No equality of the enumerations as lists is used. -/
theorem productionChildNodeShadows_perm
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node) :
    List.Perm
      ((input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2)))
      (canonicalChildNodes mol node) := by
  have hcopy := canonicalChildCopies_perm_executableOfficialChildCopies mol input agreement
    wellFormed unique supported node onode atomBound parentBound currentObserved parentObserved
    noOxido
  have hmapped := hcopy.map (Rule1bRepresentedAtomObservation.canonicalChildOfCopy node)
  simpa [canonicalChildNodes, List.map_map, Function.comp_def] using hmapped

/-- **Actual child-NODE permutation (root).**  The root seed bridge gives the same child-node
permutation for an official root and a canonical self-parent root marker. -/
theorem productionRootChildNodeShadows_perm
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node) :
    List.Perm
      ((input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2)))
      (canonicalChildNodes mol node) := by
  have hself : node.parent = node.atom :=
    (NodeCorresponds.parent_eq_none_iff_selfParent hcorr).mp parentNone
  have hcopy := canonicalChildCopies_perm_executableOfficialChildCopies_root mol input agreement
    wellFormed unique supported node onode atomBound currentObserved parentNone hself noOxido
  have hmapped := hcopy.map (Rule1bRepresentedAtomObservation.canonicalChildOfCopy node)
  simpa [canonicalChildNodes, List.map_map, Function.comp_def] using hmapped

/-! ## Combined leaf-aware child endpoint -/

/-- **Combined production child endpoint (parent observed, leaf-aware).**  There is an aligned
canonical list of the *actual* official child nodes that is pointwise `NodeCorresponds`-related to
those official nodes and is a permutation of the *actual* canonical child list.  At a duplicate
leaf both enumerations are empty; at an expandable node the alignment is the existing copy
permutation lifted through both constructors.  This is the endpoint needed for a recursive key
bridge; it asserts no output, list or key equality. -/
theorem productionCIPChildren_forall₂_canonicalChildren
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node) :
    ∃ alignedCanonical : List RawMolecule.CanonicalBranchNode,
      List.Forall₂ (NodeCorresponds (fun atom : input.Atom => atom.val))
        (input.executableOfficialCIPChildren onode) alignedCanonical ∧
      List.Perm alignedCanonical (mol.canonicalChildren node) := by
  cases hleaf : onode.isDuplicateLeaf with
  | true =>
      have hforced : node.forcedLeaf = true := by
        rw [node_forcedLeaf_eq hcorr, hleaf]
      exact ⟨[], by simp [CertifiedLocalizedCIPInput.executableOfficialCIPChildren, hleaf],
        by simp [RawMolecule.canonicalChildren, hforced]⟩
  | false =>
      have hforced : node.forcedLeaf = false := by
        rw [node_forcedLeaf_eq hcorr, hleaf]
      refine ⟨(input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2)), ?_, ?_⟩
      · have hchildren : input.executableOfficialCIPChildren onode =
            (input.executableOfficialChildCopies onode).map
              (fun copy => onode.extend copy.1 copy.2) := by
          simp [CertifiedLocalizedCIPInput.executableOfficialCIPChildren, hleaf]
        rw [hchildren]
        have hnoSelf : ∀ copy ∈ input.executableOfficialChildCopies onode,
            (fun atom : input.Atom => atom.val) copy.1 ≠ node.atom :=
          fun copy hmem =>
            productionCopy_noSelf mol input agreement node onode atomBound currentObserved hmem
        simpa using
          officialChildNodes_forall₂_shadows hcorr Fin.val_injective
            (input.executableOfficialChildCopies onode) hnoSelf
      · simpa [canonicalChildren_eq_childNodes_of_not_forcedLeaf mol node hforced] using
          productionChildNodeShadows_perm mol input agreement wellFormed unique supported node
            onode atomBound parentBound currentObserved parentObserved noOxido

/-- **Combined production child endpoint (root, leaf-aware).**  The root counterpart of
`productionCIPChildren_forall₂_canonicalChildren`, using the separate root seed bridge. -/
theorem productionRootCIPChildren_forall₂_canonicalChildren
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node) :
    ∃ alignedCanonical : List RawMolecule.CanonicalBranchNode,
      List.Forall₂ (NodeCorresponds (fun atom : input.Atom => atom.val))
        (input.executableOfficialCIPChildren onode) alignedCanonical ∧
      List.Perm alignedCanonical (mol.canonicalChildren node) := by
  cases hleaf : onode.isDuplicateLeaf with
  | true =>
      have hforced : node.forcedLeaf = true := by
        rw [node_forcedLeaf_eq hcorr, hleaf]
      exact ⟨[], by simp [CertifiedLocalizedCIPInput.executableOfficialCIPChildren, hleaf],
        by simp [RawMolecule.canonicalChildren, hforced]⟩
  | false =>
      have hforced : node.forcedLeaf = false := by
        rw [node_forcedLeaf_eq hcorr, hleaf]
      refine ⟨(input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2)), ?_, ?_⟩
      · have hchildren : input.executableOfficialCIPChildren onode =
            (input.executableOfficialChildCopies onode).map
              (fun copy => onode.extend copy.1 copy.2) := by
          simp [CertifiedLocalizedCIPInput.executableOfficialCIPChildren, hleaf]
        rw [hchildren]
        have hnoSelf : ∀ copy ∈ input.executableOfficialChildCopies onode,
            (fun atom : input.Atom => atom.val) copy.1 ≠ node.atom :=
          fun copy hmem =>
            productionCopy_noSelf mol input agreement node onode atomBound currentObserved hmem
        simpa using
          officialChildNodes_forall₂_shadows hcorr Fin.val_injective
            (input.executableOfficialChildCopies onode) hnoSelf
      · simpa [canonicalChildren_eq_childNodes_of_not_forcedLeaf mol node hforced] using
          productionRootChildNodeShadows_perm mol input agreement wellFormed unique supported node
            onode atomBound currentObserved parentNone noOxido hcorr

/-! ## Multiplicity transport -/

/-- **Multiplicity (parent observed).**  The canonical child-node multiset is preserved exactly:
every predicate has the same count over the mapped official enumeration and over the canonical
child-node enumeration. -/
theorem productionChildNode_countP_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (predicate : RawMolecule.CanonicalBranchNode → Bool) :
    ((input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2))).countP predicate =
      (canonicalChildNodes mol node).countP predicate :=
  (productionChildNodeShadows_perm mol input agreement wellFormed unique supported node onode
    atomBound parentBound currentObserved parentObserved noOxido).countP_eq predicate

/-- **Multiplicity (root).**  The same exact count preservation for the root bridge. -/
theorem productionRootChildNode_countP_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    (predicate : RawMolecule.CanonicalBranchNode → Bool) :
    ((input.executableOfficialChildCopies onode).map
        (fun copy => Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2))).countP predicate =
      (canonicalChildNodes mol node).countP predicate :=
  (productionRootChildNodeShadows_perm mol input agreement wellFormed unique supported node onode
    atomBound currentObserved parentNone noOxido hcorr).countP_eq predicate

/-- **Multiplicity on official child nodes.**  For any predicate pair that respects the constructor
correspondence per emitted copy, the count over the actual official child nodes equals the count
over the actual canonical child nodes.  This is the node-level multiset transport; it does not
assume list equality or key/compare equality. -/
theorem productionOfficialChildNode_countP_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (predicate : OfficialCIPNode input.Atom → Bool)
    (predicate' : RawMolecule.CanonicalBranchNode → Bool)
    (respectful : ∀ copy ∈ input.executableOfficialChildCopies onode,
      predicate (onode.extend copy.1 copy.2) =
        predicate' (Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
          (copy.1.val, copy.2))) :
    (executableOfficialChildNodes input onode).countP predicate =
      (canonicalChildNodes mol node).countP predicate' := by
  have hcopyCount := productionChildNode_countP_eq mol input agreement wellFormed unique
    supported node onode atomBound parentBound currentObserved parentObserved noOxido predicate'
  rw [← hcopyCount]
  simp only [executableOfficialChildNodes, List.countP_map]
  apply List.countP_congr
  intro copy hmem
  have hEq := respectful copy hmem
  simpa only [Function.comp_apply] using (Bool.eq_iff_iff.mp hEq)

/-- **Length/multiplicity.**  The actual official and canonical child enumerations have the same
length. -/
theorem productionChildNode_length_eq
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node) :
    (input.executableOfficialChildCopies onode).length =
      (mol.canonicalChildCopies node).length := by
  simpa using
    (canonicalChildCopies_perm_executableOfficialChildCopies mol input agreement wellFormed unique
      supported node onode atomBound parentBound currentObserved parentObserved noOxido).length_eq

/-! ## Generated-child closure on the actual production enumerations -/

/-- Every official child emitted at a parent-observed node is related to the canonical child of the
same mapped copy, and that canonical child is an actual member of the canonical child-node list. -/
theorem productionOfficialChildNode_corresponds_mem
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (parentBound : node.parent < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentObserved : onode.parent? =
      some (localizedIndexOf mol input agreement ⟨node.parent, parentBound⟩))
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    {copy : input.Atom × ℕ}
    (present : copy ∈ input.executableOfficialChildCopies onode) :
    ∃ child ∈ canonicalChildNodes mol node,
      NodeCorresponds (fun atom : input.Atom => atom.val)
        (onode.extend copy.1 copy.2) child := by
  have hcopyPerm := canonicalChildCopies_perm_executableOfficialChildCopies mol input agreement
    wellFormed unique supported node onode atomBound parentBound currentObserved parentObserved
    noOxido
  have hmappedMem : (copy.1.val, copy.2) ∈
      (input.executableOfficialChildCopies onode).map
        (fun copy => (copy.1.val, copy.2)) := List.mem_map.mpr ⟨copy, present, rfl⟩
  have hcanonicalMem : (copy.1.val, copy.2) ∈ mol.canonicalChildCopies node :=
    hcopyPerm.mem_iff.mp hmappedMem
  refine ⟨Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
      (copy.1.val, copy.2), ?_, ?_⟩
  · exact List.mem_map.mpr ⟨(copy.1.val, copy.2), hcanonicalMem, rfl⟩
  · exact nodeCorresponds_extend_childOfCopy hcorr Fin.val_injective copy.1 copy.2
      (productionCopy_noSelf mol input agreement node onode atomBound currentObserved present)

/-- **Generated-child closure at the root.**  The root version of the correspondence-membership
statement, using the separate root copy bridge. -/
theorem productionRootOfficialChildNode_corresponds_mem
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed) (unique : mol.BondRecordsUnique)
    (supported : ∀ bond ∈ mol.bonds, bond.kind.IsLocalizedCovalent)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (noOxido : NoOxidoRootEdgeHistory mol node)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node)
    {copy : input.Atom × ℕ}
    (present : copy ∈ input.executableOfficialChildCopies onode) :
    ∃ child ∈ canonicalChildNodes mol node,
      NodeCorresponds (fun atom : input.Atom => atom.val)
        (onode.extend copy.1 copy.2) child := by
  have hself : node.parent = node.atom :=
    (NodeCorresponds.parent_eq_none_iff_selfParent hcorr).mp parentNone
  have hcopyPerm := canonicalChildCopies_perm_executableOfficialChildCopies_root mol input
    agreement wellFormed unique supported node onode atomBound currentObserved parentNone
    hself noOxido
  have hmappedMem : (copy.1.val, copy.2) ∈
      (input.executableOfficialChildCopies onode).map
        (fun copy => (copy.1.val, copy.2)) := List.mem_map.mpr ⟨copy, present, rfl⟩
  have hcanonicalMem : (copy.1.val, copy.2) ∈ mol.canonicalChildCopies node :=
    hcopyPerm.mem_iff.mp hmappedMem
  refine ⟨Rule1bRepresentedAtomObservation.canonicalChildOfCopy node
      (copy.1.val, copy.2), ?_, ?_⟩
  · exact List.mem_map.mpr ⟨(copy.1.val, copy.2), hcanonicalMem, rfl⟩
  · exact nodeCorresponds_extend_childOfCopy hcorr Fin.val_injective copy.1 copy.2
      (productionCopy_noSelf mol input agreement node onode atomBound currentObserved present)

/-! ## Root seed equality summary -/

/-- **Root bridge, explicit form.**  With a corresponding official root and canonical
self-parent root marker, both child-copy enumerations are their seed enumerations.  This is the
statement that the canonical self-parent erase is inert while the official side simply omits the
parent filter. -/
theorem productionRootChildCopies_eq_seeds
    (mol : RawMolecule) (input : CertifiedLocalizedCIPInput)
    (agreement : mol.AuthoritativeStructureAgreement input.certified.input)
    (wellFormed : mol.WellFormed)
    (node : RawMolecule.CanonicalBranchNode) (onode : OfficialCIPNode input.Atom)
    (atomBound : node.atom < mol.atomCount)
    (currentObserved : onode.current? =
      some (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩))
    (parentNone : onode.parent? = none)
    (hcorr : NodeCorresponds (fun atom : input.Atom => atom.val) onode node) :
    mol.canonicalChildCopies node = mol.canonicalSeedCopies node ∧
      input.executableOfficialChildCopies onode =
        input.executableSeedCopies
          (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩) := by
  have hself : node.parent = node.atom :=
    (NodeCorresponds.parent_eq_none_iff_selfParent hcorr).mp parentNone
  exact ⟨canonicalChildCopies_eq_seed_of_selfParent mol node wellFormed hself,
    executableOfficialChildCopies_eq_seed_of_parentNone input onode
      (localizedIndexOf mol input agreement ⟨node.atom, atomBound⟩) currentObserved parentNone⟩

