    · exact ctx.claimsIncluded _ (by
        simp [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims]
        aesop)
    · cases descriptorCase : assignment.generalDescriptor? with
      | none => trivial
      | some general =>
          rw [descriptorCase] at intrinsic
          refine ⟨intrinsic.2.2.2.2, ?_⟩
          exact ctx.claimsIncluded _ (by
            simp [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims]
            aesop)
  · intro center eligible
