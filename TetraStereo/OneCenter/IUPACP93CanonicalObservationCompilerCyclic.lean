/-! The fused-relation carrier is closed-world, so its compilation consumes an exact context. -/

theorem fusedRelationAuthority_validFor
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (observation : P93CanonicalFusedRelationObservation)
    (ctx : PayloadContext program scope source
      (.fusedCyclophane (.fusedRelation observation))) :
    (fusedCyclophaneAuthority program scope (.fusedRelation observation)).ValidFor
      (program.fusedPolicy scope) source := by
  have observationClaim : program.HasClaim scope source
      (.fused (.relationObservation observation)) :=
    ctx.claim (by simp
      [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have relationExact : ∀ other,
      program.HasClaim scope source (.fused (.relationObservation other)) →
        other = observation := by
    intro other claim
    have member := (ctx.claimsExact (.fused (.relationObservation other))).1 claim
    simpa [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims] using member
  rcases ctx.validFor.2 with
    ⟨systemValid, nonempty, pairsNodup, candidatesValid, selectedMem, unique, relationJudged⟩
  simp only [fusedCyclophaneAuthority, P93FusedRelationAuthorityObservation.ValidFor,
    P93AuthorityFusedSystem.ValidFor, fusedPolicy]
  refine ⟨⟨systemValid, Or.inr ⟨observation, observationClaim, rfl⟩⟩,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa using nonempty
  · simpa using pairsNodup
  · intro candidate candidateMem
    rcases List.mem_map.mp candidateMem with ⟨evidence, evidenceMem, rfl⟩
    have valid := candidatesValid evidence evidenceMem
    rcases valid with
      ⟨ordered, firstFusion, secondFusion, firstLocant, secondLocant, pathValid,
        distanceEq, lowerEq, shortest⟩
    refine ⟨ordered, firstFusion, secondFusion, firstLocant, secondLocant, lowerEq,
      ?_, ?_, ?_⟩
    · exact ⟨observation, observationClaim, rfl, evidence, evidenceMem, rfl, rfl⟩
    · rcases pathValid with ⟨middle, pathEq, _nodup, _bounded, _connected, _inside⟩
      rw [pathEq] at distanceEq
      simp only [List.length_cons, List.length_append] at distanceEq
      omega
    · exact ⟨observation, observationClaim, rfl, evidence, evidenceMem,
        rfl, rfl, rfl, rfl⟩
  · intro first second eligible
    rcases eligible with ⟨other, otherClaim, systemEq, evidence, evidenceMem, firstEq, secondEq⟩
    have otherEq := relationExact other otherClaim
    subst other
    refine ⟨evidence.candidate, List.mem_map.mpr ⟨evidence, evidenceMem, rfl⟩,
      firstEq, secondEq⟩
  · simpa using unique
  · rcases relationJudged.2.1 with relationEq
    cases relationCase : observation.relation.nearestAtomsRelation <;>
      simp [P93CanonicalFusionLegacyDescriptor, relationCase] at relationEq ⊢ <;>
        simp_all
  · exact congrArg (fun value => value.2.2.2) relationJudged.2.1
  · exact relationJudged.2.2.1
  · exact ⟨observation, observationClaim, rfl, rfl, rfl, rfl, rfl, rfl⟩
  · exact relationJudged.2.2.2
  · exact ⟨relationJudged.1,
      ⟨observation, observationClaim, rfl, rfl, rfl, rfl⟩⟩

theorem fusedRelationAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (observation : P93CanonicalFusedRelationObservation)
    (ctx : PayloadContext program scope source
      (.fusedCyclophane (.fusedRelation observation))) :
    Remaining71P93FusedCyclophaneAuthorityRow.cisoidTransoid.ProductionJudges
      (program.fusedPolicy scope) (program.cyclophanePolicy scope) source
      (fusedCyclophaneAuthority program scope (.fusedRelation observation)) :=
  (Remaining71P93FusedCyclophaneAuthorityRow.production_eq_reference _ _ _ _ _).2
    (fusedRelationAuthority_validFor program scope source observation ctx)

