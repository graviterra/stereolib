/-! ## Complete top-level fused/cyclophane family dispatch -/

theorem fusedCyclophaneAuthority_judged
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93FusedCyclophaneAuthorityRow}
    (payload : P93FusedCyclophaneClausePayload row)
    (ctx : PayloadContext program scope source (.fusedCyclophane payload)) :
    (row.reference (program.fusedPolicy scope) (program.cyclophanePolicy scope)).Judges source
      (fusedCyclophaneAuthority program scope payload) := by
  cases payload with
  | fusedCIP observation =>
      exact fusedCIPAuthority_validFor_of_included program scope source observation ctx.toIncluded
  | fusedRelation observation =>
      exact fusedRelationAuthority_validFor program scope source observation ctx
  | cyclophanePlanes printed executable =>
      exact cyclophanePlanesAuthority_validFor_of_included program scope source printed
        executable ctx.toIncluded
  | cyclophaneCenters system unit citation specification =>
      cases specification with
      | cip context kind descriptor =>
          exact cyclophaneCentersCIPAuthority_validFor_of_included program scope source system unit
            citation context kind descriptor ctx.toIncluded
      | relativeRCT candidates selected referenceSide assignments =>
          apply cyclophaneCentersRelativeAuthority_validFor_of_included program scope source
            system unit citation candidates selected referenceSide assignments ctx.toIncluded
          intro center eligible
          have member := (ctx.claimsExact
            (.cyclophane (.rctEligible system center))).1 eligible
          have carried : ∃ candidate ∈ candidates, center = candidate.center := by
            simpa [P93ClausePayloadData.toClaims,
              P93FusedCyclophaneClausePayload.toClaims] using member
          rcases carried with ⟨candidate, candidateMem, centerEq⟩
          exact ⟨candidate, candidateMem, centerEq.symm⟩
  | cyclophaneDoubleBonds system unit citation ring phaneRing geometry carbonContext context
      descriptor? =>
      exact cyclophaneDoubleBondsAuthority_validFor_of_included program scope source system unit
        citation ring phaneRing geometry carbonContext context descriptor? ctx.toIncluded

theorem fusedCyclophaneAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93FusedCyclophaneAuthorityRow}
    (payload : P93FusedCyclophaneClausePayload row)
    (ctx : PayloadContext program scope source (.fusedCyclophane payload)) :
    row.ProductionJudges (program.fusedPolicy scope) (program.cyclophanePolicy scope) source
      (fusedCyclophaneAuthority program scope payload) :=
  (row.production_eq_reference (program.fusedPolicy scope) (program.cyclophanePolicy scope)
    source (fusedCyclophaneAuthority program scope payload)).2
      (fusedCyclophaneAuthority_judged program scope source payload ctx)

/-! ## Fullerene compilation -/

/-- The methodology row is still discharged by its exact printed-rule claim.  Each molecular row
already stores the complete relational observation at the canonical audited policy, so compilation
is a dependent projection rather than a reconstruction through the legacy site-rooted carrier. -/
theorem fullereneAuthority_judged
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93FullereneAuthorityRow}
    (payload : P93FullereneClausePayload row)
    (ctx : PayloadContext program scope source (.fullerene payload)) :
    (row.reference (program.fullerenePolicy scope) program.relationalFullerenePolicy).Judges source
      (fullereneAuthority program scope payload) := by
  cases payload with
  | methodology =>
      exact ⟨ctx.claim (by
        simp [P93ClausePayloadData.toClaims, P93FullereneClausePayload.toClaims]),
        p93FullereneFourWaySubstitutionDecisionRule⟩
  | inherentParent observation
  | inherentSubstitution observation
  | noninherentSubstitution observation =>
      exact ⟨True.intro, ctx.validFor.2.1, ctx.validFor.2.2⟩
  | chiralSubstituents observation
  | superimposed observation =>
      exact ctx.validFor.2

theorem fullereneAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93FullereneAuthorityRow}
    (payload : P93FullereneClausePayload row)
    (ctx : PayloadContext program scope source (.fullerene payload)) :
    row.ProductionJudges (program.fullerenePolicy scope) program.relationalFullerenePolicy source
      (fullereneAuthority program scope payload) :=
  (row.production_eq_reference (program.fullerenePolicy scope)
    program.relationalFullerenePolicy source (fullereneAuthority program scope payload)).2
      (fullereneAuthority_judged program scope source payload ctx)

/-! ## Coupled-usable ring-assembly compilation -/

theorem ringAssemblyAxesAuthority_validFor_of_included
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    (printed : P93CanonicalRingAssemblyPrintedAxesObservation)
    (executable : P93CanonicalRingAssemblyAxesExecutableWitness)
    (ctx : IncludedPayloadContext program scope source
      (.ringAssembly (.axes printed executable)))
    (complete : ∀ junction,
      program.HasClaim scope source (.ringAssembly (.axisEligible printed.assembly junction)) →
        ∃ assignment ∈ executable.assignments, assignment.junction = junction) :
    (ringAssemblyAuthority program scope
      (.axes printed executable)).ValidFor
        (program.ringAssemblyPolicy scope) source := by
  rcases ctx.validFor.2 with ⟨printedValid, executableValid⟩
  rcases printedValid with
    ⟨_moleculeEq, assemblyValid, printedNonempty, printedJunctionsNodup,
      printedCitationsNodup, printedAssignmentsValid⟩
  rcases executableValid with
    ⟨spatialEq, normalizationAgreement, normalizationExact, agreement,
      executableAssignmentsValid⟩
  have nonempty : executable.assignments ≠ [] := by
    intro empty
    rw [empty, List.map_nil] at agreement
    exact printedNonempty agreement
  have junctionsNodup :
      (executable.assignments.map fun assignment => assignment.junction).Nodup := by
    rw [agreement] at printedJunctionsNodup
    simpa [P93RingAssemblyAxisAssignment.toPrinted] using printedJunctionsNodup
  have citationsNodup :
      (executable.assignments.map fun assignment => assignment.citation).Nodup := by
    rw [agreement] at printedCitationsNodup
    simpa [P93RingAssemblyAxisAssignment.toPrinted] using printedCitationsNodup
  have assemblyClaim := ctx.claimsIncluded (.ringAssembly (.assembly printed.assembly)) (by
    simp [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims])
  simp only [ringAssemblyAuthority, P93RingAssemblyAxesAuthorityObservation.ValidFor,
    P93AuthorityRingAssembly.ValidFor, ringAssemblyPolicy]
  refine ⟨⟨assemblyValid, assemblyClaim⟩, spatialEq,
    normalizationAgreement, normalizationExact, nonempty, junctionsNodup,
    citationsNodup, ?_, ?_⟩
  · intro assignment assignmentMem
    have printedMem : assignment.toPrinted ∈ printed.assignments := by
      rw [agreement]
      exact List.mem_map.mpr ⟨assignment, assignmentMem, rfl⟩
    rcases printedAssignmentsValid assignment.toPrinted printedMem with
      ⟨junctionMem, frameValid, cipEq, preferredEq, generalEq,
        preferredValid, citationValid⟩
    rcases executableAssignmentsValid assignment assignmentMem with ⟨recordEq, geometry⟩
    rw [recordEq] at frameValid cipEq
    refine ⟨junctionMem, ?_, frameValid, cipEq, geometry, preferredEq, generalEq,
      preferredValid, ?_, citationValid, ?_⟩
    · exact ctx.claimsIncluded
        (.ringAssembly (.axisEligible printed.assembly assignment.junction)) (by
        simp only [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims,
          List.mem_append, List.mem_singleton, List.mem_flatMap]
        exact Or.inr ⟨assignment.toPrinted, printedMem, by
          simp [P93RingAssemblyAxisAssignment.toPrinted]⟩)
    · exact ctx.claimsIncluded
        (.ringAssembly (.axisDescriptors printed.assembly assignment.junction
          assignment.preferredDescriptor assignment.generalDescriptor)) (by
        simp only [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims,
          List.mem_append, List.mem_singleton, List.mem_flatMap]
        exact Or.inr ⟨assignment.toPrinted, printedMem, by
          simp [P93RingAssemblyAxisAssignment.toPrinted]⟩)
    · exact ctx.claimsIncluded
        (.ringAssembly (.axisCitation printed.assembly assignment.junction
          assignment.citation)) (by
        simp only [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims,
          List.mem_append, List.mem_singleton, List.mem_flatMap]
        exact Or.inr ⟨assignment.toPrinted, printedMem, by
          simp [P93RingAssemblyAxisAssignment.toPrinted]⟩)
  · intro junction _junctionMem eligible
    exact complete junction eligible

