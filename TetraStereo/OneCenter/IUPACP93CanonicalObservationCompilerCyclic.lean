  refine ⟨⟨assemblyValid, assemblyClaim⟩, nonempty, centersNodup, citationsNodup, ?_, ?_⟩
  · intro assignment assignmentMem
    have intrinsic := assignmentsIntrinsic assignment assignmentMem
    have physicalValid := program.physicalUnit_validForAtScope scope source
      (.atomCenter assignment.center) intrinsic.2.1 (by trivial)
    refine ⟨intrinsic.1, physicalValid, ?_, intrinsic.2.2.1, ?_, intrinsic.2.2.2.1,
