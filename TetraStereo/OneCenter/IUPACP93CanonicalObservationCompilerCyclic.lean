theorem spiroAuthority_judged_of_included
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93SpiroReadyAuthorityRow}
    (payload : P93SpiroClausePayload row)
    (ctx : IncludedPayloadContext program scope source (.spiro payload)) :
    (row.reference (program.spiroPolicy scope)).Judges source
      (spiroAuthority program scope payload) := by
  cases payload with
  | xabcd system citation descriptor =>
      let unit := P93AuthorityPhysicalUnit.atomCenter system.center
      have unitMem : (.spiro (.unit system unit) : P93SourceClaim) ∈
          (P93ClausePayloadData.spiro (.xabcd system citation descriptor)).toClaims := by
        simp [unit, P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims]
      have unitEnvelope := ctx.envelope unitMem
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        simpa [unit, P93SourceClaim.SourceEnvelope, P93SpiroClaim.SourceEnvelope] using
          unitEnvelope.2.1) (by simp [unit, QualitativeUnitSupported])
      simp only [Remaining71P93SpiroReadyAuthorityRow.reference,
        Remaining71P93SpiroReadyAuthorityRow.toAuthorityRow,
        Remaining71P93SpiroAuthorityRow.reference, p93SpiroXabcdReference,
        spiroAuthority, P93SpiroXabcdAuthorityObservation.ValidFor,
        P93AuthoritySpiroSystem.ValidFor, spiroPolicy]
      rcases ctx.validFor.2 with ⟨systemValid, familySupported, descriptorMatches, citationValid⟩
      refine ⟨⟨systemValid, ?_⟩, unitValid, ?_, ?_, familySupported, descriptorMatches,
        ?_, citationValid, ?_⟩
      all_goals exact ctx.claimsIncluded _ (by simp
        [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims])
  | xabab system citation family descriptor order =>
      let unit := P93AuthorityPhysicalUnit.atomCenter system.center
      have unitMem : (.spiro (.unit system unit) : P93SourceClaim) ∈
          (P93ClausePayloadData.spiro (.xabab system citation family descriptor order)).toClaims := by
        simp [unit, P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims]
      have unitEnvelope := ctx.envelope unitMem
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        simpa [unit, P93SourceClaim.SourceEnvelope, P93SpiroClaim.SourceEnvelope] using
          unitEnvelope.2.1) (by simp [unit, QualitativeUnitSupported])
      simp only [Remaining71P93SpiroReadyAuthorityRow.reference,
        Remaining71P93SpiroReadyAuthorityRow.toAuthorityRow,
        Remaining71P93SpiroAuthorityRow.reference, p93SpiroXababReference,
        spiroAuthority, P93SpiroXababAuthorityObservation.ValidFor,
        P93AuthoritySpiroSystem.ValidFor, spiroPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, familySupported, centerFamily, orderValid, descriptorMatches,
          citationValid⟩
      refine ⟨⟨systemValid, ?_⟩, unitValid, ?_, ?_, familySupported, centerFamily,
        orderValid, ?_, descriptorMatches, ?_, citationValid, ?_⟩
      all_goals exact ctx.claimsIncluded _ (by simp
        [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims])
  | doubleBond b ring geometry context descriptor? =>
      rcases b with ⟨system, unit, citation⟩
      have unitMem : (.spiro (.unit system unit) : P93SourceClaim) ∈
          (P93ClausePayloadData.spiro
            (.doubleBond ⟨system, unit, citation⟩ ring geometry context descriptor?)).toClaims := by
        simp [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims]
      have ringMem : (.spiro (.doubleBondRing system unit ring) : P93SourceClaim) ∈
          (P93ClausePayloadData.spiro
            (.doubleBond ⟨system, unit, citation⟩ ring geometry context descriptor?)).toClaims := by
        simp [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims]
      have ringEnvelope := ctx.envelope ringMem
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := unit) unitMem (by
        simp [P93SourceClaim.physicalUnits, P93SpiroClaim.physicalUnits])
      have unitExactEnvelope : P93CanonicalPhysicalUnitEnvelope source unit :=
        ringEnvelope.2.1
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        exact unitExactEnvelope) unitSupport
      simp only [Remaining71P93SpiroReadyAuthorityRow.reference,
        Remaining71P93SpiroReadyAuthorityRow.toAuthorityRow,
        Remaining71P93SpiroAuthorityRow.reference, p93SpiroDoubleBondsReference,
        spiroAuthority, P93SpiroDoubleBondAuthorityObservation.ValidFor,
        P93AuthoritySpiroSystem.ValidFor, spiroPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, unitSupported, inRing, ringBelongs, allowed, preferred, citationValid⟩
      refine ⟨⟨systemValid, ?_⟩, unitValid, unitSupported, inRing, ringBelongs,
        ?_, ?_, ?_, ?_, allowed, preferred, citationValid, ?_⟩
      all_goals exact ctx.claimsIncluded _ (by simp
        [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims])
  | axial system citation centerDescriptor descriptor =>
      let unit := P93AuthorityPhysicalUnit.atomCenter system.center
      have unitMem : (.spiro (.unit system unit) : P93SourceClaim) ∈
          (P93ClausePayloadData.spiro
            (.axial system citation centerDescriptor descriptor)).toClaims := by
        simp [unit, P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims]
      have unitEnvelope := ctx.envelope unitMem
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        simpa [unit, P93SourceClaim.SourceEnvelope, P93SpiroClaim.SourceEnvelope] using
          unitEnvelope.2.1) (by simp [unit, QualitativeUnitSupported])
      simp only [Remaining71P93SpiroReadyAuthorityRow.reference,
        Remaining71P93SpiroReadyAuthorityRow.toAuthorityRow,
        Remaining71P93SpiroAuthorityRow.reference, p93SpiroAxialChiralityReference,
        spiroAuthority, P93SpiroAxialAuthorityObservation.ValidFor,
        P93AuthoritySpiroSystem.ValidFor, spiroPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, centerSupported, axialSupported, centerMatches, axialMatches,
          correspondence, recommended, citationValid⟩
      refine ⟨⟨systemValid, ?_⟩, unitValid, ?_, ?_, centerSupported, axialSupported,
        centerMatches, axialMatches, correspondence, ?_, ?_, recommended, citationValid, ?_⟩
      all_goals exact ctx.claimsIncluded _ (by simp
        [P93ClausePayloadData.toClaims, P93SpiroClausePayload.toClaims])

