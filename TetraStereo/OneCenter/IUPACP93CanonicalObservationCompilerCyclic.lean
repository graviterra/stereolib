theorem ringAssemblyAuthority_judged
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93RingAssemblyAuthorityRow}
    (payload : P93RingAssemblyClausePayload row)
    (ctx : PayloadContext program scope source (.ringAssembly payload)) :
    (row.reference (program.ringAssemblyPolicy scope)).Judges source
      (ringAssemblyAuthority program scope payload) := by
  cases payload with
  | axes printed executable =>
      apply ringAssemblyAxesAuthority_validFor_of_included program scope source printed
        executable ctx.toIncluded
      intro junction eligible
      have member := (ctx.claimsExact
        (.ringAssembly (.axisEligible printed.assembly junction))).1 eligible
      have carried : ∃ assignment ∈ printed.assignments,
          junction = assignment.junction := by
        simpa [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims] using member
      rcases carried with ⟨printedAssignment, printedMem, junctionEq⟩
      rcases ctx.validFor.2 with ⟨_printedValid,
        ⟨_spatialEq, _normalizationAgreement, _normalizationExact, agreement,
          _assignmentsValid⟩⟩
      rw [agreement] at printedMem
      rcases List.mem_map.mp printedMem with ⟨assignment, assignmentMem, assignmentEq⟩
      refine ⟨assignment, assignmentMem, ?_⟩
      have junctionAgreement : assignment.junction = printedAssignment.junction := by
        simpa [P93RingAssemblyAxisAssignment.toPrinted] using
          congrArg P93CanonicalRingAssemblyPrintedAxisAssignment.junction assignmentEq
      exact junctionAgreement.trans junctionEq.symm
  | centers assembly assignments =>
      apply ringAssemblyCentersAuthority_validFor_of_included program scope source assembly
        assignments ctx.toIncluded
      intro center eligible
      have member := (ctx.claimsExact
        (.ringAssembly (.centerEligible assembly center))).1 eligible
      have carriedOr : ∃ assignment ∈ assignments,
          center = assignment.center ∨
            P93SourceClaim.ringAssembly (P93RingAssemblyClaim.centerEligible assembly center) ∈
              match assignment.generalDescriptor? with
              | none => []
              | some general => [P93SourceClaim.ringAssembly
                  (P93RingAssemblyClaim.centerGeneralEquivalent assembly assignment.center
                    assignment.preferredDescriptor general)] := by
        simpa [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims] using member
      rcases carriedOr with ⟨assignment, assignmentMem, centerEq | impossible⟩
      · exact ⟨assignment, assignmentMem, centerEq.symm⟩
      · cases descriptorCase : assignment.generalDescriptor? <;>
          simp [descriptorCase] at impossible
  | doubleBonds assembly assignments =>
      apply ringAssemblyDoubleBondsAuthority_validFor_of_included program scope source assembly
        assignments ctx.toIncluded
      intro ringIndex first second _bond required
      have eligible := required.1
      have member := (ctx.claimsExact
        (.ringAssembly (.doubleBondStereogenic assembly ringIndex first second))).1 eligible
      have carried : ∃ assignment ∈ assignments,
          ringIndex = assignment.ringIndex ∧ first = assignment.first ∧
            second = assignment.second := by
        simpa [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims] using member
      rcases carried with ⟨assignment, assignmentMem, ringEq, firstEq, secondEq⟩
      exact ⟨assignment, assignmentMem, ringEq.symm, firstEq.symm, secondEq.symm⟩

theorem ringAssemblyAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93RingAssemblyAuthorityRow}
    (payload : P93RingAssemblyClausePayload row)
    (ctx : PayloadContext program scope source (.ringAssembly payload)) :
    row.ProductionJudges (program.ringAssemblyPolicy scope) source
      (ringAssemblyAuthority program scope payload) :=
  (row.production_eq_reference (program.ringAssemblyPolicy scope) source
    (ringAssemblyAuthority program scope payload)).2
      (ringAssemblyAuthority_judged program scope source payload ctx)

/-! ## Coupled closed-world completion from the canonical union invariant -/

theorem coupledEvidence_upstream_not_coupled
    (evidence : P93CanonicalReviewedDescriptorEvidence) (claim : P93CoupledClaim) :
    (.coupled claim : P93SourceClaim) ∉ evidence.upstreamClaims := by
  cases evidence with
  | acyclicCenter p | acyclicDoubleBond p | acyclicEvenCumulene p
  | acyclicOddCumulene p =>
      cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
        P93AcyclicClausePayload.toClaims, P93AcyclicBasePayload.baseClaims]
  | monocyclicAbsoluteCenter p | monocyclicAchiralCenter p =>
      cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
        P93MonocyclicClausePayload.toClaims, P93MonocyclicCitedPayload.baseClaims,
        P93MonocyclicPhysicalPayload.baseClaims]
  | monocyclicDoubleBond p _ _ =>
      cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
        P93MonocyclicClausePayload.toClaims, P93MonocyclicPhysicalPayload.baseClaims]
