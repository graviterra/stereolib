    simp [P93ClausePayloadData.toClaims, P93RingAssemblyClausePayload.toClaims])
  simp only [ringAssemblyAuthority, P93RingAssemblyDoubleBondsAuthorityObservation.ValidFor,
    P93AuthorityRingAssembly.ValidFor, P93RingAssemblyDoubleBondAssignment.ValidFor,
