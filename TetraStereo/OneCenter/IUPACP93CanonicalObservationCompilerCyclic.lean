  refine ⟨⟨systemValid, systemClaim⟩, rootValid, unitSupported, rootUnitClaim,
    selectedValid.2, rootCitationClaim, True.intro, True.intro, nonempty, centersNodup,
    citationsNodup, ?_, complete, unique, sideNotPlane, ?_, assignmentsNonempty,
    assignmentCentersNodup, assignmentCitationsNodup, candidateAssignments, ?_⟩
  · intro candidate candidateMem
    have candidateUnitMem : (.cyclophane
        (.unit system (.atomCenter candidate.center)) : P93SourceClaim) ∈
        (P93ClausePayloadData.fusedCyclophane
          (.cyclophaneCenters system (.atomCenter selected.center) selected.citation
            (.relativeRCT candidates selected referenceSide assignments))).toClaims := by
      simp [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims]
      aesop
    have candidateEnvelope := ctx.envelope candidateUnitMem
    have candidateUnitValid := program.physicalUnit_validForAtScope scope source
      (.atomCenter candidate.center) (by
        simpa [P93SourceClaim.SourceEnvelope, P93CyclophaneClaim.SourceEnvelope] using
          candidateEnvelope.2.1) (by trivial)
    have intrinsic := candidatesIntrinsic candidate candidateMem
    refine ⟨intrinsic.1, candidateUnitValid, ?_, ?_, intrinsic.2, ?_, ?_⟩
    all_goals exact ctx.claimsIncluded _ (by
      simp [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims]
      aesop)
  · exact ctx.claimsIncluded _ (by
      simp [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  · intro assignment assignmentMem
    have intrinsic := assignmentsIntrinsic assignment assignmentMem
    refine ⟨intrinsic.1, ?_, intrinsic.2⟩
    exact ctx.claimsIncluded _ (by
      simp only [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims,
        List.mem_append, List.mem_cons]
      exact Or.inr (List.mem_map.mpr ⟨assignment, assignmentMem, rfl⟩))

