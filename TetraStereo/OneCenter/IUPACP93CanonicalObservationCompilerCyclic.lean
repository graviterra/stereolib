/-! ## Coupled-usable fused CIP compilation -/

theorem fusedCIPAuthority_validFor_of_included
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (observation : P93CanonicalFusedCIPObservation)
    (ctx : IncludedPayloadContext program scope source
      (.fusedCyclophane (.fusedCIP observation))) :
    (fusedCIPObservation observation (program.fusedPolicy scope)).ValidFor
      (program.fusedPolicy scope) source := by
  have observationClaim : program.HasClaim scope source
      (.fused (.cipObservation observation)) :=
    ctx.claimsIncluded _ (by simp
      [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  simp only [fusedCIPObservation, P93FusedCIPAuthorityObservation.ValidFor,
    P93AuthorityFusedSystem.ValidFor, fusedPolicy]
  rcases ctx.validFor.2 with
    ⟨systemValid, unitValid, descriptorMatches, citationValid, citationCites⟩
  refine ⟨⟨systemValid, Or.inl ⟨observation, observationClaim, rfl⟩⟩, ?_,
    ⟨observation, observationClaim, rfl, rfl⟩, descriptorMatches,
    ⟨observation, observationClaim, rfl, rfl, rfl⟩, citationValid, citationCites,
    ⟨observation, observationClaim, rfl, rfl⟩⟩
  cases unitCase : observation.unit with
  | physical unit =>
      rw [unitCase] at unitValid
      have qualitative := ctx.qualitativeSupported_of_claim
        (claim := .fused (.cipObservation observation)) (unit := unit) (by simp
          [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims]) (by
            intro candidate candidateMem
            simpa [P93SourceClaim.qualitativePhysicalUnits, P93SourceClaim.physicalUnits,
              P93FusedClaim.physicalUnits, P93FusedAuthorityUnit.physicalUnits, unitCase]
              using candidateMem)
      exact ⟨program.physicalUnit_validForAtScope scope source unit unitValid.1 qualitative,
        unitValid.2⟩
  | fusedAxis path =>
      rw [unitCase] at unitValid
      exact ⟨unitValid.1, unitValid.2.1, unitValid.2.2.1, unitValid.2.2.2.1,
        unitValid.2.2.2.2.1, unitValid.2.2.2.2.2,
        ⟨observation, observationClaim, rfl, unitCase⟩⟩

