import TetraStereo.OneCenter.IUPACP93CanonicalPolicyCompiler

set_option autoImplicit false

/-!
# Canonical P-93 cyclic observation compiler

This module erases the closed payloads for the thirty-two non-coupled cyclic P-93 clauses into
their legacy reviewed observation carriers.  Every proof is parameterized by the claim-family
scope, so the same converters also serve the nested evidence of the coupled-ring-chain clause.
Closed-world carrier conditions are proved from an exact source-keyed claim equivalence, never
from an open collection of positive witnesses.
-/

namespace TetraStereo.OneCenter

open BlueBookP93
open BlueBookP93.Acyclic
open BlueBookP93.Cyclic
open IUPACNormativeProvision

namespace P93CanonicalSourceProgram

/-- The compiled policy contains exactly the claims generated by one source-bound payload. -/
def ClaimsExact
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (claims : List P93SourceClaim) : Prop :=
  ∀ claim, program.HasClaim scope source claim ↔ claim ∈ claims

theorem claimsExact_of_entry
    (program : P93CanonicalSourceProgram)
    {entry : P93CanonicalClauseObservationEntry}
    (entryMem : entry ∈ program.observations) :
    program.ClaimsExact entry.clause.family entry.source
      entry.observation.auditClaims :=
  fun claim => program.hasClaim_iff entryMem claim

theorem sourceEnvelope_of_hasPhysicalSupport
    (program : P93CanonicalSourceProgram) {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {claim : P93PhysicalClaim}
    (supported : program.HasPhysicalSupport scope source claim) :
    claim.SourceEnvelope source := by
  rcases supported with ⟨entry, _entryMem, sourceEq, _familyEq, claimEq⟩
  subst claim
  simpa [sourceEq] using entry.sourceEnvelope

/-- A qualitative physical unit has at least one source-valid support frame at this source key. -/
def QualitativeUnitSupported
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) : P93AuthorityPhysicalUnit → Prop
  | .plane members => ∃ frame, program.HasPhysicalSupport scope source (.plane members frame)
  | .helix path => ∃ frame, program.HasPhysicalSupport scope source (.helix path frame)
  | .polyhedron center positions =>
      ∃ geometry frame,
        program.HasPhysicalSupport scope source (.polyhedron center positions geometry frame)
  | _ => True

theorem physicalUnit_validForAtScope
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (unit : P93AuthorityPhysicalUnit)
    (envelope : P93CanonicalPhysicalUnitEnvelope source unit)
    (supported : program.QualitativeUnitSupported scope source unit) :
    unit.ValidFor (program.physicalPolicy scope) source := by
  cases unit with
  | atomCenter center => exact envelope
  | bond first second => exact envelope
  | axis path => exact envelope
  | plane members =>
      rcases supported with ⟨frame, observed⟩
      exact ⟨frame, program.sourceEnvelope_of_hasPhysicalSupport observed, observed⟩
  | helix path =>
      rcases supported with ⟨frame, observed⟩
      exact ⟨frame, program.sourceEnvelope_of_hasPhysicalSupport observed, observed⟩
  | polyhedron center positions =>
      rcases supported with ⟨geometry, frame, observed⟩
      exact ⟨geometry, frame, program.sourceEnvelope_of_hasPhysicalSupport observed, observed⟩

/-- All evidence needed to compile one dependent payload at one exact source key. -/
structure PayloadContext
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) {clause : P93Clause}
    (payload : P93ClausePayloadData clause) : Prop where
  validFor : payload.ValidFor source
  claimsExact : program.ClaimsExact scope source payload.toClaims
  qualitativeSupported : ∀ unit ∈ payload.toClaims.flatMap P93SourceClaim.qualitativePhysicalUnits,
    program.QualitativeUnitSupported scope source unit
  exactPhysicalSupported : ∀ claim ∈ payload.exactQualitativePhysicalClaims,
    program.HasPhysicalSupport scope source claim

/-- Positive payload context used when one payload is nested inside a larger coupled claim union. -/
structure IncludedPayloadContext
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) {clause : P93Clause}
    (payload : P93ClausePayloadData clause) : Prop where
  validFor : payload.ValidFor source
  claimsIncluded : ∀ claim ∈ payload.toClaims, program.HasClaim scope source claim
  qualitativeSupported : ∀ unit ∈ payload.toClaims.flatMap P93SourceClaim.qualitativePhysicalUnits,
    program.QualitativeUnitSupported scope source unit
  exactPhysicalSupported : ∀ claim ∈ payload.exactQualitativePhysicalClaims,
    program.HasPhysicalSupport scope source claim

def PayloadContext.toIncluded
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : PayloadContext program scope source payload) :
    IncludedPayloadContext program scope source payload where
  validFor := ctx.validFor
  claimsIncluded := fun claim member => (ctx.claimsExact claim).2 member
  qualitativeSupported := ctx.qualitativeSupported
  exactPhysicalSupported := ctx.exactPhysicalSupported

theorem payloadContext_of_entry
    (program : P93CanonicalSourceProgram)
    {entry : P93CanonicalClauseObservationEntry}
    (entryMem : entry ∈ program.observations) :
    PayloadContext program entry.clause.family entry.source
      entry.observation.payload := by
  refine
    { validFor := entry.observation.validFor
      claimsExact := program.claimsExact_of_entry entryMem
      qualitativeSupported := ?_
      exactPhysicalSupported := ?_ }
  · intro unit unitMem
    rcases program.qualitativePhysicalCovered entry entryMem unit unitMem with
      ⟨support, supportMem, sourceEq, clauseEq, unitEq⟩
    have observed : program.HasPhysicalSupport entry.clause.family entry.source support.claim :=
      ⟨support, supportMem, sourceEq, congrArg P93Clause.family clauseEq, rfl⟩
    generalize claimEq : support.claim = physicalClaim at observed unitEq
    cases physicalClaim with
    | helix path frame =>
        simp only [P93PhysicalClaim.unit] at unitEq
        cases unit <;> simp_all [QualitativeUnitSupported]
        exact ⟨frame, observed⟩
    | plane members frame =>
        simp only [P93PhysicalClaim.unit] at unitEq
        cases unit <;> simp_all [QualitativeUnitSupported]
        exact ⟨frame, observed⟩
    | polyhedron center positions geometry frame =>
        simp only [P93PhysicalClaim.unit] at unitEq
        cases unit <;> simp_all [QualitativeUnitSupported]
        exact ⟨geometry, frame, observed⟩
  · intro claim claimMem
    exact program.hasPhysicalSupport_of_exact entryMem claimMem

namespace PayloadContext

attribute [simp] P93SourceClaim.qualitativePhysicalUnits
  P93AuthorityPhysicalUnit.qualitativeOnly

theorem claim
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : PayloadContext program scope source payload)
    {claim : P93SourceClaim} (member : claim ∈ payload.toClaims) :
    program.HasClaim scope source claim :=
  (ctx.claimsExact claim).2 member

theorem envelope
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : PayloadContext program scope source payload)
    {claim : P93SourceClaim} (member : claim ∈ payload.toClaims) :
    claim.SourceEnvelope source :=
  ctx.validFor.1 claim member

theorem qualitativeSupported_of_claim
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : PayloadContext program scope source payload)
    {claim : P93SourceClaim} (claimMem : claim ∈ payload.toClaims)
    {unit : P93AuthorityPhysicalUnit}
    (projected : ∀ candidate ∈ unit.qualitativeOnly,
      candidate ∈ claim.qualitativePhysicalUnits) :
    program.QualitativeUnitSupported scope source unit := by
  cases unit with
  | atomCenter _ | bond _ _ | axis _ => trivial
  | plane members =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.plane members)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)
  | helix path =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.helix path)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)
  | polyhedron center positions =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.polyhedron center positions)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)

end PayloadContext

namespace IncludedPayloadContext

theorem envelope
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : IncludedPayloadContext program scope source payload)
    {claim : P93SourceClaim} (member : claim ∈ payload.toClaims) :
    claim.SourceEnvelope source :=
  ctx.validFor.1 claim member

theorem qualitativeSupported_of_claim
    {program : P93CanonicalSourceProgram} {scope : P93ClaimFamily}
    {source : AuthoritativeChemicalInput} {clause : P93Clause}
    {payload : P93ClausePayloadData clause}
    (ctx : IncludedPayloadContext program scope source payload)
    {claim : P93SourceClaim} (claimMem : claim ∈ payload.toClaims)
    {unit : P93AuthorityPhysicalUnit}
    (projected : ∀ candidate ∈ unit.qualitativeOnly,
      candidate ∈ claim.qualitativePhysicalUnits) :
    program.QualitativeUnitSupported scope source unit := by
  cases unit with
  | atomCenter _ | bond _ _ | axis _ => trivial
  | plane members =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.plane members)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)
  | helix path =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.helix path)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)
  | polyhedron center positions =>
      exact ctx.qualitativeSupported (P93AuthorityPhysicalUnit.polyhedron center positions)
        (List.mem_flatMap.mpr ⟨claim, claimMem,
          projected _ (by simp [P93AuthorityPhysicalUnit.qualitativeOnly])⟩)

end IncludedPayloadContext

/-! ## Payload erasure -/

def monocyclicAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93MonocyclicAuthorityRow} :
    P93MonocyclicClausePayload row → (row.reference (program.monocyclicPolicy scope)).Observation
  | .configurations b descriptor knowledge notationValue =>
      { physical := monocyclicPhysical b.toP93MonocyclicPhysicalPayload
        citation := b.citation, descriptor := descriptor
        knowledge := knowledge, «notation» := notationValue }
  | .absoluteCenter b _ kind descriptor knowledge notationValue
  | .achiralCenter b _ kind descriptor knowledge notationValue =>
      { physical := monocyclicPhysical b.toP93MonocyclicPhysicalPayload
        citation := b.citation, kind := kind, descriptor := descriptor
        knowledge := knowledge, «notation» := notationValue }
  | .cisTrans ring first second ligandA ligandB plane firstSide secondSide descriptor =>
      { ringAtoms := ring, firstRingPosition := first, secondRingPosition := second
        firstSubstituent := ligandA, secondSubstituent := ligandB, plane := plane
        firstSide := firstSide, secondSide := secondSide, descriptor := descriptor }
  | .rct ring candidates selected referenceSide assignments =>
      { ringAtoms := ring, candidates := candidates, selected := selected
        referenceSide := referenceSide, assignments := assignments }
  | .unsaturated b topology count descriptor contextIsPIN =>
      { physical := monocyclicPhysical b, topology := topology, doubleBondCount := count
        contextIsPIN := contextIsPIN, descriptor := descriptor }
  | .cyclicDouble b count geometry descriptor? =>
      { physical := monocyclicPhysical b, doubleBondCount := count
        geometry := geometry, descriptor? := descriptor? }
  | .exocyclicEZ b count opposite contextIsPIN method treatment descriptor?
  | .exocyclicOther b count opposite contextIsPIN method treatment descriptor? =>
      { physical := monocyclicPhysical b, contextIsPIN := contextIsPIN
        doubleBondCount := count, oppositePositions := opposite, method := method
        treatment := treatment, descriptor? := descriptor? }

def vonBaeyerAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93VonBaeyerAuthorityRow} :
    P93VonBaeyerClausePayload row → (row.reference (program.vonBaeyerPolicy scope)).Observation
  | .cip b _ kind descriptor knowledge notationValue =>
      { system := b.system, unit := b.unit, citation := b.citation, kind := kind
        descriptor := descriptor, knowledge := knowledge, «notation» := notationValue }
  | .bridge system attachment substituent citation kind descriptor =>
      { system := system, attachmentAtom := attachment, substituent := substituent
        citation := citation, attachment := kind, descriptor := descriptor }
  | .relative system firstLigand secondLigand firstCitation? secondCitation?
      firstSide secondSide descriptor pin notationValue =>
      { system := system, firstLigand := firstLigand, secondLigand := secondLigand
        firstCitation? := firstCitation?, secondCitation? := secondCitation?
        firstSide := firstSide, secondSide := secondSide, descriptor := descriptor
        contextIsPIN := pin, «notation» := notationValue }
  | .doubleBond b (.ordinary pin larger geometry descriptor?) =>
      { system := b.system, unit := b.unit, citation := b.citation
        specification := .ordinaryDoubleBond pin larger geometry descriptor? }
  | .doubleBond b (.included context parity descriptor) =>
      { system := b.system, unit := b.unit, citation := b.citation
        specification := .includedOpenCumulene context parity descriptor }

def spiroAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93SpiroReadyAuthorityRow} :
    P93SpiroClausePayload row → (row.reference (program.spiroPolicy scope)).Observation
  | .xabcd system citation descriptor =>
      { system := system, citation := citation, descriptor := descriptor }
  | .xabab system citation family descriptor order =>
      { system := system, citation := citation, family := family
        descriptor := descriptor, occurrenceOrder := order }
  | .doubleBond b ring geometry context descriptor? =>
      { system := b.system, unit := b.unit, ring := ring, citation := b.citation
        geometry := geometry, context := context, descriptor? := descriptor? }
  | .axial system citation centerDescriptor descriptor =>
      { system := system, citation := citation, centerDescriptor := centerDescriptor
        axialDescriptor := descriptor }

def spiroNontetrahedralAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (payload : P93SpiroNontetrahedralPayload) :
    P93SpiroPolyhedralAuthorityObservation (program.spiroPolicy scope) where
  system := payload.system
  unit := .polyhedron payload.system.center payload.positions
  citation := payload.citation
  coordination := payload.coordination
  knowledge := payload.knowledge
  descriptor := payload.descriptor

def fusedCyclophaneAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93FusedCyclophaneAuthorityRow} :
    P93FusedCyclophaneClausePayload row →
      (row.reference (program.fusedPolicy scope) (program.cyclophanePolicy scope)).Observation
  | .fusedCIP observation =>
      fusedCIPObservation observation (program.fusedPolicy scope)
  | .fusedRelation observation =>
      { system := observation.system
        candidates := observation.candidates.map P93CanonicalFusedNearestCandidate.candidate
        selected := observation.selected.candidate
        selectedCitation := observation.relation.citation
        firstJunction := observation.relation.firstJunction
        secondJunction := observation.relation.secondJunction
        legacyDescriptor := observation.relation.legacyDescriptor
        preferredDescriptor := observation.relation.preferredDescriptor }
  | .cyclophanePlanes printed executable =>
      { system := printed.system, unit := .plane printed.members, frame := executable.frame
        citation := printed.citation, reference := printed.reference
        context := printed.context, descriptor := printed.descriptor }
  | .cyclophaneCenters system unit citation specification =>
      { system := system, unit := unit, citation := citation, specification := specification }
  | .cyclophaneDoubleBonds system unit citation ring phaneRing geometry carbonContext context
      descriptor? =>
      { system := system, unit := unit, ring := ring, phaneRing := phaneRing
        citation := citation
        geometry := geometry, carbonContext := carbonContext, context := context
        descriptor? := descriptor? }

def fullereneAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93FullereneAuthorityRow} :
    P93FullereneClausePayload row →
      (row.reference (program.fullerenePolicy scope)
        program.relationalFullerenePolicy).Observation
  | .methodology => .fourWayDecisionRule
  | .inherentParent observation
  | .inherentSubstitution observation
  | .noninherentSubstitution observation
  | .chiralSubstituents observation
  | .superimposed observation => observation

def ringAssemblyAuthority
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    {row : Remaining71P93RingAssemblyAuthorityRow} :
    P93RingAssemblyClausePayload row →
      (row.reference (program.ringAssemblyPolicy scope)).Observation
  | .axes printed executable =>
      { assembly := printed.assembly, normalization := executable.normalization.result
        spatial := executable.spatial, assignments := executable.assignments }
  | .centers assembly assignments =>
      { assembly := assembly, assignments := assignments }
  | .doubleBonds assembly assignments =>
      { assembly := assembly, assignments := assignments }

/-! ## Monocyclic compilation -/

theorem monocyclicAuthority_judged
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93MonocyclicAuthorityRow}
    (payload : P93MonocyclicClausePayload row)
    (ctx : PayloadContext program scope source (.monocyclic payload)) :
    (row.reference (program.monocyclicPolicy scope)).Judges source
      (monocyclicAuthority program scope payload) := by
  cases payload with
  | configurations b descriptor knowledge notationValue =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93CyclicConfigurationsReference, monocyclicAuthority,
        P93MonocyclicGeneralAssignment.ValidFor, P93MonocyclicPhysicalUnit.ValidFor,
        monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, citation, notationEq⟩
      refine ⟨⟨closed, ?_, unitValid, ?_⟩, citation, ?_, ?_, Or.inl ?_, notationEq⟩
      all_goals exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
        P93MonocyclicClausePayload.toClaims, P93MonocyclicCitedPayload.baseClaims,
        P93MonocyclicPhysicalPayload.baseClaims])
  | absoluteCenter b center kind descriptor knowledge notationValue =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93MonocyclicAbsoluteCentersReference, P93MonocyclicAbsoluteCenterJudged,
        monocyclicAuthority, P93MonocyclicCenterAuthorityObservation.ValidFor,
        P93MonocyclicPhysicalUnit.ValidFor, monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, unitEq, kindOk, applies, absolute, notationEq, citation⟩
      have centerClaim := ctx.claim
        (claim := .monocyclic (.center center kind descriptor knowledge notationValue)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
      refine ⟨⟨⟨closed, ?_, unitValid, ?_⟩,
        ⟨center, unitEq, ⟨descriptor, knowledge, notationValue, centerClaim⟩,
          ⟨kind, knowledge, notationValue, centerClaim⟩,
          ⟨kind, descriptor, notationValue, centerClaim⟩⟩,
        kindOk, applies, Or.inr ⟨center, kind, descriptor, unitEq, centerClaim⟩,
        notationEq, citation, ?_⟩, absolute⟩
      all_goals exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
        P93MonocyclicClausePayload.toClaims, P93MonocyclicCitedPayload.baseClaims,
        P93MonocyclicPhysicalPayload.baseClaims])
  | achiralCenter b center kind descriptor knowledge notationValue =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93MonocyclicAchiralCentersReference, P93MonocyclicAchiralCenterJudged,
        monocyclicAuthority, P93MonocyclicCenterAuthorityObservation.ValidFor,
        P93MonocyclicPhysicalUnit.ValidFor, monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, unitEq, kindOk, applies, notationEq, citation⟩
      have centerClaim := ctx.claim
        (claim := .monocyclic (.center center kind descriptor knowledge notationValue)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicCitedPayload.baseClaims, P93MonocyclicPhysicalPayload.baseClaims])
      refine ⟨⟨⟨closed, ?_, unitValid, ?_⟩,
        ⟨center, unitEq, ⟨descriptor, knowledge, notationValue, centerClaim⟩,
          ⟨kind, knowledge, notationValue, centerClaim⟩,
          ⟨kind, descriptor, notationValue, centerClaim⟩⟩,
        kindOk, applies, Or.inr ⟨center, kind, descriptor, unitEq, centerClaim⟩,
        notationEq, citation, ?_⟩, ⟨center, unitEq, ?_⟩⟩
      all_goals exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
        P93MonocyclicClausePayload.toClaims, P93MonocyclicCitedPayload.baseClaims,
        P93MonocyclicPhysicalPayload.baseClaims])
  | cisTrans ring first second ligandA ligandB plane firstSide secondSide descriptor =>
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93MonocyclicCisTransReference, monocyclicAuthority,
        P93MonocyclicCisTransAuthorityObservation.ValidFor, monocyclicPolicy]
      rcases ctx.validFor.2 with
        ⟨closed, firstMem, secondMem, neCenters, neLigands, ligandANot, ligandBNot,
          bondA, bondB, planeOk, relative⟩
      refine ⟨closed, ?_, firstMem, secondMem, neCenters, neLigands, ligandANot, ligandBNot,
        bondA, bondB, ?_, planeOk, ?_, ?_, relative⟩
      all_goals exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
        P93MonocyclicClausePayload.toClaims])
  | rct ring candidates selected referenceSide assignments =>
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93MonocyclicRCTReference, monocyclicAuthority,
        P93MonocyclicRCTAuthorityObservation.ValidFor, monocyclicPolicy]
      rcases ctx.validFor.2 with
        ⟨closed, candidatesNonempty, pairNodup, candidateValid, selectedValid, sideNotPlane,
          assignmentsNonempty, assignmentNodup, covered, assignmentValid⟩
      refine ⟨closed, ?_, candidatesNonempty, pairNodup, ?_, selectedValid, sideNotPlane, ?_,
        assignmentsNonempty, assignmentNodup, covered, ?_⟩
      · exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
          P93MonocyclicClausePayload.toClaims])
      · intro candidate candidateMem
        refine ⟨(candidateValid candidate candidateMem).1,
          (candidateValid candidate candidateMem).2.1,
          (candidateValid candidate candidateMem).2.2.1,
          (candidateValid candidate candidateMem).2.2.2, ?_, ?_⟩
        · exact ctx.claim
            (claim := .monocyclic (.citation candidate.citation (.atomCenter candidate.ringPosition)))
            (by
              simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims]
              exact ⟨candidate, candidateMem, rfl, rfl⟩)
        · exact ctx.claim
            (claim := .monocyclic (.rctCandidate ring candidate.ringPosition
              candidate.substituent candidate.citation candidate.namedAsSuffix
              candidate.sequencePriority))
            (by
              simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims]
              exact ⟨candidate, candidateMem, rfl, rfl, rfl, rfl, rfl⟩)
      · exact ctx.claim (by simp [P93ClausePayloadData.toClaims,
          P93MonocyclicClausePayload.toClaims])
      · intro assignment assignmentMem
        refine ⟨(assignmentValid assignment assignmentMem).1, ?_,
          (assignmentValid assignment assignmentMem).2⟩
        exact ctx.claim (claim := .monocyclic (.ringSide ring assignment.substituent assignment.side))
          (by
            simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims]
            exact Or.inr ⟨assignment, assignmentMem, rfl, rfl⟩)
  | unsaturated b topology count descriptor contextIsPIN =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93UnsaturatedMonocyclesReference, P93UnsaturatedMonocycleJudged,
        monocyclicAuthority, P93MonocyclicUnsaturationAuthorityObservation.ValidFor,
        P93MonocyclicPhysicalUnit.ValidFor, monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, topologyEq, preferred⟩
      refine ⟨⟨⟨closed, ?_, unitValid, ?_⟩, ?_, ?_, ?_, preferred⟩, topologyEq⟩
      · exact ctx.claim (claim := .monocyclic (.ring b.ring)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.unitInRing b.ring b.unit)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.unsaturation b.ring b.unit topology count)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ⟨contextIsPIN, ctx.claim
          (claim := .monocyclic (.chiralCycloalkene b.unit descriptor contextIsPIN)) (by
            simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
              P93MonocyclicPhysicalPayload.baseClaims])⟩
      · exact ⟨descriptor, ctx.claim
          (claim := .monocyclic (.chiralCycloalkene b.unit descriptor contextIsPIN)) (by
            simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
              P93MonocyclicPhysicalPayload.baseClaims])⟩
  | cyclicDouble b count geometry descriptor? =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93CyclicDoubleBondsReference, monocyclicAuthority,
        P93MonocyclicDoubleBondAuthorityObservation.ValidFor,
        P93MonocyclicPhysicalUnit.ValidFor, monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, bond, expected⟩
      refine ⟨⟨closed, ?_, unitValid, ?_⟩, bond, ?_, ?_, expected⟩
      · exact ctx.claim (claim := .monocyclic (.ring b.ring)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.unitInRing b.ring b.unit)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim
          (claim := .monocyclic (.unsaturation b.ring b.unit .ordinaryCyclicDoubleBondSystem count))
          (by simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.seniorGeometry b.unit geometry)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
  | exocyclicEZ b count opposite contextIsPIN method treatment descriptor?
  | exocyclicOther b count opposite contextIsPIN method treatment descriptor? =>
      have unitEnvelope := ctx.envelope (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
          P93MonocyclicPhysicalPayload.baseClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .monocyclic (.unitInRing b.ring b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
        (by simp [P93SourceClaim.physicalUnits, P93MonocyclicClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93MonocyclicClaim.SourceEnvelope] using unitEnvelope.2)
        unitSupport
      simp only [Remaining71P93MonocyclicAuthorityRow.reference,
        p93ExocyclicDoubleBondEZReference, p93ExocyclicDoubleBondOtherReference,
        P93ExocyclicDoubleBondEZJudged, P93ExocyclicDoubleBondOtherJudged,
        monocyclicAuthority,
        P93MonocyclicExocyclicAuthorityObservation.ValidFor,
        P93MonocyclicPhysicalUnit.ValidFor, monocyclicPhysical, monocyclicPolicy]
      rcases ctx.validFor.2 with ⟨closed, methodOk, unitShape, descriptorKind⟩
      refine ⟨⟨⟨closed, ?_, unitValid, ?_⟩, ?_, methodOk, unitShape, ?_⟩, descriptorKind⟩
      · exact ctx.claim (claim := .monocyclic (.ring b.ring)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.unitInRing b.ring b.unit)) (by simp
          [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim (claim := .monocyclic (.exocyclicSystem b.ring b.unit count opposite))
          (by simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])
      · exact ctx.claim
          (claim := .monocyclic
            (.exocyclicNaming b.unit contextIsPIN method treatment descriptor?))
          (by simp [P93ClausePayloadData.toClaims, P93MonocyclicClausePayload.toClaims,
            P93MonocyclicPhysicalPayload.baseClaims])

theorem monocyclicAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93MonocyclicAuthorityRow}
    (payload : P93MonocyclicClausePayload row)
    (ctx : PayloadContext program scope source (.monocyclic payload)) :
    row.ProductionJudges (program.monocyclicPolicy scope) source
      (monocyclicAuthority program scope payload) :=
  (row.production_eq_reference (program.monocyclicPolicy scope) source
    (monocyclicAuthority program scope payload)).2
