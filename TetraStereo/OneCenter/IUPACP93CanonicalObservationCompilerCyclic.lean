theorem ringAssemblyDoubleBondsAuthority_sourceCore_of_included
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (assembly : P93AuthorityRingAssembly)
