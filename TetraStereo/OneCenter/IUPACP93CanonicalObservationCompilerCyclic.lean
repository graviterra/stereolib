    (citation : P93AuthorityCitationToken)
    (candidates : List P93CyclophaneRCTReferenceCandidate)
    (selected : P93CyclophaneRCTReferenceCandidate) (referenceSide : RingSide)
    (located : List P93CyclophaneRCTLocatedAssignment)
    (assignment : P93CyclophaneRCTLocatedAssignment)
    (consumerMem : P93CanonicalReviewedDescriptorEvidence.cyclophaneCenterRelative
      (.cyclophaneCenters system unit citation
        (.relativeRCT candidates selected referenceSide located)) assignment ∈
      payload.assignments)
    (allValid : ∀ evidence ∈ payload.assignments, evidence.ValidFor entry.source)
    (unionClosed : P93CoupledAssignmentsUnionClosed payload.assignments) :
    ∀ center,
      program.HasClaim .coupled entry.source (.cyclophane (.rctEligible system center)) →
        ∃ candidate ∈ candidates, candidate.center = center := by
  intro center eligible
  have eligibleMem := (program.hasClaim_iff entryMem
    (.cyclophane (.rctEligible system center))).1 (by simpa [familyEq] using eligible)
  rw [auditEq] at eligibleMem
  have origin : ∃ producer ∈ payload.assignments,
      (.cyclophane (.rctEligible system center) : P93SourceClaim) ∈
        producer.upstreamClaims := by
    simpa [P93CoupledClausePayload.toClaims] using eligibleMem
  rcases origin with ⟨producer, producerMem, claimMem⟩
  have factMem : P93CoupledClosedWorldFact.cyclophaneRelativeCenter system center ∈
      producer.closedWorldFacts := by
    cases producer with
    | acyclicCenter p | acyclicDoubleBond p | acyclicEvenCumulene p
    | acyclicOddCumulene p =>
        cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93AcyclicClausePayload.toClaims, P93AcyclicBasePayload.baseClaims] at claimMem
    | monocyclicAbsoluteCenter p | monocyclicAchiralCenter p =>
        cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93MonocyclicClausePayload.toClaims, P93MonocyclicCitedPayload.baseClaims,
          P93MonocyclicPhysicalPayload.baseClaims] at claimMem
    | monocyclicDoubleBond p _ _ =>
        cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93MonocyclicClausePayload.toClaims,
          P93MonocyclicPhysicalPayload.baseClaims] at claimMem
    | fusedCIP observation =>
        simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims] at claimMem
    | cyclophanePlane p | cyclophaneDoubleBond p _ =>
        cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93FusedCyclophaneClausePayload.toClaims] at claimMem
    | cyclophaneCenterCIP p =>
        have producerValid := allValid _ producerMem
        cases p with
        | cyclophaneCenters _ _ _ specification =>
            cases specification with
            | cip _ _ _ =>
                simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
                  P93FusedCyclophaneClausePayload.toClaims] at claimMem
                split at claimMem <;> cases claimMem
            | relativeRCT _ _ _ _ =>
                simp [P93CanonicalReviewedDescriptorEvidence.ValidFor] at producerValid
    | cyclophaneCenterRelative p _ =>
        cases p with
        | cyclophaneCenters _ _ _ specification =>
            cases specification <;>
              simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
                P93CanonicalReviewedDescriptorEvidence.closedWorldFacts,
                P93FusedCyclophaneClausePayload.toClaims] at claimMem ⊢ <;>
              aesop
    | spiroPolyhedral p =>
        simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93SpiroNontetrahedralPayload.toClaims] at claimMem
    | ringAssemblyAxis p _ | ringAssemblyDoubleBond p _ =>
        cases p ; simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
          P93RingAssemblyClausePayload.toClaims] at claimMem
    | ringAssemblyCenter p _ =>
        cases p with
        | centers _ assignments =>
            simp [P93CanonicalReviewedDescriptorEvidence.upstreamClaims,
              P93RingAssemblyClausePayload.toClaims] at claimMem
            rcases claimMem with ⟨a, _aMem, claimMem⟩
            cases descriptorCase : a.generalDescriptor? <;> simp [descriptorCase] at claimMem
  have covered := unionClosed
    (.cyclophaneCenterRelative
      (.cyclophaneCenters system unit citation
        (.relativeRCT candidates selected referenceSide located)) assignment)
    consumerMem producer producerMem
    (.cyclophaneRelativeCenter system center) factMem
  exact covered rfl

