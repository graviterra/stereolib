/-! ## Von Baeyer compilation -/

theorem vonBaeyerAuthority_judged
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93VonBaeyerAuthorityRow}
    (payload : P93VonBaeyerClausePayload row)
    (ctx : PayloadContext program scope source (.vonBaeyer payload)) :
    (row.reference (program.vonBaeyerPolicy scope)).Judges source
      (vonBaeyerAuthority program scope payload) := by
  cases payload with
  | cip b center kind descriptor knowledge notationValue =>
      have unitEnvelope := ctx.envelope (claim := .vonBaeyer (.unit b.system b.unit)) (by
        simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := b.unit)
        (claim := .vonBaeyer (.unit b.system b.unit)) (by
          simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
        (by simp [P93SourceClaim.physicalUnits, P93VonBaeyerClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source b.unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93VonBaeyerClaim.SourceEnvelope] using
          unitEnvelope.2.1) unitSupport
      simp only [Remaining71P93VonBaeyerAuthorityRow.reference,
        p93VonBaeyerCIPCentersReference, P93VonBaeyerCIPCenterJudged,
        vonBaeyerAuthority, P93VonBaeyerCenterAuthorityObservation.ValidFor,
        P93AuthorityVonBaeyerSystem.ValidFor, vonBaeyerPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, unitEq, supported, kindOk, applies, absolute, notationEq, citation⟩
      have centerClaim := ctx.claim
        (claim := .vonBaeyer (.center center kind descriptor knowledge notationValue)) (by
          simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      refine ⟨⟨⟨systemValid, ?_⟩, unitValid, supported, ?_,
        ⟨center, unitEq, ⟨descriptor, knowledge, notationValue, centerClaim⟩,
          ⟨kind, knowledge, notationValue, centerClaim⟩,
          ⟨kind, descriptor, notationValue, centerClaim⟩,
          ⟨kind, descriptor, centerClaim⟩⟩,
        kindOk, applies, notationEq, citation, ?_⟩, absolute⟩
      all_goals exact ctx.claim (by simp
        [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
  | bridge system attachment substituent citation kind descriptor =>
      let unit := P93AuthorityPhysicalUnit.atomCenter attachment
      have unitEnvelope := ctx.envelope (claim := .vonBaeyer (.unit system unit)) (by
        simp [unit, P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        simpa [unit, P93SourceClaim.SourceEnvelope, P93VonBaeyerClaim.SourceEnvelope] using
          unitEnvelope.2.1) (by simp [unit, QualitativeUnitSupported])
      simp only [Remaining71P93VonBaeyerAuthorityRow.reference,
        p93VonBaeyerEndoExoSynAntiReference, vonBaeyerAuthority,
        P93VonBaeyerBridgeOrientationAuthorityObservation.ValidFor,
        P93AuthorityVonBaeyerSystem.ValidFor, vonBaeyerPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, applicable, attachmentMem, substituentNot, bonded,
          descriptorEq, notAbsolute, citationValid⟩
      refine ⟨⟨systemValid, ?_⟩, applicable, attachmentMem, substituentNot, bonded,
        unitValid, ?_, ?_, descriptorEq, notAbsolute, citationValid, ?_⟩
      all_goals exact ctx.claim (by simp
        [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
  | relative system firstLigand secondLigand firstCitation? secondCitation?
      firstSide secondSide descriptor pin notationValue =>
      simp only [Remaining71P93VonBaeyerAuthorityRow.reference,
        p93VonBaeyerCisTransReference, vonBaeyerAuthority,
        P93VonBaeyerBridgeheadRelativeAuthorityObservation.ValidFor,
        P93AuthorityVonBaeyerSystem.ValidFor, vonBaeyerPolicy]
      rcases ctx.validFor.2 with
        ⟨systemValid, ligandNe, firstNot, secondNot, firstBond, secondBond, relative,
          preferred, firstCitationValid, secondCitationValid, citationsPresent⟩
      refine ⟨⟨systemValid, ?_⟩, ligandNe, firstNot, secondNot, firstBond, secondBond,
        ?_, ?_, relative, ?_, preferred, ?_, ?_, citationsPresent⟩
      · exact ctx.claim (by simp
          [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      · exact ctx.claim (by simp
          [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      · exact ctx.claim (by simp
          [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      · exact ctx.claim (by simp
          [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      · cases firstCitation? with
        | none => simp [P93VonBaeyerOptionalBridgeheadCitationValid]
        | some citation =>
            refine ⟨firstCitationValid citation (by simp), ctx.claim ?_⟩
            simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims]
      · cases secondCitation? with
        | none => simp [P93VonBaeyerOptionalBridgeheadCitationValid]
        | some citation =>
            refine ⟨secondCitationValid citation (by simp), ctx.claim ?_⟩
            simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims]
  | doubleBond b specification =>
      rcases b with ⟨system, unit, citationToken⟩
      have unitEnvelope := ctx.envelope (claim := .vonBaeyer (.unit system unit)) (by
        cases specification <;>
          simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      have unitSupport := ctx.qualitativeSupported_of_claim (unit := unit)
        (claim := .vonBaeyer (.unit system unit)) (by
          cases specification <;>
            simp [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
        (by simp [P93SourceClaim.physicalUnits, P93VonBaeyerClaim.physicalUnits])
      have unitValid := program.physicalUnit_validForAtScope scope source unit (by
        simpa [P93SourceClaim.SourceEnvelope, P93VonBaeyerClaim.SourceEnvelope] using
          unitEnvelope.2.1) unitSupport
      cases specification with
      | ordinary pin larger geometry descriptor? =>
          simp only [Remaining71P93VonBaeyerAuthorityRow.reference,
            p93VonBaeyerDoubleBondsReference, vonBaeyerAuthority,
            P93VonBaeyerUnsaturationAuthorityObservation.ValidFor,
            P93AuthorityVonBaeyerSystem.ValidFor, vonBaeyerPolicy]
          rcases ctx.validFor.2 with
            ⟨systemValid, supported, bond, citation, allowed, preferred⟩
          refine ⟨⟨systemValid, ?_⟩, unitValid, supported, ?_, citation, ?_, bond,
            ?_, ?_, ?_, allowed, preferred⟩
          all_goals exact ctx.claim (by simp
            [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])
      | included context parity descriptor =>
          rcases ctx.validFor.2 with
            ⟨systemValid, supported, axis, citation, applies, recommended⟩
          rcases axis with ⟨path, unitEq⟩
          change unit = .axis path at unitEq
          subst unit
          simp only [Remaining71P93VonBaeyerAuthorityRow.reference,
            p93VonBaeyerDoubleBondsReference, vonBaeyerAuthority,
            P93VonBaeyerUnsaturationAuthorityObservation.ValidFor,
            P93AuthorityVonBaeyerSystem.ValidFor, vonBaeyerPolicy]
          refine ⟨⟨systemValid, ?_⟩, unitValid, supported, ?_, citation, ?_,
            ⟨path, rfl, ?_⟩, ?_, applies, recommended⟩
          all_goals exact ctx.claim (by simp
            [P93ClausePayloadData.toClaims, P93VonBaeyerClausePayload.toClaims])

theorem vonBaeyerAuthority_productionJudges
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput)
    {row : Remaining71P93VonBaeyerAuthorityRow}
    (payload : P93VonBaeyerClausePayload row)
    (ctx : PayloadContext program scope source (.vonBaeyer payload)) :
    row.ProductionJudges (program.vonBaeyerPolicy scope) source
      (vonBaeyerAuthority program scope payload) :=
  (row.production_eq_reference (program.vonBaeyerPolicy scope) source
    (vonBaeyerAuthority program scope payload)).2
      (vonBaeyerAuthority_judged program scope source payload ctx)

/-! ## Coupled-usable spiro polyhedral compilation -/

theorem spiroNontetrahedralAuthority_validFor_of_included
    (program : P93CanonicalSourceProgram) (scope : P93ClaimFamily)
    (source : AuthoritativeChemicalInput) (payload : P93SpiroNontetrahedralPayload)
    (ctx : IncludedPayloadContext program scope source (.spiroNontetrahedral payload)) :
    (spiroNontetrahedralAuthority program scope payload).ValidFor
      (program.spiroPolicy scope) source := by
  let unit := P93AuthorityPhysicalUnit.polyhedron payload.system.center payload.positions
  have unitMem : (.spiro (.unit payload.system unit) : P93SourceClaim) ∈
      (P93ClausePayloadData.spiroNontetrahedral payload).toClaims := by
    simp [unit, P93ClausePayloadData.toClaims, P93SpiroNontetrahedralPayload.toClaims]
  have exactMem :
      (.polyhedron payload.system.center payload.positions payload.executable.geometry
          payload.executable.frame : P93PhysicalClaim) ∈
        (P93ClausePayloadData.spiroNontetrahedral payload).exactQualitativePhysicalClaims := by
    simp [P93ClausePayloadData.exactQualitativePhysicalClaims,
      P93SpiroNontetrahedralPayload.exactQualitativePhysicalClaims]
  have exactObserved := ctx.exactPhysicalSupported _ exactMem
  have unitValid : unit.ValidFor (program.physicalPolicy scope) source := by
    exact ⟨payload.executable.geometry, payload.executable.frame,
      program.sourceEnvelope_of_hasPhysicalSupport exactObserved, exactObserved⟩
