      (.fusedCyclophane (.cyclophanePlanes printed executable))) :
    (fusedCyclophaneAuthority program scope
      (.cyclophanePlanes printed executable)).ValidFor
        (program.cyclophanePolicy scope) source := by
  let unit := P93AuthorityPhysicalUnit.plane printed.members
  have systemClaim := ctx.claimsIncluded (.cyclophane (.system printed.system)) (by
    simp [P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have unitClaim := ctx.claimsIncluded (.cyclophane (.unit printed.system unit)) (by
    simp [unit, P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have citationClaim := ctx.claimsIncluded (.cyclophane (.citation printed.citation unit)) (by
    simp [unit, P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have referenceClaim := ctx.claimsIncluded
      (.cyclophane (.planeReference printed.system unit printed.reference)) (by
    simp [unit, P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have orderClaim := ctx.claimsIncluded
      (.cyclophane (.planeOrder printed.system unit printed.high printed.low)) (by
    simp [unit, P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  have descriptorClaim := ctx.claimsIncluded
      (.cyclophane (.planeDescriptor printed.system unit printed.context printed.descriptor)) (by
    simp [unit, P93ClausePayloadData.toClaims, P93FusedCyclophaneClausePayload.toClaims])
  rcases ctx.validFor.2 with ⟨printedValid, executableValid⟩
  rcases printedValid with
    ⟨_moleculeEq, systemValid, _carrier, unitSupported, _torsion, _symmetry,
      referenceValid, preferred, citationValid⟩
  rcases executableValid with
    ⟨_membersEq, _pilotEq, order, _inPlaneEq, _outOfPlaneEq, _torsionEq,
      _symmetryEq, frameValid, spatial, highPoint, lowPoint, inPlanePoint,
      outOfPlanePoint, general, spatialEq, highAt, lowAt, inPlaneAt, outOfPlaneAt,
      rational, descriptorEq⟩
  simp only [fusedCyclophaneAuthority, P93CyclophanePlaneAuthorityObservation.ValidFor,
    P93AuthorityCyclophaneSystem.ValidFor, cyclophanePolicy]
  refine ⟨⟨systemValid, systemClaim⟩, unitSupported,
    ⟨printed.members, spatial, printed.high, printed.low, highPoint, lowPoint,
      inPlanePoint, outOfPlanePoint, general, rfl, frameValid, spatialEq, ?_, orderClaim,
      highAt, lowAt, (by simpa [_inPlaneEq] using inPlaneAt),
      (by simpa [_outOfPlaneEq] using outOfPlaneAt), rational, referenceClaim, descriptorClaim,
      descriptorEq⟩,
    referenceValid, preferred, unitClaim, citationValid, citationClaim⟩
  rcases order with order | order
  · exact Or.inl ⟨order.1.symm, order.2.symm⟩
  · exact Or.inr ⟨order.2.symm, order.1.symm⟩

