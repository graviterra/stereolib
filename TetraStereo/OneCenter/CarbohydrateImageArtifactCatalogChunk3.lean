@[simp] theorem imageArtifactsChunk3_length : imageArtifactsChunk3.length = 50 := by rfl

def imageArtifactPathsChunk3 : List String :=
  imageArtifactsChunk3.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk3_isChain :
    imageArtifactPathsChunk3.IsChain (· < ·) := by decide

theorem imageArtifactsChunk3_transcribedCount :
    (imageArtifactsChunk3.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk3_transcribedTemplatesWellFormed :
    (imageArtifactsChunk3.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk3_genericAndErratumTranscribed :
    (imageArtifactsChunk3.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk3_kindCounts :
    (imageArtifactsChunk3.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk3.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk3.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk3.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk3_chemicalPartitionCounts :
    (imageArtifactsChunk3.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk3.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk3_graphAuditMaturityCounts :
    (imageArtifactsChunk3.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk3.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk3.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

