@[simp] theorem imageArtifactsChunk7_length : imageArtifactsChunk7.length = 50 := by rfl

def imageArtifactPathsChunk7 : List String :=
  imageArtifactsChunk7.map ImageArtifactData.relativePath

theorem imageArtifactPathsChunk7_isChain :
    imageArtifactPathsChunk7.IsChain (· < ·) := by decide

theorem imageArtifactsChunk7_transcribedCount :
    (imageArtifactsChunk7.filter ImageArtifactData.symbolicTemplateTranscribed).length = 0 := by
  decide

theorem imageArtifactsChunk7_transcribedTemplatesWellFormed :
    (imageArtifactsChunk7.filter ImageArtifactData.symbolicTemplateTranscribed).all fun data =>
      match symbolicTemplate? data.relativePath with
      | some graph => graph.wellFormed
      | none => false := by
  decide

theorem imageArtifactsChunk7_genericAndErratumTranscribed :
    (imageArtifactsChunk7.filter fun data =>
      data.kind = .genericGlossaryStructure ∨ data.kind = .erratumCorrectedStructure).all
      ImageArtifactData.symbolicTemplateTranscribed := by
  decide

theorem imageArtifactsChunk7_kindCounts :
    (imageArtifactsChunk7.filter fun data =>
      data.kind = .numberedOrChartStructure).length = 50 ∧
    (imageArtifactsChunk7.filter fun data =>
      data.kind = .genericGlossaryStructure).length = 0 ∧
    (imageArtifactsChunk7.filter fun data =>
      data.kind = .erratumCorrectedStructure).length = 0 ∧
    (imageArtifactsChunk7.filter fun data =>
      data.kind = .typographyGlyph).length = 0 := by
  decide

theorem imageArtifactsChunk7_chemicalPartitionCounts :
    (imageArtifactsChunk7.filter fun data =>
      data.kind.requiresMolecularGraph).length = 50 ∧
    (imageArtifactsChunk7.filter fun data =>
      !data.kind.requiresMolecularGraph).length = 0 := by
  decide

theorem imageArtifactsChunk7_graphAuditMaturityCounts :
    (imageArtifactsChunk7.filter fun data =>
      data.graphAuditMaturity = .symbolicTemplateTranscribed).length = 0 ∧
    (imageArtifactsChunk7.filter fun data =>
      data.graphAuditMaturity = .sourceOnlyGraphPending).length = 50 ∧
    (imageArtifactsChunk7.filter fun data =>
      data.graphAuditMaturity = .nonChemicalGlyphAudited).length = 0 := by
  decide

