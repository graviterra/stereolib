import TetraStereo.Engine.RingGraphAuxiliaries

/-! Enumerate auxiliary requests from bonds and cache each once per original-root sphere. -/
set_option autoImplicit false

namespace TetraStereo.Engine.RingGraphCache
open OneCenter CertifiedLocalizedCIPInput
open LocalizedChemicalRing (Input)
open RingGraphPaths (Path site represents_site)
open RingActiveDistanceSchedule (Cell View distance height)

structure Visit (i : Input) (r : i.certified.Atom) where
  history : List i.certified.Atom
  atom : i.certified.Atom
  path : Path i r history atom

private def extend {i r} (v : Visit i r) (b : i.certified.Atom) : Option (Visit i r) :=
  if ok : i.certified.moleculeGraph.Adj v.atom b ∧ b ∉ v.history then
    some ⟨b :: v.history,b,.step v.path ok.1 ok.2⟩ else none

private def children {i r} (v : Visit i r) :=
  (List.finRange i.certified.certified.input.molecule.atomCount).filterMap (extend v)

/-- Enumerate every simple path with exactly this many bonds from the requested root. -/
def sphere (i : Input) (r : i.certified.Atom) : Nat → List (Visit i r)
  | 0 => [⟨[r],r,.origin⟩]
  | n+1 => (sphere i r n).flatMap children

private theorem cover {i r h a} (p : Path i r h a) :
    ∃ n, h.length = n+1 ∧ (⟨h,a,p⟩ : Visit i r) ∈ sphere i r n := by
  induction p with
  | origin => exact ⟨0,rfl,List.mem_singleton_self _⟩
  | step prior adj fresh ih =>
    obtain ⟨n,hn,mem⟩ := ih
    refine ⟨n+1,by simp [hn],List.mem_flatMap.mpr ⟨_,mem,?_⟩⟩
    exact List.mem_filterMap.mpr ⟨_,List.mem_finRange _,dif_pos ⟨adj,fresh⟩⟩

theorem sphere_iff {i r} (v : Visit i r) (n : Nat) : v ∈ sphere i r n ↔ v.history.length = n+1 := by
  constructor
  · intro mem
    induction n generalizing v with
    | zero =>
      obtain rfl := List.mem_singleton.mp mem
      rfl
    | succ n ih =>
      obtain ⟨u,hu,hv⟩ := List.mem_flatMap.mp mem
      obtain ⟨b,_,step⟩ := List.mem_filterMap.mp hv
      unfold extend at step
      split at step
      · obtain rfl := Option.some.inj step
        simp [ih u hu]
      · contradiction
  · intro size
    obtain ⟨k,eqn,mem⟩ := cover v.path
    obtain rfl : k = n := by omega
    exact mem

private def select {i r} (v : Visit i r) : Option (RingActivePairs.Site i) :=
  if v.atom ≠ r ∧ Fintype.card (i.certified.moleculeGraph.Neighbor v.atom) = 4 then some (site v.path) else none

def queue (i : Input) (r : i.certified.Atom) (n : Nat) := (sphere i r n).filterMap select

theorem inventory (i : Input) (r : i.certified.Atom) : RingSphereQueue.Inventory r (queue i r) := by
  intro n q
  constructor
  · intro found
    obtain ⟨v,mem,hit⟩ := List.mem_filterMap.mp found
    unfold select at hit
    split at hit
    · rename_i ok
      obtain rfl := Option.some.inj hit
      have rep := represents_site v.path
      have depth := RingGraphPaths.path_length rep
      have size := (sphere_iff v n).mp mem
      exact ⟨(RingSphereQueue.candidate_iff ..).mpr
        ⟨rep.1,rep.2.2.1,v.atom,rep.2.2.2,ok⟩,by omega⟩
    · contradiction
  · rintro ⟨eligible,depth⟩
    obtain ⟨h,a,p,rep,other,four⟩ := (RingGraphPaths.auxiliary_iff ..).mp eligible
    let v : Visit i r := ⟨h,a,p⟩
    have shape := RingGraphPaths.path_length rep
    have mem : v ∈ sphere i r n := (sphere_iff v n).mpr (by change h.length = n+1; omega)
    refine List.mem_filterMap.mpr ⟨v,mem,?_⟩
    exact (if_pos ⟨other,four⟩).trans (congrArg some (RingGraphPaths.unique_site (represents_site p) rep))

/-- The local rule is the rebuilt constitutional and stereo calculation. Cached rows are
generated by the graph's bonded paths. They contain successes, refusals, and coverage. -/
def root (i : Input) (r : i.certified.Atom) : Cell :=
  match RingZeroMassReport.zeroEarly? i (RingGroupedReport.origin i r) with
  | some s => some s.letters
  | none => RingSphereQueue.finalCell (RingRebuiltStereo.publish i) r (queue i r)

theorem root_exact {i : Input} (coords : LocalizedChemicalRing.coordinatesAdmitted i = true)
    (r : i.certified.Atom) : root i r = RingGroupedPublication.state i (RingGroupedReport.origin i r) := by
  have skip : RingSphereQueue.SkipsNoncentres (RingRebuiltStereo.publish i) := by
    intro q read no
    simp [RingRebuiltStereo.publish,no]
  unfold root
  cases hit : RingZeroMassReport.zeroEarly? i (RingGroupedReport.origin i r) with
  | some s => exact (RingSphereQueue.early_exact coords ((RingZeroMassReport.zero_early_exact i _).symm.trans hit)).symm
  | none => rw [RingSphereQueue.final_exact skip (inventory i r),RingRebuiltStereo.state_exact i coords]

end TetraStereo.Engine.RingGraphCache

assert_kernel_only TetraStereo.Engine.RingGraphCache.sphere_iff
assert_kernel_only TetraStereo.Engine.RingGraphCache.inventory
assert_kernel_only TetraStereo.Engine.RingGraphCache.root_exact
