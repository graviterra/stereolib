import TetraStereo.Engine.RingRetainedChemicalTrace
import TetraStereo.OneCenter.LocalizedContextCyclicReaderBridge

set_option autoImplicit false

namespace TetraStereo.Engine.RingRetainedChemicalCoverage

open OneCenter CertifiedLocalizedCIPInput
open LocalizedChemicalRing (Input)
open RingRetainedConstitution (Cursor Incident)
open RingRetainedChemicalTrace

/-- Check the molecule's written records once. Real atoms require their written
isotope mass. A ring copy can require the ordinary mass of the same element. -/
def atomsCovered (m : RawMolecule) : Bool :=
  m.atoms.all fun a => a.element.atomicNumber > 0 &&
    (CIPRule2MassData.rule2MassPico? a.element.atomicNumber a.isotope?).isSome &&
    (CIPRule2MassData.rule2MassPico? a.element.atomicNumber none).isSome

/-- The public input already certifies all real isotope spellings. Every periodic
element at the same position also has an ordinary mass in the reviewed table. -/
theorem admitted_atoms (i : Input) : atomsCovered i.molecule = true := by
  apply List.all_eq_true.mpr
  intro r hr
  obtain ⟨idx,get⟩ := List.mem_iff_get.mp hr
  let source := i.certified.certified.input.molecule
  obtain ⟨atom,atSource,converted⟩ :=
    i.molecule.toSemanticMolecule?_atomAtFin source i.agreement.1 idx
  change (i.molecule.atoms.get idx).toSemanticAtom? = some atom at converted
  rw [get] at converted
  have data := AtomSpec.toSemanticAtom?_exact r atom converted
  have member := listGet?_eq_some_implies_mem source.atoms idx.val atom atSource
  obtain ⟨mass,known⟩ := i.certified.graphReady.2.2.1 atom member
  change CIPRule2MassData.rule2MassPico? atom.element.atomicNumber atom.isotopeMassNumber? = some mass at known
  have z := atom.element.positive
  have upper := atom.element.atMost118
  rw [data.1] at z upper known
  rw [data.2.1] at known
  have periodic : r.element.atomicNumber ∈ CIPRule2MassData.currentAtomicNumbers := by
    unfold CIPRule2MassData.currentAtomicNumbers
    apply List.mem_map.mpr
    refine ⟨r.element.atomicNumber-1,List.mem_range.mpr (by omega),?_⟩
    change Nat.succ (r.element.atomicNumber-1) = r.element.atomicNumber
    omega
  obtain ⟨ordinary,found⟩ := CIPRule2MassData.every_current_atomic_number_has_an_ordinary_value _ periodic
  simp [z,known,CIPRule2MassData.rule2MassPico?_ordinary,found]

private theorem record (i : Input) (ok : atomsCovered i.molecule = true) (a : i.certified.Atom) :
    ∃ r m u, i.molecule.atoms[a.val]? = some r ∧ 0 < r.element.atomicNumber ∧
      CIPRule2MassData.rule2MassPico? r.element.atomicNumber r.isotope? = some m ∧
      CIPRule2MassData.rule2MassPico? r.element.atomicNumber none = some u := by
  have count := i.molecule.toSemanticMolecule?_atomCount i.certified.certified.input.molecule i.agreement.1
  have bound : a.val < i.molecule.atoms.length := by
    change a.val < i.molecule.atomCount
    rw [← count]
    exact a.isLt
  let r := i.molecule.atoms[a.val]
  have member : r ∈ i.molecule.atoms := List.getElem_mem bound
  have good := List.all_eq_true.mp ok r member
  simp only [Bool.and_eq_true,decide_eq_true_eq,Option.isSome_iff_exists] at good
  obtain ⟨⟨z,m,hm⟩,u,hu⟩ := good
  exact ⟨r,m,u,List.getElem?_eq_getElem bound,z,hm,hu⟩

private def SourceNode (i : Input) (n : OfficialCIPNode i.certified.Atom) : Prop :=
  ∃ a, n.current? = some a ∧ (n.provenance = .realAtom ∨ ∃ o,
    n.provenance = .ringDuplicate o ∧ o ≤ i.molecule.atomCount ∧
    n.history.head? = some a ∧ n.history.tail.reverse.idxOf a = o ∧ a ∈ n.history.tail)

private theorem firstIndex {α : Type} [DecidableEq α] (a : α) (xs : List α) (mem : a ∈ xs) :
    firstIndexOf? a xs = some (xs.idxOf a) := by
  induction xs with
  | nil => contradiction
  | cons x xs ih =>
    by_cases eq : x = a
    · subst x; rw [firstIndexOf?_cons_self,List.idxOf_cons_eq _ rfl]
    · have tail : a ∈ xs := (List.mem_cons.mp mem).resolve_left (Ne.symm eq)
      rw [firstIndexOf?,if_neg eq,ih tail,List.idxOf_cons_ne _ eq]
      simp

/-- Every node generated by the single-bond carrier either has a real current atom
or closes onto a particular member of a simple original history. -/
private theorem sourceNode (i : Input) {root n address}
    (legit : LegitimateOccurrence i.certified root n address) : SourceNode i n := by
  cases legit with
  | simple p =>
    have real := i.certified.simpleOccurrencePath_provenance p
    cases p with
    | root => exact ⟨_,rfl,Or.inl real⟩
    | step => exact ⟨_,rfl,Or.inl real⟩
  | @ring parent addr current next path observed edge avoid seen =>
    let o := parent.history.reverse.idxOf next
    have reversed := List.mem_reverse.mpr seen
    have dist : parent.duplicateRootDistance next = o := by
      simp [OfficialCIPNode.duplicateRootDistance,firstIndex next _ reversed,o]
    have exactOrigin := i.certified.legitimateOccurrence_ring_provenance seen
    rw [dist] at exactOrigin
    have upper := (i.certified.simpleOccurrencePath_history_nodup path).length_le_card
    simp only [Fintype.card_fin] at upper
    have count := i.molecule.toSemanticMolecule?_atomCount i.certified.certified.input.molecule i.agreement.1
    have lower := List.idxOf_lt_length_iff.mpr reversed
    simp only [List.length_reverse] at lower
    refine ⟨next,rfl,.inr ⟨o,exactOrigin,?_,rfl,rfl,seen⟩⟩
    dsimp [o]
    omega
  | @multiple parent addr current next copy path observed edge bound positive =>
    have one := i.single current next edge
    rw [one] at bound
    exact False.elim (positive (by omega))

/-- Every cursor of every finite original carrier has a physical observation on
this molecule. Recognition requires no local witnesses supplied by a caller. -/
theorem observed (i : Input) (ok : atomsCovered i.molecule = true) {d : Nat}
    (q : Cursor i.certified d) : ∃ o,
    observation? i q (i.certified.executableLocalizedRerootChildren q).isEmpty = some o := by
  obtain ⟨a,atAtom,kind⟩ := sourceNode i (i.certified.carrierOccurrence_legitimate i.single q.occurrence)
  obtain ⟨r,m,u,atRecord,z,hm,hu⟩ := record i ok a
  rcases kind with real | ⟨origin,closure,bound,head,depth,seen⟩
  · exact ⟨⟨r.element.atomicNumber,0,m⟩,by simp [observation?,atAtom,atRecord,z,real,hm,duplicateValue]⟩
  · have dup := i.certified.isDuplicateLeaf_eq_true_of_ring_provenance q.occurrence.val.node closure
    have noChildren : i.certified.executableLocalizedRerootChildren q = [] := by
      simp [executableLocalizedRerootChildren,intendedLocalizedRerootChildFrames,dup]
    change CIPRule2MassData.ordinaryAtomicMassPico? r.element.atomicNumber = some u at hu
    exact ⟨⟨r.element.atomicNumber,duplicateValue i.molecule.atomCount (some origin),u⟩,
      by simp [observation?,atAtom,atRecord,z,closure,bound,head,depth,seen,noChildren,hu]⟩

theorem key_total (i : Input) (ok : atomsCovered i.molecule = true) {d : Nat}
    (q : Cursor i.certified d) (valid : i.certified.LocalizedRerootCursorValid q) :
    ∃ k, key? i q = some k :=
  (key_covered_iff i q valid).mpr (fun t _ => observed i ok t)

/-- At molecule-wide depth the same global mass check guarantees an exact
constitutional comparison for every pair of distinct directions at every
real focus, including directions entering through the old parent. -/
theorem all_incident (i : Input) (ok : atomsCovered i.molecule = true)
    (f a b : i.certified.LocalizedCIPOccurrence (i.certified.certified.input.molecule.atomCount+1))
    (inc : Incident i.certified f a b) : ∃ t, compareAt? i f a b = some t := by
  obtain ⟨x,hx⟩ := key_total i ok ⟨a,some f⟩
    ((i.certified.mem_localizedRerootNeighborFrames_iff f.val a.val).mpr ⟨a.property,inc.2.2.1⟩)
  obtain ⟨y,hy⟩ := key_total i ok ⟨b,some f⟩
    ((i.certified.mem_localizedRerootNeighborFrames_iff f.val b.val).mpr ⟨b.property,inc.2.2.2⟩)
  exact ⟨keyTrace x y,by simp [compareAt?,inc,trace?,hx,hy]⟩

/-- Every admitted ring has complete retained Rule 1a, Rule 1b and Rule 2
comparisons. A tie here is a positive constitutional result that can be
consumed by stereochemical rules. Both corrected source expansions are
available at the same original molecular focus. -/
theorem admitted_incident (i : Input)
    (f a b : i.certified.LocalizedCIPOccurrence (i.certified.certified.input.molecule.atomCount+1))
    (inc : Incident i.certified f a b) :
    ∃ t x y, compareAt? i f a b = some t ∧ Expansion i ⟨a,some f⟩ x ∧
      Expansion i ⟨b,some f⟩ y ∧ t = keyTrace x y := by
  obtain ⟨t,hit⟩ := all_incident i (admitted_atoms i) f a b inc
  obtain ⟨_,x,y,hx,hy,eq⟩ := compareAt?_source hit
  exact ⟨t,x,y,hit,hx,hy,eq⟩

end TetraStereo.Engine.RingRetainedChemicalCoverage

assert_kernel_only TetraStereo.Engine.RingRetainedChemicalCoverage.observed
assert_kernel_only TetraStereo.Engine.RingRetainedChemicalCoverage.key_total
assert_kernel_only TetraStereo.Engine.RingRetainedChemicalCoverage.all_incident
assert_kernel_only TetraStereo.Engine.RingRetainedChemicalCoverage.admitted_atoms
assert_kernel_only TetraStereo.Engine.RingRetainedChemicalCoverage.admitted_incident
