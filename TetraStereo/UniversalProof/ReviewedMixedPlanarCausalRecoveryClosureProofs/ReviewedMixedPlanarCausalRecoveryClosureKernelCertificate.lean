import TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure
import TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness
import TetraStereo.KernelOnly

set_option autoImplicit false
set_option maxRecDepth 10000
set_option maxHeartbeats 1000000

namespace TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosureKernelCertificate

open TetraStereo.OneCenter
open TetraStereo.OneCenter.AuthoritativeChemicalInput
open TetraStereo.OneCenter.AuthoritativeChemicalInput.SingleWedgeSource
open TetraStereo.UniversalProof.ScheduledDrawingSpatialEndToEndProofs.ScheduledDrawingSpatialIntegration
open TetraStereo.UniversalProof.SourceNativeRawAnnotationAgreementProofs.SourceNativeRawAnnotationAgreement
open TetraStereo.UniversalProof.MixedPlanarCausalRecoveryProofs.SourceNativeMixedPlanarCausalModel
open TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure




















namespace ClosedAnnotatedPlanarWitness

abbrev closedSource : AuthoritativeChemicalInput :=
  TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness.source

abbrev closedDiagram : DiagramConfiguration :=
  TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness.diagram

abbrev closedRaw : RawMolecule :=
  TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness.annotatedRaw

abbrev closedAgreement : RawAnnotationAgreement closedRaw closedSource :=
  TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness.actual_annotation_agreement

abbrev closedWrittenExact : closedRaw.WrittenNeighborExact :=
  TetraStereo.UniversalProof.SourceNativeAnnotatedPlanarParserWitnessProofs.SourceNativeAnnotatedPlanarParserWitness.actual_written_exact

/-- The actual closed source diagram writes only plain bonds. -/
theorem closed_all_bonds_plain :
    ∀ bond ∈ closedDiagram.bonds, bond.style = .plain := by decide +kernel

/-- The actual closed annotated source lies in the plain-diagram structural domain. -/
theorem closed_plainDiagram : HasPlainDiagram closedSource :=
  ⟨closedDiagram, rfl, closed_all_bonds_plain⟩

/-- The generic domain law specialises to the actual closed source: its source-wide candidate conflict
guard is empty at every carrier and rule fuel. -/
theorem closed_globalConflictFree (carrierFuel ruleFuel : Nat) :
    PlanarGlobalConflictFree closedRaw closedSource closedAgreement closedWrittenExact carrierFuel
      ruleFuel :=
  planarGlobalConflictFree_of_plain closedRaw closedSource closedAgreement closedWrittenExact
    closed_plainDiagram carrierFuel ruleFuel

end ClosedAnnotatedPlanarWitness

end TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosureKernelCertificate

/-! Trust checks for the generic closure and the closed specialisation above. -/

assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.foldStatus_none_cons_ne_conflict
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.wedgeRecords_incident_eq_nil_of_plain
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.extract_none_of_plain_diagram
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.hasPlainDiagram_extract?_eq_none
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.occurrenceOrdinaryDescriptor?_eq_none_of_plain
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.hasPlainDiagram_drawingAbsent
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarJointDrawingDescriptor?_eq_none_of_drawingAbsent
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarJointStatus_ne_conflict_of_drawingAbsent
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarGlobalConflictFree_of_drawingAbsent
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarJointAuditObligation_of_partial_of_drawingAbsent
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarGlobalConflictFree_of_plain
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosure.planarJointAuditObligation_of_partial_of_plain
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosureKernelCertificate.ClosedAnnotatedPlanarWitness.closed_all_bonds_plain
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosureKernelCertificate.ClosedAnnotatedPlanarWitness.closed_plainDiagram
assert_kernel_only TetraStereo.UniversalProof.ReviewedMixedPlanarCausalRecoveryClosureProofs.ReviewedMixedPlanarCausalRecoveryClosureKernelCertificate.ClosedAnnotatedPlanarWitness.closed_globalConflictFree
