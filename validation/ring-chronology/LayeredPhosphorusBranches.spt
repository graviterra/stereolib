end "model mol";
for (var mask = 0; mask < 64; mask++) {
  var qmask = mask
  var wanted = ""
  var nearL = 0
  var nearR = 0
  var farL = 0
  var farR = 0
  var weight = 32
  for (var k = 5; k >= 0; k--) {
    var b = qmask >= weight
    if (b) { qmask = qmask-weight }
    weight = weight/2
    var t = 14 + 2*k
    var c = 7+k
    var cl = point(t,t*t/4,t*t*t/16)
    if (b) {
      cl = point(2*c-t,(2*c*c-t*t)/4,(2*c*c*c-t*t*t)/16)
      wanted = "R"+wanted
      if (k == 0) { nearL = 1 }
      if (k == 1) { nearR = 1 }
      if (k == 2 || k == 3) { farL++ }
      if (k == 4 || k == 5) { farR++ }
    } else { wanted = "S"+wanted }
    var anum = t+1
    {atomno=anum}.xyz = cl
  }
  var leftBest = (nearL == 1 ? farL : 2-farL)
  var rightBest = (nearR == 1 ? farR : 2-farR)
  var orig = ""
  var refl = ""
  if (leftBest > rightBest) { orig = "S"; refl = "R" }
  if (rightBest > leftBest) { orig = "R"; refl = "S" }
  if (leftBest == rightBest && nearL > nearR) { orig = "s"; refl = "s" }
  if (leftBest == rightBest && nearR > nearL) { orig = "r"; refl = "r" }
  for (var rev = 0; rev < 2; rev++) {
    calculate chirality
    var rootHand = {atomno=1}.chirality
    var expectation = (rev == 0 ? orig : refl)
    var tips = ""
    for (var n = 8; n <= 13; n++) { tips += {atomno=n}.chirality }
    if (rootHand != expectation || tips != wanted) {
      print "mismatch " + mask + " " + rev + " " + rootHand + "/" + expectation + " " + tips + "/" + wanted
      throw "phosphorus configuration"
    }
    wanted = wanted.replace("R","x").replace("S","R").replace("x","S")
    select *
    invertSelected POINT {0 0 0}
  }
}
print "LAYERED_PHOSPHORUS_128_PASS"

# Split the rank of the far tips on each side by replacing one chlorine with bromine.
{atomno=19 or atomno=23}.elemno = 35
if ({bromine}.count != 2) { throw "bromine substitution" }
{atomno=15}.xyz = {0 -24.5 -128.625}
{atomno=17}.xyz = {0 -32.0 -192.0}
{atomno=19}.xyz = {0 -40.5 -273.375}
{atomno=21}.xyz = {20 100.0 500.0}
{atomno=23}.xyz = {22 121.0 665.5}
{atomno=25}.xyz = {0 -72.0 -648.0}
for (var rev = 0; rev < 2; rev++) {
  calculate chirality
  var tips = ""
  for (var n = 8; n <= 13; n++) { tips += {atomno=n}.chirality }
  var expected = (rev == 0 ? "SRRRSSR" : "RSSSRRS")
  if ({atomno=1}.chirality + tips != expected) { throw "mixed-path descriptor" }
  select *
  invertSelected POINT {0 0 0}
}
print "MIXED_PHOSPHORUS_PASS"
